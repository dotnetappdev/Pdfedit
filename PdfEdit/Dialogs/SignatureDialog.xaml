<Window x:Class="PdfEdit.Dialogs.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Signature"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <!-- Tab item style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground"       Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,8"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog button style -->
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- Primary (apply) button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabCtrl"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">

            <!-- ── Type tab (index 0) ── -->
            <TabItem Header="Type">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Name input row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TypedNameBox"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 Padding="8,6" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TypedNameBox_TextChanged"
                                 AutomationProperties.Name="Type your name"/>
                        <TextBlock Grid.Column="1" Text="Style:" Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DimForegroundBrush}"
                                   FontSize="12"/>
                        <ComboBox Grid.Column="2" x:Name="FontStyleBox"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  Background="{DynamicResource InputBgBrush}"
                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                  SelectionChanged="FontStyleBox_SelectionChanged"
                                  AutomationProperties.Name="Font style"/>
                    </Grid>

                    <!-- Preview area -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Background="White" Margin="0,0,0,0">
                        <TextBlock x:Name="SignaturePreview"
                                   FontFamily="Segoe Script" FontSize="52"
                                   Foreground="#1B3A6B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Your Name Here" Padding="16,8"
                                   TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Draw tab (index 1) ── -->
            <TabItem Header="Draw">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Draw your signature with your mouse or stylus:"
                               Foreground="{DynamicResource DimForegroundBrush}"
                               FontSize="12" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Background="White">
                        <InkCanvas x:Name="InkArea" Background="White"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Image tab (index 2) ── -->
            <TabItem Header="Image">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Browse image…" Style="{StaticResource DlgBtn}"
                                Click="BrowseImage_Click"
                                AutomationProperties.Name="Browse for signature image"/>
                        <TextBlock x:Name="ImagePathLabel" Margin="12,0,0,0"
                                   Foreground="{DynamicResource DimForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Text="No image selected" FontSize="11"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Background="White">
                        <Image x:Name="ImagePreview" Stretch="Uniform" Margin="8"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── Save to library + action buttons ── -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Save to library row -->
            <Border Grid.Row="0"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SaveToLibraryCb"
                              Content="Save signature:"
                              IsChecked="True"
                              Foreground="{DynamicResource ForegroundBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              AutomationProperties.Name="Save signature to library"/>
                    <TextBox Grid.Column="1" x:Name="LibraryNameTb"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             BorderThickness="1" Padding="8,4"
                             FontSize="12" Text="My Signature"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Signature name"/>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear" Style="{StaticResource DlgBtn}" Click="Clear_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="ApplyBtn" Content="Apply Signature"
                        Style="{StaticResource PrimaryBtn}"
                        IsDefault="True" Click="Apply_Click"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Apply signature"/>
                <Button Content="Cancel" Style="{StaticResource DlgBtn}"
                        IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

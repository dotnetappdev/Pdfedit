<Window x:Class="PdfEdit.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" FontSize="12" Margin="0,0,0,6"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Height="28" FontSize="12"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="OK" Width="80" Height="28"
                    Click="OK_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="PdfEdit.Dialogs.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Process"
        Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Files -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" x:Name="FilesHead" Text="FILES (0)" Style="{StaticResource Head}"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Add files…" Padding="10,3" Margin="0,0,6,6" Click="AddFiles_Click"/>
                <Button Content="Add folder…" Padding="10,3" Margin="0,0,6,6" Click="AddFolder_Click"/>
                <Button x:Name="AddOpenBtn" Content="Add open PDF" Padding="10,3" Margin="0,0,6,6" Click="AddOpen_Click"/>
                <Button Content="Remove" Padding="10,3" Margin="0,0,6,6" Click="RemoveFile_Click"/>
                <Button Content="Clear" Padding="10,3" Margin="0,0,6,6" Click="ClearFiles_Click"/>
                <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" VerticalAlignment="Center" Margin="0,0,0,6"/>
            </WrapPanel>
            <ListBox x:Name="FileList" Style="{StaticResource DarkListBox}" SelectionMode="Extended" AllowDrop="True" Drop="FileList_Drop"
                     AutomationProperties.Name="Files to process"/>
        </DockPanel>

        <!-- Steps -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="STEPS" Style="{StaticResource Head}"/>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2" Margin="4,0,0,0" Click="DeleteAction_Click" ToolTip="Delete this saved action"/>
                <Button DockPanel.Dock="Right" Content="Save…" Padding="8,2" Margin="4,0,0,0" Click="SaveAction_Click" ToolTip="Save these steps as a reusable action"/>
                <ComboBox x:Name="ActionBox" Height="26" DisplayMemberPath="Name" SelectionChanged="ActionBox_SelectionChanged"
                          ToolTip="Saved actions" AutomationProperties.Name="Saved actions"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="0" Margin="4,0,0,0" Click="RemoveStep_Click" ToolTip="Remove step" AutomationProperties.Name="Remove step"/>
                <Button DockPanel.Dock="Right" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="0" Margin="4,0,0,0" Click="StepDown_Click" ToolTip="Move down" AutomationProperties.Name="Move step down"/>
                <Button DockPanel.Dock="Right" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="0" Margin="4,0,0,0" Click="StepUp_Click" ToolTip="Move up" AutomationProperties.Name="Move step up"/>
                <ComboBox x:Name="AddStepBox" Height="26" SelectionChanged="AddStepBox_SelectionChanged" ToolTip="Add a step" AutomationProperties.Name="Add a step"/>
            </DockPanel>
            <ListBox x:Name="StepList" Style="{StaticResource DarkListBox}" SelectionChanged="StepList_SelectionChanged" AutomationProperties.Name="Steps"/>
        </DockPanel>

        <!-- Step settings -->
        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" x:Name="SettingsHead" Text="STEP SETTINGS" Style="{StaticResource Head}"/>
            <Border Background="{DynamicResource SidebarBgBrush}" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel"/>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Output -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
            <TextBlock Text="SAVE RESULTS" Style="{StaticResource Head}"/>
            <WrapPanel>
                <RadioButton x:Name="SameFolder" Content="Next to each file" IsChecked="True" GroupName="Out" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Out_Changed"/>
                <RadioButton x:Name="OtherFolder" Content="In folder" GroupName="Out" Margin="0,0,6,0" VerticalAlignment="Center" Checked="Out_Changed"/>
                <TextBox x:Name="FolderBox" Width="280" Margin="0,0,4,0" IsEnabled="{Binding IsChecked, ElementName=OtherFolder}"/>
                <Button Content="Browse…" Padding="10,2" Margin="0,0,18,0" Click="BrowseOut_Click" IsEnabled="{Binding IsChecked, ElementName=OtherFolder}"/>
                <TextBlock Text="Add to name" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBox x:Name="SuffixBox" Width="110" Text="_processed" Margin="0,0,14,0"/>
                <CheckBox x:Name="OverwriteBox" Content="Replace the original files" VerticalAlignment="Center" Checked="Out_Changed" Unchecked="Out_Changed"
                          ToolTip="Only when saving next to each file — the originals are overwritten"/>
            </WrapPanel>
        </StackPanel>

        <!-- Progress + buttons -->
        <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Height="4" Margin="0,0,0,6"/>
            <ListBox Grid.Row="1" x:Name="LogList" Style="{StaticResource DarkListBox}" FontFamily="Consolas" AutomationProperties.Name="Batch log"/>
            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                <Button DockPanel.Dock="Right" x:Name="CloseBtn" Content="Close" Padding="16,4" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" x:Name="RunBtn" Content="Run" Padding="20,4" Style="{StaticResource ModernButton}" Click="Run_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

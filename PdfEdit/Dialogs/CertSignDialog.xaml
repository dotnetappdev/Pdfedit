<Window x:Class="PdfEdit.Dialogs.CertSignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign with a Certificate"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="SIGNING ID" Style="{StaticResource Head}" Margin="0,0,0,6"/>
        <ComboBox x:Name="CertBox" Height="28" SelectionChanged="CertBox_SelectionChanged" AutomationProperties.Name="Signing ID"/>
        <WrapPanel Margin="0,6,0,0">
            <Button Content="Use a .pfx / .p12 file…" Padding="10,3" Margin="0,0,6,0" Click="BrowsePfx_Click"/>
            <Button Content="Create a signing ID…" Padding="10,3" Click="CreateId_Click"/>
        </WrapPanel>
        <DockPanel x:Name="PasswordRow" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Text="Password" Style="{StaticResource Lbl}"/>
            <PasswordBox x:Name="PasswordBox" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource InputForegroundBrush}" AutomationProperties.Name="Signing ID password"/>
        </DockPanel>
        <TextBlock x:Name="CertInfo" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DimForegroundBrush}"/>

        <TextBlock Text="DETAILS" Style="{StaticResource Head}"/>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Reason" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="ReasonBox" IsEditable="True" Height="26" Text="I approve this document">
                <ComboBoxItem Content="I approve this document"/>
                <ComboBoxItem Content="I am the author of this document"/>
                <ComboBoxItem Content="I have reviewed this document"/>
                <ComboBoxItem Content="I agree to the terms defined by this document"/>
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Location" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="LocationBox"/>
        </DockPanel>
        <DockPanel>
            <TextBlock Text="Contact" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="ContactBox" ToolTip="Email or phone, shown in the signature details"/>
        </DockPanel>

        <TextBlock Text="APPEARANCE" Style="{StaticResource Head}"/>
        <RadioButton x:Name="PlaceDraw" Content="Visible — drag a box on the page after clicking Sign" IsChecked="True" GroupName="Place" Margin="0,2"/>
        <DockPanel Margin="0,2">
            <RadioButton x:Name="PlaceField" Content="In the signature field" GroupName="Place" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FieldBox" Height="26" IsEnabled="{Binding IsChecked, ElementName=PlaceField}" AutomationProperties.Name="Signature field"/>
        </DockPanel>
        <RadioButton x:Name="PlaceNone" Content="Invisible (kept in the file, no mark on the page)" GroupName="Place" Margin="0,2"/>
        <DockPanel Margin="0,8,0,0">
            <CheckBox x:Name="UseImageBox" Content="Show my signature" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ImageBox" Height="26" DisplayMemberPath="Name" IsEnabled="{Binding IsChecked, ElementName=UseImageBox}" AutomationProperties.Name="Signature image"/>
        </DockPanel>

        <TextBlock Text="OPTIONS" Style="{StaticResource Head}"/>
        <DockPanel>
            <CheckBox x:Name="TimestampBox" Content="Add a trusted timestamp from" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TsaBox" Text="http://timestamp.digicert.com" IsEnabled="{Binding IsChecked, ElementName=TimestampBox}"/>
        </DockPanel>
        <CheckBox x:Name="CertifyBox" Content="Certify — lock the document so no further changes are allowed" Margin="0,8,0,0"/>

        <TextBlock Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Signing saves a new copy of the PDF with everything you've added. Any later change shows up as a modification after signing, so sign last."/>
        <TextBlock x:Name="ErrorText" Foreground="#E5534B" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Sign" Padding="18,4" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Sign_Click"/>
            <Button Content="Cancel" Padding="16,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="PdfEdit.Dialogs.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="580" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}" Padding="16,10">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"
                           Text="Bold keys are ones you've changed."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Change shortcuts…" Padding="14,4" Margin="0,0,8,0" Click="Change_Click"
                            AutomationProperties.Name="Change keyboard shortcuts"/>
                    <Button Content="Close" Padding="14,4" IsCancel="True" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

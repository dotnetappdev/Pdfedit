<Window x:Class="PdfEdit.Dialogs.TemplateChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New from Template"
        Width="1180" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}"
        AutomationProperties.Name="Choose a template">
    <Window.Resources>
        <!-- A category in the list on the left -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A template card: thumbnail, title, category -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Width="150">
                            <Border x:Name="Frame" Height="196" CornerRadius="6" BorderThickness="2"
                                    BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource ContentBgBrush}">
                                <Grid>
                                    <TextBlock Text="…" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DimForegroundBrush}"/>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Template.Title}" FontWeight="SemiBold" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Margin="2,1,2,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="AutomationProperties.Name" Value="{Binding Template.Title}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Categories -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <TextBlock DockPanel.Dock="Top" Text="Templates" FontSize="20" FontWeight="SemiBold" Margin="6,0,0,12"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Blank PDF" Padding="10,6" Margin="0,0,0,6" Click="Blank_Click"
                            ToolTip="Start with one empty A4 page" AutomationProperties.Name="Blank PDF"/>
                    <Button Content="Blank design" Padding="10,6" Click="BlankDesign_Click"
                            ToolTip="Start an empty page on the Design canvas" AutomationProperties.Name="Blank design"/>
                </StackPanel>
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource CategoryItem}"
                         SelectionChanged="Filter_Changed" AutomationProperties.Name="Template categories"/>
            </DockPanel>
        </Border>

        <!-- Search and gallery -->
        <DockPanel Grid.Column="1" Margin="16,16,8,12">
            <Grid DockPanel.Dock="Top" Margin="8,0,8,10">
                <TextBox x:Name="SearchBox" Padding="28,6,8,6" TextChanged="Filter_Changed"
                         AutomationProperties.Name="Search templates"
                         ToolTip="Search templates — invoice, resume, calendar…"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="9,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBlock x:Name="SearchHint" Text="Search templates — invoice, resume, calendar…" Margin="30,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource DimForegroundBrush}"/>
            </Grid>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="10,4" Visibility="Collapsed"
                       Foreground="{DynamicResource DimForegroundBrush}" Text="No templates match your search."/>
            <ListBox x:Name="Gallery" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource CardItem}"
                     SelectionChanged="Gallery_SelectionChanged" MouseDoubleClick="Gallery_DoubleClick" KeyDown="Gallery_KeyDown"
                     AutomationProperties.Name="Templates">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <!-- Preview of the chosen template -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="20,20,20,16">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="CustomiseButton" Content="Customise in Design" Padding="12,8" Margin="0,0,0,8" IsDefault="True"
                            Click="Customise_Click" IsEnabled="False"
                            ToolTip="Put the template on the Design canvas to change its text, colours and layout (Enter)"/>
                    <Button x:Name="PdfButton" Content="Open as PDF" Padding="12,8" Margin="0,0,0,8" Click="OpenPdf_Click" IsEnabled="False"
                            ToolTip="Make the template into a PDF straight away — with its form fields, ready to fill in"/>
                    <Button Content="Cancel" Padding="12,8" IsCancel="True"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="PreviewCategory" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4"
                               Foreground="{DynamicResource ForegroundBrush}" Text="Choose a template"/>
                    <TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" Foreground="{DynamicResource DimForegroundBrush}"
                               Text="Pick one on the left to see it here. Double-click to start with it."/>
                    <TextBlock x:Name="PreviewFillable" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" FontSize="11.5"
                               Foreground="{DynamicResource DimForegroundBrush}"
                               Text="Has form fields: open it as a PDF to fill in, sign and send."/>
                </StackPanel>
                <Border Margin="0,14" Background="{DynamicResource ContentBgBrush}" CornerRadius="6" Padding="10">
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="PdfEdit.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PdfEdit"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        AutomationProperties.Name="About PdfEdit">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,24,32,18">

            <!-- App icon, name, version -->
            <Image Source="pack://application:,,,/Resources/app.ico" Width="72" Height="72"
                   HorizontalAlignment="Center" Margin="0,0,0,14"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="PdfEdit icon"/>
            <TextBlock Text="PdfEdit" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,6"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="PDF form filler, editor and designer for Windows" FontSize="13"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource DimForegroundBrush}" Margin="0,0,0,16"/>

            <!-- Details (also copied by "Copy details", handy for bug reports) -->
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource InputBgBrush}" Padding="12,8">
                <Grid x:Name="DetailsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="Version" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,16,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailVersion"/>
                    <TextBlock Grid.Row="1" Text="Installed as" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,16,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailInstall"/>
                    <TextBlock Grid.Row="2" Text="Folder" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,16,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailFolder"/>
                    <TextBlock Grid.Row="3" Text=".NET" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,16,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailRuntime"/>
                    <TextBlock Grid.Row="4" Text="Windows" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,16,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailOs"/>
                </Grid>
            </Border>

            <!-- Links -->
            <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center">
                <Hyperlink Click="GitHub_Click" AutomationProperties.Name="PdfEdit on GitHub">GitHub</Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource DimForegroundBrush}"/>
                <Hyperlink Click="WhatsNew_Click" AutomationProperties.Name="What's new">What's new</Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource DimForegroundBrush}"/>
                <Hyperlink Click="ReportProblem_Click" AutomationProperties.Name="Report a problem">Report a problem</Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource DimForegroundBrush}"/>
                <Hyperlink Click="License_Click" AutomationProperties.Name="MIT licence">MIT licence</Hyperlink>
            </TextBlock>

            <!-- Built with -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,10">
                <WrapPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
                    </Style>
                </WrapPanel.Resources>
                <Border><TextBlock Text=".NET 10"/></Border>
                <Border><TextBlock Text="iText 8"/></Border>
                <Border><TextBlock Text="Fluent.Ribbon 10"/></Border>
                <Border><TextBlock Text="AvalonDock"/></Border>
                <Border><TextBlock Text="Tesseract OCR"/></Border>
            </WrapPanel>

            <TextBlock x:Name="CopyrightText" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource DimForegroundBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Check for _Updates…" Padding="12,5" Margin="0,0,6,0"
                            Click="CheckForUpdates_Click" AutomationProperties.Name="Check for updates"/>
                    <Button x:Name="CopyBtn" Content="_Copy details" Padding="12,5"
                            Click="CopyDetails_Click" AutomationProperties.Name="Copy version details"/>
                </StackPanel>
                <Button Content="Close" Width="90" HorizontalAlignment="Right"
                        IsDefault="True" IsCancel="True" Click="Close_Click"
                        AutomationProperties.Name="Close About dialog"/>
            </Grid>
        </Border>
    </Grid>
</Window>

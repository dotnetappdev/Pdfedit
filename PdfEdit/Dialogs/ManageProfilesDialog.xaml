<Window x:Class="PdfEdit.Dialogs.ManageProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Profiles"
        Width="700" Height="580"
        MinWidth="580" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        AutomationProperties.Name="Personal profiles manager">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Profile list ──────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0">
            <!-- Add / Delete toolbar -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="8,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddBtn" Content="＋  New"
                            FontSize="12" Padding="10,5" Margin="0,0,6,0"
                            Click="AddProfile_Click"
                            AutomationProperties.Name="Add new profile"/>
                    <Button x:Name="DeleteBtn" Content="— Delete"
                            FontSize="12" Padding="10,5"
                            Click="DeleteProfile_Click"
                            AutomationProperties.Name="Delete selected profile"/>
                </StackPanel>
            </Border>

            <!-- Profile list header -->
            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="PROFILES" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource DimForegroundBrush}"/>
            </Border>

            <ListBox x:Name="ProfileList"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ProfileList_SelectionChanged"
                     AutomationProperties.Name="Profile list">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource InputBgBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource AppBorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FullName}" FontSize="11"
                                       Foreground="{DynamicResource DimForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Divider -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Width="1" Background="{DynamicResource AppBorderBrush}"/>

        <!-- ── Right: Edit form ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="0" Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditPanel" Margin="20,16,20,16" IsEnabled="False">

                <!-- Profile name -->
                <TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <TextBox x:Name="DisplayNameBox" Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="Profile display name"/>

                <!-- Personal details section -->
                <Border Margin="0,20,0,0" Padding="0,0,0,6"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="PERSONAL DETAILS" Style="{StaticResource FieldLabel}" Margin="0"/>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="0" x:Name="FirstNameBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="First name"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="2" x:Name="MiddleNameBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Middle name"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name / Surname" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="3" Grid.Column="0" x:Name="LastNameBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Last name"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="3" Grid.Column="2" x:Name="DobBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Date of birth"
                              AutomationProperties.HelpText="e.g. 01/01/1990"/>
                </Grid>

                <TextBlock Text="National Insurance Number" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NiBox" Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="National Insurance number"
                         AutomationProperties.HelpText="e.g. AB 12 34 56 C"/>

                <!-- Contact section -->
                <Border Margin="0,20,0,0" Padding="0,0,0,6"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="CONTACT" Style="{StaticResource FieldLabel}" Margin="0"/>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Email Address" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="0" x:Name="EmailBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Email address"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Phone / Mobile" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="2" x:Name="PhoneBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Phone number"/>
                </Grid>

                <!-- Address section -->
                <Border Margin="0,20,0,0" Padding="0,0,0,6"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}" Margin="0"/>
                </Border>

                <TextBlock Text="Address Line 1" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Addr1Box" Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="Address line 1"/>

                <TextBlock Text="Address Line 2" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Addr2Box" Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="Address line 2"/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="City / Town" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="0" x:Name="CityBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="City"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="County / State" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="1" Grid.Column="2" x:Name="CountyBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="County or state"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Postcode" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="3" Grid.Column="0" x:Name="PostcodeBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Postcode"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Country" Style="{StaticResource FieldLabel}"/>
                    <TextBox  Grid.Row="3" Grid.Column="2" x:Name="CountryBox" Style="{StaticResource FieldBox}"
                              AutomationProperties.Name="Country"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Bottom buttons ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DimForegroundBrush}"
                           FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveProfileBtn"
                            Content="Save Profile" Padding="16,7"
                            FontSize="13" Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="SaveProfile_Click"
                            AutomationProperties.Name="Save current profile"/>
                    <Button Content="Done" Padding="16,7"
                            FontSize="13"
                            Click="Done_Click"
                            AutomationProperties.Name="Close dialog"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

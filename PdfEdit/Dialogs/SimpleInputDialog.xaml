<Window x:Class="PdfEdit.Dialogs.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLabel"
                   Foreground="{DynamicResource ForegroundBrush}"
                   FontSize="13"/>

        <TextBox Grid.Row="2" x:Name="InputBox"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 BorderBrush="{DynamicResource AppBorderBrush}"
                 CaretBrush="{DynamicResource ForegroundBrush}"
                 Padding="8,6" FontSize="13"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderBrush="{DynamicResource AccentBrush}"/>
            <Button Content="Cancel" Width="80"
                    IsCancel="True" Click="Cancel_Click"
                    Background="{DynamicResource InputBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>

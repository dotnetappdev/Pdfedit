<Window x:Class="PdfEdit.Dialogs.TipOfTheDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tip of the Day"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        AutomationProperties.Name="Tip of the Day">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The classic look: a sunken white page with a grey band and a light bulb down the left -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource InputBgBrush}" MinHeight="210">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Ellipse Width="46" Height="46" Fill="#33FFC83D"/>
                        <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="#F2B01E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,16,18,16">
                    <TextBlock Text="Did you know…" FontFamily="Georgia, Times New Roman" FontSize="22"
                               FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="TipTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TipText" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="TipCount" FontSize="11" Margin="0,14,0,0"
                               Foreground="{DynamicResource DimForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <CheckBox x:Name="ShowAtStartup" Content="_Show tips at startup" VerticalAlignment="Center"
                      Foreground="{DynamicResource ForegroundBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Previous" Width="86" Height="28" Margin="0,0,6,0" Click="Previous_Click"/>
                <Button x:Name="NextBtn" Content="_Next Tip" Width="86" Height="28" Margin="0,0,6,0" Click="Next_Click" IsDefault="True"/>
                <Button Content="Close" Width="86" Height="28" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

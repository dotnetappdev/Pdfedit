<Window x:Class="PdfEdit.Dialogs.SignaturesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signatures"
        Width="560" Height="460" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Padding="16,4" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" IsDefault="True"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
    </DockPanel>
</Window>

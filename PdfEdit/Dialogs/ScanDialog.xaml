<Window x:Class="PdfEdit.Dialogs.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan"
        Width="1080" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        AutomationProperties.Name="Scan document">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Settings (what the selected scanner supports, like Windows Scan) ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Scanner" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="30" Margin="4,0,0,0"
                            Click="Refresh_Click" ToolTip="Look for scanners again" AutomationProperties.Name="Refresh scanner list"/>
                    <ComboBox x:Name="DeviceBox" Height="28" AutomationProperties.Name="Scanner"
                              SelectionChanged="DeviceBox_SelectionChanged"
                              ToolTip="Scanners connected to this PC or on your network — the same list as the Windows Scan app"/>
                </DockPanel>
                <TextBlock x:Name="DeviceNote" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource DimForegroundBrush}"/>

                <TextBlock Text="Source" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SourceBox" Height="28" AutomationProperties.Name="Paper source"
                          ToolTip="Flatbed glass, or the document feeder (one or both sides)"/>

                <TextBlock Text="File type" Style="{StaticResource Label}"/>
                <ComboBox x:Name="FileTypeBox" Height="28" AutomationProperties.Name="File type"
                          SelectionChanged="FileTypeBox_SelectionChanged"
                          ToolTip="PDF, or the image types this scanner can save to"/>

                <TextBlock Text="Colour mode" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ColorBox" Height="28" AutomationProperties.Name="Colour mode"/>

                <TextBlock Text="Resolution (DPI)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="DpiBox" Height="28" AutomationProperties.Name="Resolution"/>

                <TextBlock Text="Page size" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SizeBox" Height="28" SelectedIndex="0" AutomationProperties.Name="Page size"
                          SelectionChanged="SizeBox_SelectionChanged"
                          ToolTip="Scan just this size from the top-left corner of the glass">
                    <ComboBoxItem Content="Whole scan area" Tag="Auto"/>
                    <ComboBoxItem Content="A4 (210 × 297 mm)" Tag="A4"/>
                    <ComboBoxItem Content="A5 (148 × 210 mm)" Tag="A5"/>
                    <ComboBoxItem Content="Letter (8.5 × 11 in)" Tag="Letter"/>
                    <ComboBoxItem Content="Legal (8.5 × 14 in)" Tag="Legal"/>
                </ComboBox>
                <CheckBox x:Name="AutoCropBox" Content="Auto-crop to the document's edges" Margin="0,8,0,0" Visibility="Collapsed"
                          ToolTip="The scanner finds the document on the glass and crops to it"
                          AutomationProperties.Name="Auto-crop"/>

                <TextBlock Text="Brightness" Style="{StaticResource Label}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat=0}"/>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="10"
                            IsSnapToTickEnabled="True" AutomationProperties.Name="Brightness"/>
                </DockPanel>
                <TextBlock Text="Contrast" Style="{StaticResource Label}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding Value, ElementName=ContrastSlider, StringFormat=0}"/>
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="10"
                            IsSnapToTickEnabled="True" AutomationProperties.Name="Contrast"/>
                </DockPanel>
                <CheckBox x:Name="DriverUiBox" Content="Use the scanner's own settings dialog" Margin="0,10,0,0"
                          ToolTip="Show the scanner driver's window instead of the settings above"
                          AutomationProperties.Name="Use the scanner's own dialog"/>

                <TextBlock Text="AFTER SCANNING" Style="{StaticResource Head}"/>
                <StackPanel x:Name="PdfOptions">
                    <CheckBox x:Name="OcrBox" Content="Recognise text (OCR) — searchable PDF" IsChecked="True" Margin="0,4,0,0"
                              ToolTip="Adds invisible, searchable text over the scanned pages"
                              AutomationProperties.Name="Recognise text"/>
                    <RadioButton x:Name="OutNew" Content="Save as a new PDF" IsChecked="True" Margin="0,8,0,0" GroupName="Out"/>
                    <RadioButton x:Name="OutAfter" Content="Add after the current page" Margin="0,4,0,0" GroupName="Out"/>
                    <RadioButton x:Name="OutEnd" Content="Add at the end of the open PDF" Margin="0,4,0,0" GroupName="Out"/>
                </StackPanel>
                <TextBlock x:Name="ImageOptionsNote" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource DimForegroundBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Preview (drag to choose the scan area / crop) ─────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBlock Text="PREVIEW" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource ContentBgBrush}" CornerRadius="4">
                <Grid>
                    <Viewbox Stretch="Uniform" Margin="12">
                        <Grid x:Name="PreviewSurface" Width="1" Height="1">
                            <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Scan preview"/>
                            <Canvas x:Name="SelectionCanvas" Background="Transparent" Cursor="Cross" ClipToBounds="True"
                                    MouseLeftButtonDown="Selection_MouseDown" MouseMove="Selection_MouseMove"
                                    MouseLeftButtonUp="Selection_MouseUp">
                                <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" Fill="#220078D4"
                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE8FE;" FontFamily="Segoe MDL2 Assets" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>
                        <TextBlock Text="Place the document on the scanner, then Preview or Scan." Margin="0,10,0,0"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>
                    </StackPanel>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" x:Name="ClearAreaBtn" Content="Clear selection" Click="ClearArea_Click" Padding="10,3" Margin="6,0,0,0"
                        IsEnabled="False" AutomationProperties.Name="Clear selection"/>
                <Button DockPanel.Dock="Right" x:Name="CropBtn" Content="Crop page" Click="Crop_Click" Padding="10,3"
                        IsEnabled="False" ToolTip="Crop the selected scanned page to the rectangle you dragged"
                        AutomationProperties.Name="Crop page to selection"/>
                <TextBlock x:Name="AreaText" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource DimForegroundBrush}"
                           Text="Scan area: whole page. Preview, then drag on the preview to scan just part of the glass."/>
            </DockPanel>
        </Grid>

        <!-- ── Scanned pages ───────────────────────────────────────────────── -->
        <Grid Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PagesHead" Text="PAGES (0)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
            <ListBox x:Name="PageList" Grid.Row="1" SelectionChanged="PageList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Scanned pages"/>
            <UniformGrid Grid.Row="2" Columns="5" Margin="0,6,0,0">
                <Button Content="&#xE7AD;" FontFamily="Segoe MDL2 Assets" Click="RotateLeft_Click" ToolTip="Rotate left" Height="28" Margin="1" AutomationProperties.Name="Rotate page left"/>
                <Button Content="&#xE7AD;" FontFamily="Segoe MDL2 Assets" Click="RotateRight_Click" ToolTip="Rotate right" Height="28" Margin="1" AutomationProperties.Name="Rotate page right" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                </Button>
                <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Click="MoveUp_Click" ToolTip="Move up" Height="28" Margin="1" AutomationProperties.Name="Move page up"/>
                <Button Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" Click="MoveDown_Click" ToolTip="Move down" Height="28" Margin="1" AutomationProperties.Name="Move page down"/>
                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="Delete_Click" ToolTip="Delete page" Height="28" Margin="1" AutomationProperties.Name="Delete page"/>
            </UniformGrid>
        </Grid>

        <!-- ── Buttons ─────────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add image file…" Click="AddImage_Click" Padding="12,4"
                    ToolTip="Add pages from image files (JPG, PNG, TIFF…) — e.g. phone photos of a document"
                    AutomationProperties.Name="Add image file"/>
            <Button DockPanel.Dock="Right" x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" Padding="16,4" Margin="6,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="DoneBtn" Content="Done" Click="Done_Click" Padding="16,4" Margin="6,0,0,0" IsEnabled="False"
                    ToolTip="Make the PDF from the scanned pages" AutomationProperties.Name="Done — make the PDF"/>
            <Button DockPanel.Dock="Right" x:Name="ScanBtn" Content="Scan" Click="Scan_Click" Padding="16,4" Margin="6,0,0,0" IsDefault="True"
                    ToolTip="Scan and add the page(s)" AutomationProperties.Name="Scan"/>
            <Button DockPanel.Dock="Right" x:Name="PreviewBtn" Content="Preview" Click="Preview_Click" Padding="16,4"
                    ToolTip="Quick low-resolution scan to check placement (not added)" AutomationProperties.Name="Preview"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="PdfEdit.Dialogs.FolderSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search PDFs in a Folder"
        Width="760" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="SearchBtn" Content="Search" Padding="18,4" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource ModernButton}" Click="Search_Click"/>
                <TextBox x:Name="QueryBox" AutomationProperties.Name="Text to find"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,3" Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBlock Text="In" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBox x:Name="FolderBox" AutomationProperties.Name="Folder"/>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="SubBox" Content="Include subfolders" IsChecked="True" Margin="0,0,16,0"/>
                <CheckBox x:Name="CaseBox" Content="Match case" Margin="0,0,16,0"/>
                <CheckBox x:Name="WordBox" Content="Whole words only"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,10,0,6" Foreground="{DynamicResource DimForegroundBrush}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Double-click a result to open that PDF at the page. Scanned PDFs need Recognise text (OCR) first."/>
        <ListBox x:Name="Results" Style="{StaticResource DarkListBox}" MouseDoubleClick="Results_DoubleClick" KeyDown="Results_KeyDown"
                 AutomationProperties.Name="Search results">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock>
                            <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="{Binding Page, StringFormat=  · page {0}, Mode=OneWay}" Foreground="{DynamicResource DimForegroundBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

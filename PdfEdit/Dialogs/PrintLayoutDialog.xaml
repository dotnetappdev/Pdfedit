<Window x:Class="PdfEdit.Dialogs.PrintLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pages per Sheet &amp; Booklet"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="96"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Makes a new PDF laid out for printing: several pages on each sheet, or a booklet to print double-sided, fold and staple. The open PDF isn't changed."/>
        <DockPanel Margin="0,3">
            <TextBlock Text="Layout" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="LayoutBox" Height="28" SelectedIndex="1" SelectionChanged="LayoutBox_SelectionChanged" AutomationProperties.Name="Layout">
                <ComboBoxItem Content="2 pages per sheet" Tag="2x1"/>
                <ComboBoxItem Content="4 pages per sheet" Tag="2x2"/>
                <ComboBoxItem Content="6 pages per sheet" Tag="2x3"/>
                <ComboBoxItem Content="9 pages per sheet" Tag="3x3"/>
                <ComboBoxItem Content="16 pages per sheet" Tag="4x4"/>
                <ComboBoxItem Content="Booklet (fold in half)" Tag="booklet"/>
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,3">
            <TextBlock Text="Sheet size" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="SheetBox" Height="28" AutomationProperties.Name="Sheet size"/>
        </DockPanel>
        <CheckBox x:Name="BordersBox" Content="Draw a thin border round each page" Margin="96,8,0,2"/>
        <CheckBox x:Name="DownFirstBox" Content="Go down the columns first" Margin="96,2,0,2"/>
        <TextBlock x:Name="BookletNote" TextWrapping="Wrap" FontSize="11" Margin="96,6,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Print on both sides, flipping on the short edge. Blank pages are added at the end if needed to make a multiple of four."/>
        <CheckBox x:Name="OpenBox" Content="Open the new PDF when it's made" IsChecked="True" Margin="0,14,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Make PDF…" Padding="16,5" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Ok_Click"/>
            <Button Content="Cancel" Padding="16,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

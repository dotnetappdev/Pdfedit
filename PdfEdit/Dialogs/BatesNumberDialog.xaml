<Window x:Class="PdfEdit.Dialogs.BatesNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Bates Numbers"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Prefix:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="PrefixBox" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Suffix:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="SuffixBox" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Start number:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="StartNumberBox" Text="1" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Digits (padding):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="PaddingBox" Text="6" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Font size (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="FontSizeBox" Text="8" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Position:" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="PositionBox" Height="26" FontSize="12"
                          Background="{DynamicResource InputBgBrush}"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <ComboBoxItem Content="BottomRight" IsSelected="True"/>
                    <ComboBoxItem Content="BottomLeft"/>
                    <ComboBoxItem Content="BottomCenter"/>
                    <ComboBoxItem Content="TopRight"/>
                    <ComboBoxItem Content="TopLeft"/>
                    <ComboBoxItem Content="TopCenter"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Apply" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

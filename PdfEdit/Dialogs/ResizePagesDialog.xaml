<Window x:Class="PdfEdit.Dialogs.ResizePagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize Pages"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="96"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Change the paper size of pages, for example A4 to Letter, or shrink the content to add a margin. Form fields, links and comments move with it."/>
        <DockPanel Margin="0,3">
            <TextBlock Text="Page size" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="SizeBox" Height="28" SelectionChanged="SizeBox_SelectionChanged" AutomationProperties.Name="Page size"/>
        </DockPanel>
        <DockPanel x:Name="CustomPanel" Margin="0,3" Visibility="Collapsed">
            <TextBlock Text="Width × height" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="UnitBox" DockPanel.Dock="Right" Width="64" Height="28" Margin="6,0,0,0" SelectedIndex="0"
                      AutomationProperties.Name="Units">
                <ComboBoxItem Content="mm" Tag="2.8346"/>
                <ComboBoxItem Content="in" Tag="72"/>
                <ComboBoxItem Content="pt" Tag="1"/>
            </ComboBox>
            <TextBox x:Name="WidthBox" Width="80" Text="210" AutomationProperties.Name="Width"/>
            <TextBlock Text=" × " VerticalAlignment="Center"/>
            <TextBox x:Name="HeightBox" Width="80" Text="297" HorizontalAlignment="Left" AutomationProperties.Name="Height"/>
        </DockPanel>
        <CheckBox x:Name="KeepOrientationBox" Content="Keep landscape pages landscape" IsChecked="True" Margin="96,6,0,4"/>

        <DockPanel Margin="0,8,0,3">
            <TextBlock Text="Content" Style="{StaticResource Lbl}"/>
            <StackPanel>
                <RadioButton x:Name="FitBox" Content="Scale to fit the new size" IsChecked="True" GroupName="Fit" Margin="0,2"/>
                <RadioButton Content="Keep its size and centre it (adds or trims a border)" GroupName="Fit" Margin="0,2"/>
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,6,0,3">
            <TextBlock Text="Margin" Style="{StaticResource Lbl}"/>
            <TextBlock DockPanel.Dock="Right" Text="mm all round" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{DynamicResource DimForegroundBrush}"/>
            <TextBox x:Name="MarginBox" Width="60" Text="0" HorizontalAlignment="Left" AutomationProperties.Name="Margin in millimetres"/>
        </DockPanel>

        <DockPanel Margin="0,8,0,3">
            <TextBlock Text="Pages" Style="{StaticResource Lbl}" VerticalAlignment="Top" Margin="0,3,0,0"/>
            <StackPanel>
                <RadioButton x:Name="PagesAll" Content="All pages" IsChecked="True" GroupName="Pages" Margin="0,2"/>
                <RadioButton x:Name="PagesCurrent" Content="Current page" GroupName="Pages" Margin="0,2"/>
                <DockPanel Margin="0,2">
                    <RadioButton x:Name="PagesRange" Content="Pages" GroupName="Pages" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RangeBox" Text="1-" GotFocus="RangeBox_GotFocus" ToolTip="e.g. 1-3, 5, 8-" AutomationProperties.Name="Page range"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Resize" Padding="16,5" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Ok_Click"/>
            <Button Content="Cancel" Padding="16,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

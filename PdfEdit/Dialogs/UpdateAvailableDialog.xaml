<Window x:Class="PdfEdit.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        AutomationProperties.Name="Update available">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="A new version of PdfEdit is available" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock FontSize="12" Margin="0,4,0,0">
                        <Hyperlink Click="GitHub_Click" AutomationProperties.Name="View this release on GitHub">
                            <Run x:Name="LinkText" Text="View on GitHub"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Release notes, shown on request -->
            <ToggleButton x:Name="NotesToggle" Content="See release notes ▾" HorizontalAlignment="Left"
                          Margin="58,12,0,0" Padding="10,3"
                          Checked="NotesToggle_Changed" Unchecked="NotesToggle_Changed"
                          AutomationProperties.Name="See release notes"/>
            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" Height="170" Margin="0,8,0,0"
                     VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6" Visibility="Collapsed"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     AutomationProperties.Name="Release notes"/>

            <TextBlock Text="Do you want to update now?" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DimForegroundBrush}"
                       Text="Yes: choose where to save it, download and install. No: skip this version. Cancel: ask me again next time."/>

            <CheckBox x:Name="AtStartupBox" Content="Check for updates when PdfEdit _starts" Margin="0,14,0,0"
                      Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Yes, update" MinWidth="100" Padding="12,5" Margin="0,0,6,0" FontWeight="SemiBold"
                        IsDefault="True" Click="Yes_Click" AutomationProperties.Name="Yes, update now"/>
                <Button Content="_No" MinWidth="80" Padding="12,5" Margin="0,0,6,0"
                        Click="No_Click" AutomationProperties.Name="No, skip this version"/>
                <Button Content="Cancel" MinWidth="80" Padding="12,5" IsCancel="True"
                        AutomationProperties.Name="Cancel, ask me again next time"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="PdfEdit.Dialogs.PageRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page Range"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="DescriptionLabel" Text="Enter page range:" FontSize="12" Margin="0,0,0,8"
                   TextWrapping="Wrap"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="First page:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="FirstPageBox" Height="28" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="–" FontSize="16" VerticalAlignment="Bottom"
                       Margin="8,0,8,4"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Last page:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="LastPageBox" Height="28" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Text="" Foreground="Red" FontSize="11"
                   Margin="0,0,0,6" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button x:Name="ActionButton" Content="OK" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

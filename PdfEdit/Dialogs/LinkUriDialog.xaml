<Window x:Class="PdfEdit.Dialogs.LinkUriDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Hyperlink"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Enter the URL this link should open:" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="UriBox" Height="28" FontSize="12"
                 Text="https://"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="Red" FontSize="11"
                   Margin="0,0,0,6" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Add Link" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

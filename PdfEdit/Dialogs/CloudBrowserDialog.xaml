<Window x:Class="PdfEdit.Dialogs.CloudBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud storage"
        Width="720" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Provider + account -->
        <Grid Margin="0,0,0,10">
            <StackPanel x:Name="ProviderButtons" Orientation="Horizontal"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="AccountText" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                           Foreground="{DynamicResource DimForegroundBrush}"/>
                <Button x:Name="ConnectBtn" Padding="12,3" Click="Connect_Click"/>
            </StackPanel>
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="UpBtn" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Width="30" Height="28" Padding="0"
                    Click="Up_Click" ToolTip="Up one folder" AutomationProperties.Name="Up one folder"/>
            <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" FontSize="13"
                       TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" Padding="6,4" KeyDown="Search_KeyDown"
                     ToolTip="Search PDFs by name (Enter)" AutomationProperties.Name="Search cloud PDFs"/>
            <Button x:Name="NewFolderBtn" Grid.Column="3" Content="&#xE8F4;" FontFamily="Segoe MDL2 Assets" Width="30" Height="28"
                    Padding="0" Margin="6,0,0,0" Click="NewFolder_Click" ToolTip="New folder" AutomationProperties.Name="New folder"/>
            <Button Grid.Column="4" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="30" Height="28" Padding="0"
                    Margin="6,0,0,0" Click="Refresh_Click" ToolTip="Refresh" AutomationProperties.Name="Refresh"/>
        </Grid>

        <!-- Files -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource InputBgBrush}">
            <Grid>
                <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ForegroundBrush}"
                         MouseDoubleClick="FileList_DoubleClick" SelectionChanged="FileList_SelectionChanged"
                         KeyDown="FileList_KeyDown" HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="Files and folders">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DimForegroundBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource DimForegroundBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" MaxWidth="440"/>
                    <Button x:Name="MessageBtn" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14,4"
                            Visibility="Collapsed" Click="MessageBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Save: file name -->
        <Grid x:Name="SavePanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="File name" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Padding="6,4" AutomationProperties.Name="File name"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Padding="18,4" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Ok_Click"/>
                <Button Content="Cancel" Padding="16,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

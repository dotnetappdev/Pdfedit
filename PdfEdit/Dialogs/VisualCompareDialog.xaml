<Window x:Class="PdfEdit.Dialogs.VisualCompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare PDFs (visual)"
        Width="1100" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock Text="Old" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="BrowseOld_Click"/>
                <TextBox x:Name="OldBox" AutomationProperties.Name="Old version"/>
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="New" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                <Button DockPanel.Dock="Right" x:Name="CompareBtn" Content="Compare" Padding="16,3" Margin="6,0,0,0" Style="{StaticResource ModernButton}" Click="Compare_Click"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="BrowseNew_Click"/>
                <TextBox x:Name="NewBox" AutomationProperties.Name="New version"/>
            </DockPanel>
            <DockPanel Margin="0,10,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="ViewDiff" Content="Differences" IsChecked="True" GroupName="V" Margin="0,0,12,0" Checked="View_Changed"/>
                    <RadioButton x:Name="ViewSide" Content="Side by side" GroupName="V" Margin="0,0,12,0" Checked="View_Changed"/>
                    <RadioButton x:Name="ViewOld" Content="Old" GroupName="V" Margin="0,0,12,0" Checked="View_Changed"/>
                    <RadioButton x:Name="ViewNew" Content="New" GroupName="V" Checked="View_Changed"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}">
                    <Run Text="■" Foreground="#E53B3B"/> removed  <Run Text="■" Foreground="#2EB04E"/> added  <Run Text="■" Foreground="#E68C00"/> changed
                </TextBlock>
            </DockPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="PageList" Style="{StaticResource DarkListBox}" SelectionChanged="PageList_SelectionChanged" AutomationProperties.Name="Pages"/>
            <Border Grid.Column="2" Background="{DynamicResource ContentBgBrush}" CornerRadius="4" Padding="10">
                <Grid>
                    <Viewbox x:Name="SingleView" Stretch="Uniform"><Image x:Name="MainImage" RenderOptions.BitmapScalingMode="HighQuality"/></Viewbox>
                    <Grid x:Name="SideView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Viewbox Stretch="Uniform"><Image x:Name="OldImage" RenderOptions.BitmapScalingMode="HighQuality"/></Viewbox>
                        <Viewbox Grid.Column="2" Stretch="Uniform"><Image x:Name="NewImage" RenderOptions.BitmapScalingMode="HighQuality"/></Viewbox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

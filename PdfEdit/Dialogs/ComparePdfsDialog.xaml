<Window x:Class="PdfEdit.Dialogs.ComparePdfsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare PDFs — Results"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryLabel" Text="Comparing..." FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock x:Name="StatLabel" Text="" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Results list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8" CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource InputBgBrush}"
                                Background="{DynamicResource ContentBgBrush}">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Page {0}">
                                            <Binding Path="PageIndex"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="Gray" Margin="0,2,0,4"/>
                                <ItemsControl ItemsSource="{Binding OnlyInA}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" Foreground="#C62828"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding StringFormat='— {0}'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding OnlyInB}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" Foreground="#2E7D32"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding StringFormat='+ {0}'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="2" Content="Close" Width="90" Height="28" HorizontalAlignment="Right"
                Margin="0,8,0,0" Click="Close_Click" IsCancel="True"
                Background="{DynamicResource ButtonBgBrush}"
                Foreground="{DynamicResource ForegroundBrush}"/>
    </Grid>
</Window>

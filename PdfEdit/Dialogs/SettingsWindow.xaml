<Window x:Class="PdfEdit.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PdfEdit.Controls"
        Title="Settings — PdfEdit"
        Width="580" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontSize="{DynamicResource DialogFontSize}"
        AutomationProperties.Name="PdfEdit Settings">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="SettingsTabs"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}">

            <!-- ── Appearance Tab ────────────────────────────────────────── -->
            <TabItem Header="Appearance"
                     AutomationProperties.Name="Appearance settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="THEME"/>

                        <ComboBox x:Name="ThemeBox" Width="300" HorizontalAlignment="Left" Height="30" Margin="0,0,0,8"
                                  SelectionChanged="ThemeBox_SelectionChanged"
                                  AutomationProperties.Name="Theme"/>

                        <CheckBox x:Name="UseAccentCb" Content="Use my Windows accent colour"
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="13" Margin="0,0,0,4"
                                  Click="UseAccent_Click"
                                  AutomationProperties.Name="Use the Windows accent colour"/>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="With a Windows contrast theme on (Settings → Accessibility → Contrast themes), High contrast and Use Windows setting use its colours. Changes in Windows are picked up straight away."/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="PDF RENDER ENGINE"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="RbEngineCustom" Content="Custom  (built-in C# engine — no native dependencies)"
                                         GroupName="RenderEngine" Tag="Custom"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         Margin="0,0,0,0" IsChecked="True"
                                         Checked="RenderEngine_Checked"
                                         AutomationProperties.Name="Custom built-in render engine"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="RbEnginePdfium" Content="Pdfium  (Chrome/Adobe quality, requires native DLL)"
                                         GroupName="RenderEngine" Tag="Pdfium"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         Checked="RenderEngine_Checked"
                                         AutomationProperties.Name="Pdfium render engine"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="RbEngineWinRT" Content="WinRT  (Windows built-in, legacy fallback)"
                                         GroupName="RenderEngine" Tag="WinRT"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         Checked="RenderEngine_Checked"
                                         AutomationProperties.Name="WinRT render engine"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource SubtleForegroundBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="Custom: pure C# engine — zero native dependencies, handles FlateDecode/JPEG/PNG streams and the 14 standard fonts. Pdfium: Chrome/Adobe quality with sub-pixel hinting (requires Docnet.Core). Restart not required; takes effect on next file open."/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="UI SCALE"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Scale factor:"/>
                            <Slider x:Name="UiScaleSlider"
                                    Minimum="0.75" Maximum="2.0" TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    Width="200" VerticalAlignment="Center"
                                    ValueChanged="UiScaleSlider_ValueChanged"
                                    AutomationProperties.Name="UI scale slider"
                                    AutomationProperties.HelpText="Adjust the overall interface scale"/>
                            <TextBlock x:Name="UiScaleLabel"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Text="100%"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Fonts Tab (Visual Studio style) ───────────────────────── -->
            <TabItem Header="Fonts" x:Name="FontsTab"
                     AutomationProperties.Name="Interface font settings">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHead}"
                               Margin="0,0,0,6" Text="INTERFACE FONT SIZES"/>
                    <TextBlock Grid.Row="1"
                               Foreground="{DynamicResource DimForegroundBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Pick an area of the interface, then choose its font size. Changes apply immediately."/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Show settings for: -->
                        <DockPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,0,4" Text="Show settings for:"/>
                            <ListBox x:Name="FontAreaList"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1"
                                     DisplayMemberPath="DisplayName"
                                     SelectionChanged="FontAreaList_SelectionChanged"
                                     AutomationProperties.Name="Interface area list"/>
                        </DockPanel>

                        <!-- Selected area editor -->
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FontAreaName"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,20,0,2"/>
                            <TextBlock x:Name="FontAreaDesc"
                                       Foreground="{DynamicResource DimForegroundBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Size:"/>
                                <ComboBox x:Name="FontSizeCombo"
                                          Width="90" Height="30" IsEditable="True"
                                          FontSize="13" VerticalContentAlignment="Center"
                                          SelectionChanged="FontSizeCombo_Changed"
                                          AutomationProperties.Name="Font size for selected area"/>
                            </StackPanel>

                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" Padding="12" CornerRadius="3">
                                <TextBlock x:Name="FontPreview"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Text="AaBbCcXxYyZz 0123456789 — The quick brown fox."/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="3" Content="Reset all to defaults"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Padding="12,6" Click="ResetFonts_Click"
                            Background="{DynamicResource InputBgBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="Reset all interface font sizes to defaults"/>
                </Grid>
            </TabItem>

            <!-- ── Editor Tab ────────────────────────────────────────────── -->
            <TabItem Header="Editor"
                     AutomationProperties.Name="Editor settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="DEFAULT FONT"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Font family:"/>
                            <ComboBox x:Name="DefaultFontCombo" Grid.Row="0" Grid.Column="1"
                                      Height="30" FontSize="13" Margin="0,0,0,8"
                                      AutomationProperties.Name="Default font family"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Font size:"/>
                            <TextBox x:Name="DefaultFontSizeTb" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource SettingTextBox}" Margin="0,0,0,8"
                                     AutomationProperties.Name="Default font size"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Default color:"/>
                            <TextBox x:Name="DefaultColorTb" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource SettingTextBox}"
                                     AutomationProperties.Name="Default text color (hex)"
                                     AutomationProperties.HelpText="Enter a hex color code like #000000"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHead}" Text="DATE STAMP FORMAT"/>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Choose how dates appear when using the Date Stamp tool. Preview shows today's date in each format."/>
                        <StackPanel x:Name="DateFormatPanel" Margin="0,0,0,4"/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="BEHAVIOUR"/>
                        <CheckBox x:Name="ForceUpperCaseCb"
                                  Content="Force uppercase text by default"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,4,0,0"
                                  AutomationProperties.Name="Force uppercase text by default"/>
                        <CheckBox x:Name="SpellCheckCb"
                                  Content="Check spelling as I type (text boxes, form fields, notes)"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,8,0,0"
                                  AutomationProperties.Name="Check spelling as I type"/>
                        <CheckBox x:Name="TipsAtStartupCb"
                                  Content="Show Tip of the Day when PdfEdit starts"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,8,0,0"
                                  AutomationProperties.Name="Show Tip of the Day at startup"/>
                        <CheckBox x:Name="TourNextStartCb"
                                  Content="Show the welcome tour next time PdfEdit starts"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  FontSize="13" Margin="0,8,0,0"
                                  AutomationProperties.Name="Show the welcome tour next time"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── AI Tab ────────────────────────────────────────────────── -->
            <TabItem Header="AI Assistant"
                     AutomationProperties.Name="AI assistant settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="CLAUDE AI"/>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Enter your Anthropic API key to enable the AI form-fill assistant. Your key is stored locally."/>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="API key:" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource InputForegroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1" Padding="6,4" FontSize="13" Height="30"
                                     AutomationProperties.Name="Anthropic API key"
                                     AutomationProperties.HelpText="Your Claude API key from console.anthropic.com"/>

                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"
                                   Margin="0,6,0,20"
                                   Text="Get your API key from console.anthropic.com"/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="OPENAI"/>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Enter your OpenAI API key to use GPT models. Your key is stored locally."/>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="API key:" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="OpenAiKeyBox"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource InputForegroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1" Padding="6,4" FontSize="13" Height="30"
                                     AutomationProperties.Name="OpenAI API key"
                                     AutomationProperties.HelpText="Your OpenAI API key from platform.openai.com"/>

                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"
                                   Margin="0,6,0,20"
                                   Text="Get your API key from platform.openai.com"/>

                        <!-- Local AI: free, private, offline -->
                        <TextBlock Style="{StaticResource SectionHead}" Text="LOCAL AI (FREE · PRIVATE · OFFLINE)"/>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Run form filling, chat and document analysis on this PC with no API costs — nothing leaves the machine. Works with any OpenAI-compatible local server: Ollama, LM Studio, llama.cpp, Jan, GPT4All or LocalAI."/>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Quick start with Ollama: install from ollama.com, then run  ollama pull llama3.2  (or qwen2.5 / mistral / phi3). Then pick Local in the AI panel."/>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="Server:" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Ollama" Tag="http://localhost:11434/v1" Click="LocalPreset_Click" Padding="8,2" Margin="0,0,4,0" AutomationProperties.Name="Use Ollama default address"/>
                            <Button Content="LM Studio" Tag="http://localhost:1234/v1" Click="LocalPreset_Click" Padding="8,2" Margin="0,0,4,0" AutomationProperties.Name="Use LM Studio default address"/>
                            <Button Content="llama.cpp" Tag="http://localhost:8080/v1" Click="LocalPreset_Click" Padding="8,2" Margin="0,0,4,0" AutomationProperties.Name="Use llama.cpp server default address"/>
                            <Button Content="Jan" Tag="http://localhost:1337/v1" Click="LocalPreset_Click" Padding="8,2" AutomationProperties.Name="Use Jan default address"/>
                        </StackPanel>
                        <TextBox x:Name="LocalEndpointBox"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource InputForegroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1" Padding="6,4" FontSize="13" Height="30"
                                 AutomationProperties.Name="Local AI server address"
                                 ToolTip="OpenAI-compatible base URL, e.g. http://localhost:11434/v1"/>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="Model:" Margin="0,10,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Detect models" Click="DetectLocalModels_Click" Padding="10,2" Margin="6,0,0,0"
                                    AutomationProperties.Name="Detect local models"/>
                            <ComboBox x:Name="LocalModelBox" IsEditable="True" Height="30" FontSize="13"
                                      AutomationProperties.Name="Local AI model"
                                      ToolTip="The model name as the server knows it, e.g. llama3.2"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="API key (optional):" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="LocalKeyBox"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource InputForegroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1" Padding="6,4" FontSize="13" Height="30"
                                     AutomationProperties.Name="Local AI API key"
                                     AutomationProperties.HelpText="Only needed if your local server requires one"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Test connection" Click="TestLocalAi_Click" Padding="10,3" AutomationProperties.Name="Test local AI connection"/>
                            <TextBlock x:Name="LocalStatusText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="320" Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── OCR Tab ───────────────────────────────────────────────── -->
            <TabItem Header="Keyboard" x:Name="KeyboardTab" AutomationProperties.Name="Keyboard shortcut settings">
                <controls:ShortcutEditor x:Name="ShortcutsEditor"/>
            </TabItem>

            <TabItem Header="Cloud" x:Name="CloudTab" AutomationProperties.Name="Cloud storage settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="Open and save PDFs in Google Drive or OneDrive using your own app details, so there's no middleman and no shared quota. You sign in once in your browser; the sign-in is stored encrypted for your Windows account."/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="GOOGLE DRIVE"/>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Client ID:" Margin="0,0,0,4"/>
                        <TextBox x:Name="GoogleClientIdBox" Style="{StaticResource SettingTextBox}"
                                 AutomationProperties.Name="Google OAuth client ID"/>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Client secret:" Margin="0,8,0,4"/>
                        <PasswordBox x:Name="GoogleSecretBox"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputForegroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="13" Height="30"
                                     AutomationProperties.Name="Google OAuth client secret"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="GoogleConnectBtn" Padding="14,4" Click="GoogleConnect_Click"/>
                            <TextBlock x:Name="GoogleStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17">
                            <Run Text="How to get these: in console.cloud.google.com create a project, enable the Google Drive API, set up the OAuth consent screen (External; add yourself as a test user), then Credentials → Create credentials → OAuth client ID → Desktop app. Copy the client ID and secret here."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SectionHead}" Text="ONEDRIVE (MICROSOFT)"/>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Application (client) ID:" Margin="0,0,0,4"/>
                        <TextBox x:Name="OneDriveClientIdBox" Style="{StaticResource SettingTextBox}"
                                 AutomationProperties.Name="Microsoft application client ID"/>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Accounts (tenant):" Margin="0,8,0,4"/>
                        <ComboBox x:Name="OneDriveTenantBox" IsEditable="True" Height="30" FontSize="13"
                                  ToolTip="common: personal and work accounts · consumers: personal only · organizations: work or school only · or your tenant ID"
                                  AutomationProperties.Name="Microsoft tenant">
                            <ComboBoxItem Content="common"/>
                            <ComboBoxItem Content="consumers"/>
                            <ComboBoxItem Content="organizations"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="OneDriveConnectBtn" Padding="14,4" Click="OneDriveConnect_Click"/>
                            <TextBlock x:Name="OneDriveStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17"
                                   Text="How to get this: in entra.microsoft.com go to App registrations → New registration. Choose who can sign in (any account type for personal OneDrive), and under Redirect URI pick 'Public client/native (mobile &amp; desktop)' with http://localhost. Then in Authentication turn on 'Allow public client flows'. Copy the Application (client) ID here. No secret is needed."/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="SAVING"/>
                        <CheckBox x:Name="CloudAutoUploadCb" Content="When I save a file opened from the cloud, upload it back straight away"
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="13"
                                  AutomationProperties.Name="Upload cloud files back when saving"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="OCR" AutomationProperties.Name="Text recognition settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="TEXT RECOGNITION (OCR)"/>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Used by Scan, Recognise text and Make searchable. PdfEdit includes the Tesseract OCR engine with English, so OCR works on any PC — no Windows language pack needed."/>

                        <TextBlock Style="{StaticResource SettingLabel}" Text="Engine:" Margin="0,0,0,4"/>
                        <RadioButton x:Name="OcrAuto" Content="Automatic — Windows OCR when installed, otherwise Tesseract" GroupName="OcrEngine" Margin="0,2"/>
                        <RadioButton x:Name="OcrTesseract" Content="Tesseract (bundled, many languages)" GroupName="OcrEngine" Margin="0,2"/>
                        <RadioButton x:Name="OcrWindows" Content="Windows OCR" GroupName="OcrEngine" Margin="0,2"/>
                        <TextBlock x:Name="OcrStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="TESSERACT LANGUAGES" Margin="0,18,0,6"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource DimForegroundBrush}"
                                   Text="Tick the languages your documents use. Missing ones download once (about 1–10 MB each) and then work offline."/>
                        <WrapPanel x:Name="OcrLanguagePanel" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Download ticked languages" Click="DownloadOcrLanguages_Click" Padding="10,3"
                                    AutomationProperties.Name="Download ticked OCR languages"/>
                            <ProgressBar x:Name="OcrDownloadProgress" Width="140" Height="8" Margin="10,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHead}" Text="WINDOWS OCR" Margin="0,18,0,6"/>
                        <TextBlock x:Name="WinOcrStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button x:Name="InstallWinOcrBtn" Content="Install Windows OCR language…" Click="InstallWindowsOcr_Click" Padding="10,3"
                                HorizontalAlignment="Left"
                                ToolTip="Adds Windows' OCR for your language (Windows asks for administrator approval)"
                                AutomationProperties.Name="Install Windows OCR language"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Accessibility Tab ─────────────────────────────────────── -->
            <TabItem Header="Accessibility" x:Name="AccessibilityTab"
                     AutomationProperties.Name="Accessibility settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="SIZE" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Icon size:" Width="110"/>
                            <ComboBox x:Name="IconSizeBox" Width="180" Height="30"
                                      SelectionChanged="IconSizeBox_SelectionChanged"
                                      AutomationProperties.Name="Icon size"
                                      AutomationProperties.HelpText="Size of the ribbon and toolbar icons"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Menu text size:" Width="110"/>
                            <ComboBox x:Name="MenuFontBox" Width="80" Height="30" IsEditable="True"
                                      SelectionChanged="MenuFontBox_SelectionChanged"
                                      LostFocus="MenuFontBox_LostFocus"
                                      AutomationProperties.Name="Menu text size"
                                      AutomationProperties.HelpText="Font size of right-click menus and the ribbon's drop-down menus"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="Text size for the ribbon, panels, status bar and dialogs is on the"/>
                            <Hyperlink Click="OpenFontsTab_Click" AutomationProperties.Name="Open the Fonts tab">Fonts</Hyperlink>
                            <Run Text="tab. Ctrl+Plus and Ctrl+Minus make the whole window bigger or smaller."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SectionHead}" Text="SCREEN READER"/>
                        <TextBlock x:Name="ScreenReaderStatus" Foreground="{DynamicResource DimForegroundBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AnnounceToScreenReaderCb" Margin="0,2"
                                  Content="Tell my screen reader about status messages, page and tool changes"
                                  AutomationProperties.Name="Send announcements to the screen reader"/>
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,8,0,2" Text="Announce:"/>
                        <WrapPanel Margin="12,0,0,4">
                            <CheckBox x:Name="AnnounceStatusCb" Content="Status messages" Margin="0,2,16,2"
                                      AutomationProperties.Name="Announce status messages"/>
                            <CheckBox x:Name="AnnouncePagesCb" Content="Page changes" Margin="0,2,16,2"
                                      AutomationProperties.Name="Announce page changes"/>
                            <CheckBox x:Name="AnnounceToolsCb" Content="Tool changes" Margin="0,2,16,2"
                                      AutomationProperties.Name="Announce tool changes"/>
                        </WrapPanel>
                        <CheckBox x:Name="HighContrastFocusCb" Margin="0,4,0,2"
                                  Content="Show high-contrast focus indicators"
                                  AutomationProperties.Name="High contrast focus indicators"/>

                        <TextBlock Style="{StaticResource SectionHead}" Text="NARRATION"/>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="PdfEdit can read things out in a Windows voice, without a screen reader. The voice and speed are also used by View → Read Page."/>
                        <CheckBox x:Name="NarrateAnnouncementsCb" Margin="0,2"
                                  Content="Speak the announcements ticked above"
                                  AutomationProperties.Name="Speak announcements aloud"/>
                        <CheckBox x:Name="NarrateFocusCb" Margin="0,2"
                                  Content="Speak buttons, boxes and menu items as I move to them with the keyboard"
                                  AutomationProperties.Name="Speak the focused control"/>
                        <CheckBox x:Name="NarrateTooltipsCb" Margin="0,2"
                                  Content="Speak tooltips when I hover over a button"
                                  AutomationProperties.Name="Speak tooltips"/>
                        <CheckBox x:Name="NarrateQuietCb" Margin="0,2,0,8"
                                  Content="Stay quiet while a screen reader is running"
                                  AutomationProperties.Name="Stay quiet while a screen reader is running"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Voice:"/>
                            <ComboBox x:Name="VoiceBox" Grid.Column="1" Height="30" Margin="0,2"
                                      AutomationProperties.Name="Narration voice"/>
                            <Button Grid.Column="2" Content="Test" Padding="12,4" Margin="8,2,0,2"
                                    Click="TestVoice_Click"
                                    Background="{DynamicResource InputBgBrush}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    AutomationProperties.Name="Test the voice"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingLabel}" Text="Speed:"/>
                            <Slider x:Name="VoiceRateSlider" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2.5"
                                    TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,6"
                                    ValueChanged="VoiceRateSlider_ValueChanged"
                                    AutomationProperties.Name="Speaking speed"/>
                            <TextBlock x:Name="VoiceRateLabel" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource SettingLabel}" Text="Volume:"/>
                            <Slider x:Name="VoiceVolumeSlider" Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,6"
                                    ValueChanged="VoiceVolumeSlider_ValueChanged"
                                    AutomationProperties.Name="Speaking volume"/>
                            <TextBlock x:Name="VoiceVolumeLabel" Grid.Row="2" Grid.Column="2" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHead}" Text="KEYBOARD"/>
                        <TextBlock Foreground="{DynamicResource DimForegroundBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="Everything in PdfEdit can be reached from the keyboard: Alt shows the ribbon's key tips, F1 lists the shortcuts, and you can change them on the"/>
                            <Hyperlink Click="OpenKeyboardTab_Click" AutomationProperties.Name="Open the Keyboard tab">Keyboard</Hyperlink>
                            <Run Text="tab."/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ── Save / Cancel buttons ─────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="32" Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Background="{DynamicResource InputBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="Cancel and close settings"/>
                <Button Content="Save" Width="80" Height="32"
                        Click="Save_Click"
                        Style="{StaticResource ModernButton}"
                        AutomationProperties.Name="Save settings"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

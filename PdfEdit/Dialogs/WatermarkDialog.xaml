<Window x:Class="PdfEdit.Dialogs.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watermark &amp; Background"
        Width="860" Height="640" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="SOURCE" Style="{StaticResource Head}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="KindText" Content="Text" IsChecked="True" Margin="0,0,16,0" GroupName="Kind" Checked="Changed"/>
                    <RadioButton x:Name="KindImage" Content="Image (logo, scan…)" GroupName="Kind" Checked="Changed"/>
                </StackPanel>

                <StackPanel x:Name="TextPanel" Margin="0,6,0,0">
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Text" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="TextCombo" IsEditable="True" Height="26" Text="DRAFT"
                                  AutomationProperties.Name="Watermark text">
                            <ComboBoxItem Content="DRAFT"/>
                            <ComboBoxItem Content="CONFIDENTIAL"/>
                            <ComboBoxItem Content="COPY"/>
                            <ComboBoxItem Content="SAMPLE"/>
                            <ComboBoxItem Content="DO NOT COPY"/>
                            <ComboBoxItem Content="APPROVED"/>
                            <ComboBoxItem Content="VOID"/>
                            <ComboBoxItem Content="FOR REVIEW"/>
                            <ComboBoxItem Content="INTERNAL USE ONLY"/>
                            <ComboBoxItem Content="NOT FOR DISTRIBUTION"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Font" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="FontBox" Height="26" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="Font">
                            <ComboBoxItem Content="Helvetica Bold" Tag="Helvetica-Bold"/>
                            <ComboBoxItem Content="Helvetica" Tag="Helvetica"/>
                            <ComboBoxItem Content="Times Bold" Tag="Times-Bold"/>
                            <ComboBoxItem Content="Times" Tag="Times-Roman"/>
                            <ComboBoxItem Content="Courier Bold" Tag="Courier-Bold"/>
                            <ComboBoxItem Content="Courier" Tag="Courier"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Size" Style="{StaticResource Lbl}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Val}" Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} pt}"/>
                        <Slider x:Name="SizeSlider" Minimum="12" Maximum="200" Value="72" VerticalAlignment="Center" ValueChanged="Changed" AutomationProperties.Name="Font size"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock Text="Colour" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="ColorBox" DockPanel.Dock="Right" Width="74" Text="#808080" TextChanged="Changed" AutomationProperties.Name="Colour hex"/>
                        <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="ImagePanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="Browse_Click"/>
                        <TextBox x:Name="ImagePathBox" IsReadOnly="True" AutomationProperties.Name="Image file"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock Text="Size" Style="{StaticResource Lbl}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Val}" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0}%}"/>
                        <Slider x:Name="ScaleSlider" Minimum="10" Maximum="100" Value="50" VerticalAlignment="Center" ValueChanged="Changed"
                                ToolTip="Width as a share of the page width" AutomationProperties.Name="Image size"/>
                    </DockPanel>
                </StackPanel>

                <DockPanel Margin="0,4,0,2">
                    <TextBlock Text="Opacity" Style="{StaticResource Lbl}"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Val}" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}"/>
                    <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" Value="25" VerticalAlignment="Center" ValueChanged="Changed" AutomationProperties.Name="Opacity"/>
                </DockPanel>

                <TextBlock Text="APPEARANCE" Style="{StaticResource Head}"/>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Layout" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="LayoutBox" Height="26" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="Layout">
                        <ComboBoxItem Content="↗  Diagonal: bottom left to top right"/>
                        <ComboBoxItem Content="↘  Diagonal: top left to bottom right"/>
                        <ComboBoxItem Content="→  Horizontal"/>
                        <ComboBoxItem Content="↑  Vertical: reads bottom to top"/>
                        <ComboBoxItem Content="↓  Vertical: reads top to bottom"/>
                        <ComboBoxItem Content="∠  Custom angle"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,4,0,2">
                    <TextBlock Text="Angle" Style="{StaticResource Lbl}"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Val}" Text="{Binding Value, ElementName=AngleSlider, StringFormat={}{0:0}°}"/>
                    <Slider x:Name="AngleSlider" Minimum="-90" Maximum="90" Value="45" TickFrequency="15" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" ValueChanged="Changed"
                            IsEnabled="False"
                            AutomationProperties.Name="Angle"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Position" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="PositionBox" Height="26" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="Position">
                        <ComboBoxItem Content="Centre of the page"/>
                        <ComboBoxItem Content="Top of the page"/>
                        <ComboBoxItem Content="Bottom of the page"/>
                        <ComboBoxItem Content="Tiled — repeated across the page"/>
                    </ComboBox>
                </DockPanel>

                <TextBlock Text="LAYER" Style="{StaticResource Head}"/>
                <RadioButton x:Name="LayerBehind" Content="Behind text and fields (background)" IsChecked="True" GroupName="Layer" Checked="Changed"
                             ToolTip="Text and form fields stay on top and readable"/>
                <RadioButton x:Name="LayerTop" Content="On top of the page" GroupName="Layer" Margin="0,4,0,0" Checked="Changed"
                             ToolTip="Visible even over images and filled backgrounds"/>

                <TextBlock Text="PAGES" Style="{StaticResource Head}"/>
                <RadioButton x:Name="PagesAll" Content="All pages" IsChecked="True" GroupName="Pages"/>
                <RadioButton x:Name="PagesCurrent" Content="Current page" GroupName="Pages" Margin="0,4,0,0"/>
                <DockPanel Margin="0,4,0,0">
                    <RadioButton x:Name="PagesRange" Content="Pages" GroupName="Pages" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RangeBox" Text="1-" GotFocus="RangeBox_GotFocus" ToolTip="e.g. 1-3, 5, 8-" AutomationProperties.Name="Page range"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Grid.Row="1" Background="{DynamicResource ContentBgBrush}" CornerRadius="4" Padding="12">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="PreviewRoot" Background="White" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Fill"/>
                        <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Buttons -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="RemoveBtn" DockPanel.Dock="Left" Content="Remove watermark" Padding="12,4" Visibility="Collapsed"
                    Click="Remove_Click" ToolTip="Take out watermarks added by PdfEdit (undoable)"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,4" Margin="8,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Apply" Padding="16,4" IsDefault="True" Style="{StaticResource ModernButton}" Click="Apply_Click"/>
        </DockPanel>
    </Grid>
</Window>

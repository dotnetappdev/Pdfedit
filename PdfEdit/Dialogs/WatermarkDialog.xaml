<Window x:Class="PdfEdit.Dialogs.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Watermark"
        Width="380" Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Watermark text -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label Content="Text:"/>
            <TextBox x:Name="TxtText" Text="DRAFT" Width="220"/>
        </StackPanel>

        <!-- Font size -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Font size:"/>
            <Slider x:Name="SliderSize" Minimum="24" Maximum="144" Value="72" Width="160" TickFrequency="12" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding ElementName=SliderSize, Path=Value, StringFormat='{}{0:F0} pt'}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Width="44"/>
        </StackPanel>

        <!-- Opacity -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="Opacity:"/>
            <Slider x:Name="SliderOpacity" Minimum="0.05" Maximum="1" Value="0.25" Width="160"/>
            <TextBlock Text="{Binding ElementName=SliderOpacity, Path=Value, StringFormat='{}{0:P0}'}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Width="44"/>
        </StackPanel>

        <!-- Angle -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label Content="Angle:"/>
            <Slider x:Name="SliderAngle" Minimum="-90" Maximum="90" Value="-45" Width="160" TickFrequency="15" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding ElementName=SliderAngle, Path=Value, StringFormat='{}{0:F0}°'}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Width="44"/>
        </StackPanel>

        <!-- Color -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Label Content="Color (hex):"/>
            <TextBox x:Name="TxtColor" Text="#808080" Width="100"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply" Width="80" IsDefault="True" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

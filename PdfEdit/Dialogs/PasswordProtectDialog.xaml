<Window x:Class="PdfEdit.Dialogs.PasswordProtectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Protect PDF"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Set passwords to restrict access to this PDF." FontSize="12" Margin="0,0,0,12"
                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>

        <!-- Open password -->
        <TextBlock Text="Open password (users must enter this to open the file):"
                   FontSize="12" Margin="0,0,0,4"/>
        <PasswordBox x:Name="UserPasswordBox" Height="28" FontSize="12" Margin="0,0,0,4"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"/>
        <PasswordBox x:Name="UserPasswordConfirmBox" Height="28" FontSize="12" Margin="0,0,0,12"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     ToolTip="Confirm open password"/>

        <!-- Owner / permissions password -->
        <TextBlock Text="Owner password (required to change permissions — optional):"
                   FontSize="12" Margin="0,0,0,4"/>
        <PasswordBox x:Name="OwnerPasswordBox" Height="28" FontSize="12" Margin="0,0,0,12"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Permissions -->
        <TextBlock Text="Permissions when opened with the open password:"
                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="AllowPrintingBox" Content="Allow printing" IsChecked="True"
                  FontSize="12" Margin="0,0,0,4"/>
        <CheckBox x:Name="AllowCopyingBox" Content="Allow copying text/images" IsChecked="False"
                  FontSize="12" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="Red" FontSize="11"
                   Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Protect" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

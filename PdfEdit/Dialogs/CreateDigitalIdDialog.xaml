<Window x:Class="PdfEdit.Dialogs.CreateDigitalIdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a Digital ID"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="A self-signed Digital ID proves the document hasn't changed since you signed it. Others see it as 'not trusted' until they choose to trust it; for legally recognised signatures use an ID from a certificate provider."/>
        <DockPanel Margin="0,0,0,6"><TextBlock Text="Name" Style="{StaticResource Lbl}"/><TextBox x:Name="NameBox"/></DockPanel>
        <DockPanel Margin="0,0,0,6"><TextBlock Text="Email" Style="{StaticResource Lbl}"/><TextBox x:Name="EmailBox"/></DockPanel>
        <DockPanel Margin="0,0,0,6"><TextBlock Text="Organisation" Style="{StaticResource Lbl}"/><TextBox x:Name="OrgBox"/></DockPanel>
        <DockPanel Margin="0,0,0,6"><TextBlock Text="Password" Style="{StaticResource Lbl}"/>
            <PasswordBox x:Name="Pw1" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputForegroundBrush}"/></DockPanel>
        <DockPanel><TextBlock Text="Confirm" Style="{StaticResource Lbl}"/>
            <PasswordBox x:Name="Pw2" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputForegroundBrush}"/></DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#E5534B" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Create" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Create_Click"/>
            <Button Content="Cancel" Padding="16,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

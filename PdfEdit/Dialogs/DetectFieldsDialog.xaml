<Window x:Class="PdfEdit.Dialogs.DetectFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detected Form Fields"
        Width="620" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <TextBlock x:Name="Intro" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Select all" Padding="10,3" Margin="0,0,6,0" Click="All_Click"/>
            <Button DockPanel.Dock="Left" Content="Select none" Padding="10,3" Click="None_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,4" Margin="8,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="AddBtn" Content="Add fields" Padding="16,4" IsDefault="True" Style="{StaticResource ModernButton}" Click="Add_Click"/>
        </DockPanel>
        <Border Background="{DynamicResource SidebarBgBrush}" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" AutomationProperties.Name="Include field"/>
                                <TextBlock Grid.Column="1" Text="{Binding Page, StringFormat=p. {0}}" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                                <TextBox Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropGridInlineTextBox}" AutomationProperties.Name="Field name"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>

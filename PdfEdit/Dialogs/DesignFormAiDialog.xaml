<Window x:Class="PdfEdit.Dialogs.DesignFormAiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Design a Form with AI"
        Width="560" Height="500" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontSize="{DynamicResource DialogFontSize}"
        AutomationProperties.Name="Design a form with AI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="What form do you need?"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Describe the form and any fields it must have. The AI plans the sections and fields, and PdfEdit lays out real fillable boxes, tick boxes, drop-downs and signature boxes on the Design canvas, ready to adjust."/>

        <TextBox Grid.Row="2" x:Name="DescriptionBox"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="90" Padding="8,6" FontSize="13"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}"
                 CaretBrush="{DynamicResource ForegroundBrush}"
                 SpellCheck.IsEnabled="True"
                 TextChanged="DescriptionBox_TextChanged"
                 AutomationProperties.Name="Describe the form"/>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" Text="Or start from an idea:" Margin="0,0,0,4"/>
            <WrapPanel x:Name="IdeasPanel"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Page:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PageSizeBox" Grid.Column="1" Height="28" AutomationProperties.Name="Page size">
                <ComboBoxItem Content="A4" Tag="A4" IsSelected="True"/>
                <ComboBoxItem Content="US Letter" Tag="Letter"/>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="Colour:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ColourBox" Grid.Column="4" Height="28" AutomationProperties.Name="Heading colour"/>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DimForegroundBrush}"
                       Text="The design replaces what's on the canvas. Undo (Ctrl+Z) brings it back."/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DesignBtn" Content="Design form" Width="120" Height="32" Margin="0,0,8,0"
                    IsDefault="True" IsEnabled="False" Click="Design_Click"
                    Style="{StaticResource ModernButton}"
                    AutomationProperties.Name="Design the form"/>
            <Button Content="Cancel" Width="90" Height="32" Click="Cancel_Click"
                    Background="{DynamicResource InputBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>

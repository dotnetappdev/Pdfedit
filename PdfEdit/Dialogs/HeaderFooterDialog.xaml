<Window x:Class="PdfEdit.Dialogs.HeaderFooterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Header / Footer"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Header text (leave blank to skip):" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="HeaderTextBox" Height="26" FontSize="12" Margin="0,0,0,12"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"/>

        <TextBlock Text="Footer text (leave blank to skip):" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="FooterTextBox" Height="26" FontSize="12" Margin="0,0,0,12"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Font size (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="FontSizeBox" Text="10" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Alignment:" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="AlignmentBox" Height="26" FontSize="12"
                          Background="{DynamicResource InputBgBrush}"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <ComboBoxItem Content="Center" IsSelected="True"/>
                    <ComboBoxItem Content="Left"/>
                    <ComboBoxItem Content="Right"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Apply" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="PdfEdit.Dialogs.ThemedConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfEdit"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                    Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                <TextBlock x:Name="IconText" Text="?" FontSize="17" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,20"/>

        <!-- Separator -->
        <Rectangle Grid.Row="2" Height="1"
                   Fill="{DynamicResource AppBorderBrush}"
                   Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Padding="18,7" Margin="0,0,10,0"
                    FontSize="12" IsCancel="True"
                    Click="CancelBtn_Click"
                    AutomationProperties.Name="Cancel"/>
            <Button x:Name="ConfirmBtn"
                    Padding="18,7"
                    FontSize="12" FontWeight="SemiBold"
                    IsDefault="True"
                    Click="ConfirmBtn_Click"
                    AutomationProperties.Name="Confirm"/>
        </StackPanel>
    </Grid>
</Window>

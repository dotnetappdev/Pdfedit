<Window x:Class="PdfEdit.Dialogs.SanitizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strip Hidden Data"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Removes things that travel with a PDF but aren't visible on the page. The pages themselves and your form fields are kept."/>
        <CheckBox x:Name="MetaBox" Content="Document metadata (author, title, creation software, XMP)" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="ScriptBox" Content="JavaScript and actions that run automatically" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="FilesBox" Content="Attached files" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="CommentsBox" Content="Comments and mark-up (notes, highlights, stamps)" Margin="0,4"/>
        <CheckBox x:Name="BookmarksBox" Content="Bookmarks" Margin="0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"
                   Text="To hide text or images on the page itself, use Redact. Ctrl+Z undoes this."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Remove" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource ModernButton}" Click="Ok_Click"/>
            <Button Content="Cancel" Padding="16,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="PdfEdit.Dialogs.ThemedErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfEdit"
        Width="560" MinWidth="420" SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="#CC4444" Margin="0,0,12,0">
                <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" Text="Error"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,16"/>

        <!-- Details expander -->
        <Expander Grid.Row="2"
                  x:Name="DetailsExpander"
                  Header="Technical details"
                  Foreground="{DynamicResource DimForegroundBrush}"
                  Margin="0,0,0,16"
                  Visibility="Collapsed">
            <Border Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Margin="0,8,0,0" MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="DetailsBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="Transparent"
                             Foreground="{DynamicResource DimForegroundBrush}"
                             BorderThickness="0"
                             Padding="10,8"/>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Separator -->
        <Rectangle Grid.Row="3" Height="1"
                   Fill="{DynamicResource AppBorderBrush}"
                   Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CopyBtn"
                    Content="Copy details"
                    Padding="14,7" Margin="0,0,8,0"
                    FontSize="12"
                    Visibility="Collapsed"
                    Click="CopyBtn_Click"
                    AutomationProperties.Name="Copy error details"/>
            <Button Content="OK"
                    Padding="24,7"
                    FontSize="12"
                    FontWeight="SemiBold"
                    IsDefault="True" IsCancel="True"
                    Click="OkBtn_Click"
                    AutomationProperties.Name="Close error dialog"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="PdfEdit.Dialogs.FieldNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Form Field"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="FieldTypeLabel" Text="Text Field name:" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="FieldNameBox" Height="28" FontSize="12" Margin="0,0,0,10"
                 Background="{DynamicResource InputBgBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Shown only for ComboBox fields -->
        <StackPanel x:Name="ComboOptionsPanel" Visibility="Collapsed">
            <TextBlock Text="Dropdown options (one per line):" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="ComboOptionsBox" Height="80" FontSize="12"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     Margin="0,0,0,10"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Text="" Foreground="Red" FontSize="11"
                   Margin="0,0,0,6" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Add" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="PdfEdit.Dialogs.CropPageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Pages"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBgBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Set crop margins (in points, from each edge of the page):"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Left (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="LeftBox" Text="0" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Right (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="RightBox" Text="0" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Top (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TopBox" Text="0" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Bottom (pt):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="BottomBox" Text="0" Height="26" FontSize="12"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Note: 1 inch = 72 pt. These margins are removed from all pages."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Crop" Width="80" Height="28"
                    Click="Apply_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

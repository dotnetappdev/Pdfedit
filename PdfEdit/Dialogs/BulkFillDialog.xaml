<Window x:Class="PdfEdit.Dialogs.BulkFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Fill from Spreadsheet"
        Width="760" Height="640" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TemplateText" TextWrapping="Wrap"/>
            <TextBlock Text="SPREADSHEET" Style="{StaticResource Head}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="BrowseData_Click"/>
                <TextBox x:Name="DataPathBox" IsReadOnly="True" AutomationProperties.Name="Spreadsheet file"/>
            </DockPanel>
            <TextBlock x:Name="DataInfo" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"
                       Text="CSV or Excel (.xlsx). The first row holds the column names; each row after it makes one PDF."/>
        </StackPanel>

        <DockPanel Grid.Row="1">
            <TextBlock Text="MATCH FIELDS TO COLUMNS" Style="{StaticResource Head}"/>
            <TextBlock x:Name="PreviewNote" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"
                       FontSize="11" Foreground="{DynamicResource DimForegroundBrush}"/>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="MapGrid" Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="SAVE" Style="{StaticResource Head}"/>
            <DockPanel>
                <TextBlock Text="Folder" Width="80" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="BrowseOut_Click"/>
                <TextBox x:Name="FolderBox"/>
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="File names" Width="80" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBlock x:Name="NameExample" DockPanel.Dock="Right" Width="210" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="PatternBox" Text="{}{row}" TextChanged="PatternBox_TextChanged"
                         ToolTip="Use column names in braces, e.g. {Last name} {First name}; {row} is the row number"/>
            </DockPanel>
            <WrapPanel Margin="80,8,0,0">
                <CheckBox x:Name="FlattenBox" Content="Flatten (values can't be changed afterwards)" Margin="0,0,18,0"/>
                <CheckBox x:Name="CombineBox" Content="Also combine all of them into one PDF"/>
            </WrapPanel>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="4" Margin="0,0,0,10" Visibility="Hidden"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,4" Margin="8,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="OpenFolderBtn" Content="Open folder" Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed" Click="OpenFolder_Click"/>
            <Button DockPanel.Dock="Right" x:Name="RunBtn" Content="Make PDFs" Padding="18,4" Style="{StaticResource ModernButton}" Click="Run_Click"/>
        </DockPanel>
    </Grid>
</Window>

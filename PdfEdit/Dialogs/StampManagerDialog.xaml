<Window x:Class="PdfEdit.Dialogs.StampManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stamps"
        Width="880" Height="600" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left: every stamp, grouped, with a preview of each -->
        <DockPanel Margin="0,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource DimForegroundBrush}"/>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Find a stamp by its text"
                         AutomationProperties.Name="Search stamps"/>
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New stamp" Padding="12,5" Click="New_Click" ToolTip="Create a stamp with your own text and colour"
                        AutomationProperties.Name="New stamp"/>
                <Button x:Name="DuplicateBtn" Content="Duplicate" Padding="12,5" Margin="6,0,0,0" Click="Duplicate_Click"
                        ToolTip="Make your own copy of this stamp to change" AutomationProperties.Name="Duplicate stamp"/>
                <Button x:Name="DeleteBtn" Content="Delete" Padding="12,5" Margin="6,0,0,0" Click="Delete_Click"
                        ToolTip="Remove this custom stamp from the list (stamps already on pages stay)" AutomationProperties.Name="Delete stamp"/>
            </StackPanel>
            <ListBox x:Name="StampList" SelectionChanged="StampList_SelectionChanged" MouseDoubleClick="StampList_DoubleClick"
                     Background="{DynamicResource ContentBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     AutomationProperties.Name="Stamps">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3" ToolTip="{Binding Tooltip}"
                                   AutomationProperties.Name="{Binding Tooltip}">
                            <TextBlock DockPanel.Dock="Right" Text="DEFAULT" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="8,0,4,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding DefaultVisibility}"/>
                            <Border Background="White" CornerRadius="4" Padding="6,4" HorizontalAlignment="Left">
                                <Viewbox Height="26" MaxWidth="220" Stretch="Uniform" HorizontalAlignment="Left">
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Preview}"/>
                                </Viewbox>
                            </Border>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Margin="4,10,0,4"
                                           Foreground="{DynamicResource DimForegroundBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <!-- Right: preview, details and what to do with it -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ModeText" Text="PREVIEW" Style="{StaticResource Head}" Margin="0,0,0,6"/>
                <Border Background="White" CornerRadius="6" Height="150" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <Viewbox Margin="24" Stretch="Uniform" MaxHeight="110">
                        <Rectangle x:Name="BigPreview" AutomationProperties.Name="Stamp preview"/>
                    </Viewbox>
                </Border>

                <TextBlock Text="DETAILS" Style="{StaticResource Head}"/>
                <TextBlock x:Name="BuiltInNote" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                           Foreground="{DynamicResource DimForegroundBrush}"
                           Text="This is a built-in stamp. Change its text or colour below and it becomes a new stamp of your own; the original stays as it is."/>
                <DockPanel Margin="0,3">
                    <TextBlock Text="Text" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TitleBox" TextChanged="Editor_Changed" CharacterCasing="Upper" MaxLength="40"
                             AutomationProperties.Name="Stamp text"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,3">
                    <TextBlock Text="Colour" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="ColorBox" DockPanel.Dock="Right" Width="84" Text="#6A1B9A" TextChanged="Editor_Changed"
                             AutomationProperties.Name="Colour hex"/>
                    <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                </DockPanel>
                <CheckBox x:Name="DynamicBox" Margin="64,8,0,0" Checked="Editor_Changed" Unchecked="Editor_Changed"
                          Content="Add my name and the date and time under the text"
                          AutomationProperties.Name="Add name and time"/>
                <StackPanel Orientation="Horizontal" Margin="64,12,0,0">
                    <Button x:Name="SaveBtn" Content="Save changes" Padding="14,5" Style="{StaticResource ModernButton}" Click="Save_Click"
                            AutomationProperties.Name="Save stamp"/>
                    <Button x:Name="CancelEditBtn" Content="Cancel" Padding="14,5" Margin="6,0,0,0" Click="CancelEdit_Click"
                            AutomationProperties.Name="Cancel new stamp"/>
                </StackPanel>

                <TextBlock Text="USE IT" Style="{StaticResource Head}"/>
                <WrapPanel>
                    <Button x:Name="DefaultBtn" Content="Set as default" Padding="12,5" Margin="0,0,6,6" Click="Default_Click"
                            ToolTip="The Stamp tool starts with this stamp, now and next time" AutomationProperties.Name="Set as default stamp"/>
                    <Button x:Name="BackgroundBtn" Content="Use as page background…" Padding="12,5" Margin="0,0,6,6" Click="Background_Click"
                            ToolTip="Put this text behind the page content, large and faint, like a CONFIDENTIAL or DRAFT watermark"
                            AutomationProperties.Name="Use as page background"/>
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,2,0,0"
                           Text="A stamp is placed where you click and can be moved, resized and deleted. A page background goes behind the text on every page you choose; Ctrl+Z or Watermark → Remove takes it off."/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,5" Margin="8,0,0,0" IsCancel="True"/>
            <Button x:Name="UseBtn" DockPanel.Dock="Right" Content="Use this stamp" Padding="16,5" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="Use_Click"
                    ToolTip="Choose this stamp and switch to the Stamp tool: click the page to place it"
                    AutomationProperties.Name="Use this stamp"/>
        </DockPanel>
    </Grid>
</Window>

<UserControl x:Class="PdfEdit.Controls.CommentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBgBrush}"
             AutomationProperties.Name="Comments list">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title, count, add a note -->
        <DockPanel Margin="10,8,10,4">
            <Button DockPanel.Dock="Right" Click="AddNote_Click" Padding="8,2" Cursor="Hand"
                    ToolTip="Add a sticky note — then click the page" AutomationProperties.Name="Add comment">
                <TextBlock Text="+ Comment"/>
            </Button>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"/>
            <TextBlock Text="Comments" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
        </DockPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="10,2,10,4">
            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="22,3,4,3"
                     AutomationProperties.Name="Search comments"
                     ToolTip="Search comment text, replies and authors"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" IsHitTestVisible="False"
                       Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}"/>
        </Grid>

        <!-- Filter / sort (Comments list toolbar) -->
        <WrapPanel Grid.Row="2" Margin="8,0,8,6">
            <ComboBox x:Name="TypeFilter" Width="118" Margin="2" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="Filter by type" ToolTip="Show comments of one type">
                <ComboBoxItem Content="All types" IsSelected="True"/>
                <ComboBoxItem Content="Notes"/>
                <ComboBoxItem Content="Text"/>
                <ComboBoxItem Content="Highlights"/>
                <ComboBoxItem Content="Drawings"/>
                <ComboBoxItem Content="Text edits"/>
                <ComboBoxItem Content="Measurements"/>
            </ComboBox>
            <ComboBox x:Name="StatusFilter" Width="110" Margin="2" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="Filter by status" ToolTip="Show comments with a review status">
                <ComboBoxItem Content="Any status" IsSelected="True"/>
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Accepted"/>
                <ComboBoxItem Content="Rejected"/>
                <ComboBoxItem Content="Cancelled"/>
                <ComboBoxItem Content="Completed"/>
                <ComboBoxItem Content="Checked"/>
                <ComboBoxItem Content="Unchecked"/>
            </ComboBox>
            <ComboBox x:Name="AuthorFilter" Width="110" Margin="2" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="Filter by author" ToolTip="Show one reviewer's comments"/>
            <ComboBox x:Name="SortBy" Width="96" Margin="2" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="Sort comments" ToolTip="Sort by">
                <ComboBoxItem Content="Page" IsSelected="True"/>
                <ComboBoxItem Content="Date"/>
                <ComboBoxItem Content="Author"/>
                <ComboBoxItem Content="Type"/>
            </ComboBox>
        </WrapPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListHost" Margin="6,0,6,8"/>
        </ScrollViewer>
    </Grid>
</UserControl>

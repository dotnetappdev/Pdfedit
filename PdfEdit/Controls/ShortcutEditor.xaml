<UserControl x:Class="PdfEdit.Controls.ShortcutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Keyboard shortcuts editor">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"
                   Text="Pick a command, click in the box below and press the keys you want. Single keys (like H or Shift+S) work when you're not typing in a box; use Ctrl or Alt for shortcuts that work everywhere."/>

        <TextBox x:Name="SearchBox" Grid.Row="1" Padding="6,4" Margin="0,0,0,8" TextChanged="Search_Changed"
                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputForegroundBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}"
                 ToolTip="Search commands or keys" AutomationProperties.Name="Search shortcuts"/>

        <ListView x:Name="List" Grid.Row="2" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                  Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource ForegroundBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" AutomationProperties.Name="Commands and their shortcuts">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Group" Width="80" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Command" Width="230" DisplayMemberBinding="{Binding Label}"/>
                    <GridViewColumn Header="Shortcut" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Keys}" FontFamily="Consolas"
                                           FontWeight="{Binding IsCustom, Converter={StaticResource BoolToFontWeightConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="New shortcut:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBox x:Name="CaptureBox" Grid.Column="1" Padding="6,4" IsReadOnly="True" FontFamily="Consolas"
                     PreviewKeyDown="Capture_PreviewKeyDown" GotKeyboardFocus="Capture_GotFocus" IsEnabled="False"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputForegroundBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     AutomationProperties.Name="Press the new shortcut"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="AssignBtn" Content="Assign" Padding="12,3" Margin="0,0,6,0" IsEnabled="False" Click="Assign_Click"
                        ToolTip="Replace this command's shortcut with the one you pressed"/>
                <Button x:Name="AddBtn" Content="Add" Padding="12,3" Margin="0,0,6,0" IsEnabled="False" Click="Add_Click"
                        ToolTip="Keep the current keys and add this one too"/>
                <Button x:Name="ClearBtn" Content="Remove" Padding="12,3" Margin="0,0,6,0" IsEnabled="False" Click="Clear_Click"
                        ToolTip="No shortcut for this command"/>
                <Button x:Name="ResetBtn" Content="Default" Padding="12,3" IsEnabled="False" Click="Reset_Click"
                        ToolTip="Back to the built-in shortcut"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Margin="0,0,120,0"
                       Foreground="{DynamicResource DimForegroundBrush}"/>
            <Button Content="Reset all" HorizontalAlignment="Right" Padding="12,3" Click="ResetAll_Click"
                    ToolTip="Every command back to its built-in shortcut"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="PdfEdit.Controls.DesignCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PdfEdit.Models"
             Background="{DynamicResource AppBgBrush}"
             Focusable="True">

    <UserControl.Resources>

        <!-- ── Shared element border/selection style ─────────────────────── -->
        <Style x:Key="SelectionBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Text element template ─────────────────────────────────────── -->
        <DataTemplate x:Key="TextTemplate" DataType="{x:Type models:TextDesignElement}">
            <Grid>
                <!-- Editable text box (shown when IsEditing) -->
                <TextBox x:Name="EditBox"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="{Binding Wrap, Converter={StaticResource BoolToTextWrapConverter}}"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ForegroundBrush}"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeightConverter}}"
                         FontStyle="{Binding Italic, Converter={StaticResource BoolToFontStyleConverter}}"
                         TextAlignment="{Binding Alignment}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                         Padding="2"/>
                <!-- Display text block (shown when not editing) -->
                <TextBlock x:Name="DisplayBlock"
                           Text="{Binding Text}"
                           TextWrapping="{Binding Wrap, Converter={StaticResource BoolToTextWrapConverter}}"
                           FontFamily="{Binding FontFamily}"
                           FontSize="{Binding FontSize}"
                           FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeightConverter}}"
                           FontStyle="{Binding Italic, Converter={StaticResource BoolToFontStyleConverter}}"
                           TextAlignment="{Binding Alignment}"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                           TextDecorations="{Binding Underline, Converter={StaticResource BoolToTextDecoration}}"
                           Padding="2">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding Color}"/>
                    </TextBlock.Foreground>
                    <TextBlock.Background>
                        <SolidColorBrush Color="{Binding BgColor}"/>
                    </TextBlock.Background>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ── Rectangle template ────────────────────────────────────────── -->
        <DataTemplate x:Key="RectTemplate" DataType="{x:Type models:ShapeDesignElement}">
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       StrokeThickness="{Binding StrokeThickness}">
                <Rectangle.Fill><SolidColorBrush Color="{Binding FillColor}"/></Rectangle.Fill>
                <Rectangle.Stroke><SolidColorBrush Color="{Binding StrokeColor}"/></Rectangle.Stroke>
            </Rectangle>
        </DataTemplate>

        <!-- ── Ellipse template ───────────────────────────────────────────── -->
        <DataTemplate x:Key="EllipseTemplate" DataType="{x:Type models:ShapeDesignElement}">
            <Ellipse StrokeThickness="{Binding StrokeThickness}">
                <Ellipse.Fill><SolidColorBrush Color="{Binding FillColor}"/></Ellipse.Fill>
                <Ellipse.Stroke><SolidColorBrush Color="{Binding StrokeColor}"/></Ellipse.Stroke>
            </Ellipse>
        </DataTemplate>

        <!-- ── Line / Arrow template ─────────────────────────────────────── -->
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type models:ShapeDesignElement}">
            <Canvas>
                <Line x:Name="MainLine"
                      X1="0" Y1="0"
                      X2="{Binding Width}" Y2="{Binding Height}"
                      StrokeThickness="{Binding StrokeThickness}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Stroke><SolidColorBrush Color="{Binding StrokeColor}"/></Line.Stroke>
                </Line>
            </Canvas>
        </DataTemplate>

        <!-- ── Image template ────────────────────────────────────────────── -->
        <DataTemplate x:Key="ImageTemplate" DataType="{x:Type models:ImageDesignElement}">
            <Image Source="{Binding Bitmap}" Stretch="Fill"/>
        </DataTemplate>

        <!-- ── Freehand template ──────────────────────────────────────────── -->
        <DataTemplate x:Key="FreehandTemplate" DataType="{x:Type models:FreehandDesignElement}">
            <!-- Rendered programmatically in code-behind via a Canvas child -->
            <Canvas x:Name="FreehandCanvas" Tag="{Binding}"/>
        </DataTemplate>

        <!-- ── Table template ────────────────────────────────────────────── -->
        <DataTemplate x:Key="TableTemplate" DataType="{x:Type models:TableDesignElement}">
            <Border x:Name="TableHost"
                    BorderThickness="{Binding BorderThickness}"
                    ClipToBounds="True">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{Binding BorderColor}"/>
                </Border.BorderBrush>
            </Border>
        </DataTemplate>

        <!-- ── Form field placeholder template ───────────────────────────── -->
        <!-- Design-time placeholder for an AcroForm field: caption label to the
             left/right of the field box (with an adjustable pixel gap), or the
             label shown as a hint inside the box. The label is static caption
             text — never user-editable once exported to PDF Live View. -->
        <DataTemplate x:Key="FormFieldTemplate" DataType="{x:Type models:FormFieldDesignElement}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Label to the left of the field -->
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="{Binding LabelOffset, Converter={StaticResource DoubleToRightMarginConverter}}"
                           Visibility="{Binding LabelPosition, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Left}"/>

                <!-- Field box -->
                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Background="#1A0078D7" CornerRadius="2" MinHeight="18">
                    <Grid>
                        <!-- Placeholder-style hint text inside the box -->
                        <TextBlock Text="{Binding Label}"
                                   Foreground="Gray" FontStyle="Italic" Margin="4,0"
                                   VerticalAlignment="Top" Padding="0,2,0,0"
                                   TextWrapping="{Binding Wrap, Converter={StaticResource BoolToTextWrapConverter}}"
                                   Visibility="{Binding LabelPosition, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Placeholder}"/>
                        <!-- Field-kind glyph, centered — indicates what this placeholder becomes on export -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource DimForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value=""/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FieldKind}" Value="Checkbox">
                                            <Setter Property="Text" Value="&#xE739;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldKind}" Value="Radio">
                                            <Setter Property="Text" Value="&#xEA81;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldKind}" Value="ComboBox">
                                            <Setter Property="Text" Value="&#xE70D;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldKind}" Value="Signature">
                                            <Setter Property="Text" Value="&#xEDC6;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Label to the right of the field -->
                <TextBlock Grid.Column="2" Text="{Binding Label}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="{Binding LabelOffset, Converter={StaticResource DoubleToLeftMarginConverter}}"
                           Visibility="{Binding LabelPosition, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Right}"/>
            </Grid>
        </DataTemplate>

        <!-- ── Selection overlay style (shared) ─────────────────────────── -->
        <Style x:Key="HandleThumb" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="{DynamicResource AccentBrush}"
                                   Stroke="White" StrokeThickness="1"
                                   Width="8" Height="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Element context menu (right-click) -->
    <UserControl.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="Copy"           Click="Copy_Click"      InputGestureText="Ctrl+C"/>
            <MenuItem Header="Paste"          Click="Paste_Click"     InputGestureText="Ctrl+V"/>
            <MenuItem Header="Duplicate"      Click="Duplicate_Click" InputGestureText="Ctrl+D"/>
            <Separator/>
            <MenuItem Header="Bring Forward"  Click="BringForward_Click"/>
            <MenuItem Header="Send Backward"  Click="SendBackward_Click"/>
            <MenuItem Header="Bring to Front" Click="BringToFront_Click"/>
            <MenuItem Header="Send to Back"   Click="SendToBack_Click"/>
            <Separator/>
            <MenuItem Header="Lock Element"   Click="LockElement_Click"/>
            <Separator/>
            <MenuItem Header="Delete Element" Click="DeleteElement_Click"/>
            <Separator/>
            <MenuItem Header="Select All"     Click="SelectAll_Click"/>
            <!-- Table operations — visible only when a table is selected -->
            <Separator x:Name="SepTable"/>
            <MenuItem x:Name="MenuItemTable" Header="Table">
                <MenuItem Header="Insert Row Above"   Click="TableInsertRowBefore_Click"/>
                <MenuItem Header="Insert Row Below"   Click="TableInsertRowAfter_Click"/>
                <MenuItem Header="Delete Row"         Click="TableDeleteRow_Click"/>
                <Separator/>
                <MenuItem Header="Insert Column Left"  Click="TableInsertColumnBefore_Click"/>
                <MenuItem Header="Insert Column Right" Click="TableInsertColumnAfter_Click"/>
                <MenuItem Header="Delete Column"       Click="TableDeleteColumn_Click"/>
            </MenuItem>
            <!-- Palette / theme -->
            <Separator/>
            <MenuItem Header="Apply Theme Palette">
                <MenuItem Header="Ocean Blue" Click="ApplyPaletteOceanBlue_Click"/>
                <MenuItem Header="Warm Earth" Click="ApplyPaletteWarmEarth_Click"/>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Canvas scroll area ────────────────────────────────────────── -->
        <ScrollViewer x:Name="CanvasScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBgBrush}"
                      Padding="40">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Page drop shadow -->
                <Border x:Name="PageShadow" Margin="0,0,6,6"
                        Background="#44000000" CornerRadius="2">
                    <Border.RenderTransform>
                        <TranslateTransform X="6" Y="6"/>
                    </Border.RenderTransform>
                    <Rectangle Width="{Binding PageWidth}" Height="{Binding PageHeight}"/>
                </Border>

                <!-- Page surface (white) -->
                <Border x:Name="PageBorder" Background="White" CornerRadius="2"
                        Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                        ClipToBounds="True">

                    <Grid>
                        <!-- Grid overlay (optional) -->
                        <Canvas x:Name="GridOverlay" IsHitTestVisible="False"
                                Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="{Binding PageWidth}" Height="{Binding PageHeight}"/>

                        <!-- Elements layer -->
                        <ItemsControl x:Name="ElementsHost"
                                      ItemsSource="{Binding Elements}"
                                      Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True"
                                            Width="{Binding DataContext.PageWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding DataContext.PageHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZOrder}"/>
                                    <Setter Property="Opacity" Value="{Binding Opacity}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <!-- Templates dispatched in code-behind via TemplateSelector -->
                            <ItemsControl.ItemTemplateSelector>
                                <local:DesignElementTemplateSelector
                                    xmlns:local="clr-namespace:PdfEdit.Controls"
                                    TextTemplate="{StaticResource TextTemplate}"
                                    RectTemplate="{StaticResource RectTemplate}"
                                    EllipseTemplate="{StaticResource EllipseTemplate}"
                                    LineTemplate="{StaticResource LineTemplate}"
                                    ImageTemplate="{StaticResource ImageTemplate}"
                                    FreehandTemplate="{StaticResource FreehandTemplate}"
                                    TableTemplate="{StaticResource TableTemplate}"
                                    FormFieldTemplate="{StaticResource FormFieldTemplate}"/>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>

                        <!-- Selection handles overlay (drawn in code-behind over selected element) -->
                        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False"
                                Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <!-- selection rect + handles drawn programmatically -->
                        </Canvas>

                        <!-- Draw preview (rubber-band rect while drawing) -->
                        <Canvas x:Name="DrawPreviewCanvas" IsHitTestVisible="False"
                                Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <Rectangle x:Name="DrawPreviewRect"
                                       Stroke="{DynamicResource AccentBrush}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4,2"
                                       Fill="{DynamicResource AccentBrush}"
                                       Opacity="0.15"
                                       Visibility="Collapsed"/>
                            <Line x:Name="DrawPreviewLine"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2"
                                  StrokeDashArray="4,2"
                                  Visibility="Collapsed"/>
                        </Canvas>

                        <!-- Ink canvas for freehand (transparent, events only when active) -->
                        <InkCanvas x:Name="InkSurface"
                                   Background="Transparent"
                                   EditingMode="None"
                                   Width="{Binding PageWidth}" Height="{Binding PageHeight}"/>

                        <!-- Mouse capture overlay (receives clicks/drags for drawing & selection) -->
                        <Canvas x:Name="InteractionCanvas"
                                Background="Transparent"
                                Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                                MouseLeftButtonDown="InteractionCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="InteractionCanvas_MouseLeftButtonUp"
                                MouseMove="InteractionCanvas_MouseMove"
                                MouseRightButtonDown="InteractionCanvas_MouseRightButtonDown"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>

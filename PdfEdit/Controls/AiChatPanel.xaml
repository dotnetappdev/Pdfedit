<UserControl x:Class="PdfEdit.Controls.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PdfEdit.Models"
             Background="{DynamicResource PanelBgBrush}"
             AutomationProperties.Name="AI chat assistant">

    <UserControl.Resources>

        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Model picker toggle button -->
        <Style x:Key="ModelPickerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only action button (cog, clear) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DimForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Model row radio button inside popup -->
        <Style x:Key="ModelRadioBtn" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <Ellipse x:Name="Dot" Grid.Column="1"
                                         Width="7" Height="7" Margin="8,0,0,0"
                                         Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Connection action button -->
        <Style x:Key="ConnectBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disconnect/sign-out button -->
        <Style x:Key="DisconnectBtn" TargetType="Button" BasedOn="{StaticResource ConnectBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CC4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CC4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22CC4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChatMessageTemplate" DataType="{x:Type models:AiChatMessage}">
            <Grid Margin="4,3">
                <!-- User bubble -->
                <Border x:Name="UserBubble"
                        MaxWidth="280" HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="14,14,4,14" Padding="12,8"
                        Margin="36,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="White" FontSize="13" LineHeight="20"/>
                        <TextBlock Text="{Binding TimeDisplay}" FontSize="9"
                                   Foreground="#AAFFFFFF" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Assistant bubble -->
                <Border x:Name="AiBubble"
                        Visibility="Collapsed"
                        MaxWidth="280" HorizontalAlignment="Left"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="4,14,14,14" Padding="12,8"
                        Margin="0,0,36,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="✦" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="AI" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DimForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="13" LineHeight="20"/>
                        <TextBlock Text="{Binding TimeDisplay}" FontSize="9"
                                   Foreground="{DynamicResource DimForegroundBrush}"
                                   HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                    <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AiBubble" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Model selector bar -->
            <RowDefinition Height="Auto"/>  <!-- Profile selector -->
            <RowDefinition Height="Auto"/>  <!-- Task presets -->
            <RowDefinition Height="*"/>     <!-- Chat history -->
            <RowDefinition Height="Auto"/>  <!-- Input row -->
        </Grid.RowDefinitions>

        <!-- ── Model selector bar ───────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Model picker button -->
                <Button Grid.Column="0"
                        x:Name="ModelPickerBtn"
                        Style="{StaticResource ModelPickerBtn}"
                        Click="ModelPickerBtn_Click"
                        ToolTip="Select AI model"
                        AutomationProperties.Name="Select AI model">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProviderIcon}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ModelDisplayLabel}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="  +"
                                   FontSize="14" FontWeight="Light"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <!-- Connections cog -->
                <Button Grid.Column="2"
                        x:Name="ConnectionsBtn"
                        Style="{StaticResource IconBtn}"
                        Margin="4,0,0,0"
                        Click="ConnectionsBtn_Click"
                        ToolTip="AI account connections"
                        AutomationProperties.Name="AI connections settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <!-- Document context badge -->
                <Border x:Name="DocContextBadge"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#1A3A1A" BorderBrush="#2A5A2A" BorderThickness="1"
                        CornerRadius="8" Padding="6,3" Margin="6,0,0,0"
                        ToolTip="Document text loaded — AI can read and analyze this PDF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="Doc context" FontSize="10" Foreground="#4ACA6A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Clear chat -->
                <Button Grid.Column="3"
                        x:Name="ClearBtn"
                        Style="{StaticResource IconBtn}"
                        Margin="2,0,0,0"
                        Click="Clear_Click"
                        ToolTip="Clear chat history"
                        AutomationProperties.Name="Clear chat history">
                    <TextBlock Text="✕" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Model picker Popup ────────────────────────────────────────────── -->
        <Popup x:Name="ModelPickerPopup"
               PlacementTarget="{Binding ElementName=ModelPickerBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    MinWidth="200"
                    Effect="{x:Null}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.35" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Provider tabs -->
                    <StackPanel Orientation="Horizontal" Margin="2,4,2,8">
                        <Button x:Name="ClaudeTabBtn"
                                Tag="Claude"
                                Click="ProviderTab_Click"
                                Padding="10,4" Margin="0,0,4,0"
                                FontSize="11" FontWeight="SemiBold"
                                AutomationProperties.Name="Claude provider tab">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBd"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✦" Foreground="White" Margin="0,0,5,0" FontSize="11"/>
                                            <TextBlock Text="Claude" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AiProvider}" Value="OpenAI">
                                            <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource InputBgBrush}"/>
                                            <Setter TargetName="TabBd" Property="TextElement.Foreground" Value="{DynamicResource DimForegroundBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="OpenAiTabBtn"
                                Tag="OpenAI"
                                Click="ProviderTab_Click"
                                Padding="10,4"
                                FontSize="11" FontWeight="SemiBold"
                                AutomationProperties.Name="OpenAI provider tab">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBd2"
                                            Background="{DynamicResource InputBgBrush}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☁" Margin="0,0,5,0" FontSize="11"
                                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                                            <TextBlock Text="ChatGPT" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AiProvider}" Value="OpenAI">
                                            <Setter TargetName="TabBd2" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="TabBd2" Property="TextElement.Foreground" Value="White"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Model list (updated by code-behind) -->
                    <StackPanel x:Name="ModelListPanel" Margin="0,0,0,4"/>

                    <!-- Connection status hint -->
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                            Padding="4,8,4,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PopupStatusDot" Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="#CC4444"/>
                            <TextBlock x:Name="PopupStatusText"
                                       Text="Not connected — add key in ⚙" FontSize="10"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ── Connections settings Popup ───────────────────────────────────── -->
        <Popup x:Name="ConnectionsPopup"
               PlacementTarget="{Binding ElementName=ConnectionsBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Width="270">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.35" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="AI Connections" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12"/>

                    <!-- ── Claude section ────────────────────────────────── -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="✦" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Claude (Anthropic)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="ClaudeStatusDot" Width="7" Height="7" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Fill="#CC4444"/>
                            <TextBlock x:Name="ClaudeStatusText" Text="Not connected" FontSize="10"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>

                        <!-- Connected view -->
                        <StackPanel x:Name="ClaudeConnectedView" Orientation="Horizontal" Visibility="Collapsed">
                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="8,5" Margin="0,0,8,0">
                                <TextBlock x:Name="ClaudeKeyHint" FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource DimForegroundBrush}"/>
                            </Border>
                            <Button Style="{StaticResource DisconnectBtn}"
                                    Content="Sign out"
                                    Click="ClaudeSignOut_Click"
                                    AutomationProperties.Name="Sign out from Claude"/>
                        </StackPanel>

                        <!-- Not connected view -->
                        <StackPanel x:Name="ClaudeConnectView">
                            <PasswordBox x:Name="ClaudeKeyBox"
                                         Margin="0,0,0,6"
                                         Height="32"
                                         FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         AutomationProperties.Name="Claude API key"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource DimForegroundBrush}"
                                       Margin="0,0,0,6"
                                       Text="Enter your Anthropic API key (sk-ant-…)"/>
                            <Button Style="{StaticResource ConnectBtn}"
                                    Content="Connect Claude"
                                    HorizontalAlignment="Left"
                                    Click="ClaudeConnect_Click"
                                    AutomationProperties.Name="Connect Claude account"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,0,0,14"/>

                    <!-- ── OpenAI / ChatGPT section ─────────────────────── -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="☁" FontSize="13"
                                       Foreground="{DynamicResource DimForegroundBrush}" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="OpenAI (ChatGPT)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="OpenAiStatusDot" Width="7" Height="7" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Fill="#CC4444"/>
                            <TextBlock x:Name="OpenAiStatusText" Text="Not connected" FontSize="10"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimForegroundBrush}"/>
                        </StackPanel>

                        <!-- Connected view -->
                        <StackPanel x:Name="OpenAiConnectedView" Orientation="Horizontal" Visibility="Collapsed">
                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="8,5" Margin="0,0,8,0">
                                <TextBlock x:Name="OpenAiKeyHint" FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource DimForegroundBrush}"/>
                            </Border>
                            <Button Style="{StaticResource DisconnectBtn}"
                                    Content="Sign out"
                                    Click="OpenAiSignOut_Click"
                                    AutomationProperties.Name="Sign out from OpenAI"/>
                        </StackPanel>

                        <!-- Not connected view -->
                        <StackPanel x:Name="OpenAiConnectView">
                            <PasswordBox x:Name="OpenAiKeyBox"
                                         Margin="0,0,0,6"
                                         Height="32"
                                         FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         AutomationProperties.Name="OpenAI API key"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource DimForegroundBrush}"
                                       Margin="0,0,0,6"
                                       Text="Enter your OpenAI API key (sk-…)"/>
                            <Button Style="{StaticResource ConnectBtn}"
                                    Content="Connect ChatGPT"
                                    HorizontalAlignment="Left"
                                    Click="OpenAiConnect_Click"
                                    AutomationProperties.Name="Connect OpenAI account"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer note -->
                    <TextBlock FontSize="10" Foreground="{DynamicResource DimForegroundBrush}"
                               TextWrapping="Wrap"
                               Text="Keys are stored locally on your device and never shared with third parties."/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ── Profile selector row ────────────────────────────────────────── -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Profile:" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource DimForegroundBrush}"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="DisplayName"
                          FontSize="12"
                          AutomationProperties.Name="Personal profile selector"/>

                <Button Grid.Column="2"
                        Content="⚡ Quick Fill"
                        FontSize="11" Padding="8,4" Margin="6,0,0,0"
                        Command="{Binding QuickFillWithProfileCommand}"
                        ToolTip="Fill form fields instantly from the selected profile (no AI needed)"
                        AutomationProperties.Name="Quick fill from profile"/>

                <Button Grid.Column="3"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13" Width="28" Height="28"
                        Margin="4,0,0,0"
                        Command="{Binding ManageProfilesCommand}"
                        ToolTip="Manage personal profiles"
                        AutomationProperties.Name="Manage profiles"/>
            </Grid>
        </Border>

        <!-- ── Task preset chips ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="6,6">
            <WrapPanel>
                <Button Style="{StaticResource PresetChip}" Tag="smartfill"
                        Click="Preset_Click"
                        ToolTip="AI reads the document and fills all form fields intelligently"
                        AutomationProperties.Name="Smart fill from document">📄 Smart Fill</Button>
                <Button Style="{StaticResource PresetChip}" Tag="summarize"
                        Click="Preset_Click"
                        ToolTip="Summarize the document — key parties, dates, amounts, main points"
                        AutomationProperties.Name="Summarize preset">📋 Summarize</Button>
                <Button Style="{StaticResource PresetChip}" Tag="extract"
                        Click="Preset_Click"
                        ToolTip="Extract structured data: names, dates, addresses, amounts, references"
                        AutomationProperties.Name="Extract data preset">🔍 Extract Data</Button>
                <Button Style="{StaticResource PresetChip}" Tag="contract"
                        Click="Preset_Click"
                        ToolTip="Analyze this as a contract — parties, obligations, risks, missing clauses"
                        AutomationProperties.Name="Contract analysis preset">🔎 Contract</Button>
                <Button Style="{StaticResource PresetChip}" Tag="qa"
                        Click="Preset_Click"
                        ToolTip="Ask questions about the PDF"
                        AutomationProperties.Name="Q and A preset">💬 Q&amp;A</Button>
                <Button Style="{StaticResource PresetChip}" Tag="pii"
                        Click="Preset_Click"
                        ToolTip="Find all PII (names, IDs, addresses, financials) that should be redacted"
                        AutomationProperties.Name="Find PII preset">🔒 Find PII</Button>
                <Button Style="{StaticResource PresetChip}" Tag="translate"
                        Click="Preset_Click"
                        ToolTip="Translate document content to English"
                        AutomationProperties.Name="Translate preset">🌐 Translate</Button>
                <Button Style="{StaticResource PresetChip}" Tag="fill"
                        Click="Preset_Click"
                        ToolTip="Describe how to fill the form fields"
                        AutomationProperties.Name="Fill form preset">📝 Fill Fields</Button>
            </WrapPanel>
        </Border>

        <!-- ── Chat history ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3"
                      x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4,6">
            <StackPanel>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20,40">
                    <TextBlock Text="✦" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="AI Assistant" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource DimForegroundBrush}"
                               Text="Pick a task above or type a message to get started. Connect your account with the ⚙ icon above."/>
                </StackPanel>

                <ItemsControl x:Name="ChatList"
                              ItemTemplate="{StaticResource ChatMessageTemplate}"/>

                <!-- Thinking indicator -->
                <Border x:Name="ThinkingIndicator"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="4,14,14,14" Padding="14,10" Margin="4,3,36,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Thinking…" FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Input row ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding AiChatInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxHeight="80" MinHeight="36"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10,8"
                         FontSize="13"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"
                         AutomationProperties.Name="AI message input"/>

                <Button Grid.Column="1"
                        x:Name="SendBtn"
                        Content="&#xE724;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Width="42" Height="36"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsAiRunning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                        Click="Send_Click"
                        AutomationProperties.Name="Send message"/>

                <!-- Cancel button — shown only while AI is running -->
                <Button Grid.Column="1"
                        x:Name="CancelBtn"
                        Visibility="Collapsed"
                        Width="42" Height="36"
                        Margin="6,0,0,0"
                        Background="#CC4444"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE711;"
                        Click="CancelBtn_Click"
                        ToolTip="Stop generating"
                        AutomationProperties.Name="Stop AI generation">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#AA3333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

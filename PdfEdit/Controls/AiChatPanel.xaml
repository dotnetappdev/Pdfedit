<UserControl x:Class="PdfEdit.Controls.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PdfEdit.Models"
             Background="{DynamicResource PanelBgBrush}"
             AutomationProperties.Name="AI chat assistant">

    <UserControl.Resources>
        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChatMessageTemplate" DataType="{x:Type models:AiChatMessage}">
            <Grid Margin="4,3">
                <!-- User bubble -->
                <Border x:Name="UserBubble"
                        MaxWidth="280" HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="14,14,4,14" Padding="12,8"
                        Margin="36,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="White" FontSize="13" LineHeight="20"/>
                        <TextBlock Text="{Binding TimeDisplay}" FontSize="9"
                                   Foreground="#AAFFFFFF" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Assistant bubble -->
                <Border x:Name="AiBubble"
                        Visibility="Collapsed"
                        MaxWidth="280" HorizontalAlignment="Left"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="4,14,14,14" Padding="12,8"
                        Margin="0,0,36,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="✦" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="AI" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DimForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="13" LineHeight="20"/>
                        <TextBlock Text="{Binding TimeDisplay}" FontSize="9"
                                   Foreground="{DynamicResource DimForegroundBrush}"
                                   HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                    <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AiBubble" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Provider / model -->
            <RowDefinition Height="Auto"/>  <!-- Profile selector -->
            <RowDefinition Height="Auto"/>  <!-- Task presets -->
            <RowDefinition Height="*"/>     <!-- Chat history -->
            <RowDefinition Height="Auto"/>  <!-- Input row -->
        </Grid.RowDefinitions>

        <!-- ── Provider / Model row ─────────────────────────────────────── -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AiProviders}"
                          SelectedItem="{Binding AiProvider}"
                          FontSize="12"
                          AutomationProperties.Name="AI provider selector"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding AiModels}"
                          SelectedItem="{Binding AiModel}"
                          FontSize="12"
                          AutomationProperties.Name="AI model selector"/>

                <Button Grid.Column="3" x:Name="ClearBtn"
                        Content="✕" Width="26" Height="26"
                        Margin="6,0,0,0" FontSize="11"
                        ToolTip="Clear chat history"
                        Click="Clear_Click"
                        AutomationProperties.Name="Clear chat history"/>
            </Grid>
        </Border>

        <!-- ── Profile selector row ────────────────────────────────────── -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Profile:" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource DimForegroundBrush}"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="DisplayName"
                          FontSize="12"
                          AutomationProperties.Name="Personal profile selector"/>

                <Button Grid.Column="2"
                        Content="⚡ Quick Fill"
                        FontSize="11" Padding="8,4" Margin="6,0,0,0"
                        Command="{Binding QuickFillWithProfileCommand}"
                        ToolTip="Fill form fields instantly from the selected profile (no AI needed)"
                        AutomationProperties.Name="Quick fill from profile"/>

                <Button Grid.Column="3"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13" Width="28" Height="28"
                        Margin="4,0,0,0"
                        Command="{Binding ManageProfilesCommand}"
                        ToolTip="Manage personal profiles"
                        AutomationProperties.Name="Manage profiles"/>
            </Grid>
        </Border>

        <!-- ── Task preset chips ────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="6,6">
            <WrapPanel>
                <Button Style="{StaticResource PresetChip}" Tag="fill"
                        Click="Preset_Click" ToolTip="Fill form fields automatically"
                        AutomationProperties.Name="Fill form preset">📝 Fill Form</Button>
                <Button Style="{StaticResource PresetChip}" Tag="summarize"
                        Click="Preset_Click" ToolTip="Summarize the document"
                        AutomationProperties.Name="Summarize preset">📋 Summarize</Button>
                <Button Style="{StaticResource PresetChip}" Tag="extract"
                        Click="Preset_Click" ToolTip="Extract key data from the PDF"
                        AutomationProperties.Name="Extract data preset">🔍 Extract Data</Button>
                <Button Style="{StaticResource PresetChip}" Tag="qa"
                        Click="Preset_Click" ToolTip="Ask questions about the PDF"
                        AutomationProperties.Name="Q and A preset">💬 Q&amp;A</Button>
                <Button Style="{StaticResource PresetChip}" Tag="redact"
                        Click="Preset_Click" ToolTip="Find PII that should be redacted"
                        AutomationProperties.Name="Redact suggestions preset">🔒 Redact PII</Button>
                <Button Style="{StaticResource PresetChip}" Tag="translate"
                        Click="Preset_Click" ToolTip="Translate document content"
                        AutomationProperties.Name="Translate preset">🌐 Translate</Button>
            </WrapPanel>
        </Border>

        <!-- ── Chat history ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3"
                      x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4,6">
            <StackPanel>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20,40">
                    <TextBlock Text="✦" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="AI Assistant" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource DimForegroundBrush}"
                               Text="Pick a task above or type a message to get started. Bring your own API key in Settings → AI."/>
                </StackPanel>

                <ItemsControl x:Name="ChatList"
                              ItemTemplate="{StaticResource ChatMessageTemplate}"/>

                <!-- Thinking indicator -->
                <Border x:Name="ThinkingIndicator"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="4,14,14,14" Padding="14,10" Margin="4,3,36,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Thinking…" FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource DimForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Input row ─────────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding AiChatInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxHeight="80" MinHeight="36"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10,8"
                         FontSize="13"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"
                         AutomationProperties.Name="AI message input"/>

                <Button Grid.Column="1"
                        x:Name="SendBtn"
                        Content="&#xE724;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Width="42" Height="36"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsAiRunning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                        Click="Send_Click"
                        AutomationProperties.Name="Send message"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

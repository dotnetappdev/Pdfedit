<UserControl x:Class="PdfEdit.Controls.FieldsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBgBrush}"
             AutomationProperties.Name="Form fields list">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="10,8,10,6">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"/>
            <TextBlock Text="Fields" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
        </DockPanel>

        <ListBox x:Name="FieldList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource ForegroundBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="FieldList_SelectionChanged"
                 MouseDoubleClick="FieldList_MouseDoubleClick"
                 AutomationProperties.Name="Fields">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat='Page {0}'}" FontWeight="SemiBold" Margin="6,8,0,2"
                                       Foreground="{DynamicResource DimForegroundBrush}" FontSize="11"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Properties…" Click="Properties_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Delete" Click="Delete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="10,6" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource DimForegroundBrush}"
                   Text="Click a field to select it on the page. Double-click for its properties."/>
    </Grid>
</UserControl>

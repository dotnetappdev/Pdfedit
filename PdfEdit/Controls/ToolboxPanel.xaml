                <TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/>
            </RadioButton>

            <RadioButton x:Name="DesignSignBtn" Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Sign"
                         Click="DesignSign_Click"
                         ToolTip="Sign — choose or create a signature, then click a signature field or the page  (S)"

<UserControl x:Class="PdfEdit.Controls.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="52"
             Background="Transparent"
             AutomationProperties.Name="Fill and Sign floating toolbar">

    <UserControl.Resources>

        <!-- Floating icon-button (RadioButton) -->
        <Style x:Key="FToolBtn" TargetType="RadioButton">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating toggle button (for Grid / Snap-to-grid) -->
        <Style x:Key="FToggleBtn" TargetType="ToggleButton">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating plain button (for Sign + Annotation popup triggers) -->
        <Style x:Key="FBtn" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon glyph in Segoe MDL2 -->
        <Style x:Key="Ico" TargetType="TextBlock">
            <Setter Property="FontFamily"    Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"      Value="16"/>
            <Setter Property="Foreground"    Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- White icon variant (used inside selected blue button) -->
        <Style x:Key="IcoW" TargetType="TextBlock" BasedOn="{StaticResource Ico}">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Thin horizontal divider -->
        <Style x:Key="FDiv" TargetType="Separator">
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Margin"      Value="6,4"/>
            <Setter Property="Background"  Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <!-- Popup menu item -->
        <Style x:Key="PopupItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ── Floating pill container ─────────────────────────────────────────── -->
    <Border Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4,8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270"/>
        </Border.Effect>

        <!-- Grid (not StackPanel) so each section receives the available height: the sections are
             vertical WrapPanels that flow into a second column instead of being clipped off the top
             and bottom of the window (which hid the form-field components). -->
        <Grid>

            <!-- ══ PDF FILL & SIGN tools (visible in PDF mode) ════════════════
                 Acrobat Fill & Sign rail: Select · Comment · Highlight · Draw · Add text · Sign
                 · colour · More (…). Everything else lives in the More popup; the Design
                 section below keeps the full canvas tool set. -->
            <WrapPanel Orientation="Vertical" x:Name="PdfToolsPanel">

            <!-- Grip (visual, like Acrobat's rail) -->
            <Border Width="28" Height="4" CornerRadius="2" Margin="6,2,6,6" HorizontalAlignment="Center"
                    Background="{DynamicResource AppBorderBrush}"/>

            <!-- Select -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="Select"
                         Checked="Tool_Checked"
                         ToolTip="Select — click fields to fill, click placed text to edit  (V)"
                         AutomationProperties.Name="Select tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8B0;"/>
            </RadioButton>

            <!-- Add comment (sticky note) -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="StickyNote"
                         Checked="Tool_Checked"
                         ToolTip="Add comment — click to place a sticky note"
                         AutomationProperties.Name="Add comment tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE90A;"/>
            </RadioButton>

            <!-- Highlight + color popup -->
            <RadioButton x:Name="HighlightBtn"
                         Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="Highlight"
                         Checked="HighlightTool_Checked"
                         ToolTip="Highlight — drag to mark text  (I)"
                         AutomationProperties.Name="Highlight tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE7C1;" FontSize="15"/>
            </RadioButton>

            <!-- Highlight color popup -->
            <Popup x:Name="HighlightColorPopup"
                   PlacementTarget="{Binding ElementName=HighlightBtn}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="8,8" MinWidth="160">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Highlight Color" FontSize="11"
                                   Foreground="{DynamicResource DimForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Tag="#80FFFF00" Click="HlColor_Click" Width="28" Height="28" Margin="2" ToolTip="Yellow" Background="#FFFF00" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"/>
                            <Button Tag="#80FF69B4" Click="HlColor_Click" Width="28" Height="28" Margin="2" ToolTip="Pink"   Background="#FF69B4" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"/>
                            <Button Tag="#8090EE90" Click="HlColor_Click" Width="28" Height="28" Margin="2" ToolTip="Green"  Background="#90EE90" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"/>
                            <Button Tag="#8087CEEB" Click="HlColor_Click" Width="28" Height="28" Margin="2" ToolTip="Blue"   Background="#87CEEB" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"/>
                            <Button Tag="#80FFA500" Click="HlColor_Click" Width="28" Height="28" Margin="2" ToolTip="Orange" Background="#FFA500" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Draw (freehand) -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="DrawFreehand"
                         Checked="Tool_Checked"
                         ToolTip="Draw — freehand pen  (W)"
                         AutomationProperties.Name="Freehand draw tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEDC6;"/>
            </RadioButton>

            <!-- Add text (Fill & Sign): click to place text; the corner arrow picks ✓ ✕ ● ○ — -->
            <Grid>
                <RadioButton x:Name="AddTextBtn"
                             Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="AddText"
                             Checked="AddTextTool_Checked"
                             ToolTip="Add text — click on the page to type  (T). Corner arrow: checkmark, cross, dot, circle, line"
                             AutomationProperties.Name="Add text tool">
                    <Border Width="22" Height="22" BorderThickness="1.5" CornerRadius="2" Padding="1">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource ForegroundColor}"/>
                        </Border.BorderBrush>
                        <TextBlock x:Name="AddTextGlyph" Text="A" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                </RadioButton>
                <Button Click="AnnotBtn_Click" Width="12" Height="12" Padding="0" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"
                        ToolTip="More marks: checkmark, cross, dot, circle, line"
                        AutomationProperties.Name="More text marks">
                    <TextBlock Text="◢" FontSize="8" Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </Grid>

            <!-- Annotation sub-type popup (image 2) -->
            <Popup x:Name="AnnotPopup"
                   PlacementTarget="{Binding ElementName=AddTextBtn}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="6,8" MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="AnnotTypeText"   Style="{StaticResource PopupItem}" Tag="AddText"    Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" BorderBrush="{DynamicResource ForegroundBrush}" BorderThickness="1.5" CornerRadius="3" Margin="0,0,10,0">
                                    <TextBlock Text="A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="Type text" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnotTypeCross"  Style="{StaticResource PopupItem}" Tag="XMark"      Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Width="22" TextAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Crossmark" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnotTypeCheck"  Style="{StaticResource PopupItem}" Tag="Checkmark"  Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Width="22" TextAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Checkmark" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnotTypeDot"    Style="{StaticResource PopupItem}" Tag="Dot"        Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" FontSize="13" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Dot" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnotTypeCircle" Style="{StaticResource PopupItem}" Tag="Circle"     Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="○" FontSize="15" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Circle around" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnotTypeLine"   Style="{StaticResource PopupItem}" Tag="Line"       Click="AnnotType_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="—" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Cross out" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Sign button + popup (image 1 style) -->
            <Button x:Name="SignBtn"
                    Style="{StaticResource FBtn}"
                    Click="SignBtn_Click"
                    ToolTip="Sign — place or create your signature  (S)"
                    AutomationProperties.Name="Signature tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xED63;" FontSize="18"/>
            </Button>

            <!-- Signature popup (image 1) -->
            <Popup x:Name="SigPopup"
                   PlacementTarget="{Binding ElementName=SignBtn}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   Opened="SigPopup_Opened">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="8,10" MinWidth="220" MaxWidth="280">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Saved signatures (built in code-behind) -->
                        <StackPanel x:Name="SavedSigPanel"/>

                        <!-- Divider if sigs exist -->
                        <Separator x:Name="SigDivider" Style="{StaticResource FDiv}" Margin="0,4" Visibility="Collapsed"/>

                        <!-- Add Signature -->
                        <Button Style="{StaticResource PopupItem}"
                                Click="AddSignature_Click"
                                AutomationProperties.Name="Add signature">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED63;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Width="22" TextAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Add Signature" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Add Initials -->
                        <Button Style="{StaticResource PopupItem}"
                                Click="AddInitials_Click"
                                AutomationProperties.Name="Add initials">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Width="22" TextAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Add Initials" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Colour for text, marks and drawing -->
            <Button x:Name="InkColorBtn" Style="{StaticResource FBtn}" Click="InkColorBtn_Click"
                    ToolTip="Colour for text, marks and drawing"
                    AutomationProperties.Name="Ink colour">
                <Ellipse x:Name="InkColorDot" Width="16" Height="16" Fill="Black"
                         Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1"/>
            </Button>
            <Popup x:Name="InkColorPopup"
                   PlacementTarget="{Binding ElementName=InkColorBtn}"
                   Placement="Left" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8" MinWidth="150">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Colour" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" Margin="0,0,0,6"/>
                        <WrapPanel MaxWidth="160">
                                <Button Tag="#000000" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Black" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#000000"/>
                                <Button Tag="#1A237E" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Dark blue" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#1A237E"/>
                                <Button Tag="#0050C8" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Blue" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#0050C8"/>
                                <Button Tag="#B71C1C" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Red" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#B71C1C"/>
                                <Button Tag="#1B5E20" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Green" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#1B5E20"/>
                                <Button Tag="#757575" Click="InkColor_Click" Width="26" Height="26" Margin="2" ToolTip="Gray" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#757575"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- More tools -->
            <Button x:Name="MoreBtn" Style="{StaticResource FBtn}" Click="MoreBtn_Click"
                    ToolTip="More tools — hand, zoom, date, stamp, shapes, eraser, form fields"
                    AutomationProperties.Name="More tools">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE712;"/>
            </Button>
            <Popup x:Name="MorePopup"
                   PlacementTarget="{Binding ElementName=MoreBtn}"
                   Placement="Left" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,4,6,8" MinWidth="220">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <StackPanel>
                            <TextBlock Text="NAVIGATE" FontSize="10" Foreground="{DynamicResource DimForegroundBrush}" Margin="6,6,0,2"/>
                            <Button Style="{StaticResource PopupItem}" Tag="Hand" Click="MoreTool_Click" AutomationProperties.Name="Hand — pan  (H)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Hand — pan  (H)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="Zoom" Click="MoreTool_Click" AutomationProperties.Name="Zoom  (Z)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Zoom  (Z)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="FILL" FontSize="10" Foreground="{DynamicResource DimForegroundBrush}" Margin="6,6,0,2"/>
                            <Button Style="{StaticResource PopupItem}" Tag="TextFill" Click="MoreTool_Click" AutomationProperties.Name="Fill text field  (F)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fill text field  (F)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="CheckboxToggle" Click="MoreTool_Click" AutomationProperties.Name="Toggle checkbox / radio">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Toggle checkbox / radio" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="DateStamp" Click="MoreTool_Click" AutomationProperties.Name="Date stamp  (D)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Date stamp  (D)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="Stamp" Click="MoreTool_Click" AutomationProperties.Name="Text stamp  (M)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Text stamp  (M)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="DRAW" FontSize="10" Foreground="{DynamicResource DimForegroundBrush}" Margin="6,6,0,2"/>
                            <Button Style="{StaticResource PopupItem}" Tag="DrawRectangle" Click="MoreTool_Click" AutomationProperties.Name="Rectangle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Rectangle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="DrawEllipse" Click="MoreTool_Click" AutomationProperties.Name="Ellipse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA3A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Ellipse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="DrawArrow" Click="MoreTool_Click" AutomationProperties.Name="Arrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEBD4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Arrow" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="DrawCallout" Click="MoreTool_Click" AutomationProperties.Name="Callout">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Callout" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="Eraser" Click="MoreTool_Click" AutomationProperties.Name="Eraser">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED60;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Eraser" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="PREPARE FORM" FontSize="10" Foreground="{DynamicResource DimForegroundBrush}" Margin="6,6,0,2"/>
                            <Button Style="{StaticResource PopupItem}" Tag="EditFields" Click="MoreTool_Click" AutomationProperties.Name="Edit fields — move / resize  (E)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Edit fields — move / resize  (E)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddTextField" Click="MoreTool_Click" AutomationProperties.Name="Add text field">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add text field" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddCheckbox" Click="MoreTool_Click" AutomationProperties.Name="Add checkbox">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add checkbox" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddRadioButton" Click="MoreTool_Click" AutomationProperties.Name="Add radio button">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA81;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add radio button" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddComboBox" Click="MoreTool_Click" AutomationProperties.Name="Add combo box">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add combo box" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddListBox" Click="MoreTool_Click" AutomationProperties.Name="Add list box">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add list box" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddSignatureField" Click="MoreTool_Click" AutomationProperties.Name="Add signature field">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEE56;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add signature field" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupItem}" Tag="AddDateField" Click="MoreTool_Click" AutomationProperties.Name="Add date field">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add date field" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
            </WrapPanel><!-- end PDF tools -->

            <!-- ══ DESIGN CANVAS tools (visible in design mode) ═══════════════ -->
            <!-- Visibility of the two sections is set in code (ToolboxPanel.ApplyMode) whenever
                 IsDesignMode changes, so the toolbox always matches the active view. -->
            <WrapPanel Orientation="Vertical" x:Name="DesignToolsPanel" Visibility="Collapsed">

            <!-- Select -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Select"
                         Checked="DesignTool_Checked"
                         ToolTip="Select — move and resize elements  (V)"
                         AutomationProperties.Name="Design select tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8B0;"/>
            </RadioButton>

            <!-- Fill & Sign on the Design canvas: fill in form fields, sign -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Fill"
                         Checked="DesignTool_Checked"
                         ToolTip="Fill — click a form field to type in it, tick it or pick an option  (F). Tab moves to the next field."
                         AutomationProperties.Name="Design fill form tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/>
            </RadioButton>

            <RadioButton x:Name="DesignSignBtn" Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Sign"
                         Click="DesignSign_Click"
                         ToolTip="Sign — choose or create a signature, then click a signature field or the page  (S)"
                         AutomationProperties.Name="Design sign tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xED63;" FontSize="18"/>
            </RadioButton>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Text -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Text"
                         Checked="DesignTool_Checked"
                         ToolTip="Text — add a text element  (T)"
                         AutomationProperties.Name="Design text tool">
                <TextBlock Style="{StaticResource Ico}" Text="T" FontFamily="Segoe UI" FontWeight="Bold" FontSize="15"
                           Foreground="{DynamicResource ForegroundBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
            </RadioButton>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Rectangle -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Rectangle"
                         Checked="DesignTool_Checked"
                         ToolTip="Rectangle — drag to draw  (R)"
                         AutomationProperties.Name="Design rectangle tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE7C2;"/>
            </RadioButton>

            <!-- Ellipse -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Ellipse"
                         Checked="DesignTool_Checked"
                         ToolTip="Ellipse — drag to draw  (E)"
                         AutomationProperties.Name="Design ellipse tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEA3A;"/>
            </RadioButton>

            <!-- Line -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Line"
                         Checked="DesignTool_Checked"
                         ToolTip="Line — drag to draw in any direction  (L)"
                         AutomationProperties.Name="Design line tool">
                <TextBlock Style="{StaticResource Ico}" Text="╱" FontFamily="Segoe UI" FontSize="16"/>
            </RadioButton>

            <!-- Arrow -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Arrow"
                         Checked="DesignTool_Checked"
                         ToolTip="Arrow — drag to draw  (A)"
                         AutomationProperties.Name="Design arrow tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEBD4;"/>
            </RadioButton>

            <!-- Pen / Freehand -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Pen"
                         Checked="DesignTool_Checked"
                         ToolTip="Pen — freehand drawing  (P)"
                         AutomationProperties.Name="Design pen tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEDC6;"/>
            </RadioButton>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Image -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Image"
                         Checked="DesignTool_Checked"
                         ToolTip="Image — insert an image  (I)"
                         AutomationProperties.Name="Design image tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEB9F;"/>
            </RadioButton>

            <!-- Table -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Table"
                         Checked="DesignTool_Checked"
                         ToolTip="Table — insert a table  (B)"
                         AutomationProperties.Name="Design table tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8A9;"/>
            </RadioButton>

            <!-- Checkmark / X mark -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Checkmark"
                         Checked="DesignTool_Checked"
                         ToolTip="Checkmark — click to place  (K)"
                         AutomationProperties.Name="Design checkmark tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE73E;"/>
            </RadioButton>
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="XMark"
                         Checked="DesignTool_Checked"
                         ToolTip="X mark — click to place  (X)"
                         AutomationProperties.Name="Design X mark tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE711;"/>
            </RadioButton>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Form field placeholders — matches the Fill &amp; Sign toolbox, but places an
                 editable AcroForm placeholder instead of a filled-in value -->
            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="TextField"
                         Checked="DesignTool_Checked"
                         ToolTip="Text Field — a single-line fillable field"
                         AutomationProperties.Name="Design text field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/>
            </RadioButton>

            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Memo"
                         Checked="DesignTool_Checked"
                         ToolTip="Memo — a multi-line paragraph text field"
                         AutomationProperties.Name="Design memo field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/>
            </RadioButton>

            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Checkbox"
                         Checked="DesignTool_Checked"
                         ToolTip="Checkbox field"
                         AutomationProperties.Name="Design checkbox field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE739;"/>
            </RadioButton>

            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Radio"
                         Checked="DesignTool_Checked"
                         ToolTip="Radio button field"
                         AutomationProperties.Name="Design radio button field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEA81;"/>
            </RadioButton>

            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="ComboBox"
                         Checked="DesignTool_Checked"
                         ToolTip="Combo Box — a dropdown choice field"
                         AutomationProperties.Name="Design combo box field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE70D;"/>
            </RadioButton>

            <RadioButton Style="{StaticResource FToolBtn}" GroupName="DesignTools" Tag="Signature"
                         Checked="DesignTool_Checked"
                         ToolTip="Signature field"
                         AutomationProperties.Name="Design signature field tool">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEDC6;"/>
            </RadioButton>

            <Separator Style="{StaticResource FDiv}"/>

            <!-- Grid on/off -->
            <ToggleButton Style="{StaticResource FToggleBtn}"
                          IsChecked="{Binding DesignCanvas.ShowGrid}"
                          ToolTip="Toggle grid overlay"
                          AutomationProperties.Name="Toggle grid">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE80A;"/>
            </ToggleButton>

            <!-- Snap to grid -->
            <ToggleButton Style="{StaticResource FToggleBtn}"
                          IsChecked="{Binding DesignCanvas.SnapToGrid}"
                          ToolTip="Snap elements to grid while dragging"
                          AutomationProperties.Name="Snap to grid">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE7EF;"/>
            </ToggleButton>

            </WrapPanel><!-- end Design tools -->
        </Grid>
    </Border>
</UserControl>

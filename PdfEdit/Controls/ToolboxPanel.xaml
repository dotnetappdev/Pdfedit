<UserControl x:Class="PdfEdit.Controls.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="160"
             Background="{DynamicResource SidebarBgBrush}">

    <UserControl.Resources>

        <!-- ── Active-tool accent-bar style (Acrobat-style left stripe) ──────── -->
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Height"              Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin"              Value="0,1"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Focusable"           Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Outer border carries the left accent stripe when checked -->
                        <Border x:Name="Outer"
                                Background="Transparent"
                                BorderThickness="2,0,0,0"
                                BorderBrush="Transparent"
                                Padding="10,0,8,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background"   Value="{DynamicResource ActiveBgBrush}"/>
                                <Setter TargetName="Outer" Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"    Value="True"/>
                                    <Condition Property="IsMouseOver"  Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource ActiveBgBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header ─────────────────────────────────────────────────── -->
        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="9"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="{DynamicResource DimForegroundBrush}"/>
            <Setter Property="Margin"         Value="12,12,8,3"/>
            <Setter Property="CharacterSpacing" Value="120"/>
        </Style>

        <!-- ── Thin separator ─────────────────────────────────────────────────── -->
        <Style x:Key="ToolSep" TargetType="Separator">
            <Setter Property="Background"  Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Margin"      Value="0,4"/>
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Opacity"     Value="0.5"/>
        </Style>

        <!-- Icon glyph style (Segoe MDL2 / emoji) -->
        <Style x:Key="ToolIcon" TargetType="TextBlock">
            <Setter Property="Width"           Value="22"/>
            <Setter Property="TextAlignment"   Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
        </Style>

        <!-- Tool label text -->
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"          Value="8,0,0,0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
        </Style>

        <!-- Active tool label: brighter -->
        <Style x:Key="ToolLabelActive" TargetType="TextBlock" BasedOn="{StaticResource ToolLabel}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,4,0,8">

            <!-- ── NAVIGATE ──────────────────────────────────────────────────── -->
            <TextBlock Text="NAVIGATE" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Hand"
                         IsChecked="True" Checked="Tool_Checked"
                         ToolTip="Hand Tool — Pan the document (H)"
                         AutomationProperties.Name="Hand pan tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE7C9;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Hand"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Zoom"
                         Checked="Tool_Checked"
                         ToolTip="Zoom Tool — Click to zoom in; Ctrl+Wheel also zooms (Z)"
                         AutomationProperties.Name="Zoom tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE71E;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Zoom"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── FILL IN FORM ──────────────────────────────────────────────── -->
            <TextBlock Text="FILL IN FORM" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="TextFill"
                         Checked="Tool_Checked"
                         ToolTip="Fill text fields — click a field to type in it"
                         AutomationProperties.Name="Text fill tool">
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="20"
                            BorderBrush="{DynamicResource ForegroundBrush}" BorderThickness="1"
                            CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Ab" FontSize="11" FontWeight="Bold"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Fill Text Field"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="CheckboxToggle"
                         Checked="Tool_Checked"
                         ToolTip="Toggle checkbox or radio fields — click to check/uncheck"
                         AutomationProperties.Name="Checkbox toggle tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Checkbox / Radio"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DateStamp"
                         Checked="Tool_Checked"
                         ToolTip="Date Stamp — click the page to place today's date (D)"
                         AutomationProperties.Name="Date stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Date"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── ADD TEXT ──────────────────────────────────────────────────── -->
            <TextBlock Text="ADD TEXT" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="AddText"
                         Checked="Tool_Checked"
                         ToolTip="Add Text — click anywhere on the page to place text (T)"
                         AutomationProperties.Name="Add horizontal text annotation">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               Text="T" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Add Text"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="VerticalText"
                         Checked="Tool_Checked"
                         ToolTip="Vertical Text — click the page to place top-to-bottom text"
                         AutomationProperties.Name="Add vertical text annotation">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="22" Height="22">
                        <TextBlock Text="T" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Vertical Text"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── SIGN ──────────────────────────────────────────────────────── -->
            <TextBlock Text="SIGN" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Signature"
                         Checked="Tool_Checked"
                         ToolTip="Signature — click a signature field or the page to place your signature (S)"
                         AutomationProperties.Name="Signature tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Sign"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── MARKUP ─────────────────────────────────────────────────────── -->
            <TextBlock Text="MARKUP" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Checkmark"
                         Checked="Tool_Checked"
                         ToolTip="Checkmark — click the page to stamp ✓ (K)"
                         AutomationProperties.Name="Checkmark stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               Text="✓" FontSize="16" FontWeight="Bold" Foreground="#4CAF50"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Checkmark"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="XMark"
                         Checked="Tool_Checked"
                         ToolTip="X Mark — click the page to stamp ✕"
                         AutomationProperties.Name="X mark stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               Text="✕" FontSize="16" FontWeight="Bold" Foreground="#F44336"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="X Mark"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Dot"
                         Checked="Tool_Checked"
                         ToolTip="Dot — click the page to place a filled dot ●"
                         AutomationProperties.Name="Dot stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="●" FontSize="14"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Dot"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Line"
                         Checked="Tool_Checked"
                         ToolTip="Line — click the page to place a horizontal line —"
                         AutomationProperties.Name="Line stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="—" FontSize="14"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Line"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Circle"
                         Checked="Tool_Checked"
                         ToolTip="Circle — click the page to place a circle ○"
                         AutomationProperties.Name="Circle stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="○" FontSize="14"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Circle"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── COMMENT ───────────────────────────────────────────────────── -->
            <TextBlock Text="COMMENT" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Highlight"
                         Checked="Tool_Checked"
                         ToolTip="Highlight Tool (I)"
                         AutomationProperties.Name="Highlight tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE7C1;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Highlight"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Stamp"
                         Checked="Tool_Checked"
                         ToolTip="Stamp Tool — place a text stamp on the page (M)"
                         AutomationProperties.Name="Stamp tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Stamp"/>
                </StackPanel>
            </RadioButton>

            <Separator Style="{StaticResource ToolSep}"/>

            <!-- ── MY SIGNATURES ─────────────────────────────────────────────── -->
            <TextBlock Text="MY SIGNATURES" Style="{StaticResource SecHdr}"/>

            <Button x:Name="AddSigBtn"
                    Height="32"
                    Margin="8,3,8,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    ToolTip="Save a new signature to your library"
                    Click="AddSig_Click"
                    Focusable="False"
                    Cursor="Hand"
                    AutomationProperties.Name="Add signature to library"
                    Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                               Width="16" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Add Signature" FontSize="12" VerticalAlignment="Center"
                               Margin="6,0,0,0" Foreground="White"/>
                </StackPanel>
            </Button>

            <!-- Dynamic saved-signatures list (populated in code-behind) -->
            <StackPanel x:Name="SavedSigPanel" Margin="0,2"/>

            <!-- ── DRAW / ANNOTATE ────────────────────────────────────────────── -->
            <Separator Style="{StaticResource ToolSep}"/>
            <TextBlock Text="DRAW / ANNOTATE" Style="{StaticResource SecHdr}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DrawFreehand"
                         Checked="Tool_Checked"
                         ToolTip="Freehand — draw with a pen"
                         AutomationProperties.Name="Freehand draw tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEDC6;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Freehand"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DrawRectangle"
                         Checked="Tool_Checked"
                         ToolTip="Rectangle — drag to draw a rectangle annotation"
                         AutomationProperties.Name="Draw rectangle annotation">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE7C2;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Rectangle"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DrawEllipse"
                         Checked="Tool_Checked"
                         ToolTip="Ellipse — drag to draw an ellipse annotation"
                         AutomationProperties.Name="Draw ellipse annotation">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEA3A;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Ellipse"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DrawArrow"
                         Checked="Tool_Checked"
                         ToolTip="Arrow — drag to draw an arrow annotation"
                         AutomationProperties.Name="Draw arrow annotation">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEBD4;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Arrow"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="DrawCallout"
                         Checked="Tool_Checked"
                         ToolTip="Callout — drag a box then type callout text"
                         AutomationProperties.Name="Draw callout annotation">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE8F2;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Callout"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Eraser"
                         Checked="Tool_Checked"
                         ToolTip="Eraser — click or drag over annotations to erase them"
                         AutomationProperties.Name="Eraser tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xED60;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Eraser"/>
                </StackPanel>
            </RadioButton>

            <!-- ══ DESIGN (switches to Design canvas) ═══════════════════════════ -->
            <Border Margin="8,10,8,4" Height="1"
                    Background="{DynamicResource AccentBrush}" Opacity="0.5"/>
            <TextBlock Text="DESIGN CANVAS" Style="{StaticResource SecHdr}"
                       Foreground="{DynamicResource AccentBrush}"/>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Select"
                         Checked="DesignTool_Checked"
                         ToolTip="Select — move and resize design elements"
                         AutomationProperties.Name="Design select tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE8B0;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Select"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Text"
                         Checked="DesignTool_Checked"
                         ToolTip="Text — add a text element to the design canvas"
                         AutomationProperties.Name="Design text tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               Text="T" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Text"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Rectangle"
                         Checked="DesignTool_Checked"
                         ToolTip="Rectangle — draw a rectangle on the design canvas"
                         AutomationProperties.Name="Design rectangle tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE7C2;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Rect (Design)"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Ellipse"
                         Checked="DesignTool_Checked"
                         ToolTip="Ellipse — draw an ellipse on the design canvas"
                         AutomationProperties.Name="Design ellipse tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEA3A;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Ellipse (Design)"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Arrow"
                         Checked="DesignTool_Checked"
                         ToolTip="Arrow — draw an arrow on the design canvas"
                         AutomationProperties.Name="Design arrow tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEBD4;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Arrow (Design)"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Pen"
                         Checked="DesignTool_Checked"
                         ToolTip="Pen — draw freehand on the design canvas"
                         AutomationProperties.Name="Design pen tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEDC6;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Pen (Design)"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Tag="Image"
                         Checked="DesignTool_Checked"
                         ToolTip="Image — insert an image on the design canvas"
                         AutomationProperties.Name="Design image tool">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolIcon}"
                               FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" FontSize="15"/>
                    <TextBlock Style="{StaticResource ToolLabel}" Text="Image (Design)"/>
                </StackPanel>
            </RadioButton>

        </StackPanel>
    </ScrollViewer>
</UserControl>

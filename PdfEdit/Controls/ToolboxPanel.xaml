<UserControl x:Class="PdfEdit.Controls.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="52"
             Background="Transparent"
             AutomationProperties.Name="Fill and Sign floating toolbar">

    <UserControl.Resources>

        <!-- Floating icon-button (RadioButton) -->
        <Style x:Key="FToolBtn" TargetType="RadioButton">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating toggle button (for Grid / Snap-to-grid) -->
        <Style x:Key="FToggleBtn" TargetType="ToggleButton">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating plain button (for Sign + Annotation popup triggers) -->
        <Style x:Key="FBtn" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Margin"          Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon glyph in Segoe MDL2 -->
        <Style x:Key="Ico" TargetType="TextBlock">
            <Setter Property="FontFamily"    Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"      Value="16"/>
            <Setter Property="Foreground"    Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- White icon variant (used inside selected blue button) -->
        <Style x:Key="IcoW" TargetType="TextBlock" BasedOn="{StaticResource Ico}">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Thin horizontal divider -->
        <Style x:Key="FDiv" TargetType="Separator">
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Margin"      Value="6,4"/>
            <Setter Property="Background"  Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <!-- Popup menu item -->
        <Style x:Key="PopupItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

    <!-- ── Page tools (shows these beside the rail: rotate, insert, delete, extract) ── -->
    <Border x:Name="PageToolsPill" VerticalAlignment="Top" Margin="0,8,6,0"
            Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="2,6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" Opacity="0.35" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <Button Style="{StaticResource FBtn}" Command="{Binding RotatePageCWCommand}" ToolTip="Rotate page clockwise" AutomationProperties.Name="Rotate page clockwise">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE7AD;"/>
            </Button>
            <Button Style="{StaticResource FBtn}" Command="{Binding InsertBlankPageCommand}" ToolTip="Insert a blank page after this one" AutomationProperties.Name="Insert a blank page after this one">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/>
            </Button>
            <Button Style="{StaticResource FBtn}" Command="{Binding DeleteCurrentPageCommand}" ToolTip="Delete this page" AutomationProperties.Name="Delete this page">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE74D;"/>
            </Button>
            <Button Style="{StaticResource FBtn}" Command="{Binding ExtractCurrentPageCommand}" ToolTip="Extract this page as a new PDF" AutomationProperties.Name="Extract this page as a new PDF">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEDE1;"/>
            </Button>
        </StackPanel>
    </Border>

    <!-- ── Floating pill container ─────────────────────────────────────────── -->
    <Border Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4,8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270"/>
        </Border.Effect>

        <!-- Grid (not StackPanel) so each section receives the available height: the sections are
             vertical WrapPanels that flow into a second column instead of being clipped off the top
             and bottom of the window (which hid the form-field components). -->
        <Grid>

            <!-- ══ PDF FILL & SIGN tools (visible in PDF mode) ════════════════
                 Complete & Sign rail: Select · Comment · Highlight · Draw · Add text · Sign
                 · colour · More (…). Everything else lives in the More popup; the Design
                 section below keeps the full canvas tool set. -->
            <WrapPanel Orientation="Vertical" x:Name="PdfToolsPanel">

            <!-- Grip (visual like other PDF editors' rail) -->
            <Border Width="28" Height="4" CornerRadius="2" Margin="6,2,6,6" HorizontalAlignment="Center"
                    Background="{DynamicResource AppBorderBrush}"/>

            <!-- Select: click = tool, corner arrow = its options (quick-tools rail) -->
            <Grid>
                <RadioButton x:Name="SelectBtn" Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="Select"
                             Checked="RailTool_Checked" ToolTip="Select — click fields or boxes to fill them, click placed text to edit  (V)"
                             AutomationProperties.Name="Select tool">
                    <TextBlock x:Name="SelectGlyph" Style="{StaticResource Ico}" Text="&#xE8B0;"/>
                </RadioButton>
                <Button Click="Corner_Click" Tag="SelectPopup" Width="12" Height="12" Padding="0" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"
                        ToolTip="More select tool options" AutomationProperties.Name="Select tool options">
                    <TextBlock Text="◢" FontSize="8" Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </Grid>
            <Popup x:Name="SelectPopup" PlacementTarget="{Binding ElementName=SelectBtn}" Placement="Left"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="{DynamicResource PopupAnim}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,8" MinWidth="190">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource PopupItem}" Tag="Select" Click="SubTool_Click" AutomationProperties.Name="Select">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Select" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Hand" Click="SubTool_Click" AutomationProperties.Name="Hand — pan the page  (H)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Hand — pan the page  (H)" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Zoom" Click="SubTool_Click" AutomationProperties.Name="Marquee zoom  (Z)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Marquee zoom  (Z)" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Comment: click = tool, corner arrow = its options (quick-tools rail) -->
            <Grid>
                <RadioButton x:Name="CommentBtn" Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="StickyNote"
                             Checked="RailTool_Checked" ToolTip="Add comment — click to place a sticky note"
                             AutomationProperties.Name="Comment tool">
                    <TextBlock x:Name="CommentGlyph" Style="{StaticResource Ico}" Text="&#xE90A;"/>
                </RadioButton>
                <Button Click="Corner_Click" Tag="CommentPopup" Width="12" Height="12" Padding="0" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"
                        ToolTip="More comment tool options" AutomationProperties.Name="Comment tool options">
                    <TextBlock Text="◢" FontSize="8" Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </Grid>
            <Popup x:Name="CommentPopup" PlacementTarget="{Binding ElementName=CommentBtn}" Placement="Left"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="{DynamicResource PopupAnim}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,8" MinWidth="190">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource PopupItem}" Tag="StickyNote" Click="SubTool_Click" AutomationProperties.Name="Sticky note">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Sticky note" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawCallout" Click="SubTool_Click" AutomationProperties.Name="Text callout">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Text callout" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="InsertText" Click="SubTool_Click" AutomationProperties.Name="Insert text">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Insert text" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="ReplaceText" Click="SubTool_Click" AutomationProperties.Name="Replace text">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Replace text" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Separator Style="{StaticResource FDiv}" Margin="0,4"/>
                        <Button Style="{StaticResource PopupItem}" Tag="Stamp" Click="SubTool_Click" AutomationProperties.Name="Stamp  (M)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Stamp  (M)" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedStamp, StringFormat=' · {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource DimForegroundBrush}" MaxWidth="140" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Click="ManageStamps_Click" AutomationProperties.Name="Choose or create stamps">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Choose or create stamps…" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Separator Style="{StaticResource FDiv}" Margin="0,4"/>
                        <Button Style="{StaticResource PopupItem}" Click="ShowComments_Click" AutomationProperties.Name="Show comments list">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Comments list…" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Highlight: click = tool, corner arrow = its options (quick-tools rail) -->
            <Grid>
                <RadioButton x:Name="HighlightBtn" Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="Highlight"
                             Checked="RailTool_Checked" ToolTip="Highlight text — drag over text  (I)"
                             AutomationProperties.Name="Highlight tool">
                    <TextBlock x:Name="HighlightGlyph" Style="{StaticResource Ico}" Text="&#xE7C1;" FontSize="15"/>
                </RadioButton>
                <Button Click="Corner_Click" Tag="HighlightPopup" Width="12" Height="12" Padding="0" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"
                        ToolTip="More highlight tool options" AutomationProperties.Name="Highlight tool options">
                    <TextBlock Text="◢" FontSize="8" Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </Grid>
            <Popup x:Name="HighlightPopup" PlacementTarget="{Binding ElementName=HighlightBtn}" Placement="Left"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="{DynamicResource PopupAnim}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,8" MinWidth="190">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource PopupItem}" Tag="Highlight" Click="SubTool_Click" AutomationProperties.Name="Highlight text">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Highlight text" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Underline" Click="SubTool_Click" AutomationProperties.Name="Underline text">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Underline text" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Squiggly" Click="SubTool_Click" AutomationProperties.Name="Squiggly underline">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#x223F;" FontSize="16" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Squiggly underline" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Strikethrough" Click="SubTool_Click" AutomationProperties.Name="Strikethrough text">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE0;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Strikethrough text" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Separator Style="{StaticResource FDiv}" Margin="0,4"/>
                        <TextBlock Text="Highlight colour" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" Margin="10,2,0,4"/>
                        <WrapPanel Margin="8,0,8,4" MaxWidth="180"><Button Tag="#80FFFF00" Click="HlColor_Click" Width="22" Height="22" Margin="2" ToolTip="Yellow" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#FFFF00"/><Button Tag="#80FF69B4" Click="HlColor_Click" Width="22" Height="22" Margin="2" ToolTip="Pink" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#FF69B4"/><Button Tag="#8090EE90" Click="HlColor_Click" Width="22" Height="22" Margin="2" ToolTip="Green" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#90EE90"/><Button Tag="#8087CEEB" Click="HlColor_Click" Width="22" Height="22" Margin="2" ToolTip="Blue" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#87CEEB"/><Button Tag="#80FFA500" Click="HlColor_Click" Width="22" Height="22" Margin="2" ToolTip="Orange" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="#FFA500"/></WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Draw: click = tool, corner arrow = its options (quick-tools rail) -->
            <Grid>
                <RadioButton x:Name="DrawBtn" Style="{StaticResource FToolBtn}" GroupName="FloatTools" Tag="DrawFreehand"
                             Checked="RailTool_Checked" ToolTip="Draw — freehand pen  (W)"
                             AutomationProperties.Name="Draw tool">
                    <TextBlock x:Name="DrawGlyph" Style="{StaticResource Ico}" Text="&#xEDC6;"/>
                </RadioButton>
                <Button Click="Corner_Click" Tag="DrawPopup" Width="12" Height="12" Padding="0" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3"
                        ToolTip="More draw tool options" AutomationProperties.Name="Draw tool options">
                    <TextBlock Text="◢" FontSize="8" Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </Grid>
            <Popup x:Name="DrawPopup" PlacementTarget="{Binding ElementName=DrawBtn}" Placement="Left"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="{DynamicResource PopupAnim}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,8" MinWidth="190">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawFreehand" Click="SubTool_Click" AutomationProperties.Name="Draw freehand">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDC6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Draw freehand" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawRectangle" Click="SubTool_Click" AutomationProperties.Name="Rectangle">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Rectangle" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawEllipse" Click="SubTool_Click" AutomationProperties.Name="Ellipse">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA3A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Ellipse" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawArrow" Click="SubTool_Click" AutomationProperties.Name="Arrow">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEBD4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Arrow" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawLine" Click="SubTool_Click" AutomationProperties.Name="Line">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Line" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawCloud" Click="SubTool_Click" AutomationProperties.Name="Cloud">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Cloud" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawPolygon" Click="SubTool_Click" AutomationProperties.Name="Polygon (click points, double-click to close)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Polygon (click points, double-click to close)" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="DrawPolyline" Click="SubTool_Click" AutomationProperties.Name="Polyline (click points, double-click to end)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Polyline (click points, double-click to end)" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PopupItem}" Tag="Eraser" Click="SubTool_Click" AutomationProperties.Name="Eraser">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED60;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/><TextBlock Text="Eraser" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Separator Style="{StaticResource FDiv}" Margin="0,4"/>
                        <TextBlock Text="Colour" FontSize="11" Foreground="{DynamicResource DimForegroundBrush}" Margin="10,2,0,4"/>

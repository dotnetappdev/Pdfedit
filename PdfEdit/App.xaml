<Application x:Class="PdfEdit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:PdfEdit.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Generic.xaml"/>
                <!-- Active theme (Dark by default; swapped at runtime by App.xaml.cs) -->
                <ResourceDictionary x:Name="ThemeDictionary"
                                    Source="Themes/DarkTheme.xaml"/>
                <!-- Styles that reference theme tokens via DynamicResource -->
                <ResourceDictionary Source="Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters, registered application-wide so any control
                 (including stand-alone UserControls) can resolve them. -->
            <conv:ZeroToOneConverter x:Key="ZeroToOneConverter"/>
            <conv:ZoomPercentConverter x:Key="ZoomPercentConverter"/>
            <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
            <conv:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter"/>
            <conv:BoolToTextDecorationConverter x:Key="BoolToTextDecoration"/>
            <conv:PercentConverter x:Key="PercentConverter"/>
            <conv:OpacityPercentConverter x:Key="OpacityPercentConverter"/>
            <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibilityConverter"/>
            <conv:DoubleToLeftMarginConverter x:Key="DoubleToLeftMarginConverter"/>
            <conv:DoubleToRightMarginConverter x:Key="DoubleToRightMarginConverter"/>
            <conv:BoolToTextWrapConverter x:Key="BoolToTextWrapConverter"/>

            <!-- Per-area interface font sizes (defaults; overridden live by FontService
                 from the user's settings). Controls bind via DynamicResource. -->
            <sys:Double x:Key="RibbonFontSize">13</sys:Double>
            <sys:Double x:Key="PanelFontSize">13</sys:Double>
            <sys:Double x:Key="ChatFontSize">13</sys:Double>
            <sys:Double x:Key="StatusBarFontSize">12</sys:Double>
            <sys:Double x:Key="DialogFontSize">13</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>

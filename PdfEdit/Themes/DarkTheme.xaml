<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── Dark Theme — Modern Acrobat-grade palette ──────────────────────── -->
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentHoverColor">#409CFF</Color>
    <Color x:Key="AccentMutedColor">#1A3A5C</Color>
    <Color x:Key="AppBgColor">#121212</Color>
    <Color x:Key="PanelBgColor">#1D1D1D</Color>
    <Color x:Key="SidebarBgColor">#252525</Color>
    <Color x:Key="ContentBgColor">#3C3C3C</Color>
    <Color x:Key="StatusBarBgColor">#0D0D0D</Color>
    <Color x:Key="ForegroundColor">#E8E8E8</Color>
    <Color x:Key="DimForegroundColor">#808080</Color>
    <Color x:Key="AppBorderColor">#2C2C2C</Color>
    <Color x:Key="InputBgColor">#2A2A2A</Color>
    <Color x:Key="InputForegroundColor">#E8E8E8</Color>
    <Color x:Key="InputBorderColor">#3E3E3E</Color>
    <Color x:Key="ToastBgColor">#2D2D2D</Color>
    <Color x:Key="ToastForegroundColor">#E8E8E8</Color>
    <Color x:Key="SearchBgColor">#2A2A2A</Color>
    <Color x:Key="HoverBgColor">#303030</Color>
    <Color x:Key="ActiveBgColor">#1E2D3D</Color>

    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush"      Color="{StaticResource AccentMutedColor}"/>
    <SolidColorBrush x:Key="AppBgBrush"            Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush"          Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush"        Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="ContentBgBrush"        Color="{StaticResource ContentBgColor}"/>
    <SolidColorBrush x:Key="StatusBarBgBrush"      Color="{StaticResource StatusBarBgColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush"       Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="DimForegroundBrush"    Color="{StaticResource DimForegroundColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush"        Color="{StaticResource AppBorderColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"          Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputForegroundBrush"  Color="{StaticResource InputForegroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"      Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ToastBgBrush"          Color="{StaticResource ToastBgColor}"/>
    <SolidColorBrush x:Key="ToastForegroundBrush"  Color="{StaticResource ToastForegroundColor}"/>
    <SolidColorBrush x:Key="SearchBgBrush"         Color="{StaticResource SearchBgColor}"/>
    <SolidColorBrush x:Key="HoverBgBrush"          Color="{StaticResource HoverBgColor}"/>
    <SolidColorBrush x:Key="ActiveBgBrush"         Color="{StaticResource ActiveBgColor}"/>

    <!-- Font scale tokens -->
    <sys:Double x:Key="PanelFontSize">12</sys:Double>
    <sys:Double x:Key="RibbonFontSize">12</sys:Double>
    <sys:Double x:Key="StatusBarFontSize">11</sys:Double>

</ResourceDictionary>

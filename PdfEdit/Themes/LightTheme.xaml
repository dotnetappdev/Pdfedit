<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Color Tokens -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#106EBE</Color>
    <Color x:Key="AppBgColor">#F3F3F3</Color>
    <Color x:Key="PanelBgColor">#F3F3F3</Color>
    <Color x:Key="SidebarBgColor">#EBEBEB</Color>
    <Color x:Key="ContentBgColor">#DCDCDC</Color>
    <Color x:Key="StatusBarBgColor">#0078D4</Color>
    <Color x:Key="ForegroundColor">#1E1E1E</Color>
    <Color x:Key="DimForegroundColor">#666666</Color>
    <Color x:Key="AppBorderColor">#C8C8C8</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputForegroundColor">#1E1E1E</Color>
    <Color x:Key="InputBorderColor">#A0A0A0</Color>
    <Color x:Key="ToastBgColor">#323232</Color>
    <Color x:Key="ToastForegroundColor">#FFFFFF</Color>
    <Color x:Key="SearchBgColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}"/>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="{StaticResource StatusBarBgColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="DimForegroundBrush" Color="{StaticResource DimForegroundColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="{StaticResource InputForegroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ToastBgBrush" Color="{StaticResource ToastBgColor}"/>
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="{StaticResource ToastForegroundColor}"/>
    <SolidColorBrush x:Key="SearchBgBrush" Color="{StaticResource SearchBgColor}"/>

</ResourceDictionary>

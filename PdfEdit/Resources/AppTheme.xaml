<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Color Palette ──────────────────────────────────────────────────── -->
    <Color x:Key="AccentColor">#0E639C</Color>
    <Color x:Key="AccentHoverColor">#1177BB</Color>
    <Color x:Key="PanelBgColor">#1E1E1E</Color>
    <Color x:Key="SidebarBgColor">#252526</Color>
    <Color x:Key="StatusBarBgColor">#007ACC</Color>
    <Color x:Key="ForegroundColor">#CCCCCC</Color>
    <Color x:Key="DimForegroundColor">#888888</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="{StaticResource StatusBarBgColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="DimForegroundBrush" Color="{StaticResource DimForegroundColor}"/>

    <!-- ── Window / App ───────────────────────────────────────────────────── -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
    </Style>

    <!-- ── TextBlock ─────────────────────────────────────────────────────── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ── Properties panel section header ──────────────────────────────── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource DimForegroundBrush}"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <!-- ── Label ─────────────────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ── StatusBar ─────────────────────────────────────────────────────── -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource StatusBarBgBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ── Scrollbar ─────────────────────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#2D2D2D"/>
    </Style>

    <!-- ── GridSplitter ──────────────────────────────────────────────────── -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="#3E3E3E"/>
        <Setter Property="Width" Value="4"/>
    </Style>

    <!-- ── Properties panel TextBox ──────────────────────────────────────── -->
    <Style x:Key="PropTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#3C3C3C"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ── Tab strip in properties panel ─────────────────────────────────── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SidebarBgBrush}"/>
        <Setter Property="BorderBrush" Value="#3E3E3E"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>

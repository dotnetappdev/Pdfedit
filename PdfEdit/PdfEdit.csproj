<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PdfEdit</RootNamespace>
    <AssemblyName>PdfEdit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Company>PdfEdit</Company>
    <Product>PdfEdit — PDF Form Filler</Product>
    <Description>A modern WPF PDF form filler and annotator.</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.0" />
    <PackageReference Include="itext7" Version="8.0.4" />
    <PackageReference Include="Fluent.Ribbon" Version="10.0.3" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="8.0.4" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <!-- TWAIN scanning (MIT) — talks to any TWAIN scanner driver via the TWAIN DSM -->
    <PackageReference Include="NTwain" Version="3.7.6" />
    <!-- Tesseract OCR (Apache-2.0): OCR without a Windows OCR language pack -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's logic (PDF, forms, AI, cloud, settings), shared with any other front end -->
    <ProjectReference Include="..\PdfEdit.Core\PdfEdit.Core.csproj" />
    <!-- Page rendering (UI-free engines) and its WPF drawing backend -->
    <ProjectReference Include="..\PdfEdit.Render\PdfEdit.Render.csproj" />
    <ProjectReference Include="..\PdfEdit.Drawing.Wpf\PdfEdit.Drawing.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- English OCR data (tessdata_fast, Apache-2.0) shipped with the app; more languages download on demand -->
    <None Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon (also the title bar / taskbar icon of every window); MSIX tiles are copied by installer\build-msix.ps1 -->
    <Resource Include="Resources\app.ico" />
    <None Update="Resources\*.png" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>

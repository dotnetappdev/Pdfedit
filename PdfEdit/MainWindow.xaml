<Fluent:RibbonWindow x:Class="PdfEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:controls="clr-namespace:PdfEdit.Controls"
        xmlns:vm="clr-namespace:PdfEdit.ViewModels"
        xmlns:models="clr-namespace:PdfEdit.Models"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        mc:Ignorable="d"
        Title="PdfEdit — PDF Form Filler"
        Height="780" Width="1280"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        AllowDrop="True"
        AutomationProperties.Name="PdfEdit PDF Form Filler">

    <Fluent:RibbonWindow.DataContext>
        <vm:MainViewModel/>
    </Fluent:RibbonWindow.DataContext>

    <!-- ── Keyboard shortcuts ──────────────────────────────────────────────── -->
    <Fluent:RibbonWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextPageCommand}"/>
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding PreviousPageCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomFitCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control" Command="{Binding RotatePageCWCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control" Command="{Binding RotatePageCCWCommand}"/>
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding ToggleSearchCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control+Shift" Command="{Binding IncreaseUiScaleCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control+Shift" Command="{Binding DecreaseUiScaleCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}"/>
        <KeyBinding Key="D" Command="{Binding SetToolCommand}" CommandParameter="DateStamp"/>
        <KeyBinding Key="S" Command="{Binding SetToolCommand}" CommandParameter="Signature"/>
        <KeyBinding Key="K" Command="{Binding SetToolCommand}" CommandParameter="Checkmark"/>
        <KeyBinding Key="H" Command="{Binding SetToolCommand}" CommandParameter="Hand"/>
        <KeyBinding Key="V" Command="{Binding SetToolCommand}" CommandParameter="Select"/>
        <KeyBinding Key="T" Command="{Binding SetToolCommand}" CommandParameter="AddText"/>
        <KeyBinding Key="Z" Command="{Binding SetToolCommand}" CommandParameter="Zoom"/>
        <KeyBinding Key="M" Command="{Binding SetToolCommand}" CommandParameter="Stamp"/>
    </Fluent:RibbonWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Ribbon -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             RIBBON TOOLBAR
             ════════════════════════════════════════════════════════════════ -->
        <Fluent:Ribbon Grid.Row="0" x:Name="MainRibbon"
                       FontSize="{DynamicResource RibbonFontSize}"
                       AutomationProperties.Name="Main ribbon toolbar">

            <!-- Application Menu (File menu) -->
            <Fluent:Ribbon.Menu>
                <Fluent:ApplicationMenu KeyTip="F"
                                        AutomationProperties.Name="File menu">

                    <Fluent:MenuItem Header="Open…"
                                                KeyTip="O"
                                                Command="{Binding OpenCommand}"
                                                AutomationProperties.Name="Open PDF file"/>

                    <Fluent:MenuItem Header="Save"
                                                KeyTip="S"
                                                Command="{Binding SaveCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Save PDF"/>

                    <Fluent:MenuItem Header="Save As…"
                                                KeyTip="A"
                                                Command="{Binding SaveAsCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Save as new file"/>

                    <Fluent:MenuItem Header="Flatten &amp; Save…"
                                                KeyTip="L"
                                                Command="{Binding FlattenAndSaveCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Flatten and save PDF"/>

                    <Separator/>

                    <Fluent:MenuItem Header="Print…"
                                                KeyTip="P"
                                                Command="{Binding PrintCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Print document"/>

                    <Separator/>

                    <Fluent:MenuItem Header="Close"
                                                KeyTip="C"
                                                Command="{Binding CloseCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Close document"/>

                    <Fluent:MenuItem Header="Document Properties…"
                                                KeyTip="R"
                                                Command="{Binding DocumentPropertiesCommand}"
                                                IsEnabled="{Binding HasDocument}"
                                                AutomationProperties.Name="Document properties metadata"/>

                    <Separator/>

                    <Fluent:MenuItem Header="Keyboard Shortcuts (F1)"
                                                KeyTip="K"
                                                Command="{Binding ShowShortcutsCommand}"
                                                AutomationProperties.Name="Keyboard shortcuts reference"/>
                    <Fluent:MenuItem Header="About PdfEdit…"
                                                KeyTip="B"
                                                Command="{Binding ShowAboutCommand}"
                                                AutomationProperties.Name="About PdfEdit"/>

                    <Fluent:ApplicationMenu.RightPaneContent>
                        <StackPanel Margin="4,8" Width="230">
                            <TextBlock Text="RECENT FILES"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="280"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentFileEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RecentFileEntry}">
                                            <Button Command="{Binding DataContext.OpenRecentCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    HorizontalContentAlignment="Left"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,5" Margin="0,1"
                                                    ToolTip="{Binding FullPath}"
                                                    AutomationProperties.Name="{Binding FileName}">
                                                <StackPanel MaxWidth="210">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Directory}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource AppMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="No recent files" FontSize="11"
                                       Foreground="{DynamicResource AppMutedBrush}"
                                       Margin="8,4"
                                       Visibility="{Binding HasNoRecentFiles,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Separator Margin="0,8"/>
                            <Button Content="⚙ Settings"
                                    Command="{Binding OpenSettingsCommand}"
                                    Padding="10,6"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Open application settings"/>
                            <Button Content="🔍 Global Search"
                                    Command="{Binding ToggleSearchCommand}"
                                    Padding="10,6"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Open global search"/>
                        </StackPanel>
                    </Fluent:ApplicationMenu.RightPaneContent>

                </Fluent:ApplicationMenu>
            </Fluent:Ribbon.Menu>

            <!-- Quick Access Toolbar -->
            <Fluent:Ribbon.QuickAccessItems>
                <Fluent:QuickAccessMenuItem Command="{Binding OpenCommand}"
                                             ToolTip="Open (Ctrl+O)"
                                             AutomationProperties.Name="Open file"/>
                <Fluent:QuickAccessMenuItem Command="{Binding SaveCommand}"
                                             ToolTip="Save (Ctrl+S)"
                                             AutomationProperties.Name="Save"/>
            </Fluent:Ribbon.QuickAccessItems>

            <!-- ── HOME TAB ────────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="Home"
                                   AutomationProperties.Name="Home tab">

                <!-- File group -->
                <Fluent:RibbonGroupBox Header="File"
                                        AutomationProperties.Name="File operations group">
                    <Fluent:Button Header="Open"
                                   Command="{Binding OpenCommand}"
                                   KeyTip="O"
                                   ToolTip="Open a PDF file (Ctrl+O)"
                                   AutomationProperties.Name="Open PDF"
                                   AutomationProperties.HelpText="Opens a file picker to select a PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>

                    <Fluent:Button Header="Save"
                                   Command="{Binding SaveCommand}"
                                   KeyTip="S"
                                   ToolTip="Save filled PDF (Ctrl+S)"
                                   IsEnabled="{Binding HasDocument}"
                                   AutomationProperties.Name="Save PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>

                    <Fluent:Button Header="Save As"
                                   Command="{Binding SaveAsCommand}"
                                   KeyTip="A"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save as a new file (Ctrl+Shift+S)"
                                   AutomationProperties.Name="Save as new file">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <Fluent:Button Header="Print"
                                   Command="{Binding PrintCommand}"
                                   KeyTip="P"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Print document (Ctrl+P)"
                                   AutomationProperties.Name="Print document">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <Fluent:Button Header="Close"
                                   Command="{Binding CloseCommand}"
                                   KeyTip="W"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Close the current document (Ctrl+W)"
                                   AutomationProperties.Name="Close document">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <Fluent:Button Header="Settings"
                                   Command="{Binding OpenSettingsCommand}"
                                   KeyTip="E"
                                   Size="Middle"
                                   ToolTip="Open settings and preferences"
                                   AutomationProperties.Name="Open settings">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Clipboard group -->
                <Fluent:RibbonGroupBox Header="Clipboard"
                                        AutomationProperties.Name="Clipboard group">

                    <!-- Paste — large button like Word -->
                    <Fluent:Button Header="Paste"
                                   Command="ApplicationCommands.Paste"
                                   KeyTip="V"
                                   ToolTip="Paste from clipboard (Ctrl+V)"
                                   AutomationProperties.Name="Paste from clipboard">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="20" Height="20">
                                    <!-- Clipboard board -->
                                    <Path Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.3" Fill="Transparent"
                                          Data="M 3,5.5 L 3,18.5 L 17,18.5 L 17,5.5 Z"/>
                                    <!-- Clip bar at top -->
                                    <Path Fill="{DynamicResource ForegroundBrush}"
                                          Data="M 6.5,3.5 L 6.5,7.5 L 13.5,7.5 L 13.5,3.5 Z M 7.5,4.5 L 7.5,6.5 L 12.5,6.5 L 12.5,4.5 Z"
                                          FillRule="EvenOdd"/>
                                    <!-- Clip notch circle -->
                                    <Path Fill="{DynamicResource ForegroundBrush}"
                                          Data="M 9,1.5 A 1,1 0 1 0 11,1.5 A 1,1 0 1 0 9,1.5 Z"/>
                                    <!-- Lines on clipboard page -->
                                    <Path Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.1" Fill="Transparent"
                                          Data="M 5.5,10 L 14.5,10 M 5.5,12.5 L 14.5,12.5 M 5.5,15 L 11,15"/>
                                </Canvas>
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>

                    <!-- Cut — middle size -->
                    <Fluent:Button Header="Cut"
                                   Command="ApplicationCommands.Cut"
                                   KeyTip="X"
                                   Size="Middle"
                                   ToolTip="Cut to clipboard (Ctrl+X)"
                                   AutomationProperties.Name="Cut to clipboard">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="20" Height="20">
                                    <!-- Handle rings -->
                                    <Path Fill="{DynamicResource ForegroundBrush}" FillRule="EvenOdd"
                                          Data="M 1.5,4.5 A 3,3 0 1 0 7.5,4.5 A 3,3 0 1 0 1.5,4.5 Z M 3,4.5 A 1.5,1.5 0 1 1 6,4.5 A 1.5,1.5 0 1 1 3,4.5 Z M 1.5,15.5 A 3,3 0 1 0 7.5,15.5 A 3,3 0 1 0 1.5,15.5 Z M 3,15.5 A 1.5,1.5 0 1 1 6,15.5 A 1.5,1.5 0 1 1 3,15.5 Z"/>
                                    <!-- Blades converging to right -->
                                    <Path Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                          Data="M 6.5,5.5 L 19,10 L 6.5,14.5"/>
                                </Canvas>
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <!-- Copy — middle size -->
                    <Fluent:Button Header="Copy"
                                   Command="ApplicationCommands.Copy"
                                   KeyTip="C"
                                   Size="Middle"
                                   ToolTip="Copy to clipboard (Ctrl+C)"
                                   AutomationProperties.Name="Copy to clipboard">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="20" Height="20">
                                    <!-- Back page -->
                                    <Path Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                          Fill="Transparent"
                                          Data="M 2.5,5 L 2.5,18 L 13.5,18 L 13.5,5 Z"/>
                                    <!-- Front page (offset) -->
                                    <Path Fill="{DynamicResource AppBgBrush}"
                                          Data="M 6,1.5 L 6,14.5 L 17.5,14.5 L 17.5,1.5 Z"/>
                                    <Path Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.4"
                                          Fill="Transparent"
                                          Data="M 6,1.5 L 6,14.5 L 17.5,14.5 L 17.5,1.5 Z M 8,1.5 L 8,4 L 15.5,4"/>
                                </Canvas>
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Navigation group -->
                <Fluent:RibbonGroupBox Header="Navigation"
                                        AutomationProperties.Name="Page navigation group">
                    <Fluent:Button Header="First"
                                   Command="{Binding FirstPageCommand}"
                                   Size="Middle"
                                   KeyTip="F"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Go to first page"
                                   AutomationProperties.Name="Go to first page">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Previous"
                                   Command="{Binding PreviousPageCommand}"
                                   Size="Middle"
                                   KeyTip="R"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Previous page (Ctrl+Left)"
                                   AutomationProperties.Name="Previous page">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Next"
                                   Command="{Binding NextPageCommand}"
                                   Size="Middle"
                                   KeyTip="N"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Next page (Ctrl+Right)"
                                   AutomationProperties.Name="Next page">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Last"
                                   Command="{Binding LastPageCommand}"
                                   Size="Middle"
                                   KeyTip="L"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Go to last page"
                                   AutomationProperties.Name="Go to last page">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <Fluent:Spinner Header="Page"
                                    Value="{Binding CurrentPageIndex, Converter={StaticResource ZeroToOneConverter}, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="{Binding PageCount}"
                                    Format="0"
                                    IsEnabled="{Binding HasDocument}"
                                    Width="60"
                                    AutomationProperties.Name="Current page number"
                                    AutomationProperties.HelpText="Enter a page number to navigate to"/>
                </Fluent:RibbonGroupBox>

                <!-- Search group -->
                <Fluent:RibbonGroupBox Header="Search"
                                        AutomationProperties.Name="Search group">
                    <Fluent:Button Header="Search"
                                   Command="{Binding ToggleSearchCommand}"
                                   KeyTip="G"
                                   ToolTip="Global search — search all fields and annotations (Ctrl+Shift+F)"
                                   AutomationProperties.Name="Open global search"
                                   AutomationProperties.HelpText="Search all form fields and annotations">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Pages group -->
                <Fluent:RibbonGroupBox Header="Pages"
                                        AutomationProperties.Name="Page operations group">
                    <Fluent:Button Header="Delete Page"
                                   Command="{Binding DeleteCurrentPageCommand}"
                                   Size="Middle"
                                   KeyTip="DP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Delete the current page from the document"
                                   AutomationProperties.Name="Delete current page">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Insert Before"
                                   Command="{Binding InsertPageBeforeCommand}"
                                   Size="Middle"
                                   KeyTip="IB2"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Insert a blank page before the current page"
                                   AutomationProperties.Name="Insert blank page before">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Insert After"
                                   Command="{Binding InsertBlankPageCommand}"
                                   Size="Middle"
                                   KeyTip="IB"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Insert a blank page after the current page"
                                   AutomationProperties.Name="Insert blank page after">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Move Up"
                                   Command="{Binding MovePageUpCommand}"
                                   Size="Middle"
                                   KeyTip="MU"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Move this page one position earlier in the document"
                                   AutomationProperties.Name="Move page up">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Move Down"
                                   Command="{Binding MovePageDownCommand}"
                                   Size="Middle"
                                   KeyTip="MD"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Move this page one position later in the document"
                                   AutomationProperties.Name="Move page down">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Extract Page"
                                   Command="{Binding ExtractCurrentPageCommand}"
                                   Size="Middle"
                                   KeyTip="XP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save the current page as a separate PDF"
                                   AutomationProperties.Name="Extract current page to PDF">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Split PDF"
                                   Command="{Binding SplitPdfCommand}"
                                   KeyTip="SP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Split every page into a separate PDF file"
                                   AutomationProperties.Name="Split PDF into separate pages">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Merge PDFs"
                                   Command="{Binding MergePdfCommand}"
                                   KeyTip="MP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Combine this PDF with other PDFs, appending them at the end"
                                   AutomationProperties.Name="Merge PDFs">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Insert PDF"
                                   Command="{Binding InsertPdfCommand}"
                                   KeyTip="IP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Insert another PDF at the beginning, before/after the current page, or at the end"
                                   AutomationProperties.Name="Insert PDF at position">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Thumbnails"
                                   Command="{Binding ToggleThumbnailsCommand}"
                                   Size="Middle"
                                   KeyTip="TH"
                                   ToolTip="Show/hide page thumbnails panel"
                                   AutomationProperties.Name="Toggle page thumbnails">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Watermark"
                                   Command="{Binding WatermarkCommand}"
                                   KeyTip="WM"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Add a diagonal text watermark (e.g. DRAFT, CONFIDENTIAL) to all pages"
                                   AutomationProperties.Name="Add watermark to PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8D3;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Page Numbers"
                                   Command="{Binding AddPageNumbersCommand}"
                                   KeyTip="PN"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Add 'Page N of M' footer to all pages and save as a new file"
                                   AutomationProperties.Name="Add page numbers footer">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE80C;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Compress"
                                   Command="{Binding CompressPdfCommand}"
                                   KeyTip="CZ"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Re-save with maximum compression to reduce file size"
                                   AutomationProperties.Name="Compress PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8B4;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Export&#x0a;as Images"
                                   Command="{Binding ExportPagesAsImagesCommand}"
                                   KeyTip="EI"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Export every page as a PNG image file into a chosen folder"
                                   AutomationProperties.Name="Export pages as PNG images">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Document group -->
                <Fluent:RibbonGroupBox Header="Document"
                                        AutomationProperties.Name="Document metadata group">
                    <Fluent:Button Header="Properties"
                                   Command="{Binding DocumentPropertiesCommand}"
                                   KeyTip="DP2"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Edit document metadata: title, author, subject, keywords"
                                   AutomationProperties.Name="Document properties">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Duplicate&#x0a;Page"
                                   Command="{Binding DuplicatePageCommand}"
                                   KeyTip="DUP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Duplicate the current page and insert the copy immediately after it"
                                   AutomationProperties.Name="Duplicate current page">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Header /&#x0a;Footer"
                                   Command="{Binding AddHeaderFooterCommand}"
                                   KeyTip="HF"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Add custom header and/or footer text to every page"
                                   AutomationProperties.Name="Add header and footer">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Bates&#x0a;Numbers"
                                   Command="{Binding BatesNumberCommand}"
                                   KeyTip="BN"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Add sequential Bates numbers (with prefix/suffix) to every page for legal document identification"
                                   AutomationProperties.Name="Add Bates numbers">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8D0;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Crop&#x0a;Pages"
                                   Command="{Binding CropPagesCommand}"
                                   KeyTip="CP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Trim page margins by setting crop box margins (in points) on all pages"
                                   AutomationProperties.Name="Crop pages">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Security group -->
                <Fluent:RibbonGroupBox Header="Security"
                                        AutomationProperties.Name="Security group">
                    <Fluent:Button Header="Password&#x0a;Protect"
                                   Command="{Binding PasswordProtectCommand}"
                                   KeyTip="PP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Encrypt the PDF with an open password and set permissions (printing, copying)"
                                   AutomationProperties.Name="Password protect PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Remove&#x0a;Password"
                                   Command="{Binding RemovePasswordCommand}"
                                   KeyTip="RP"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Remove encryption from a PDF (requires the PDF to already be open/unlocked)"
                                   AutomationProperties.Name="Remove PDF password">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── FILL & SIGN TAB (Adobe-style) ─────────────────────────── -->
            <Fluent:RibbonTabItem Header="Fill &amp; Sign"
                                   AutomationProperties.Name="Fill and Sign tab">

                <!-- Add content -->
                <Fluent:RibbonGroupBox Header="Add Content"
                                        AutomationProperties.Name="Add content group">
                    <Fluent:ToggleButton Header="Add Text"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddText, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="AddText"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Add Text — click anywhere on the page to type, then use the floating toolbar to resize, recolour or move it (Adobe Fill &amp; Sign style)"
                                         AutomationProperties.Name="Add text anywhere">
                        <Fluent:ToggleButton.LargeIcon>
                            <TextBlock Text="Ab" FontWeight="Bold" FontSize="18"/>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Date"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DateStamp, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="DateStamp"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Date — click the page to stamp today's date (D)"
                                         AutomationProperties.Name="Add date">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Marks (check / cross / dot / line / circle) -->
                <Fluent:RibbonGroupBox Header="Marks"
                                        AutomationProperties.Name="Marks group">
                    <Fluent:ToggleButton Header="Check" GroupName="ToolGroup" Size="Middle"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Checkmark, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}" CommandParameter="Checkmark"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Checkmark — click a checkbox or the page to place ✓ (K)"
                                         AutomationProperties.Name="Checkmark">
                        <Fluent:ToggleButton.Icon>
                            <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="13"/>
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Cross" GroupName="ToolGroup" Size="Middle"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=XMark, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}" CommandParameter="XMark"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Cross — click the page to place ✕"
                                         AutomationProperties.Name="Cross mark">
                        <Fluent:ToggleButton.Icon>
                            <TextBlock Text="✕" Foreground="#F44336" FontWeight="Bold" FontSize="13"/>
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Dot" GroupName="ToolGroup" Size="Middle"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Dot, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}" CommandParameter="Dot"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Dot — click the page to place a filled dot ●"
                                         AutomationProperties.Name="Dot mark">
                        <Fluent:ToggleButton.Icon>
                            <TextBlock Text="●" FontSize="13"/>
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Line" GroupName="ToolGroup" Size="Middle"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Line, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}" CommandParameter="Line"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Line — click the page to place a short line —"
                                         AutomationProperties.Name="Line mark">
                        <Fluent:ToggleButton.Icon>
                            <TextBlock Text="—" FontSize="13"/>
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Circle" GroupName="ToolGroup" Size="Middle"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Circle, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}" CommandParameter="Circle"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Circle — click the page to place a circle ○"
                                         AutomationProperties.Name="Circle mark">
                        <Fluent:ToggleButton.Icon>
                            <TextBlock Text="○" FontSize="13"/>
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Sign -->
                <Fluent:RibbonGroupBox Header="Sign"
                                        AutomationProperties.Name="Sign group">
                    <Fluent:ToggleButton Header="Sign"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Signature, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Signature"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Sign — click a signature field or the page to place your signature (S)"
                                         AutomationProperties.Name="Sign document">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Fields -->
                <Fluent:RibbonGroupBox Header="Fields"
                                        AutomationProperties.Name="Fields group">
                    <Fluent:ToggleButton Header="Highlight Fields"
                                         IsChecked="{Binding HighlightFields, Mode=TwoWay}"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Show a coloured highlight over all fillable form fields (Adobe 'Highlight Existing Fields')"
                                         AutomationProperties.Name="Highlight existing fields">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:Button Header="Clear All"
                                   Command="{Binding ClearAllFieldsCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Clear the values of all form fields"
                                   AutomationProperties.Name="Clear all fields">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Delete Field"
                                   Command="{Binding DeleteSelectedFieldCommand}"
                                   Size="Middle"
                                   ToolTip="Delete the selected form field (or right-click a field on the page)"
                                   AutomationProperties.Name="Delete selected field">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── EDIT TAB ──────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="Edit"
                                   AutomationProperties.Name="Edit tab">

                <Fluent:RibbonGroupBox Header="Clipboard"
                                        AutomationProperties.Name="Clipboard group">
                    <Fluent:Button Header="Cut"
                                   Command="{x:Static ApplicationCommands.Cut}"
                                   KeyTip="X"
                                   ToolTip="Cut (Ctrl+X)"
                                   AutomationProperties.Name="Cut selection">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Copy"
                                   Command="{x:Static ApplicationCommands.Copy}"
                                   KeyTip="C"
                                   ToolTip="Copy (Ctrl+C)"
                                   AutomationProperties.Name="Copy selection">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Paste"
                                   Command="{x:Static ApplicationCommands.Paste}"
                                   KeyTip="V"
                                   ToolTip="Paste (Ctrl+V)"
                                   AutomationProperties.Name="Paste from clipboard">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="History"
                                        AutomationProperties.Name="History group">
                    <Fluent:Button Header="Undo"
                                   Command="{x:Static ApplicationCommands.Undo}"
                                   KeyTip="Z"
                                   ToolTip="Undo (Ctrl+Z)"
                                   AutomationProperties.Name="Undo last action">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Redo"
                                   Command="{x:Static ApplicationCommands.Redo}"
                                   KeyTip="Y"
                                   ToolTip="Redo (Ctrl+Y)"
                                   AutomationProperties.Name="Redo last action">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Annotations"
                                        AutomationProperties.Name="Annotation editing group">
                    <Fluent:Button Header="Delete"
                                   Command="{Binding DeleteAnnotationCommand}"
                                   IsEnabled="{Binding SelectedAnnotation, Converter={StaticResource NullToBoolConverter}}"
                                   ToolTip="Delete selected annotation (Del)"
                                   AutomationProperties.Name="Delete selected annotation">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Clear All Fields"
                                   Command="{Binding ClearAllFieldsCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Clear all form field values"
                                   AutomationProperties.Name="Clear all form fields"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Form Data"
                                        AutomationProperties.Name="Form data group">
                    <Fluent:Button Header="Import Data"
                                   Command="{Binding ImportDataCommand}"
                                   KeyTip="I"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Import field values from TSV file"
                                   AutomationProperties.Name="Import form data from TSV">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Export Data"
                                   Command="{Binding ExportDataCommand}"
                                   KeyTip="E"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Export field values to TSV file"
                                   AutomationProperties.Name="Export form data to TSV">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Flatten &amp; Save"
                                   Command="{Binding FlattenAndSaveCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save PDF with fields baked in (non-editable)"
                                   AutomationProperties.Name="Flatten and save PDF">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Find & Replace + Validate group -->
                <Fluent:RibbonGroupBox Header="Tools"
                                        AutomationProperties.Name="Form field tools group">
                    <Fluent:Button Header="Find &amp; Replace"
                                   Command="{Binding FindReplaceFieldsCommand}"
                                   KeyTip="FR"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Find and replace text within form field values"
                                   AutomationProperties.Name="Find and replace in form fields">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Validate&#x0a;Required"
                                   Command="{Binding ValidateRequiredFieldsCommand}"
                                   KeyTip="VR"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Check that all required fields are filled in"
                                   AutomationProperties.Name="Validate required fields">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Archive (PDF/A)"
                                   Command="{Binding ExportPdfACommand}"
                                   KeyTip="PA"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save as PDF 1.4 with archival metadata (PDF/A-like)"
                                   AutomationProperties.Name="Save as PDF/A archival format">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Export Text"
                                   Command="{Binding ExportTextCommand}"
                                   KeyTip="ET"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Extract all text from the PDF and save to a .txt file"
                                   AutomationProperties.Name="Export PDF text to TXT file">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Form Field Creator group -->
                <Fluent:RibbonGroupBox Header="Add Form Field"
                                        AutomationProperties.Name="Add new form fields to PDF">
                    <Fluent:ToggleButton Header="Text Field"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddTextField, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="AddTextField"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Add Text Field — drag a rectangle on the page to add a new editable text form field"
                                         AutomationProperties.Name="Add text form field">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xF003;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Checkbox"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddCheckbox, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="AddCheckbox"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Add Checkbox — drag a square on the page to add a new checkbox form field"
                                         AutomationProperties.Name="Add checkbox form field">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Combo Box"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddComboBox, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="AddComboBox"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Add Combo Box — drag a rectangle on the page to add a new dropdown field"
                                         AutomationProperties.Name="Add combo box form field">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── VIEW TAB ──────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="View"
                                   AutomationProperties.Name="View tab">

                <Fluent:RibbonGroupBox Header="Zoom"
                                        AutomationProperties.Name="Zoom controls group">
                    <Fluent:Button Header="Zoom In"
                                   Command="{Binding ZoomInCommand}"
                                   KeyTip="I"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Zoom in (Ctrl++)"
                                   AutomationProperties.Name="Zoom in">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Zoom Out"
                                   Command="{Binding ZoomOutCommand}"
                                   KeyTip="O"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Zoom out (Ctrl+-)"
                                   AutomationProperties.Name="Zoom out">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Fit Page"
                                   Command="{Binding ZoomFitCommand}"
                                   KeyTip="F"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Fit page (Ctrl+0)"
                                   AutomationProperties.Name="Fit page to window">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="100%"
                                   Command="{Binding ZoomActualCommand}"
                                   KeyTip="A"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Actual size"
                                   AutomationProperties.Name="Zoom to 100 percent"/>
                    <Fluent:Spinner Header="Zoom %"
                                    Value="{Binding Zoom, Converter={StaticResource ZoomPercentConverter}, Mode=TwoWay}"
                                    Minimum="10"
                                    Maximum="500"
                                    Format="0"
                                    IsEnabled="{Binding HasDocument}"
                                    Width="70"
                                    AutomationProperties.Name="Zoom percentage"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Rotate Page"
                                        AutomationProperties.Name="Page rotation group">
                    <Fluent:Button Header="Rotate CW"
                                   Command="{Binding RotatePageCWCommand}"
                                   KeyTip="R"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Rotate current page 90° clockwise (Ctrl+])"
                                   AutomationProperties.Name="Rotate page clockwise"/>
                    <Fluent:Button Header="Rotate CCW"
                                   Command="{Binding RotatePageCCWCommand}"
                                   KeyTip="L"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Rotate current page 90° counter-clockwise (Ctrl+[)"
                                   AutomationProperties.Name="Rotate page counter-clockwise"/>
                    <Fluent:Button Header="Reset Rotation"
                                   Command="{Binding ResetPageRotationCommand}"
                                   KeyTip="T"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Reset session rotation for this page"
                                   AutomationProperties.Name="Reset page rotation"/>
                    <Fluent:Button Header="All Pages CW"
                                   Command="{Binding RotateAllPagesCWCommand}"
                                   KeyTip="AC"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Rotate every page 90° clockwise"
                                   AutomationProperties.Name="Rotate all pages clockwise"/>
                    <Fluent:Button Header="All Pages CCW"
                                   Command="{Binding RotateAllPagesCCWCommand}"
                                   KeyTip="AL"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Rotate every page 90° counter-clockwise"
                                   AutomationProperties.Name="Rotate all pages counter-clockwise"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Display"
                                        AutomationProperties.Name="Display options group">
                    <Fluent:ToggleButton Header="Highlight Fields"
                                         IsChecked="{Binding HighlightFields}"
                                         KeyTip="H"
                                         Size="Middle"
                                         ToolTip="Show/hide form field highlight overlay"
                                         AutomationProperties.Name="Toggle field highlight overlay"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="UI Scale"
                                        AutomationProperties.Name="Interface scale group">
                    <StackPanel Orientation="Vertical" Margin="4,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Fluent:Button Header="−" Size="Small"
                                           Command="{Binding DecreaseUiScaleCommand}"
                                           Width="28" Margin="0,0,4,0"
                                           ToolTip="Decrease UI scale (Ctrl+Shift+−)"
                                           AutomationProperties.Name="Decrease interface scale"/>
                            <Fluent:Button Header="+" Size="Small"
                                           Command="{Binding IncreaseUiScaleCommand}"
                                           Width="28"
                                           ToolTip="Increase UI scale (Ctrl+Shift+=)"
                                           AutomationProperties.Name="Increase interface scale"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UiScale, StringFormat='{}{0:P0}'}"
                                   FontSize="11" HorizontalAlignment="Center"
                                   AutomationProperties.Name="Current interface scale"/>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── TOOLS TAB ─────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="Tools"
                                   AutomationProperties.Name="Tools tab">

                <Fluent:RibbonGroupBox Header="Active Tool"
                                        AutomationProperties.Name="Active tool selection group">
                    <Fluent:ToggleButton Header="Hand"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Hand, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Hand"
                                         ToolTip="Hand / Pan tool (H)"
                                         AutomationProperties.Name="Hand pan tool"/>
                    <Fluent:ToggleButton Header="Select"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Select, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Select"
                                         ToolTip="Selection tool (V)"
                                         AutomationProperties.Name="Selection tool"/>
                    <Fluent:ToggleButton Header="Text Fill"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TextFill, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="TextFill"
                                         ToolTip="Text fill tool — click a form field to type in it (T)"
                                         AutomationProperties.Name="Text fill tool"/>
                    <Fluent:ToggleButton Header="Zoom"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Zoom, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Zoom"
                                         ToolTip="Zoom tool — click to zoom in (Z)"
                                         AutomationProperties.Name="Zoom tool"/>
                    <Fluent:ToggleButton Header="Highlight"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Highlight, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Highlight"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Highlight — drag to draw yellow highlight (I)"
                                         AutomationProperties.Name="Highlight tool"/>
                    <Fluent:ToggleButton Header="Underline"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Underline, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Underline"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Underline — drag to draw underline annotation"
                                         AutomationProperties.Name="Underline annotation tool"/>
                    <Fluent:ToggleButton Header="Strikethrough"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Strikethrough, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Strikethrough"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Strikethrough — drag to draw strikethrough annotation"
                                         AutomationProperties.Name="Strikethrough annotation tool"/>
                    <Fluent:ToggleButton Header="Redact"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Redact, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Redact"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Redact — drag to mark sensitive areas for permanent removal"
                                         AutomationProperties.Name="Redaction tool">
                        <Fluent:ToggleButton.Header>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="10" Fill="#CC1A1A" Margin="0,0,4,0"/>
                                <TextBlock Text="Redact"/>
                            </StackPanel>
                        </Fluent:ToggleButton.Header>
                    </Fluent:ToggleButton>
                    <Fluent:Button Header="Apply&#x0a;Redactions"
                                   Command="{Binding ApplyRedactionsCommand}"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Permanently burn all redaction boxes into the PDF (irreversible)"
                                   AutomationProperties.Name="Apply redactions">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32">
                                <StackPanel>
                                    <Rectangle Width="24" Height="16" Fill="#CC1A1A"/>
                                    <TextBlock Text="APPLY" FontSize="7" Foreground="White" HorizontalAlignment="Center" Margin="0,-14,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Drawing tools group -->
                <Fluent:RibbonGroupBox Header="Drawing"
                                        AutomationProperties.Name="Drawing tools group">
                    <Fluent:ToggleButton Header="Freehand"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DrawFreehand, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="DrawFreehand"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Freehand Draw — drag to draw ink strokes on the page"
                                         AutomationProperties.Name="Freehand draw tool">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xED63;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Link"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Link, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Link"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Link — drag a rectangle, then enter a URL to create a clickable hyperlink annotation"
                                         AutomationProperties.Name="Hyperlink annotation tool">
                        <Fluent:ToggleButton.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Sign & Date group -->
                <Fluent:RibbonGroupBox Header="Sign &amp; Date"
                                        AutomationProperties.Name="Signature and date group">
                    <Fluent:ToggleButton Header="Signature"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Signature, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Signature"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Signature Tool — click a signature field (S)"
                                         AutomationProperties.Name="Signature tool"/>
                    <Fluent:ToggleButton Header="Date Stamp"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DateStamp, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="DateStamp"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Date Stamp — click page to place today's date (D)"
                                         AutomationProperties.Name="Date stamp tool"/>
                    <Fluent:ToggleButton Header="Stamp"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Stamp, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Stamp"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Rubber Stamp — click page to place stamp (M)"
                                         AutomationProperties.Name="Stamp tool"/>
                    <ComboBox ItemsSource="{Binding AvailableStamps}"
                              SelectedItem="{Binding SelectedStamp, Mode=TwoWay}"
                              IsEnabled="{Binding HasDocument}"
                              Width="110" Height="22" FontSize="11"
                              VerticalAlignment="Center" Margin="0,2,0,0"
                              ToolTip="Choose stamp text"
                              AutomationProperties.Name="Stamp text selector"/>
                </Fluent:RibbonGroupBox>

                <!-- Marks group -->
                <Fluent:RibbonGroupBox Header="Marks"
                                        AutomationProperties.Name="Marks and stamps group">
                    <Fluent:ToggleButton GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Checkmark, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="Checkmark"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Checkmark — click page to stamp ✓ (K)"
                                         AutomationProperties.Name="Checkmark stamp tool">
                        <Fluent:ToggleButton.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="#4CAF50" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="Check"/>
                            </StackPanel>
                        </Fluent:ToggleButton.Header>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=XMark, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="XMark"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="X Mark — click page to stamp ✕"
                                         AutomationProperties.Name="X mark stamp tool">
                        <Fluent:ToggleButton.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" Foreground="#F44336" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="X Mark"/>
                            </StackPanel>
                        </Fluent:ToggleButton.Header>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Highlight color picker -->
                <Fluent:RibbonGroupBox Header="Highlight Color"
                                        AutomationProperties.Name="Highlight annotation color group">
                    <StackPanel Orientation="Vertical" Margin="2,4">
                        <TextBlock Text="Color:" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox Width="110" Height="22" FontSize="11"
                                  SelectedValue="{Binding CurrentHighlightColor, Mode=TwoWay}"
                                  IsEnabled="{Binding HasDocument}"
                                  ToolTip="Highlight color"
                                  AutomationProperties.Name="Highlight color picker">
                            <ComboBoxItem Tag="#FFFF00" IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="12" Fill="#FFFF00" Margin="0,0,6,0"/>
                                    <TextBlock Text="Yellow"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#90EE90">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="12" Fill="#90EE90" Margin="0,0,6,0"/>
                                    <TextBlock Text="Green"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#ADD8E6">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="12" Fill="#ADD8E6" Margin="0,0,6,0"/>
                                    <TextBlock Text="Blue"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#FFB6C1">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="12" Fill="#FFB6C1" Margin="0,0,6,0"/>
                                    <TextBlock Text="Pink"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#FFA500">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="12" Fill="#FFA500" Margin="0,0,6,0"/>
                                    <TextBlock Text="Orange"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <!-- Text annotation tools -->
                <Fluent:RibbonGroupBox Header="Annotations"
                                        AutomationProperties.Name="Text annotation tools group">
                    <Fluent:ToggleButton Header="Add Text"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddText, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="AddText"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Add Text — click anywhere to place horizontal text"
                                         AutomationProperties.Name="Add horizontal text annotation"/>
                    <Fluent:ToggleButton Header="Vertical Text"
                                         GroupName="ToolGroup"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VerticalText, Mode=TwoWay}"
                                         Command="{Binding SetToolCommand}"
                                         CommandParameter="VerticalText"
                                         IsEnabled="{Binding HasDocument}"
                                         ToolTip="Vertical Text — click anywhere to place text top-to-bottom"
                                         AutomationProperties.Name="Add vertical text annotation"/>
                    <Fluent:Button Header="Delete"
                                   Command="{Binding DeleteAnnotationCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding SelectedAnnotation, Converter={StaticResource NullToBoolConverter}}"
                                   ToolTip="Delete selected annotation"
                                   AutomationProperties.Name="Delete selected annotation"/>
                </Fluent:RibbonGroupBox>

                <!-- Text Formatting group -->
                <Fluent:RibbonGroupBox Header="Text Format"
                                        AutomationProperties.Name="Text formatting group">
                    <StackPanel Orientation="Vertical" Margin="2,2">

                        <!-- Font family + size row -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Font:" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="110"
                                      ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding CurrentFontFamily, Mode=TwoWay}"
                                      IsEnabled="{Binding HasDocument}"
                                      FontSize="11" Height="22"
                                      AutomationProperties.Name="Font family"
                                      AutomationProperties.HelpText="Select the font for new and selected annotations"/>
                            <TextBlock Text="  Size:" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Fluent:Spinner Value="{Binding CurrentFontSize, Mode=TwoWay}"
                                            Minimum="6" Maximum="144" Format="0"
                                            IsEnabled="{Binding HasDocument}"
                                            Width="54" Height="22"
                                            AutomationProperties.Name="Font size"/>
                            <Fluent:Button Header="A-" Size="Small"
                                           Command="{Binding DecreaseFontSizeCommand}"
                                           IsEnabled="{Binding HasDocument}"
                                           ToolTip="Decrease font size" Margin="2,0,0,0"
                                           AutomationProperties.Name="Decrease font size"/>
                            <Fluent:Button Header="A+" Size="Small"
                                           Command="{Binding IncreaseFontSizeCommand}"
                                           IsEnabled="{Binding HasDocument}"
                                           ToolTip="Increase font size" Margin="2,0,0,0"
                                           AutomationProperties.Name="Increase font size"/>
                        </StackPanel>

                        <!-- Bold / Italic / Underline row -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Fluent:ToggleButton Header="B" Size="Small"
                                                  IsChecked="{Binding CurrentFontBold, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasDocument}"
                                                  ToolTip="Bold" FontWeight="Bold" Width="28"
                                                  AutomationProperties.Name="Bold text"/>
                            <Fluent:ToggleButton Header="I" Size="Small"
                                                  IsChecked="{Binding CurrentFontItalic, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasDocument}"
                                                  ToolTip="Italic" FontStyle="Italic" Width="28" Margin="2,0"
                                                  AutomationProperties.Name="Italic text"/>
                            <Fluent:ToggleButton Header="U" Size="Small"
                                                  IsChecked="{Binding CurrentFontUnderline, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasDocument}"
                                                  ToolTip="Underline" Width="28" Margin="2,0"
                                                  AutomationProperties.Name="Underline text"/>
                        </StackPanel>

                        <!-- Alignment + Force Uppercase row -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <!-- Left -->
                            <Fluent:ToggleButton Size="Small" Width="28"
                                                  ToolTip="Align text left"
                                                  Command="{Binding SetAlignmentCommand}"
                                                  CommandParameter="Left"
                                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Left}"
                                                  AutomationProperties.Name="Align text left">
                                <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Viewbox>
                            </Fluent:ToggleButton>
                            <!-- Center -->
                            <Fluent:ToggleButton Size="Small" Width="28" Margin="2,0"
                                                  ToolTip="Center text"
                                                  Command="{Binding SetAlignmentCommand}"
                                                  CommandParameter="Center"
                                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Center}"
                                                  AutomationProperties.Name="Center text">
                                <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Viewbox>
                            </Fluent:ToggleButton>
                            <!-- Right -->
                            <Fluent:ToggleButton Size="Small" Width="28" Margin="2,0"
                                                  ToolTip="Align text right"
                                                  Command="{Binding SetAlignmentCommand}"
                                                  CommandParameter="Right"
                                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Right}"
                                                  AutomationProperties.Name="Align text right">
                                <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Viewbox>
                            </Fluent:ToggleButton>
                            <!-- Force Uppercase -->
                            <Fluent:ToggleButton Header="AA" Size="Small" Width="32" Margin="6,0,0,0"
                                                  IsChecked="{Binding ForceUpperCase, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasDocument}"
                                                  ToolTip="Force UPPERCASE text entry"
                                                  AutomationProperties.Name="Force uppercase text"/>
                        </StackPanel>

                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <!-- Text Color group -->
                <Fluent:RibbonGroupBox Header="Color"
                                        AutomationProperties.Name="Text color group">
                    <WrapPanel Width="80" Margin="2">
                        <Button Width="22" Height="22" Margin="1"
                                Background="Black" ToolTip="Black"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#000000"
                                AutomationProperties.Name="Black"/>
                        <Button Width="22" Height="22" Margin="1"
                                Background="#1F3A8A" ToolTip="Dark Blue"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#1F3A8A"
                                AutomationProperties.Name="Dark blue"/>
                        <Button Width="22" Height="22" Margin="1"
                                Background="#8B0000" ToolTip="Dark Red"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#8B0000"
                                AutomationProperties.Name="Dark red"/>
                        <Button Width="22" Height="22" Margin="1"
                                Background="#006400" ToolTip="Dark Green"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#006400"
                                AutomationProperties.Name="Dark green"/>
                        <Button Width="22" Height="22" Margin="1"
                                Background="#555555" ToolTip="Dark Gray"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#555555"
                                AutomationProperties.Name="Dark gray"/>
                        <Button Width="22" Height="22" Margin="1"
                                Background="#800080" ToolTip="Purple"
                                Command="{Binding SetFontColorCommand}" CommandParameter="#800080"
                                AutomationProperties.Name="Purple"/>
                    </WrapPanel>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── FORMS TAB ─────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="Forms"
                                   AutomationProperties.Name="Forms tab">

                <Fluent:RibbonGroupBox Header="Fields"
                                        AutomationProperties.Name="Form fields group">
                    <Fluent:Button Header="Clear All"
                                   Command="{Binding ClearAllFieldsCommand}"
                                   KeyTip="C"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Clear the values of all form fields"
                                   AutomationProperties.Name="Clear all form fields">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Delete Field"
                                   Command="{Binding DeleteSelectedFieldCommand}"
                                   KeyTip="D"
                                   ToolTip="Delete the selected form field (or right-click a field on the page)"
                                   AutomationProperties.Name="Delete selected field"
                                   AutomationProperties.HelpText="Removes the currently selected form field from the document">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#D24040"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Import Data"
                                   Command="{Binding ImportDataCommand}"
                                   KeyTip="I"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Import field values from TSV file"
                                   AutomationProperties.Name="Import data from TSV"/>
                    <Fluent:Button Header="Export Data"
                                   Command="{Binding ExportDataCommand}"
                                   KeyTip="E"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Export field values to TSV file"
                                   AutomationProperties.Name="Export data to TSV"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Save Options"
                                        AutomationProperties.Name="Save options group">
                    <Fluent:Button Header="Save Filled PDF"
                                   Command="{Binding SaveCommand}"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save PDF with form fields editable"
                                   AutomationProperties.Name="Save filled PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Flatten &amp; Save"
                                   Command="{Binding FlattenAndSaveCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="Save PDF with fields baked in (non-editable)"
                                   AutomationProperties.Name="Flatten and save PDF"/>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- ── AI ASSISTANT TAB ──────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="AI Assistant"
                                   AutomationProperties.Name="AI assistant tab">
                <Fluent:RibbonGroupBox Header="Chat"
                                        AutomationProperties.Name="AI chat group">
                    <Fluent:Button Header="Open Chat"
                                   Command="{Binding ToggleAiPanelCommand}"
                                   ToolTip="Show AI Chat panel"
                                   AutomationProperties.Name="Open AI chat panel">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Clear Chat"
                                   Command="{Binding ClearAiChatCommand}"
                                   Size="Middle"
                                   ToolTip="Clear the AI chat history"
                                   AutomationProperties.Name="Clear AI chat history"/>
                    <Fluent:Button Header="Fill Fields"
                                   Command="{Binding RunAiFillCommand}"
                                   Size="Middle"
                                   IsEnabled="{Binding HasDocument}"
                                   ToolTip="AI fill using the prompt you typed"
                                   AutomationProperties.Name="Run AI form fill"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Document AI"
                                        AutomationProperties.Name="Document AI analysis group">
                    <Fluent:Button Header="Smart Fill"
                                   Command="{Binding SmartFillFromDocCommand}"
                                   ToolTip="AI reads the document text and fills all form fields intelligently"
                                   AutomationProperties.Name="Smart fill from document">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Summarize"
                                   Command="{Binding SummarizeDocumentCommand}"
                                   Size="Middle"
                                   ToolTip="AI summarizes the document — parties, dates, key points"
                                   AutomationProperties.Name="Summarize document"/>
                    <Fluent:Button Header="Extract Data"
                                   Command="{Binding ExtractKeyDataCommand}"
                                   Size="Middle"
                                   ToolTip="Extract names, dates, addresses, amounts and reference numbers"
                                   AutomationProperties.Name="Extract key data"/>
                    <Fluent:Button Header="Contract"
                                   Command="{Binding AnalyzeContractCommand}"
                                   Size="Middle"
                                   ToolTip="Analyze as a contract — parties, obligations, risks, missing clauses"
                                   AutomationProperties.Name="Analyze contract"/>
                    <Fluent:Button Header="Find PII"
                                   Command="{Binding FindPiiCommand}"
                                   Size="Middle"
                                   ToolTip="Identify personally identifiable information that should be redacted"
                                   AutomationProperties.Name="Find PII"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Provider"
                                        AutomationProperties.Name="AI provider group">
                    <Fluent:ComboBox Header="Provider"
                                     ItemsSource="{Binding AiProviders}"
                                     SelectedItem="{Binding AiProvider}"
                                     Width="90"
                                     AutomationProperties.Name="AI provider selector"/>
                    <Fluent:ComboBox Header="Model"
                                     ItemsSource="{Binding AiModels}"
                                     SelectedItem="{Binding AiModel}"
                                     Width="160"
                                     AutomationProperties.Name="AI model selector"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Profiles"
                                        AutomationProperties.Name="Personal profiles group">
                    <Fluent:Button Header="Manage Profiles"
                                   Command="{Binding ManageProfilesCommand}"
                                   ToolTip="Store your name, address, NI number and more for auto-fill"
                                   AutomationProperties.Name="Manage personal profiles">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Quick Fill"
                                   Command="{Binding QuickFillWithProfileCommand}"
                                   Size="Middle"
                                   ToolTip="Fill matching form fields from the selected profile instantly"
                                   AutomationProperties.Name="Quick fill from profile">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:ComboBox Header="Profile"
                                     ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     DisplayMemberPath="DisplayName"
                                     Width="110"
                                     AutomationProperties.Name="Active profile selector"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Setup"
                                        AutomationProperties.Name="AI setup group">
                    <Fluent:Button Header="API Keys"
                                   Command="{Binding OpenSettingsCommand}"
                                   ToolTip="Add your Claude or OpenAI API key in Settings → AI"
                                   AutomationProperties.Name="Configure AI API keys">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- ── DESIGN TAB ──────────────────────────────────────────────── -->
            <Fluent:RibbonTabItem Header="Design"
                                   AutomationProperties.Name="Design canvas tab">

                <!-- Canvas management -->
                <Fluent:RibbonGroupBox Header="Canvas"
                                        AutomationProperties.Name="Canvas management group">
                    <Fluent:Button Header="New Design"
                                   Command="{Binding NewDesignCommand}"
                                   ToolTip="Open a blank design canvas to build a PDF from scratch"
                                   AutomationProperties.Name="New design canvas">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Export PDF"
                                   Command="{Binding ExportDesignCommand}"
                                   ToolTip="Save the design canvas as a PDF file"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Export design to PDF">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Open as PDF"
                                   Command="{Binding OpenDesignInPdfViewCommand}"
                                   Size="Middle"
                                   ToolTip="Export and open in the PDF viewer"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Open design in PDF viewer">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Undo" Click="DesignUndo_Click" Size="Middle" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Redo" Click="DesignRedo_Click" Size="Middle" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Save / Load Design -->
                <Fluent:RibbonGroupBox Header="Design File"
                                        AutomationProperties.Name="Design file group">
                    <Fluent:Button Header="Save Design"
                                   Click="SaveDesign_Click"
                                   ToolTip="Save canvas as a .pdfdesign file (all elements preserved)"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Save design">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Load Design"
                                   Click="LoadDesign_Click"
                                   ToolTip="Open a previously saved .pdfdesign file"
                                   AutomationProperties.Name="Load design">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Templates -->
                <Fluent:RibbonGroupBox Header="Templates"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Design templates group">
                    <Fluent:Button Header="Invoice"
                                   Tag="Invoice" Click="DesignTemplate_Click"
                                   ToolTip="Load a professional invoice template"
                                   AutomationProperties.Name="Invoice template">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Letter"
                                   Tag="Letter" Click="DesignTemplate_Click"
                                   ToolTip="Load a formal letter template"
                                   Size="Middle"
                                   AutomationProperties.Name="Letter template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8F3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Form"
                                   Tag="Form" Click="DesignTemplate_Click"
                                   ToolTip="Load a generic form template"
                                   Size="Middle"
                                   AutomationProperties.Name="Form template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Cert."
                                   Tag="Certificate" Click="DesignTemplate_Click"
                                   ToolTip="Load a certificate template"
                                   Size="Middle"
                                   AutomationProperties.Name="Certificate template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Business Card"
                                   Tag="BusinessCard" Click="DesignTemplate_Click"
                                   ToolTip="Load a business card template (85×54 mm)"
                                   Size="Middle"
                                   AutomationProperties.Name="Business card template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8AA;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Resume"
                                   Tag="Resume" Click="DesignTemplate_Click"
                                   ToolTip="Load a professional resume/CV template"
                                   Size="Middle"
                                   AutomationProperties.Name="Resume template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Flyer"
                                   Tag="Flyer" Click="DesignTemplate_Click"
                                   ToolTip="Load a promotional flyer template"
                                   Size="Middle"
                                   AutomationProperties.Name="Flyer template">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Drawing tools -->
                <Fluent:RibbonGroupBox Header="Insert"
                                        AutomationProperties.Name="Design insert tools group">
                    <Fluent:Button Header="Select"
                                   Tag="Select" Click="DesignTool_Click"
                                   ToolTip="Select and move elements"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Select tool">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Text Box"
                                   Tag="Text" Click="DesignTool_Click"
                                   ToolTip="Add a text block"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Text tool">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Rectangle"
                                   Tag="Rectangle" Click="DesignTool_Click"
                                   ToolTip="Draw a rectangle"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Rectangle tool">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Ellipse"
                                   Tag="Ellipse" Click="DesignTool_Click"
                                   ToolTip="Draw an ellipse or circle"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Ellipse tool">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xF138;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Table"
                                   Tag="Table" Click="DesignTool_Click"
                                   ToolTip="Insert a table"
                                   IsEnabled="{Binding IsDesignMode}"
                                   AutomationProperties.Name="Table tool">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="32" Height="32"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Line"
                                   Tag="Line" Click="DesignTool_Click"
                                   ToolTip="Draw a straight line"
                                   IsEnabled="{Binding IsDesignMode}"
                                   Size="Middle"
                                   AutomationProperties.Name="Line tool">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xF4BC;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Arrow"
                                   Tag="Arrow" Click="DesignTool_Click"
                                   ToolTip="Draw an arrow"
                                   IsEnabled="{Binding IsDesignMode}"
                                   Size="Middle"
                                   AutomationProperties.Name="Arrow tool">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Pen"
                                   Tag="Pen" Click="DesignTool_Click"
                                   ToolTip="Freehand drawing"
                                   IsEnabled="{Binding IsDesignMode}"
                                   Size="Middle"
                                   AutomationProperties.Name="Pen / freehand tool">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xEDC6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Image"
                                   Tag="Image" Click="DesignTool_Click"
                                   ToolTip="Insert an image file"
                                   IsEnabled="{Binding IsDesignMode}"
                                   Size="Middle"
                                   AutomationProperties.Name="Insert image">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Text formatting -->
                <Fluent:RibbonGroupBox Header="Text Format"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Text formatting group">
                    <Fluent:ComboBox Header="Font"
                                     ItemsSource="{Binding AvailableFonts}"
                                     SelectedItem="{Binding DesignCanvas.FontFamily}"
                                     Width="130"
                                     AutomationProperties.Name="Font family"/>
                    <Fluent:Spinner Header="Size"
                                    Value="{Binding DesignCanvas.FontSize}"
                                    Minimum="6" Maximum="144" Increment="1"
                                    Width="60"
                                    AutomationProperties.Name="Font size"/>
                    <Fluent:ToggleButton Header="B" IsChecked="{Binding DesignCanvas.Bold}"
                                         FontWeight="Bold" Width="32" ToolTip="Bold" AutomationProperties.Name="Bold"/>
                    <Fluent:ToggleButton Header="I" IsChecked="{Binding DesignCanvas.Italic}"
                                         FontStyle="Italic" Width="32" ToolTip="Italic" AutomationProperties.Name="Italic"/>
                    <Fluent:ToggleButton Header="U" IsChecked="{Binding DesignCanvas.Underline}"
                                         Width="32" ToolTip="Underline" AutomationProperties.Name="Underline"/>
                    <Fluent:Button Header="Left"    Size="Middle" Tag="Left"    Click="TextAlign_Click" AutomationProperties.Name="Align left">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Center"  Size="Middle" Tag="Center"  Click="TextAlign_Click" AutomationProperties.Name="Center text">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Right"   Size="Middle" Tag="Right"   Click="TextAlign_Click" AutomationProperties.Name="Align right">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Text Color" Size="Middle" Tag="TextColor" Click="DesignColor_Click"
                                   ToolTip="Set text color" AutomationProperties.Name="Text color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8D3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Highlight" Size="Middle" Tag="TextBgColor" Click="DesignColor_Click"
                                   ToolTip="Set text highlight / background color" AutomationProperties.Name="Text highlight color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Shape format -->
                <Fluent:RibbonGroupBox Header="Shape Format"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Shape formatting group">
                    <Fluent:Spinner Header="Line Width"
                                    Value="{Binding DesignCanvas.StrokeThickness}"
                                    Minimum="0.5" Maximum="20" Increment="0.5"
                                    Width="60"
                                    AutomationProperties.Name="Stroke thickness"/>
                    <Fluent:Spinner Header="Corner Radius"
                                    Value="{Binding DesignCanvas.CornerRadius}"
                                    Minimum="0" Maximum="200" Increment="2"
                                    Width="60"
                                    ToolTip="Rectangle corner radius"
                                    AutomationProperties.Name="Corner radius"/>
                    <Fluent:Spinner Header="Opacity %"
                                    Value="{Binding DesignCanvas.ElementOpacity, Converter={StaticResource PercentConverter}}"
                                    Minimum="0" Maximum="100" Increment="5"
                                    Width="60"
                                    ToolTip="Element opacity (0=transparent, 100=opaque)"
                                    AutomationProperties.Name="Element opacity"/>
                    <Fluent:Button Header="Fill Color"   Size="Middle" Tag="FillColor"   Click="DesignColor_Click"
                                   ToolTip="Set shape fill color" AutomationProperties.Name="Fill color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Stroke Color" Size="Middle" Tag="StrokeColor" Click="DesignColor_Click"
                                   ToolTip="Set shape stroke (border) color" AutomationProperties.Name="Stroke color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:ToggleButton Header="Lock"
                                         IsChecked="{Binding DesignCanvas.ElementLocked}"
                                         Size="Middle"
                                         ToolTip="Lock selected element to prevent accidental movement"
                                         AutomationProperties.Name="Lock element">
                        <Fluent:ToggleButton.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <!-- Pen Format -->
                <Fluent:RibbonGroupBox Header="Pen Format"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Pen formatting group">
                    <Fluent:Spinner Header="Pen Size"
                                    Value="{Binding DesignCanvas.PenThickness}"
                                    Minimum="1" Maximum="50" Increment="1"
                                    Width="60"
                                    ToolTip="Freehand pen stroke thickness"
                                    AutomationProperties.Name="Pen thickness"/>
                    <Fluent:Button Header="Pen Color" Size="Middle" Click="DesignPenColor_Click"
                                   ToolTip="Set freehand pen color" AutomationProperties.Name="Pen color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xEDC6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Align -->
                <Fluent:RibbonGroupBox Header="Align"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Alignment group">
                    <Fluent:Button Header="Left Edge"   Size="Middle" Tag="AlignLeft"    Click="DesignAlign_Click" ToolTip="Align to left edge of page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Center H"    Size="Middle" Tag="AlignCenterH" Click="DesignAlign_Click" ToolTip="Center horizontally on page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Right Edge"  Size="Middle" Tag="AlignRight"   Click="DesignAlign_Click" ToolTip="Align to right edge of page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Top Edge"    Size="Middle" Tag="AlignTop"     Click="DesignAlign_Click" ToolTip="Align to top edge of page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Center V"    Size="Middle" Tag="AlignCenterV" Click="DesignAlign_Click" ToolTip="Center vertically on page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Bottom Edge" Size="Middle" Tag="AlignBottom"  Click="DesignAlign_Click" ToolTip="Align to bottom edge of page">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Arrange -->
                <Fluent:RibbonGroupBox Header="Arrange"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Arrange group">
                    <Fluent:Button Header="Bring Forward" Click="BringForward_Click" Size="Middle"
                                   ToolTip="Move element one layer up" AutomationProperties.Name="Bring forward">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Send Backward" Click="SendBackward_Click" Size="Middle"
                                   ToolTip="Move element one layer down" AutomationProperties.Name="Send backward">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="To Front" Click="BringToFront_Click" Size="Middle"
                                   ToolTip="Bring element to front" AutomationProperties.Name="Bring to front">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="To Back" Click="SendToBack_Click" Size="Middle"
                                   ToolTip="Send element to back" AutomationProperties.Name="Send to back">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Duplicate" Click="DesignDuplicate_Click" Size="Middle"
                                   ToolTip="Duplicate selected element (Ctrl+D)" AutomationProperties.Name="Duplicate element">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Delete" Click="DeleteDesignElement_Click" Size="Middle"
                                   ToolTip="Delete selected element (Del)" AutomationProperties.Name="Delete element">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Page / View -->
                <Fluent:RibbonGroupBox Header="Page"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Page settings group">
                    <Fluent:ComboBox Header="Page Size"
                                     SelectedIndex="0"
                                     Width="90"
                                     x:Name="DesignPageSizeCombo"
                                     SelectionChanged="DesignPageSize_SelectionChanged"
                                     AutomationProperties.Name="Page size selector">
                        <ComboBoxItem Content="A4"/>
                        <ComboBoxItem Content="Letter"/>
                        <ComboBoxItem Content="A3"/>
                    </Fluent:ComboBox>
                    <Fluent:ToggleButton Header="Grid"
                                         IsChecked="{Binding DesignCanvas.ShowGrid}"
                                         Size="Middle"
                                         ToolTip="Toggle grid overlay (20px)"
                                         AutomationProperties.Name="Toggle grid">
                        <Fluent:ToggleButton.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Snap"
                                         IsChecked="{Binding DesignCanvas.SnapToGrid}"
                                         Size="Middle"
                                         ToolTip="Snap elements to grid while dragging"
                                         AutomationProperties.Name="Snap to grid">
                        <Fluent:ToggleButton.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:Button Header="Bg Color" Click="DesignBgColor_Click" Size="Middle"
                                   ToolTip="Set the page background color"
                                   AutomationProperties.Name="Page background color">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Zoom In"   Click="DesignZoomIn_Click"  Size="Middle" AutomationProperties.Name="Design zoom in">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Zoom Out"  Click="DesignZoomOut_Click" Size="Middle" AutomationProperties.Name="Design zoom out">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Fit"       Click="DesignZoomFit_Click" Size="Middle" ToolTip="Fit canvas to window" AutomationProperties.Name="Design zoom fit">
                        <Fluent:Button.Icon><Viewbox Width="16" Height="16"><TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Viewbox></Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <!-- Position / Size -->
                <Fluent:RibbonGroupBox Header="Position &amp; Size"
                                        IsEnabled="{Binding DesignCanvas.HasSelection}"
                                        AutomationProperties.Name="Position and size group">
                    <Fluent:Spinner Header="X"
                                    Value="{Binding DesignCanvas.SelectedX, Mode=TwoWay}"
                                    Minimum="-9999" Maximum="9999" Increment="1"
                                    Width="64" ToolTip="Horizontal position (px)"
                                    AutomationProperties.Name="Element X position"/>
                    <Fluent:Spinner Header="Y"
                                    Value="{Binding DesignCanvas.SelectedY, Mode=TwoWay}"
                                    Minimum="-9999" Maximum="9999" Increment="1"
                                    Width="64" ToolTip="Vertical position (px)"
                                    AutomationProperties.Name="Element Y position"/>
                    <Fluent:Spinner Header="W"
                                    Value="{Binding DesignCanvas.SelectedWidth, Mode=TwoWay}"
                                    Minimum="4" Maximum="9999" Increment="1"
                                    Width="64" ToolTip="Element width (px)"
                                    AutomationProperties.Name="Element width"/>
                    <Fluent:Spinner Header="H"
                                    Value="{Binding DesignCanvas.SelectedHeight, Mode=TwoWay}"
                                    Minimum="4" Maximum="9999" Increment="1"
                                    Width="64" ToolTip="Element height (px)"
                                    AutomationProperties.Name="Element height"/>
                </Fluent:RibbonGroupBox>

                <!-- Export Image -->
                <Fluent:RibbonGroupBox Header="Export Image"
                                        IsEnabled="{Binding IsDesignMode}"
                                        AutomationProperties.Name="Design image export group">
                    <Fluent:Button Header="PNG" Size="Large" Click="DesignExportPng_Click"
                                   ToolTip="Export design canvas as PNG image"
                                   AutomationProperties.Name="Export design as PNG">
                        <Fluent:Button.LargeIcon><Viewbox Width="32" Height="32"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="28"/></Viewbox></Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="JPEG" Size="Large" Click="DesignExportJpeg_Click"
                                   ToolTip="Export design canvas as JPEG image"
                                   AutomationProperties.Name="Export design as JPEG">
                        <Fluent:Button.LargeIcon><Viewbox Width="32" Height="32"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="28"/></Viewbox></Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

        </Fluent:Ribbon>

        <!-- ════════════════════════════════════════════════════════════════
             MAIN CONTENT AREA
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Scaled inner layout (toolbox + viewer + properties) -->
            <avalonDock:DockingManager x:Name="DockManager"
                                       AllowMixedOrientation="True"
                                       Background="{DynamicResource PanelBgBrush}">
                <avalonDock:DockingManager.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
                </avalonDock:DockingManager.LayoutTransform>
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!-- ── Page thumbnails (dockable / floatable) ──────── -->
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="120">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable Title="Thumbnails" ContentId="thumbnails">
                                    <controls:PageThumbnailsPanel
                                        DataContext="{Binding}"
                                        FontSize="{DynamicResource PanelFontSize}"
                                        AutomationProperties.Name="Page thumbnails"/>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>

                        <!-- ── Document area: PDF Viewer OR Design Canvas ─── -->
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane>
                                <!-- PDF viewer (visible in PDF mode) -->
                                <avalonDock:LayoutDocument Title="Document" ContentId="document" CanClose="False">
                                    <Grid>
                                        <!-- PDF viewer (shown when not in design mode) -->
                                        <controls:PdfViewerControl x:Name="PdfViewer"
                                                                   DataContext="{Binding}"
                                                                   Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   AutomationProperties.Name="PDF document viewer"/>
                                        <!-- Design Canvas (shown in design mode) -->
                                        <controls:DesignCanvas x:Name="DesignCanvasControl"
                                                               DataContext="{Binding DesignCanvas}"
                                                               Visibility="{Binding IsDesignMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               AutomationProperties.Name="Design canvas"/>
                                    </Grid>
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>
                        </avalonDock:LayoutDocumentPaneGroup>

                        <!-- ── Properties (dockable / floatable) ───────────── -->
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="240">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable Title="Properties" ContentId="properties">
                                    <TabControl AutomationProperties.Name="Properties panel">

                        <!-- Field Properties tab -->
                        <TabItem Header="Properties"
                                 AutomationProperties.Name="Field properties">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <StackPanel>

                                    <TextBlock Text="DOCUMENT" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Document.Title, FallbackValue='—'}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Document.Title}"
                                               AutomationProperties.Name="Document title"/>
                                    <TextBlock Text="{Binding CurrentPageDisplay}"
                                               FontSize="11"
                                               AutomationProperties.Name="Page info"/>
                                    <TextBlock Text="{Binding ZoomPercent}"
                                               FontSize="11"
                                               AutomationProperties.Name="Zoom level"/>

                                    <Separator Margin="0,8" Background="{DynamicResource AppBorderBrush}"/>

                                    <TextBlock Text="SELECTED FIELD" Style="{StaticResource SectionHeader}"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding SelectedField.Name, FallbackValue='—'}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedField.Name}"
                                                   AutomationProperties.Name="Selected field name"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding SelectedField.FieldType, FallbackValue='—'}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   AutomationProperties.Name="Selected field type"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Page:" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding SelectedField.PageNumber, FallbackValue='—'}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   AutomationProperties.Name="Selected field page"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Required:" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding SelectedField.IsRequired, FallbackValue='—'}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   AutomationProperties.Name="Selected field required status"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Value:" FontSize="11" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding SelectedField.Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PropTextBox}"
                                                 Margin="0,4,0,0"
                                                 IsEnabled="{Binding SelectedField, Converter={StaticResource NullToBoolConverter}}"
                                                 AutomationProperties.Name="Field value editor"
                                                 AutomationProperties.HelpText="Edit the value of the selected form field"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tooltip:" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{Binding SelectedField.Tooltip, FallbackValue='—'}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.Name="Selected field tooltip"/>
                                    </Grid>

                                    <Separator Margin="0,8" Background="{DynamicResource AppBorderBrush}"/>

                                    <TextBlock Text="ALL FIELDS" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding AllFields.Count, StringFormat='{}{0} fields'}"
                                               FontSize="11" Margin="0,0,0,4"
                                               AutomationProperties.Name="Total field count"/>

                                    <ListBox ItemsSource="{Binding AllFields}"
                                             SelectedItem="{Binding SelectedField}"
                                             MaxHeight="260"
                                             Style="{StaticResource DarkListBox}"
                                             FontSize="11"
                                             AutomationProperties.Name="All form fields list">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FieldType}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Page Fields tab -->
                        <TabItem Header="Page Fields"
                                 AutomationProperties.Name="Current page fields">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="FIELDS ON THIS PAGE" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding CurrentPageFields.Count, StringFormat='{}{0} fields'}"
                                               FontSize="11" Margin="0,0,0,4"
                                               AutomationProperties.Name="Page field count"/>
                                    <ListBox ItemsSource="{Binding CurrentPageFields}"
                                             SelectedItem="{Binding SelectedField}"
                                             Style="{StaticResource DarkListBox}"
                                             FontSize="11"
                                             AutomationProperties.Name="Current page fields">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Design Layers tab -->
                        <TabItem Header="Layers"
                                 Visibility="{Binding IsDesignMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.Name="Design elements layers">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="DESIGN ELEMENTS"
                                           Style="{StaticResource SectionHeader}" Margin="8,8,8,4"/>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding DesignCanvas.Elements}"
                                         SelectedItem="{Binding DesignCanvas.SelectedElement, Mode=TwoWay}"
                                         AutomationProperties.Name="Design elements list">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ElementType}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ZOrder}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DimForegroundBrush}"
                                                           Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- Bookmarks tab -->
                        <TabItem Header="Bookmarks"
                                 Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.Name="PDF bookmarks outline">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="BOOKMARKS"
                                           Style="{StaticResource SectionHeader}" Margin="8,8,8,4"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding Bookmarks}"
                                              FontSize="11"
                                              AutomationProperties.Name="Bookmarks tree">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Cursor="Hand"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           ToolTip="{Binding Title}">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.NavigateToBookmarkCommand,
                                                                                RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- AI Chat tab -->
                        <TabItem Header="AI Chat"
                                 AutomationProperties.Name="AI chat assistant">
                            <controls:AiChatPanel DataContext="{Binding}"
                                                  FontSize="{DynamicResource ChatFontSize}"/>
                        </TabItem>

                                    </TabControl>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>

                        <!-- ── Fill & Sign Toolbox — right side, Adobe-style ─ -->
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="185">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable Title="Fill &amp; Sign" ContentId="tools"
                                                             CanClose="False" CanHide="False">
                                    <controls:ToolboxPanel DataContext="{Binding}"
                                                           FontSize="{DynamicResource PanelFontSize}"
                                                           AutomationProperties.Name="Fill and Sign tool palette"/>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
            <!-- End of docking manager -->

            <!-- ── Global Search Overlay ────────────────────────────────────── -->
            <Grid Panel.ZIndex="100"
                  Visibility="{Binding ShowSearchOverlay, Converter={StaticResource BoolToVisibilityConverter}}"
                  AutomationProperties.Name="Global search overlay">
                <Grid.Background>
                    <SolidColorBrush Color="Black" Opacity="0.45"/>
                </Grid.Background>

                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0"
                        Width="520"
                        Background="{DynamicResource SearchBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16"
                        AutomationProperties.Name="Search dialog">

                    <StackPanel>

                        <!-- Header row -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                       DockPanel.Dock="Left"/>
                            <TextBlock Text="Global Search" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="Ctrl+Shift+F to close" FontSize="10"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       DockPanel.Dock="Left"/>
                            <Button Content="✕"
                                    Command="{Binding ToggleSearchCommand}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Padding="4"
                                    ToolTip="Close search"
                                    AutomationProperties.Name="Close search overlay">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>

                        <!-- Search box -->
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 FontSize="14"
                                 Padding="10,6"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource InputForegroundBrush}"
                                 BorderBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="2"
                                 Margin="0,0,0,10"
                                 AutomationProperties.Name="Search query"
                                 AutomationProperties.HelpText="Type to search form fields and text annotations"/>

                        <!-- Result count -->
                        <TextBlock Text="{Binding SearchResults.Count, StringFormat='{}{0} results found'}"
                                   FontSize="11" Margin="0,0,0,6"
                                   AutomationProperties.Name="Search result count"/>

                        <!-- Results list -->
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 MaxHeight="320"
                                 Style="{StaticResource DarkListBox}"
                                 AutomationProperties.Name="Search results">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Padding="4,4"
                                            Command="{Binding DataContext.NavigateToResultCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Label}">
                                        <StackPanel Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Toast Notification Host ──────────────────────────────────── -->
            <controls:ToastHost Panel.ZIndex="200"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="16"
                                 AutomationProperties.Name="Notification area"
                                 AutomationProperties.LiveSetting="Polite"/>

        </Grid>
        <!-- End Grid.Row=1 -->

        <!-- ════════════════════════════════════════════════════════════════
             STATUS BAR
             ════════════════════════════════════════════════════════════════ -->
        <StatusBar Grid.Row="2"
                   FontSize="{DynamicResource StatusBarFontSize}"
                   AutomationProperties.Name="Status bar">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusText}"
                           AutomationProperties.Name="Status message"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Margin="8,0">
                <TextBlock Text="{Binding CurrentPageDisplay}"
                           AutomationProperties.Name="Page display"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Margin="8,0">
                <TextBlock Text="{Binding ZoomPercent}"
                           AutomationProperties.Name="Zoom level"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Margin="8,0">
                <TextBlock AutomationProperties.Name="Active tool and rotation">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Tool: {0}  |  Rotation: {1}°">
                            <Binding Path="ActiveTool"/>
                            <Binding Path="CurrentPageRotation"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" Margin="8,0">
                <TextBlock Text="{Binding UiScale, StringFormat='Scale: {0:P0}'}"
                           AutomationProperties.Name="Interface scale"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="5" Margin="8,0"
                           Visibility="{Binding DesignCanvas.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock AutomationProperties.Name="Design element position and size">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="X:{0:F0} Y:{1:F0}  W:{2:F0} H:{3:F0}">
                            <Binding Path="DesignCanvas.SelectedX"/>
                            <Binding Path="DesignCanvas.SelectedY"/>
                            <Binding Path="DesignCanvas.SelectedWidth"/>
                            <Binding Path="DesignCanvas.SelectedHeight"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Fluent:RibbonWindow>

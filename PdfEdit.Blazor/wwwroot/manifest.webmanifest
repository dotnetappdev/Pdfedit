{
  "name": "PdfEdit",
  "short_name": "PdfEdit",
  "description": "Fill in and sign forms, comment, redact, organise and convert PDFs.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#F5F5F5",
  "theme_color": "#4F46E5",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "application/pdf": [".pdf"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "shortcuts": [
    { "name": "New blank PDF", "url": "/?new=blank", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Design a form", "url": "/?new=design", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

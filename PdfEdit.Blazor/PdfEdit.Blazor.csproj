<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app's logic (PDF, forms, AI, cloud, settings), shared with the WPF app -->
    <ProjectReference Include="..\PdfEdit.Core\PdfEdit.Core.csproj" />
    <!-- Page rendering (Pdfium and the built-in engine), with no UI framework in it -->
    <ProjectReference Include="..\PdfEdit.Render\PdfEdit.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>

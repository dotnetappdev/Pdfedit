@page "/fill"
@rendermode InteractiveServer
@inject PdfDocumentStore Store
@inject IConfiguration Config
@inject IWebHostEnvironment Env

<PageTitle>Fill a Form</PageTitle>

<h1>Fill a Form</h1>

@if (_session == null)
{
    <p class="lead">Open a PDF form, fill it in on the page and download the filled-in copy.
        Pages are drawn on the server by PdfEdit.Render (Pdfium); the form is read and filled by PdfEdit.Core,
        the same code the Windows app uses.</p>

    <div class="mb-3">
        <label class="form-label" for="pdf-upload">PDF file (up to @(PdfDocumentStore.MaxUploadBytes / 1024 / 1024) MB)</label>
        <InputFile id="pdf-upload" class="form-control" accept=".pdf,application/pdf" OnChange="UploadAsync" disabled="@_busy" />
    </div>

    @if (_samples.Count > 0)
    {
        <p class="mb-1">Or try one of the sample forms:</p>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var sample in _samples)
            {
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => OpenSampleAsync(sample)">
                    @Path.GetFileNameWithoutExtension(sample)
                </button>
            }
        </div>
    }
}
else
{
    var info = _session.Info;
    <div class="toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
        <strong class="me-2">@_session.FileName</strong>
        <span class="text-body-secondary me-auto">
            @info.PageCount page@(info.PageCount == 1 ? "" : "s") ·
            @(info.FormFields.Count == 0 ? "no form fields" : $"{FieldCount} field{(FieldCount == 1 ? "" : "s")}")
            @if (ChangedCount > 0) { <text> · @ChangedCount changed</text> }
        </span>
        <div class="form-check form-check-inline mb-0">
            <input class="form-check-input" type="checkbox" id="flatten" @bind="_flatten" />
            <label class="form-check-label" for="flatten" title="Turn the fields into plain page content, so they can't be changed">Flatten</label>
        </div>
        <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save filled PDF</button>
        @if (_downloadReady)
        {
            <a class="btn btn-success" href="@($"/documents/{_session.Id}/download")" download>Download</a>
        }
        <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="Close">Open another</button>
    </div>
}

@if (_busy)
{
    <div class="alert alert-info">@_status</div>
}
@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_messages.Count > 0)
{
    <div class="alert alert-warning">
        Saved, with some problems:
        <ul class="mb-0">@foreach (var m in _messages) { <li>@m</li> }</ul>
    </div>
}

@if (_session != null)
{
    var info = _session.Info;
    @for (int p = 0; p < info.PageCount; p++)
    {
        int pageIndex = p;
        var (w, h) = info.PageSizes[pageIndex];
        int rotation = pageIndex < info.PageRotations.Count ? info.PageRotations[pageIndex] : 0;
        bool sideways = rotation is 90 or 270;
        double pageWidthPx = (sideways ? h : w) * PointsToPx;
        var fields = info.FormFields.Where(f => f.PageNumber == pageIndex + 1).ToList();

        <section class="pdf-page" style="width:@Css(pageWidthPx)px" aria-label="Page @(pageIndex + 1)">
            <img src="@($"/documents/{_session.Id}/pages/{pageIndex}.png?scale=2")" alt="Page @(pageIndex + 1)" loading="lazy" />
            @if (rotation == 0)
            {
                @foreach (var f in fields)
                {
                    @FieldControl(f, OverlayStyle(f, w, h), overlay: true)
                }
            }
        </section>
        @if (rotation != 0 && fields.Count > 0)
        {
            <p class="text-body-secondary small">This page is rotated; fill its fields in the list below.</p>
        }
        <p class="page-number">Page @(pageIndex + 1) of @info.PageCount</p>
    }

    @if (FieldCount > 0)
    {
        <details class="mt-4">
            <summary>All fields as a list</summary>
            <table class="table table-sm mt-2">
                <thead><tr><th>Field</th><th>Page</th><th>Value</th></tr></thead>
                <tbody>
                    @foreach (var f in info.FormFields.Where(IsFillable).DistinctBy(f => f.FieldType == FieldType.RadioButton ? f.Name + "#" + f.ExportValue : f.Name))
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(f.Tooltip) ? f.Name : f.Tooltip)@(f.FieldType == FieldType.RadioButton ? $" = {f.ExportValue}" : "")</td>
                            <td>@f.PageNumber</td>
                            <td>@FieldControl(f, "", overlay: false)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </details>
    }
}

@code {
    private const double PointsToPx = 96.0 / 72.0;

    private PdfSession? _session;
    private readonly Dictionary<string, string> _values = new();
    private readonly Dictionary<string, string> _original = new();
    private List<string> _samples = new();
    private List<string> _messages = new();
    private bool _busy, _flatten, _downloadReady;
    private string _status = "";
    private string? _error;

    private int FieldCount => _session?.Info.FormFields.Where(IsFillable).Select(f => f.Name).Distinct().Count() ?? 0;
    private int ChangedCount => _values.Count(kv => _original.TryGetValue(kv.Key, out var o) && o != kv.Value);

    protected override void OnInitialized()
    {
        // The repository's Samples folder, when the site runs from a checkout.
        var folder = Path.GetFullPath(Path.Combine(Env.ContentRootPath, Config["PdfEdit:SamplesFolder"] ?? "../Samples"));
        if (Directory.Exists(folder))
            _samples = Directory.GetFiles(folder, "*.pdf").Order().ToList();
    }

    // ── Opening ──────────────────────────────────────────────────────────────

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > PdfDocumentStore.MaxUploadBytes)
        {
            _error = $"That file is too big (the limit is {PdfDocumentStore.MaxUploadBytes / 1024 / 1024} MB).";
            return;
        }
        await OpenAsync(e.File.Name, () => e.File.OpenReadStream(PdfDocumentStore.MaxUploadBytes));
    }

    private Task OpenSampleAsync(string path) =>
        OpenAsync(Path.GetFileName(path), () => File.OpenRead(path));

    private async Task OpenAsync(string name, Func<Stream> open)
    {
        _busy = true; _error = null; _messages = new(); _status = $"Opening {name}…";
        StateHasChanged();
        try
        {
            await using var stream = open();
            var session = await Store.OpenAsync(stream, name);
            _session = session;
            _values.Clear(); _original.Clear(); _downloadReady = false;
            foreach (var f in session.Info.FormFields)
            {
                _values.TryAdd(f.Name, f.Value);
                _original.TryAdd(f.Name, f.Value);
            }
        }
        catch (Exception ex)
        {
            _error = $"Couldn't open {name}: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private void Close()
    {
        _session = null;
        _values.Clear(); _original.Clear();
        _messages = new(); _error = null; _downloadReady = false;
    }

    // ── Saving ───────────────────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        if (_session == null) return;
        _busy = true; _error = null; _messages = new(); _status = "Saving…";
        StateHasChanged();
        try
        {
            var changed = _values.Where(kv => _original.TryGetValue(kv.Key, out var o) && o != kv.Value)
                                 .ToDictionary(kv => kv.Key, kv => kv.Value);
            var onValues = _session.Info.FormFields.Where(f => f.FieldType == FieldType.Checkbox)
                                   .GroupBy(f => f.Name).ToDictionary(g => g.Key, g => g.First().ExportValue);
            var session = _session;
            _messages = await Task.Run(() => Store.SaveFilled(session, changed, onValues, _flatten));
            _downloadReady = true;
        }
        catch (Exception ex)
        {
            _error = "Couldn't save: " + ex.Message;
        }
        finally { _busy = false; }
    }

    // ── Fields ───────────────────────────────────────────────────────────────

    private static bool IsFillable(FormFieldInfo f) =>
        f.FieldType is FieldType.Text or FieldType.Checkbox or FieldType.RadioButton or FieldType.ComboBox or FieldType.ListBox;

    private string Value(FormFieldInfo f) => _values.TryGetValue(f.Name, out var v) ? v : "";

    private void Set(FormFieldInfo f, string? value)
    {
        _values[f.Name] = value ?? "";
        _downloadReady = false;
    }

    private void Toggle(FormFieldInfo f, ChangeEventArgs e) => Set(f, e.Value is true ? f.ExportValue : "Off");

    private static bool IsOn(string v) => !string.IsNullOrEmpty(v) && v != "Off";

    private RenderFragment FieldControl(FormFieldInfo f, string style, bool overlay) => __builder =>
    {
        var css = overlay ? "pdf-field" : "form-control form-control-sm";
        var title = string.IsNullOrWhiteSpace(f.Tooltip) ? f.Name : f.Tooltip;
        var align = f.Alignment switch { FieldAlignment.Center => "center", FieldAlignment.Right => "right", _ => "left" };
        switch (f.FieldType)
        {
            case FieldType.Text when f.IsMultiline:
                <textarea class="@css" style="@style;text-align:@align" title="@title" aria-label="@title"
                          readonly="@f.IsReadOnly" maxlength="@(f.MaxLength > 0 ? f.MaxLength : null)"
                          value="@Value(f)" @onchange="e => Set(f, e.Value?.ToString())"></textarea>
                break;
            case FieldType.Text:
                <input class="@css" style="@style;text-align:@align" title="@title" aria-label="@title"
                       type="@(f.IsPassword ? "password" : "text")" readonly="@f.IsReadOnly"
                       maxlength="@(f.MaxLength > 0 ? f.MaxLength : null)"
                       value="@Value(f)" @onchange="e => Set(f, e.Value?.ToString())" />
                break;
            case FieldType.Checkbox:
                <input class="@(overlay ? "pdf-field pdf-check" : "form-check-input")" style="@style" type="checkbox"
                       title="@title" aria-label="@title" disabled="@f.IsReadOnly"
                       checked="@IsOn(Value(f))" @onchange="e => Toggle(f, e)" />
                break;
            case FieldType.RadioButton:
                <input class="@(overlay ? "pdf-field pdf-check" : "form-check-input")" style="@style" type="radio"
                       name="@($"{(overlay ? "o" : "l")}-{f.Name}")" title="@($"{title}: {f.ExportValue}")"
                       aria-label="@($"{title}: {f.ExportValue}")" disabled="@f.IsReadOnly"
                       checked="@(Value(f) == f.ExportValue)" @onchange="() => Set(f, f.ExportValue)" />
                break;
            case FieldType.ComboBox:
            case FieldType.ListBox:
                <select class="@(overlay ? css : "form-select form-select-sm")" style="@style" title="@title" aria-label="@title"
                        disabled="@f.IsReadOnly" size="@(f.FieldType == FieldType.ListBox && overlay ? Math.Max(2, f.Options.Count) : (int?)null)"
                        value="@Value(f)" @onchange="e => Set(f, e.Value?.ToString())">
                    @if (f.FieldType == FieldType.ComboBox) { <option value=""></option> }
                    @foreach (var o in f.Options)
                    {
                        <option value="@o" selected="@(o == Value(f))">@o</option>
                    }
                </select>
                break;
            default:
                // Signatures and push buttons: shown, not filled here.
                if (overlay)
                {
                    <div class="pdf-field pdf-unsupported" style="@style" title="@($"{title} ({f.FieldType}, not supported here yet)")"></div>
                }
                break;
        }
    };

    /// <summary>Places a widget over the page image, in percentages so it follows the page as it resizes.</summary>
    private static string OverlayStyle(FormFieldInfo f, double pageW, double pageH)
    {
        double left = f.Left / pageW * 100, top = (pageH - f.Bottom - f.Height) / pageH * 100;
        double width = f.Width / pageW * 100, height = f.Height / pageH * 100;
        // Font size in container-width units, so text scales with the page.
        double fontPts = f.FontSize > 0 ? f.FontSize : Math.Clamp(f.Height * 0.65, 6, 14);
        double fontCqw = fontPts / pageW * 100;
        return $"left:{Css(left)}%;top:{Css(top)}%;width:{Css(width)}%;height:{Css(height)}%;font-size:{Css(fontCqw)}cqw";
    }

    private static string Css(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

}

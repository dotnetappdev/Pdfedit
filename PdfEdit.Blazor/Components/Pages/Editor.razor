                break;

            case RibbonTab.Help:
                <RibbonGroup Title="Updates">
                    <RibbonButton Large Icon="bi-stars" Label="What's New" Title="Release notes for every version, on GitHub" OnClick="@(() => OpenUrlAsync(GitHubUrl + "/releases"))" />
                    <RibbonButton Large Icon="bi-windows" Label="Windows App" Title="Download the full Windows app" OnClick="@(() => OpenUrlAsync(GitHubUrl + "/releases/latest"))" />

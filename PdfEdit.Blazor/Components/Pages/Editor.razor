                <RibbonGroup Title="Learn">
                    <RibbonButton Large Icon="bi-book" Label="User Guide" Title="How everything in PdfEdit works, on the PdfEdit website" OnClick="@(() => OpenUrlAsync(HelpLinks.UserGuide))" />
                    <RibbonButton Large Icon="bi-mortarboard" Label="Tutorials" Title="Step-by-step walkthroughs: sign a form, make a form fillable, merge, redact, scan and more" OnClick="@(() => OpenUrlAsync(HelpLinks.Tutorials))" />
                    <RibbonButton Large Icon="bi-lightbulb" Label="Tip of the Day" Title="A useful tip about PdfEdit, one at a time" OnClick="ShowTip" />
                    <RibbonButton Large Icon="bi-signpost-split" Label="Take the Tour" Title="A quick walk round the main parts of the window" OnClick="StartTour" />
                    <RibbonButton Large Icon="bi-keyboard" Label="Shortcuts" Title="Every keyboard shortcut (F1)" OnClick="() => ShowDialog(DialogKind.Shortcuts)" />
                </RibbonGroup>
                <RibbonGroup Title="Support">
                    <RibbonButton Large Icon="bi-life-preserver" Label="Troubleshooting" Title="Answers to common questions and problems" OnClick="@(() => OpenUrlAsync(HelpLinks.Troubleshooting))" />
                    <RibbonButton Large Icon="bi-bug" Label="Report a Problem" Title="Tell us about a bug or ask for a feature on GitHub" OnClick="@(() => OpenUrlAsync(GitHubUrl + "/issues/new"))" />
                    <RibbonButton Large Icon="bi-github" Label="PdfEdit on GitHub" Title="The project page: source code, releases and documentation" OnClick="() => OpenUrlAsync(GitHubUrl)" />
                </RibbonGroup>
                <RibbonGroup Title="About">
                    <RibbonButton Large Icon="bi-info-square" Label="About PdfEdit" Title="Version, licence and links" OnClick="() => ShowDialog(DialogKind.About)" />
                </RibbonGroup>
                break;
        }
        </div>
    </div>

    @* ── Workspace ─────────────────────────────────────────────────────── *@
    <div class="pe-workspace">
        @if (PageMenuOpen)
        {
            var mi = _menuItem;
            <div class="pe-ctx-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true"></div>
            var mf = _menuField;
            var ml = _menuLink;
            <div class="pe-ctxmenu" role="menu" aria-label="@(mi?.Describe() ?? (mf != null ? $"Field {FieldLabel(mf)}" : $"Page {_menuPage + 1}"))" style="left:@Css(_menuX)px;top:@Css(_menuY)px">
                @if (ml != null)
                {
                    var mhref = SafeHref(ml.Target);
                    <div class="pe-ctxmenu-head">@ml.Target.Describe()</div>
                    @if (mhref != null)
                    {
                        <a role="menuitem" class="pe-ctxmenu-a" href="@mhref" target="_blank" rel="noopener noreferrer" @onclick="CloseMenu"><i class="bi bi-box-arrow-up-right"></i>Open link</a>
                    }
                    else if (ml.Target.PageNumber != null)
                    {
                        <button role="menuitem" @onclick="() => MenuAsync(() => LinkClickAsync(ml))"><i class="bi bi-arrow-right-square"></i>Go to page @ml.Target.PageNumber</button>
                    }
                    <button role="menuitem" @onclick="() => MenuAct(() => EditLink(ml))"><i class="bi bi-pencil"></i>Edit link…</button>
                    <button role="menuitem" @onclick="() => MenuAsync(() => CopyLinkAsync(ml))"><i class="bi bi-copy"></i>Copy link address</button>
                    <hr />
                    <button role="menuitem" @onclick="() => MenuAsync(() => RemoveLinkAsync(ml))"><i class="bi bi-link"></i>Remove link</button>
                }
                else if (mf != null)
                {
                    int count = SelectedWidgets.Count;
                    <div class="pe-ctxmenu-head">@FieldLabel(mf)@(count > 1 ? $" + {count - 1} more" : "")</div>
                    <button role="menuitem" @onclick="() => MenuAct(() => FieldProperties(mf))"><i class="bi bi-sliders"></i>Properties…</button>
                    <button role="menuitem" @onclick="() => MenuAct(() => ClearField(mf))"><i class="bi bi-eraser"></i>Clear value</button>
                    <hr />
                    @foreach (var (title, ops) in new (string, ArrangeOp[])[]
                    {
                        ("Align", [ArrangeOp.AlignLefts, ArrangeOp.AlignCenters, ArrangeOp.AlignRights, ArrangeOp.AlignTops, ArrangeOp.AlignMiddles, ArrangeOp.AlignBottoms]),
                        ("Distribute", [ArrangeOp.DistributeHorizontally, ArrangeOp.DistributeVertically]),
                        ("Same size", [ArrangeOp.MakeSameWidth, ArrangeOp.MakeSameHeight, ArrangeOp.MakeSameSize]),
                    })
                    {
                        <div class="pe-ctxmenu-row" role="group" aria-label="@title">
                            <span>@title</span>
                            @foreach (var op in ops)
                            {
                                var cmd = Arrange.Commands.First(c => c.Op == op);
                                <button class="pe-ctxmenu-chip" title="@cmd.Hint" aria-label="@cmd.Hint" @onclick="() => MenuAct(() => ArrangeFields(cmd.Op))"><i class="bi @cmd.Icon"></i></button>
                            }
                        </div>
                    }
                    <button role="menuitem" @onclick="() => MenuAct(() => ArrangeFields(ArrangeOp.CenterOnPage))"><i class="bi bi-symmetry-vertical"></i>Center on page</button>
                    <button role="menuitem" @onclick="() => MenuAct(() => SelectAllFieldsOnPage(mf.PageNumber - 1))"><i class="bi bi-ui-checks-grid"></i>Select all fields on page</button>
                    <hr />
                    <button role="menuitem" @onclick="() => MenuAct(() => DeleteField(mf))"><i class="bi bi-trash3"></i>Delete field</button>
                    <button role="menuitem" @onclick="() => MenuAct(TogglePrepareMode)"><i class="bi bi-pencil-square"></i>Done — back to filling in</button>
                }
                else if (mi != null)
                {
                    <button role="menuitem" disabled="@mi.Locked" @onclick="() => MenuAsync(CutAsync)"><i class="bi bi-scissors"></i>Cut</button>
                    <button role="menuitem" @onclick="() => MenuAsync(CopyAsync)"><i class="bi bi-copy"></i>Copy</button>
                    <button role="menuitem" @onclick="PasteHereAsync"><i class="bi bi-clipboard"></i>Paste</button>
                    <button role="menuitem" disabled="@mi.Locked" @onclick="() => MenuAct(DeleteSelectedItem)"><i class="bi bi-trash3"></i>Delete @mi.Describe().Split(':')[0]</button>
                    <button role="menuitem" @onclick="() => MenuAct(() => mi.Locked = !mi.Locked)"><i class="bi @(mi.Locked ? "bi-unlock" : "bi-lock")"></i>@(mi.Locked ? "Unlock" : "Lock")</button>
                    @if (Editor.CanRotate(mi))
                    {
                        <hr />
                        <button role="menuitem" @onclick="() => MenuAct(() => RotateItem(mi))"><i class="bi bi-arrow-clockwise"></i>Rotate 90° Clockwise</button>
                        <button role="menuitem" @onclick="() => MenuAct(() => { RotateItem(mi); RotateItem(mi); RotateItem(mi); })"><i class="bi bi-arrow-counterclockwise"></i>Rotate 90° Counter-clockwise</button>
                    }
                    @if (mi.Kind == ItemKind.Text)
                    {
                        <hr />
                        <button role="menuitemradio" aria-checked="@(mi.Fit == TextFit.Auto)" @onclick="() => MenuAct(() => SetItemFit(mi, TextFit.Auto))"><i class="bi @(mi.Fit == TextFit.Auto ? "bi-check2" : "")"></i>Auto-size box to text</button>
                        <button role="menuitemradio" aria-checked="@(mi.Fit == TextFit.Wrap)" @onclick="() => MenuAct(() => SetItemFit(mi, TextFit.Wrap))"><i class="bi @(mi.Fit == TextFit.Wrap ? "bi-check2" : "")"></i>Wrap text, grow box to fit</button>
                        <button role="menuitemradio" aria-checked="@(mi.Fit == TextFit.Fixed)" @onclick="() => MenuAct(() => SetItemFit(mi, TextFit.Fixed))"><i class="bi @(mi.Fit == TextFit.Fixed ? "bi-check2" : "")"></i>Fixed box size</button>
                        <button role="menuitem" @onclick="() => MenuAct(() => GrowText(mi, now: true))"><i class="bi bi-arrows-angle-contract"></i>Fit box to text now</button>
                    }
                    @if (Editor.HasColor(mi))
                    {
                        <hr />
                        <div class="pe-ctxmenu-row" role="group" aria-label="Colour">
                            <span>Colour</span>
                            @foreach (var (hex, name) in Editor.SwatchColors.Concat([("#0A84FF", "Blue"), ("#FFEB3B", "Yellow")]))
                            {
                                <button class="pe-ctxmenu-swatch @(string.Equals(mi.Color, hex, StringComparison.OrdinalIgnoreCase) ? "on" : "")" style="background:@hex" title="@name" aria-label="Colour: @name"
                                        @onclick="() => MenuAct(() => SetItemColor(mi, hex))"></button>
                            }
                        </div>
                    }
                    @if (mi.Kind is ItemKind.Ink or ItemKind.Rectangle or ItemKind.Ellipse or ItemKind.Line or ItemKind.Arrow or ItemKind.Polygon or ItemKind.Polyline)
                    {
                        <div class="pe-ctxmenu-row" role="group" aria-label="Line width">
                            <span>Line width</span>
                            @foreach (var lw in new[] { 1.0, 2, 3, 5 })
                            {
                                <button class="pe-ctxmenu-chip @(Math.Abs(mi.LineWidth - lw) < 0.01 ? "on" : "")" @onclick="() => MenuAct(() => SetLineWidth(mi, lw))">@lw</button>
                            }
                        </div>
                    }
                    @if (mi.Kind == ItemKind.Highlight && mi.Markup == HighlightKind.Highlight)
                    {
                        <div class="pe-ctxmenu-row" role="group" aria-label="Opacity">
                            <span>Opacity</span>
                            @foreach (var op in new[] { 0.25, 0.4, 0.6, 1.0 })
                            {
                                <button class="pe-ctxmenu-chip @(Math.Abs(mi.Opacity - op) < 0.01 ? "on" : "")" @onclick="() => MenuAct(() => mi.Opacity = op)">@((int)(op * 100))%</button>
                            }
                        </div>
                    }
                    <hr />
                    <button role="menuitem" @onclick="() => MenuAct(() => ShowInComments(mi))"><i class="bi bi-chat-left-text"></i>Show in Comments panel</button>
                    <button role="menuitem" @onclick="() => MenuAct(() => ShowProperties(mi))"><i class="bi bi-sliders"></i>Properties…</button>
                }
                else
                {
                    <button role="menuitem" @onclick="PasteHereAsync"><i class="bi bi-clipboard"></i>Paste here</button>
                    <hr />
                    <button role="menuitem" @onclick="() => AddHereAsync(Tool.Text)"><i class="bi bi-type"></i>Add text here</button>
                    <button role="menuitem" @onclick="() => AddHereAsync(Tool.Date)"><i class="bi bi-calendar-event"></i>Add today's date here</button>
                    <button role="menuitem" @onclick="() => AddHereAsync(Tool.Check)"><i class="bi bi-check-lg"></i>Add a check mark here</button>
                    <button role="menuitem" @onclick="() => AddHereAsync(Tool.Note)"><i class="bi bi-sticky"></i>Add a sticky note here</button>
                    <hr />
                    <button role="menuitem" @onclick="() => MenuAsync(() => RotateAsync(90))"><i class="bi bi-arrow-clockwise"></i>Rotate page clockwise</button>
                    <button role="menuitem" @onclick="() => MenuAsync(() => RotateAsync(-90))"><i class="bi bi-arrow-counterclockwise"></i>Rotate page anticlockwise</button>
                }
            </div>
        }
        @if (_showTools || _showLeft)
        {
            @* Docked like the Windows app: All tools, then the page thumbnails. *@
            <div class="pe-leftdock">
                @if (_showTools)
                {
                    <aside class="pe-panel tools" aria-label="All tools">
                        <div class="pe-panel-tabs">
                            <span class="pe-panel-tab active">All tools</span>
                            <button class="pe-panel-close" title="Hide All tools (View → All Tools brings it back)" aria-label="Hide All tools" @onclick="() => _showTools = false"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="pe-panel-body"><AllToolsPanel Ed="this" /></div>
                    </aside>
                }
                @if (_showLeft)
                {
                <aside class="pe-panel left" aria-label="Thumbnails">
                    <div class="pe-panel-tabs"><span class="pe-panel-tab active">Thumbnails</span></div>
                    <div class="pe-panel-body" style="padding:0">
                        @if (Doc != null)
                        {
                            <div class="pe-thumbs">
                                @for (int p = 0; p < PageCount; p++)
                                {
                                    int pg = p;
                                    <div class="pe-thumb-wrap @(_thumbDrop == pg && _thumbDrag != pg ? (_thumbDrag < pg ? "drop-after" : "drop-before") : "")"
                                         draggable="true" @ondragstart="() => ThumbDragStart(pg)" @ondragend="ThumbDragEnd"
                                         @ondragenter="() => _thumbDrop = pg" @ondragover:preventDefault="true" @ondrop="() => ThumbDropAsync(pg)"
                                         @oncontextmenu="e => OpenThumbMenu(pg, e)" @oncontextmenu:preventDefault="true">
                                        <button class="pe-thumb @(pg == _page ? "current" : "")" @onclick="() => GoToPageAsync(pg)" aria-label="Page @(pg + 1)">
                                            <img src="@PageUrl(pg, 0.3)" loading="lazy" alt="" draggable="false" style="width:@Css(ThumbWidth(pg))px" />
                                            <div>@(pg + 1)</div>
                                        </button>
                                        <div class="pe-thumb-tools" role="toolbar" aria-label="Page @(pg + 1) tools">
                                            <button title="Rotate anticlockwise" aria-label="Rotate page @(pg + 1) anticlockwise" @onclick="() => ThumbActionAsync(pg, () => RotateAsync(-90))"><i class="bi bi-arrow-counterclockwise"></i></button>
                                            <button title="Rotate clockwise" aria-label="Rotate page @(pg + 1) clockwise" @onclick="() => ThumbActionAsync(pg, () => RotateAsync(90))"><i class="bi bi-arrow-clockwise"></i></button>
                                            <button title="Delete page" aria-label="Delete page @(pg + 1)" @onclick="() => ThumbActionAsync(pg, DeleteThisPageAsync)"><i class="bi bi-trash3"></i></button>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (_thumbMenu is { } mp)
                            {
                                <div class="pe-ctx-backdrop" @onclick="() => _thumbMenu = null" @oncontextmenu="() => _thumbMenu = null" @oncontextmenu:preventDefault="true"></div>
                                <div class="pe-ctxmenu" role="menu" aria-label="Page @(mp + 1)" style="left:@Css(_thumbMenuX)px;top:@Css(_thumbMenuY)px">
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, () => RotateAsync(90))"><i class="bi bi-arrow-clockwise"></i>Rotate CW</button>
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, () => RotateAsync(-90))"><i class="bi bi-arrow-counterclockwise"></i>Rotate CCW</button>
                                    <hr />
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, () => InsertBlankAsync(before: true))"><i class="bi bi-file-earmark-arrow-up"></i>Insert Before</button>
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, () => InsertBlankAsync(before: false))"><i class="bi bi-file-earmark-arrow-down"></i>Insert After</button>
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, DuplicatePageAsync)"><i class="bi bi-files"></i>Duplicate</button>
                                    <hr />
                                    <button role="menuitem" disabled="@(mp == 0)" @onclick="() => ThumbActionAsync(mp, () => MovePageAsync(-1))"><i class="bi bi-arrow-up"></i>Move Up</button>
                                    <button role="menuitem" disabled="@(mp >= PageCount - 1)" @onclick="() => ThumbActionAsync(mp, () => MovePageAsync(1))"><i class="bi bi-arrow-down"></i>Move Down</button>
                                    <hr />
                                    <button role="menuitem" disabled="@(PageCount < 2)" @onclick="() => ThumbActionAsync(mp, DeleteThisPageAsync)"><i class="bi bi-trash3"></i>Delete Page</button>
                                    <button role="menuitem" @onclick="() => ThumbActionAsync(mp, ExtractThisPageAsync)"><i class="bi bi-box-arrow-up-right"></i>Extract Page…</button>
                                    @if (Doc?.SourceUrl != null)
                                    {
                                        <hr />
                                        <button role="menuitem" title="A link that opens this PDF at this page" @onclick="() => { _thumbMenu = null; return CopyLinkToPageAsync(mp); }"><i class="bi bi-link-45deg"></i>Copy Link to Page</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </aside>
                }
            </div>
        }
        else
        {
            <div></div>
        }

        <main class="pe-viewer" @ref="_viewer" aria-label="Document">
            @if (_busy) { <div class="pe-busy" role="progressbar" aria-label="Working"></div> }
            <div class="pe-viewswitch" role="tablist" aria-label="View">
                <button class="@(DesignMode ? "" : "active")" role="tab" aria-selected="@(!DesignMode)" @onclick="() => SetDesignMode(false)"><i class="bi bi-file-earmark-text"></i> Live View</button>
                <button class="@(DesignMode ? "active" : "")" role="tab" aria-selected="@DesignMode" @onclick="() => SetDesignMode(true)"><i class="bi bi-pencil-square"></i> Design</button>
                @if (Tabs.Count > 0)
                {
                    <div class="pe-doctabs" role="tablist" aria-label="Open documents">
                        @foreach (var t in Tabs)
                        {
                            var tab = t;
                            bool shown = tab == ActiveTab && !DesignMode;
                            <div class="pe-doctab @(shown ? "active" : "")" title="@tab.Session.FileName">
                                <button class="pe-doctab-name" role="tab" aria-selected="@shown" @onclick="() => SwitchTabAsync(tab)">
                                    <i class="bi bi-file-earmark-pdf"></i> <span>@tab.Session.FileName</span>@if (TabHasChanges(tab)) { <span class="pe-dirty" title="Not saved">•</span> }
                                </button>
                                <button class="pe-doctab-x" title="Close" aria-label="Close @tab.Session.FileName" @onclick="() => CloseTabAsync(tab)"><i class="bi bi-x"></i></button>
                            </div>
                        }
                        <button class="pe-doctab-add" title="Open another document" aria-label="Open another document" @onclick="() => OpenBackstage(Backstage.Open)"><i class="bi bi-plus-lg"></i></button>
                    </div>
                }
            </div>
            <ToolRail Ed="this" />
            @if (DesignMode)
            {
                var (dw, dh) = DesignSize;
                <div class="pe-pages" @onclick="() => SelectedDesignId = null">
                    <div class="pe-page pe-design-page @(DesignGrid ? "grid" : "")" style="width:@Css(DesignWidthPx)px;height:@Css(DesignHeightPx)px;background-color:@DesignColor.ToCss(Design.BgColor, "#fff");--gx:@Css(DesignGridSize / dw * 100)%;--gy:@Css(DesignGridSize / dh * 100)%">
                        @foreach (var item in Design.Elements ?? [])
                        {
                            <DesignItemView @key="item.Id" Ed="this" Item="item" PageW="dw" PageH="dh" />
                        }
                        @if (_designTool == DesignTool.Pen)
                        {
                            <div class="pe-tool-layer" title="Draw with the mouse, pen or finger" data-sketch="ink" data-page="-1" @onclick:stopPropagation="true"
                                 data-ptw="@Css(dw)" data-pth="@Css(dh)" data-color="@DesignPenColor" data-width="@Css(DesignPenWidth)" data-unit="in"></div>
                        }
                        else if (_designTool != DesignTool.Select)
                        {
                            <div class="pe-tool-layer" title="Click to add, or drag to draw at a size" @onclick:stopPropagation="true"
                                 @onmousedown="DesignDown" @onmouseup="DesignUp"></div>
                        }
                        <div class="pe-page-label">@_designName</div>
                    </div>
                </div>
            }
            else if (Doc == null)
            {
                <WelcomeView Ed="this" />
            }
            else
            {
                <div class="pe-pages @(TwoPages ? "two" : "") @(NightMode ? "night" : "") @(HighlightFields ? "" : "no-field-hl")">
                    @for (int p = 0; p < PageCount; p++)
                    {
                        int pg = p;
                        var (w, h) = ViewSize(pg);
                        <div class="pe-page" id="@($"page-{pg}")" data-page="@pg" style="width:@Css(DisplayWidth(pg))px;height:@Css(DisplayHeight(pg))px">
                            <img class="pe-page-img" src="@PageUrl(pg, ImageScale)" alt="Page @(pg + 1)" loading="lazy" draggable="false" />

                            @foreach (var hit in _searchHits.Where(x => x.PageNumber == pg + 1))
                            {
                                <div class="pe-search-hit @(hit == CurrentHit ? "current" : "")" style="@HitStyle(hit)"></div>
                            }

                            @* The PDF's own links: web, email and phone links open in a new tab, page links jump; with the Link tool a click edits one. *@
                            @foreach (var link in LinksOn(pg))
                            {
                                var lk = link;
                                var href = SafeHref(lk.Target);
                                var linkKey = $"{lk.PageNumber}|{lk.AnnotIndex}";
                                var linkTitle = (_tool == Tool.Link ? "Edit link: " : string.Empty) + lk.Target.Describe();
                                @if (href != null && _tool != Tool.Link)
                                {
                                    <a class="pe-link-hit" style="@ViewStyle(pg, lk.Left, lk.Bottom, lk.Width, lk.Height)" href="@href" target="_blank" rel="noopener noreferrer"
                                       title="@lk.Target.Describe()" aria-label="Link: @lk.Target.Describe()" data-link="@linkKey"></a>
                                }
                                else
                                {
                                    <button class="pe-link-hit @(_tool == Tool.Link ? "editing" : "")" style="@ViewStyle(pg, lk.Left, lk.Bottom, lk.Width, lk.Height)"
                                            title="@linkTitle" aria-label="Link: @lk.Target.Describe()"
                                            data-link="@linkKey" @onclick="() => LinkClickAsync(lk)"></button>
                                }
                            }

                            @foreach (var f in Doc.Info.FormFields.Where(f => f.PageNumber == pg + 1 && !IsDeleted(f) && !Doc.SignedFields.Contains(f.Name)))
                            {
                                var r = FieldRect(f);
                                if (PrepareMode)
                                {
                                    <FieldBox Ed="this" Field="f" Style="@ViewStyle(pg, r.Left, r.Bottom, r.Width, r.Height)" />
                                }
                                else
                                {
                                    <FieldInput Ed="this" Field="f" Overlay="true" Style="@FieldViewStyle(pg, r.Left, r.Bottom, r.Width, r.Height, FieldFontPts(f))" />
                                }
                            }

                            @foreach (var item in _items.Where(i => i.Page == pg))
                            {
                                <PageItemView Ed="this" Item="item" PageW="w" PageH="h" />
                            }

                            @if (EditingImage is { } img && img.PageNumber == pg + 1)
                            {
                                var ir = ImageRect;
                                <div class="pe-image-edit" style="@ViewStyle(pg, ir.Left, ir.Bottom, ir.Width, ir.Height)" data-drag="img:@img.Index">
                                    <span class="pe-item-handle" data-resize="1" aria-hidden="true"></span>
                                    <div class="pe-image-bar" @onmousedown:stopPropagation="true">
                                        @if (ImageMove != null)
                                        {
                                            <button class="pe-btn primary" title="Move the picture here" @onclick="ApplyImageMoveAsync"><i class="bi bi-check-lg"></i> Apply</button>
                                        }
                                        <label class="pe-btn" title="Replace with another picture"><i class="bi bi-arrow-repeat"></i> Replace
                                            <InputFile accept="image/png,image/jpeg" OnChange="e => ReplaceImageAsync(e.File)" style="display:none" />
                                        </label>
                                        <button class="pe-btn" title="Download the picture" @onclick="SaveImageAsync"><i class="bi bi-download"></i></button>
                                        <button class="pe-btn" title="Delete the picture" @onclick="DeleteImageAsync"><i class="bi bi-trash"></i></button>
                                        <button class="pe-btn" title="Done" @onclick="CloseImageEdit"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </div>
                            }

                            @if (SketchMode is { } sketch)
                            {
                                <div class="pe-tool-layer" title="@ToolHint" data-sketch="@sketch" data-page="@pg"
                                     data-ptw="@Css(w)" data-pth="@Css(h)" data-color="@SketchColor" data-unit="@_measureUnit"
                                     data-width="@Css(SketchWidth)"
                                     data-measure="@MeasureMode"></div>
                            }
                            else if (_tool != Tool.Select)
                            {
                                <div class="pe-tool-layer" title="@ToolHint"
                                     @onmousedown="e => ToolDown(pg, e)" @onmouseup="e => ToolUpAsync(pg, e)"></div>
                            }
                            <div class="pe-page-label">@(pg + 1)</div>
                        </div>
                    }
                </div>
            }
        </main>

        @if (_showRight)
        {
            <aside class="pe-panel right" aria-label="Side panel">
                <div class="pe-panel-tabs" role="tablist">
                    @foreach (var t in Enum.GetValues<RightTab>().Where(t => t != RightTab.AllTools))
                    {
                        var tab = t;
                        <button class="pe-panel-tab @(_right == tab ? "active" : "")" role="tab" @onclick="() => _right = tab">@(tab switch { RightTab.AI => "AI", RightTab.AllTools => "All tools", _ => tab.ToString() })</button>
                    }
                </div>
                <div class="pe-panel-body"><SidePanel Ed="this" /></div>
            </aside>
        }
        else
        {
            <div></div>
        }
    </div>

    @* ── Status bar ────────────────────────────────────────────────────── *@
    <div class="pe-status" role="status">
        <span>@_status</span>
        <span class="pe-spacer"></span>
        @if (FillProgress is { } fp)
        {
            <button class="pe-form-progress @(fp.Done ? "done" : "")" title="@(fp.Done ? "Every field is filled in" : "Go to the next empty field (required ones first)")" @onclick="NextEmptyFieldAsync">
                <i class="bi @(fp.Done ? "bi-check-circle-fill" : "bi-input-cursor-text")"></i> @fp.Label
            </button>
            <span>·</span>
        }
        @if (Dictating)
        {
            <button class="pe-dictating" title="Stop dictation" @onclick="ToggleDictationAsync"><i class="bi bi-mic-fill"></i> Dictating</button>
            <span>·</span>
        }
        @if (DraftSavedAt is { } kept && (Doc != null || DesignMode))
        {
            <span class="pe-draft-kept" title="Your work is kept in this browser as a draft: reloading or closing the page doesn't lose it"><i class="bi bi-cloud-check"></i> Draft saved @kept.ToString("HH:mm")</span>
            @if (Doc != null) { <span>·</span> }
        }
        @if (Doc != null)
        {
            <button title="Previous page" aria-label="Previous page" disabled="@(_page == 0)" @onclick="() => GoToPageAsync(_page - 1)"><i class="bi bi-chevron-left"></i></button>
            <span>Page</span>
            <input id="pe-pagebox" aria-label="Page number (Ctrl+G)" value="@(_page + 1)" @onchange="PageBoxChangedAsync" />
            <span>of @PageCount</span>
            <button title="Next page" aria-label="Next page" disabled="@(_page >= PageCount - 1)" @onclick="() => GoToPageAsync(_page + 1)"><i class="bi bi-chevron-right"></i></button>
            <span>·</span>
            <button title="Zoom out" aria-label="Zoom out" @onclick="() => Zoom(0.8)"><i class="bi bi-dash"></i></button>
            <span>@((int)Math.Round(_zoom * 100))%</span>
            <button title="Zoom in" aria-label="Zoom in" @onclick="() => Zoom(1.25)"><i class="bi bi-plus"></i></button>
        }
    </div>

    @if (SlidePage is { } slide && Doc != null)
    {
        <div id="pe-slideshow" class="pe-slideshow" tabindex="0" @onkeydown="SlideKeyAsync" @onclick="() => SlideTo(slide + 1)" role="dialog" aria-label="Slide show">
            <img src="@PageUrl(slide, 2.5)" alt="Page @(slide + 1)" draggable="false" />
            <div class="pe-slide-bar" @onclick:stopPropagation="true">
                <button title="Previous (←)" aria-label="Previous page" disabled="@(slide == 0)" @onclick="() => SlideTo(slide - 1)"><i class="bi bi-chevron-left"></i></button>
                <span>@(slide + 1) / @PageCount</span>
                <button title="Next (→)" aria-label="Next page" disabled="@(slide >= PageCount - 1)" @onclick="() => SlideTo(slide + 1)"><i class="bi bi-chevron-right"></i></button>
                <button title="Leave the slide show (Esc)" aria-label="Leave the slide show" @onclick="EndSlideShowAsync"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
    }
    @if (TourIndex is { } ti)
    {
        var step = TourSteps[ti];
        <div class="pe-tour" role="dialog" aria-modal="true" aria-label="Tour: @step.Title" data-target="@step.Target" @key="ti">
            <div class="pe-tour-ring"></div>
            <div class="pe-tour-card">
                <div class="pe-tour-title">@step.Title</div>
                <p>@step.Text</p>
                <div class="pe-tour-foot">
                    <span>@(ti + 1) of @TourSteps.Length</span>
                    <span class="pe-spacer"></span>
                    <button class="pe-btn" disabled="@(ti == 0)" @onclick="() => TourGo(ti - 1)">Back</button>
                    <button class="pe-btn primary" @onclick="() => TourGo(ti + 1)">@(ti == TourSteps.Length - 1 ? "Finish" : "Next")</button>
                    <button class="pe-btn" title="Close the tour (Esc)" aria-label="Close the tour" @onclick="EndTour"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
        </div>
    }
    @if (_backstage != null) { <BackstageView Ed="this" /> }
    @if (_dialog != DialogKind.None) { <DialogHost Ed="this" /> }
    @* PDFs opened with the installed app ("Open with PdfEdit") arrive here, whatever is on screen. *@
    <InputFile id="pe-launch-input" style="display:none" multiple OnChange="e => OpenUploadsAsync(e.GetMultipleFiles(20))" />
    @if (_toast != null)
    {
        <div class="pe-toast @_toastKind" role="alert" @onclick="() => _toast = null">@_toast</div>
    }
</div>

@code {
    // Ribbon helpers: a tool button, a design-tool button, colour swatches, the text format
    // controls and the Arrange buttons (shared by several tabs, as in the Windows app).
    private RenderFragment ToolButton(Tool tool, string icon, string label, string title, bool large = false, bool compact = false) =>
        @<RibbonButton Large="large" Compact="compact" Icon="@icon" Label="@label" Title="@title" Disabled="NoDoc" Active="_tool == tool" OnClick="() => SetTool(tool)" />;

    private RenderFragment DesignToolButton(DesignTool tool, string icon, string label, string title, bool large = false) =>
        @<RibbonButton Large="large" Icon="@icon" Label="@label" Title="@title" Active="DesignMode && _designTool == tool" OnClick="() => StartDesignTool(tool)" />;

    private RenderFragment Swatches((string Hex, string Name)[] colours, string current, Action<string> pick) =>
        @<div class="pe-swatch-row" role="radiogroup">
            @foreach (var (hex, name) in colours)
            {
                var h = hex;
                <button type="button" class="pe-mini-swatch @(string.Equals(current, h, StringComparison.OrdinalIgnoreCase) ? "active" : "")" style="background:@h"
                        title="@name" aria-label="@name" role="radio" aria-checked="@(string.Equals(current, h, StringComparison.OrdinalIgnoreCase) ? "true" : "false")" @onclick="() => pick(h)"></button>
            }
        </div>;

    private RenderFragment TextFormatControls(bool colours) =>
        @<text>
            <div class="pe-stack">
                <div class="pe-field-inline">
                    <span>Size</span>
                    <select value="@_fontSize" @onchange="FontSizeChanged" aria-label="Text size">
                        @foreach (var s in new[] { 6, 8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 36, 48, 72 })
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                    <RibbonButton Compact Glyph="A-" Label="Smaller text" OnClick="() => StepFontSize(-1)" />
                    <RibbonButton Compact Glyph="A+" Label="Larger text" OnClick="() => StepFontSize(1)" />
                </div>
                <div class="pe-row">
                    <RibbonButton Compact Glyph="B" GlyphStyle="font-weight:800" Label="Bold" Active="_bold" OnClick="ToggleBold" />
                    <RibbonButton Compact Glyph="I" GlyphStyle="font-style:italic;font-family:serif" Label="Italic" Active="_italic" OnClick="ToggleItalic" />
                    <RibbonButton Compact Glyph="U" GlyphStyle="text-decoration:underline" Label="Underline" Active="_underline" OnClick="ToggleUnderline" />
                    @if (!colours)
                    {
                        <RibbonButton Compact Icon="bi-text-left" Label="Align left" Active="@(_textAlign == TextAlign.Left)" OnClick="() => SetTextAlign(TextAlign.Left)" />
                        <RibbonButton Compact Icon="bi-text-center" Label="Centre" Active="@(_textAlign == TextAlign.Center)" OnClick="() => SetTextAlign(TextAlign.Center)" />
                        <RibbonButton Compact Icon="bi-text-right" Label="Align right" Active="@(_textAlign == TextAlign.Right)" OnClick="() => SetTextAlign(TextAlign.Right)" />
                        <RibbonButton Compact Glyph="AA" Label="Force UPPERCASE text" Active="_upper" OnClick="ToggleUpper" />
                    }
                </div>
                @if (colours)
                {
                    @Swatches(TextColours, _textColor, SetTextColour)
                }
            </div>
        </text>;

    private RenderFragment ArrangeButtons(Action<ArrangeOp> run, bool disabled) =>
        @<text>
            @foreach (var chunk in Arrange.Commands.Chunk(3))
            {
                <div class="pe-stack">
                    @foreach (var c in chunk)
                    {
                        var op = c.Op;
                        <RibbonButton Icon="@c.Icon" Label="@c.Label" Title="@c.Hint" Disabled="disabled" OnClick="() => run(op)" />
                    }
                </div>
            }
        </text>;

    private RenderFragment StampPicker() =>
        @<select class="pe-stamp-pick" value="@_stampKey" @onchange="e => PickStamp(e.Value?.ToString() ?? _stampKey)" aria-label="Choose a stamp" disabled="@NoDoc">
            @foreach (var g in StampGroups)
            {
                <optgroup label="@g.Key">
                    @foreach (var d in g)
                    {
                        <option value="@StampCatalog.KeyOf(d)">@d.Title</option>
                    }
                </optgroup>
            }
        </select>;
}

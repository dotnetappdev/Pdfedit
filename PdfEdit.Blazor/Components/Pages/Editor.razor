                        <RibbonButton Icon="bi-trash3" Label="Clear Chat" Title="Clear the AI chat history" Disabled="@(AiHistory.Count == 0)" OnClick="ClearAiChat" />
                        <RibbonButton Icon="bi-ui-checks" Label="Fill Fields" Title="Fill the form using what you typed in the chat box" Disabled="@(NoDoc || AiRunning || FieldCount == 0)" OnClick="AiFillFromChatAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Document AI">
                    <RibbonButton Large Icon="bi-magic" Label="Smart Fill" Title="The AI reads the document and fills every form field" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("smartfill"))" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-card-text" Label="Summarize" Title="Parties, dates and key points" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("summarize"))" />
                        <RibbonButton Icon="bi-table" Label="Extract Data" Title="Names, dates, addresses, amounts and reference numbers" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("extract"))" />
                        <RibbonButton Icon="bi-translate" Label="Translate" Title="Translate the text in the chat" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("translate"))" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-briefcase" Label="Contract" Title="Parties, obligations, risks and missing clauses" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("contract"))" />
                        <RibbonButton Icon="bi-person-badge" Label="Find PII" Title="Personal information that should be redacted" Disabled="@(NoDoc || AiRunning)" OnClick="@(() => RunAiPresetAsync("pii"))" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Provider">
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <span>Provider</span>
                            <select value="@AiProvider" @onchange="ProviderChanged" aria-label="AI provider">
                                @foreach (var p in AiProviderService.Providers.Keys) { <option value="@p">@(p == AiProviderService.LocalProvider ? "Local AI" : p)</option> }
                            </select>
                        </div>
                        <div class="pe-field-inline">
                            <span>Model</span>
                            <select @bind="AiModel" aria-label="AI model" style="max-width:140px">
                                @foreach (var m in AiModels) { <option value="@m">@ModelName(m)</option> }
                            </select>
                        </div>
                        <span class="pe-field-inline" style="color:var(--pe-dim)">@(AiReady ? "✓ Ready" : "No API key")</span>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Profiles">
                    <RibbonButton Large Icon="bi-person-vcard" Label="Manage Profiles" Title="Store your name, address and more for filling forms in one click" OnClick="() => ShowDialog(DialogKind.Profiles)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-lightning-charge" Label="Quick Fill" Title="Fill the matching form fields from the chosen profile" Disabled="@(NoDoc || FieldCount == 0 || CurrentProfile == null)" OnClick="QuickFill" />
                        <div class="pe-field-inline">
                            <span>Profile</span>
                            <select @bind="ProfileId" aria-label="Profile" style="max-width:130px">
                                @if (Profiles.Count == 0) { <option value="">(none yet)</option> }
                                @foreach (var pr in Profiles) { <option value="@pr.Id">@pr.DisplayName</option> }
                            </select>
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Setup">
                    <RibbonButton Large Icon="bi-key" Label="API Keys" Title="Add your Claude, OpenAI or GitHub key for this session" OnClick="() => ShowDialog(DialogKind.AiSettings)" />
                </RibbonGroup>
                break;

            case RibbonTab.Design:
                var sel = SelectedDesignItem;
                bool noSel = sel == null;
                <RibbonGroup Title="View Mode">
                    <RibbonButton Large Icon="bi-file-earmark-text" Label="PDF View" Title="Back to the PDF" Active="!DesignMode" OnClick="() => SetDesignMode(false)" />
                    <RibbonButton Large Icon="bi-pencil-square" Label="Design View" Title="The design canvas" Active="DesignMode" OnClick="() => SetDesignMode(true)" />
                </RibbonGroup>
                <RibbonGroup Title="AI">
                    <RibbonButton Large Icon="bi-magic" Label="Design Form with AI" Title="Describe the form you need and the AI lays it out" Disabled="AiRunning" OnClick="() => ShowDialog(DialogKind.DesignAi)" />
                </RibbonGroup>
                <RibbonGroup Title="Canvas">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-earmark-plus" Label="New Design" Title="A blank design page" OnClick="NewDesignPage" />
                        <RibbonButton Icon="bi-file-earmark-pdf" Label="Export PDF" Title="Download the design as a fillable PDF" OnClick="ExportDesignAsync" />
                        <RibbonButton Icon="bi-box-arrow-in-right" Label="Open as PDF" Title="Make the PDF and open it in the PDF view" OnClick="OpenDesignAsPdfAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-earmark-arrow-down" Label="Import PDF Page" Title="Replace the canvas with an editable copy of the current PDF page (text, pictures and boxes)" Disabled="NoDoc" OnClick="ImportPdfPageAsync" />
                        <RibbonButton Icon="bi-arrow-counterclockwise" Label="Undo" Title="Undo (Ctrl+Z)" Disabled="!CanUndoDesign" OnClick="UndoDesign" />
                        <RibbonButton Icon="bi-arrow-clockwise" Label="Redo" Title="Redo (Ctrl+Y)" Disabled="!CanRedoDesign" OnClick="RedoDesign" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Design File">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-download" Label="Save Design" Title="Download the design (.pdfdesign) to open later here or in the Windows app" OnClick="SaveDesignAsync" />
                        <RibbonButton Icon="bi-folder2-open" Label="Load Design" Title="Open a .pdfdesign file" OnClick="() => ShowDialog(DialogKind.OpenDesign)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-floppy" Label="Save Draft" Title="Keep the design in this browser now — it's also kept every few seconds — so reloading or closing the page doesn't lose it" OnClick="SaveDraftNowAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Templates">
                    <RibbonButton Icon="bi-grid-3x2-gap" Label="All Templates" Large="true" Title="Choose from every template: invoices, forms, resumes, flyers, certificates, planners…" OnClick="() => OpenBackstage(Backstage.New)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-receipt" Label="Invoice" Title="A professional invoice" OnClick="@(() => LoadTemplate("Invoice"))" />
                        <RibbonButton Icon="bi-envelope-paper" Label="Letter" Title="A formal letter" OnClick="@(() => LoadTemplate("Letter"))" />
                        <RibbonButton Icon="bi-ui-radios" Label="Form" Title="A general form" OnClick="@(() => LoadTemplate("Form"))" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-award" Label="Cert." Title="A certificate" OnClick="@(() => LoadTemplate("Certificate"))" />
                        <RibbonButton Icon="bi-person-badge" Label="Business Card" Title="A business card (85 × 54 mm)" OnClick="@(() => LoadTemplate("BusinessCard"))" />
                        <RibbonButton Icon="bi-file-person" Label="Resume" Title="A resumé / CV" OnClick="@(() => LoadTemplate("Resume"))" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-megaphone" Label="Flyer" Title="A promotional flyer" OnClick="@(() => LoadTemplate("Flyer"))" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Insert">
                    @DesignToolButton(DesignTool.Select, "bi-cursor", "Select", "Select and move elements (Ctrl+click to select more)", large: true)
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.Text, "bi-fonts", "Text Box", "Add a text block")
                        @DesignToolButton(DesignTool.Rectangle, "bi-square", "Rectangle", "Draw a rectangle")
                        @DesignToolButton(DesignTool.Ellipse, "bi-circle", "Ellipse", "Draw an ellipse or circle")
                    </div>
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.Table, "bi-table", "Table", "Insert a table")
                        @DesignToolButton(DesignTool.Line, "bi-slash-lg", "Line", "Draw a straight line")
                        @DesignToolButton(DesignTool.Arrow, "bi-arrow-up-right", "Arrow", "Draw an arrow")
                    </div>
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.Pen, "bi-pen", "Pen", "Freehand drawing")
                        <RibbonButton Icon="bi-image" Label="Image" Title="Insert a picture" OnClick="() => { SetDesignMode(true); ShowDialog(DialogKind.DesignPicture); }" />
                        @DesignToolButton(DesignTool.Check, "bi-check-lg", "Check ✓", "Insert a checkmark")
                    </div>
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.Cross, "bi-x-lg", "X Mark ✗", "Insert an X mark")
                        <RibbonButton Icon="bi-vector-pen" Label="Signature" Title="Your signature as a picture" OnClick="AddDesignSignature" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Form Fields">
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.TextField, "bi-input-cursor-text", "Text Field", "A one-line text field")
                        @DesignToolButton(DesignTool.Memo, "bi-textarea-t", "Multi-line", "A multi-line text field")
                        @DesignToolButton(DesignTool.Checkbox, "bi-check2-square", "Checkbox", "A check box")
                    </div>
                    <div class="pe-stack">
                        @DesignToolButton(DesignTool.Radio, "bi-record-circle", "Radio", "An option button (same name = same group)")
                        @DesignToolButton(DesignTool.ComboBox, "bi-menu-button-wide", "Dropdown", "A dropdown list")
                        @DesignToolButton(DesignTool.Signature, "bi-pen", "Signature Field", "A signature field")
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Text Format">
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <select value="@(sel?.FontFamily ?? "Helvetica")" @onchange="e => DesignFormat(x => x.FontFamily = e.Value?.ToString())" disabled="@noSel" aria-label="Font" style="width:104px">
                                @foreach (var f in DesignFonts) { <option value="@f">@f</option> }
                            </select>
                            <input type="number" min="4" max="144" value="@Css(sel?.FontSize > 0 ? sel.FontSize : 12)" @onchange="e => DesignFormat(x => x.FontSize = Num(e, x.FontSize))" disabled="@noSel" aria-label="Font size" style="width:46px" />
                        </div>
                        <div class="pe-row">
                            <RibbonButton Compact Glyph="B" GlyphStyle="font-weight:800" Label="Bold" Disabled="noSel" Active="@(sel?.Bold == true)" OnClick="() => DesignFormat(x => x.Bold = !x.Bold)" />
                            <RibbonButton Compact Glyph="I" GlyphStyle="font-style:italic;font-family:serif" Label="Italic" Disabled="noSel" Active="@(sel?.Italic == true)" OnClick="() => DesignFormat(x => x.Italic = !x.Italic)" />
                            <RibbonButton Compact Glyph="U" GlyphStyle="text-decoration:underline" Label="Underline" Disabled="noSel" Active="@(sel?.Underline == true)" OnClick="() => DesignFormat(x => x.Underline = !x.Underline)" />
                            <RibbonButton Compact Icon="bi-text-wrap" Label="Wrap" Title="Wrap text within the element's width (text, text fields and multi-line fields)" Disabled="noSel" Active="@(sel?.Wrap == true)" OnClick="() => DesignFormat(x => x.Wrap = !x.Wrap)" />
                        </div>
                        <div class="pe-row">
                            <RibbonButton Compact Icon="bi-text-left" Label="Left" Disabled="noSel" Active="@(sel?.Alignment is null or "Left")" OnClick="@(() => DesignFormat(x => x.Alignment = "Left"))" />
                            <RibbonButton Compact Icon="bi-text-center" Label="Center" Disabled="noSel" Active="@(sel?.Alignment == "Center")" OnClick="@(() => DesignFormat(x => x.Alignment = "Center"))" />
                            <RibbonButton Compact Icon="bi-text-right" Label="Right" Disabled="noSel" Active="@(sel?.Alignment == "Right")" OnClick="@(() => DesignFormat(x => x.Alignment = "Right"))" />
                        </div>
                    </div>
                    <div class="pe-stack">
                        <div class="pe-field-inline" title="Text colour">
                            <span>Text</span>
                            <input type="color" value="@DesignColor.ToCss(sel?.Color, "#000000")" @onchange="e => DesignFormat(x => x.Color = Argb(e))" disabled="@noSel" aria-label="Text colour" />
                        </div>
                        <div class="pe-field-inline" title="Text highlight / background colour">
                            <span>Highlight</span>
                            <input type="color" value="@DesignColor.ToCss(sel?.BgColor, "#ffffff")" @onchange="e => DesignFormat(x => x.BgColor = Argb(e))" disabled="@noSel" aria-label="Highlight colour" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Shape Format">
                    <div class="pe-stack">
                        <div class="pe-field-inline"><span>Line Width</span><input type="number" min="0" max="20" step="0.5" value="@Css(sel?.StrokeThick ?? 1)" @onchange="e => DesignFormat(x => x.StrokeThick = Num(e, x.StrokeThick))" disabled="@noSel" aria-label="Line width" style="width:46px" /></div>
                        <div class="pe-field-inline"><span>Corner Radius</span><input type="number" min="0" max="100" value="@Css(sel?.CornerRadius ?? 0)" @onchange="e => DesignFormat(x => x.CornerRadius = Num(e, x.CornerRadius))" disabled="@noSel" aria-label="Corner radius" style="width:46px" /></div>
                        <div class="pe-field-inline"><span>Opacity %</span><input type="number" min="0" max="100" step="5" value="@((int)Math.Round((sel?.Opacity ?? 1) * 100))" @onchange="e => DesignFormat(x => x.Opacity = Math.Clamp(Num(e, x.Opacity * 100) / 100, 0, 1))" disabled="@noSel" aria-label="Opacity percent" style="width:46px" /></div>
                    </div>
                    <div class="pe-stack">
                        <div class="pe-field-inline"><span>Fill</span><input type="color" value="@DesignColor.ToCss(sel?.FillColor, "#ffffff")" @onchange="e => DesignFormat(x => x.FillColor = Argb(e))" disabled="@noSel" aria-label="Fill colour" /></div>
                        <div class="pe-field-inline"><span>Stroke</span><input type="color" value="@DesignColor.ToCss(sel?.StrokeColor, "#000000")" @onchange="e => DesignFormat(x => x.StrokeColor = Argb(e))" disabled="@noSel" aria-label="Stroke colour" /></div>
                        <RibbonButton Icon="@(sel?.IsLocked == true ? "bi-lock-fill" : "bi-unlock")" Label="Lock" Title="Lock the element so it can't be moved by accident" Disabled="noSel" Active="@(sel?.IsLocked == true)" OnClick="() => DesignFormat(x => x.IsLocked = !x.IsLocked)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Field">
                    @{ bool notField = sel?.Type != "field"; }
                    <div class="pe-stack">
                        <div class="pe-row">
                            <RibbonButton Compact Icon="bi-box-arrow-in-left" Label="Left" Title="Label to the left of the field" Disabled="notField" Active="@(sel?.LabelPosition is null or "Left")" OnClick="@(() => DesignFormat(x => x.LabelPosition = "Left"))" />
                            <RibbonButton Compact Icon="bi-box-arrow-in-right" Label="Right" Title="Label to the right of the field" Disabled="notField" Active="@(sel?.LabelPosition == "Right")" OnClick="@(() => DesignFormat(x => x.LabelPosition = "Right"))" />
                            <RibbonButton Compact Icon="bi-input-cursor" Label="Inside" Title="Label shown as a hint inside the field" Disabled="notField" Active="@(sel?.LabelPosition == "Placeholder")" OnClick="@(() => DesignFormat(x => x.LabelPosition = "Placeholder"))" />
                            <RibbonButton Compact Icon="bi-slash-circle" Label="None" Title="No label" Disabled="notField" Active="@(sel?.LabelPosition == "None")" OnClick="@(() => DesignFormat(x => x.LabelPosition = "None"))" />
                        </div>
                        <div class="pe-field-inline"><span>Label Gap</span><input type="number" min="0" max="60" value="@Css(sel?.LabelOffset ?? 6)" @onchange="e => DesignFormat(x => x.LabelOffset = Num(e, x.LabelOffset))" disabled="@notField" aria-label="Label gap" style="width:46px" /></div>
                        <RibbonButton Icon="bi-asterisk" Label="Required" Title="Mark this field as required" Disabled="notField" Active="@(sel?.Required == true)" OnClick="() => DesignFormat(x => x.Required = !x.Required)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Pen Format">
                    <div class="pe-stack">
                        <div class="pe-field-inline"><span>Pen Size</span><input type="number" min="0.5" max="20" step="0.5" @bind="DesignPenWidth" aria-label="Pen size" style="width:46px" /></div>
                        <div class="pe-field-inline"><span>Pen Color</span><input type="color" @bind="DesignPenColor" aria-label="Pen colour" /></div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Align">
                    @ArrangeButtons(op => ArrangeDesign(op), SelectedDesignIds.Count == 0)
                </RibbonGroup>
                <RibbonGroup Title="Arrange">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-layer-forward" Label="Bring Forward" Title="One layer up" Disabled="noSel" OnClick="() => MoveDesignLayer(1)" />
                        <RibbonButton Icon="bi-layer-backward" Label="Send Backward" Title="One layer down" Disabled="noSel" OnClick="() => MoveDesignLayer(-1)" />
                        <RibbonButton Icon="bi-front" Label="To Front" Title="In front of everything" Disabled="noSel" OnClick="BringToFront" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-back" Label="To Back" Title="Behind everything" Disabled="noSel" OnClick="SendToBack" />
                        <RibbonButton Icon="bi-copy" Label="Duplicate" Title="Duplicate (Ctrl+D)" Disabled="noSel" OnClick="DuplicateDesignItem" />
                        <RibbonButton Icon="bi-trash" Label="Delete" Title="Delete (Del)" Disabled="noSel" OnClick="DeleteDesignItem" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Page">
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <span>Page Size</span>
                            <select value="@Design.PageSize" @onchange="e => SetDesignPage(e.Value?.ToString() ?? Design.PageSize)" aria-label="Page size">
                                @foreach (var ps in new[] { "A4", "Letter", "A3", "Custom" }) { <option value="@ps">@ps</option> }
                            </select>
                        </div>
                        <div class="pe-row">
                            <RibbonButton Compact Icon="bi-grid-3x3" Label="Grid" Title="Show the grid" Active="DesignGrid" OnClick="() => DesignGrid = !DesignGrid" />
                            <RibbonButton Compact Icon="bi-magnet" Label="Snap" Title="Snap to the grid while moving" Active="DesignSnap" OnClick="() => DesignSnap = !DesignSnap" />
                            <RibbonButton Compact Icon="bi-zoom-in" Label="Zoom In" OnClick="() => Zoom(1.25)" />
                            <RibbonButton Compact Icon="bi-zoom-out" Label="Zoom Out" OnClick="() => Zoom(0.8)" />
                            <RibbonButton Compact Icon="bi-arrows-angle-contract" Label="Fit" Title="Fit the page in the window" OnClick="FitDesignAsync" />
                        </div>
                        <div class="pe-field-inline">
                            <span>Bg Color</span>
                            <input type="color" value="@DesignColor.ToCss(Design.BgColor, "#ffffff")" @onchange="@(e => SetDesignBackground(e.Value?.ToString() ?? "#ffffff"))" aria-label="Page colour" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Position &amp; Size">
                    <div class="pe-stack">
                        <div class="pe-field-inline"><span>X</span><input type="number" value="@Css(Math.Round(sel?.X ?? 0))" @onchange="e => DesignFormat(x => x.X = Num(e, x.X))" disabled="@noSel" aria-label="X position" style="width:52px" /><span>Y</span><input type="number" value="@Css(Math.Round(sel?.Y ?? 0))" @onchange="e => DesignFormat(x => x.Y = Num(e, x.Y))" disabled="@noSel" aria-label="Y position" style="width:52px" /></div>
                        <div class="pe-field-inline"><span>W</span><input type="number" min="1" value="@Css(Math.Round(sel?.W ?? 0))" @onchange="e => DesignFormat(x => x.W = Math.Max(1, Num(e, x.W)))" disabled="@noSel" aria-label="Width" style="width:52px" /><span>H</span><input type="number" min="1" value="@Css(Math.Round(sel?.H ?? 0))" @onchange="e => DesignFormat(x => x.H = Math.Max(1, Num(e, x.H)))" disabled="@noSel" aria-label="Height" style="width:52px" /></div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Export Image">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-filetype-png" Label="PNG" Title="Download the design as a PNG picture" OnClick="@(() => ExportDesignImageAsync("png"))" />
                        <RibbonButton Icon="bi-filetype-jpg" Label="JPEG" Title="Download the design as a JPEG picture" OnClick="@(() => ExportDesignImageAsync("jpeg"))" />
                    </div>

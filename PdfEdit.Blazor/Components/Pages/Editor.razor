                        @ToolButton(Tool.FieldCheckbox, "bi-check2-square", "Checkbox", "Add Checkbox — click where the box should go")
                        @ToolButton(Tool.FieldCombo, "bi-menu-button-wide", "Combo Box", "Add Combo Box — drag a rectangle for a dropdown")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.FieldRadio, "bi-record-circle", "Radio Button", "Add Radio Button — click where it should go")
                        @ToolButton(Tool.FieldList, "bi-list-ul", "List Box", "Add List Box — drag a rectangle")
                        @ToolButton(Tool.FieldDate, "bi-calendar-date", "Date Field", "Add Date Field — drag a rectangle")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.FieldSignature, "bi-pen", "Signature Field", "Add Signature Field — drag a rectangle")
                        <RibbonButton Icon="bi-sliders" Label="Field Properties" Title="Name, tooltip, required, read only, format …" Disabled="@(SelectedFieldInfo == null)" OnClick="() => ShowRight(RightTab.Properties)" />
                        <RibbonButton Icon="bi-check2-circle" Label="Apply Changes" Title="Write the moved, resized, changed and deleted fields into the PDF" Disabled="@(NoDoc || !HasPending)" OnClick="CommitAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Arrange Fields">
                    @ArrangeButtons(op => ArrangeFields(op), NoDoc || SelectedWidgets.Count == 0)
                </RibbonGroup>
                break;

            case RibbonTab.View:
                <RibbonGroup Title="Zoom">
                    <RibbonButton Large Icon="bi-zoom-in" Label="Zoom In" Title="Zoom in (Ctrl++)" Disabled="NoDoc" OnClick="() => Zoom(1.25)" />
                    <RibbonButton Large Icon="bi-zoom-out" Label="Zoom Out" Title="Zoom out (Ctrl+-)" Disabled="NoDoc" OnClick="() => Zoom(0.8)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-fullscreen" Label="Fit Page" Title="Fit the whole page in the window" Disabled="NoDoc" OnClick="FitPageAsync" />
                        <RibbonButton Icon="bi-arrows-expand-vertical" Label="Fit Width" Title="Fit the page width to the window" Disabled="NoDoc" OnClick="FitWidthAsync" />
                        <RibbonButton Icon="bi-1-square" Label="100%" Title="Actual size (Ctrl+0)" Disabled="NoDoc" OnClick="() => SetZoom(1)" />
                    </div>
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <span>Zoom %</span>
                            <input type="number" min="25" max="400" step="5" value="@((int)Math.Round(_zoom * 100))" @onchange="ZoomBoxChanged" disabled="@NoDoc" aria-label="Zoom percent" style="width:58px" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Rotate Page">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-arrow-clockwise" Label="Rotate CW" Title="Rotate the current page 90° clockwise (Ctrl+])" Disabled="NoDoc" OnClick="() => RotateAsync(90)" />
                        <RibbonButton Icon="bi-arrow-counterclockwise" Label="Rotate CCW" Title="Rotate the current page 90° anticlockwise (Ctrl+[)" Disabled="NoDoc" OnClick="() => RotateAsync(-90)" />
                        <RibbonButton Icon="bi-arrow-repeat" Label="Reset Rotation" Title="Turn the current page back upright" Disabled="@(NoDoc || Rotation(_page) == 0)" OnClick="ResetRotationAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-arrow-clockwise" Label="All Pages CW" Title="Rotate every page 90° clockwise" Disabled="NoDoc" OnClick="() => RotateAllAsync(90)" />
                        <RibbonButton Icon="bi-arrow-counterclockwise" Label="All Pages CCW" Title="Rotate every page 90° anticlockwise" Disabled="NoDoc" OnClick="() => RotateAllAsync(-90)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Reading">
                    <RibbonButton Large Icon="bi-easel" Label="Slide Show" Title="Full screen, one page at a time (arrows to move, Esc to leave)" Disabled="NoDoc" OnClick="StartSlideShowAsync" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-book" Label="Two Pages" Title="Show the next page beside this one" Disabled="NoDoc" Active="TwoPages" OnClick="() => TwoPages = !TwoPages" />
                        <RibbonButton Icon="bi-chevron-double-down" Label="Auto Scroll" Title="Scroll through the document by itself; click again to stop" Disabled="NoDoc" Active="AutoScrolling" OnClick="ToggleAutoScrollAsync" />
                        <RibbonButton Icon="bi-moon-stars" Label="Night Mode" Title="Dark pages for reading at night (colours keep their hue)" Disabled="NoDoc" Active="NightMode" OnClick="() => NightMode = !NightMode" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Theme">
                    <RibbonMenu Large Icon="@ThemeIcon(_theme)" Label="Theme" Title="Light, Dark, High Contrast, or follow your device">
                        @foreach (var th in Themes)
                        {
                            var id = th;
                            <button role="menuitemradio" class="@(_theme == id ? "active" : "")" title="@ThemeHint(id)" @onclick="() => SetThemeAsync(id)"><i class="bi @ThemeIcon(id)"></i> @ThemeName(id)</button>
                        }
                    </RibbonMenu>
                </RibbonGroup>
                <RibbonGroup Title="Display">
                    <RibbonButton Large Icon="bi-ui-checks" Label="Highlight Fields" Title="Show or hide the form field highlight" Active="HighlightFields" OnClick="() => HighlightFields = !HighlightFields" />
                </RibbonGroup>
                <RibbonGroup Title="UI Scale">
                    <div class="pe-stack">
                        <div class="pe-row">
                            <RibbonButton Compact Glyph="−" Label="Smaller" Title="Make the window's text and buttons smaller (Ctrl+Shift+−)" Disabled="@(UiScale <= 0.8)" OnClick="() => ChangeUiScaleAsync(-0.1)" />
                            <RibbonButton Compact Glyph="+" Label="Larger" Title="Make the window's text and buttons larger (Ctrl+Shift+=)" Disabled="@(UiScale >= 1.6)" OnClick="() => ChangeUiScaleAsync(0.1)" />
                        </div>
                        <span class="pe-field-inline" style="justify-content:center">@((int)Math.Round(UiScale * 100))%</span>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Bookmarks">
                    <RibbonButton Large Icon="bi-bookmark-plus" Label="Add Bookmark" Title="Add a bookmark for the current page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.AddBookmark)" />
                </RibbonGroup>
                <RibbonGroup Title="Attachments">
                    <RibbonButton Large Icon="bi-paperclip" Label="Attach File" Title="Attach a file to this PDF, or see the files attached" Disabled="NoDoc" OnClick="ShowAttachmentsAsync" />
                </RibbonGroup>
                <RibbonGroup Title="Annotations">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-box-arrow-up" Label="Export XFDF" Title="All comments and markup as an XFDF file — opens in Acrobat and Foxit" Disabled="NoDoc" OnClick="ExportXfdfAsync" />
                        <RibbonButton Icon="bi-box-arrow-in-down" Label="Import XFDF" Title="Bring in comments from an XFDF file another PDF viewer exported" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.ImportXfdf)" />
                        <RibbonButton Icon="bi-filetype-csv" Label="Ann. Summary" Title="A CSV summary of every comment, for review" Disabled="NoDoc" OnClick="AnnotationSummaryAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Read Aloud">
                    <RibbonButton Large Icon="bi-volume-up" Label="Read Page" Title="Read this page aloud with your browser's voice" Disabled="@(NoDoc || Reading)" OnClick="() => ReadAloudAsync(false)" />
                    <RibbonButton Large Icon="bi-soundwave" Label="Read to End" Title="Read from this page to the end" Disabled="@(NoDoc || Reading)" OnClick="() => ReadAloudAsync(true)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="@(ReadingPaused ? "bi-play-fill" : "bi-pause-fill")" Label="@(ReadingPaused ? "Resume" : "Pause")" Disabled="!Reading" OnClick="PauseReadingAsync" />
                        <RibbonButton Icon="bi-stop-fill" Label="Stop Reading" Disabled="!Reading" OnClick="StopReadingAsync" />
                        <div class="pe-field-inline">
                            <span>Speed</span>
                            <select @bind="ReadRate" aria-label="Reading speed">
                                <option value="0.75">Slow</option><option value="1">Normal</option><option value="1.25">Fast</option><option value="1.5">Faster</option>
                            </select>
                        </div>
                    </div>
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <span>Voice</span>
                            <select @bind="ReadVoice" @onfocus="LoadVoicesAsync" aria-label="Voice" style="max-width:150px">
                                <option value="">Default voice</option>
                                @foreach (var v in Voices) { <option value="@v">@v</option> }
                            </select>
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Find &amp; Compare">
                    <RibbonButton Large Icon="bi-folder2-open" Label="Search PDFs" Title="Find text in a folder of PDFs (choose the folder or the files)" OnClick="() => ShowDialog(DialogKind.SearchFolder)" />
                    <RibbonButton Large Icon="bi-intersect" Label="Visual Compare" Title="Compare two PDFs page by page — added, removed and changed content in colour" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.CompareUpload)" />
                </RibbonGroup>
                <RibbonGroup Title="Document">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-bar-chart-line" Label="Document Statistics" Title="Pages, words, comments and file size" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Statistics)" />
                        <RibbonButton Icon="bi-universal-access" Label="Accessibility Check" Title="Check the PDF works with screen readers and keyboards, and fix the common problems" Disabled="NoDoc" OnClick="AccessibilityCheckAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Panels">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-grid-3x3-gap" Label="All Tools" Title="Show or hide the All tools pane" Active="_showTools" OnClick="() => _showTools = !_showTools" />
                        <RibbonButton Icon="bi-layout-sidebar" Label="Thumbnails" Title="Show or hide the page thumbnails" Active="_showLeft" OnClick="() => _showLeft = !_showLeft" />
                        <RibbonButton Icon="bi-layout-sidebar-reverse" Label="Side Panel" Active="_showRight" OnClick="() => _showRight = !_showRight" />
                        <RibbonButton Icon="bi-bookmark" Label="Bookmarks" Disabled="NoDoc" OnClick="() => ShowRight(RightTab.Bookmarks)" />
                        <RibbonButton Icon="bi-chat-left-text" Label="Comments" Disabled="NoDoc" OnClick="() => ShowRight(RightTab.Comments)" />
                    </div>
                </RibbonGroup>
                break;

            case RibbonTab.Tools:
                <RibbonGroup Title="Active Tool">
                    <div class="pe-stack">
                        @ToolButton(Tool.Hand, "bi-hand-index", "Hand", "Hand / pan tool (H)")
                        @ToolButton(Tool.Select, "bi-cursor", "Select", "Selection tool (V) — click form fields to fill them in")
                        <RibbonButton Icon="bi-input-cursor-text" Label="Text Fill" Title="Text fill — click a form field to type in it" Disabled="NoDoc" OnClick="FillFieldTool" />
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Zoom, "bi-zoom-in", "Zoom", "Zoom tool — drag a rectangle to zoom in (Z)")
                        @ToolButton(Tool.SelectText, "bi-textarea-t", "Select Text", "Select text or an area to copy, highlight, snapshot or ask the AI about (Shift+S)")
                        @ToolButton(Tool.EditImages, "bi-image-alt", "Edit Images", "Edit Images — click a picture in the PDF to move, resize, replace, save or delete it")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Snapshot, "bi-camera", "Snapshot", "Snapshot — drag a box round any area, then copy it or save it as a picture")
                        @ToolButton(Tool.Highlight, "bi-highlighter", "Highlight", "Highlight — drag over text (I)")
                        @ToolButton(Tool.Underline, "bi-type-underline", "Underline", "Underline — drag over text")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Squiggly, "bi-water", "Squiggly", "Squiggly underline — drag under text")
                        @ToolButton(Tool.Strikeout, "bi-type-strikethrough", "Strikethrough", "Strikethrough — drag over text")
                        @ToolButton(Tool.Redact, "bi-eraser-fill", "Redact", "Mark for redaction — drag over what to remove for good")
                    </div>
                    <RibbonButton Large Icon="bi-shield-check" Label="Apply Redactions" Title="Permanently remove the marked areas from the PDF" Disabled="@(NoDoc || !_items.Any(i => i.Kind == ItemKind.Redact))" OnClick="CommitAsync" />
                </RibbonGroup>
                <RibbonGroup Title="Drawing">
                    <div class="pe-stack">
                        @ToolButton(Tool.Ink, "bi-brush", "Freehand", "Freehand draw — drag to draw ink strokes")
                        @ToolButton(Tool.Link, "bi-link-45deg", "Link", "Link — drag a rectangle to add a link (web page, email, phone or page)")
                        <RibbonButton Icon="bi-x-circle" Label="Remove Links" Title="Remove every link from this PDF (Undo brings them back)" Disabled="NoDoc" OnClick="RemoveLinksAsync" />
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Note, "bi-sticky", "Sticky Note", "Sticky note — click the page to place a comment")
                        @ToolButton(Tool.InsertText, "bi-caret-up", "Insert Text", "Insert text — click where text is missing and type what to insert")
                        @ToolButton(Tool.ReplaceText, "bi-input-cursor", "Replace Text", "Replace text — drag across the words, then type the replacement")
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-chat-left-text" Label="Comments" Title="Show the Comments list" Disabled="NoDoc" OnClick="() => ShowRight(RightTab.Comments)" />
                        @ToolButton(Tool.Rectangle, "bi-square", "Rectangle", "Rectangle — drag to draw")
                        @ToolButton(Tool.Ellipse, "bi-circle", "Ellipse", "Ellipse — drag to draw")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Arrow, "bi-arrow-up-right", "Arrow", "Arrow — drag to draw")
                        @ToolButton(Tool.Callout, "bi-chat-square-text", "Callout", "Callout — drag a box, then type")
                        @ToolButton(Tool.Line, "bi-slash-lg", "Line", "Line — drag to draw a straight line")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Cloud, "bi-cloud", "Cloud", "Cloud — drag to draw a revision cloud")
                        @ToolButton(Tool.Polygon, "bi-pentagon", "Polygon", "Polygon — click the corners, double-click or Enter to close")
                        @ToolButton(Tool.Polyline, "bi-bezier2", "Polyline", "Polyline — click the points, double-click or Enter to finish")
                    </div>
                    <div class="pe-stack">
                        @ToolButton(Tool.Eraser, "bi-eraser", "Eraser", "Eraser — click a comment or drawing to remove it")
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Measure">
                    <div class="pe-stack">
                        @ToolButton(Tool.Distance, "bi-rulers", "Distance", "Distance — drag between two points")
                        @ToolButton(Tool.Perimeter, "bi-bezier2", "Perimeter", "Perimeter — click the points, double-click or Enter to finish")
                        @ToolButton(Tool.Area, "bi-pentagon", "Area", "Area — click the corners, double-click or Enter to finish")
                    </div>
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <span>Units</span>
                            <select @bind="_measureUnit" aria-label="Measurement units">
                                <option value="in">in</option>
                                <option value="cm">cm</option>
                                <option value="mm">mm</option>
                                <option value="pt">pt</option>
                            </select>
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Sign &amp; Date">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-pen" Label="Signature" Title="Signature — click a signature field or the page (S)" Disabled="NoDoc" Active="_tool == Tool.Signature" OnClick="SignatureToolAsync" />
                        @ToolButton(Tool.Date, "bi-calendar-event", "Date Stamp", "Date stamp — click the page to place today's date (D)")
                        @ToolButton(Tool.Stamp, "bi-postage", "Stamp", "Rubber stamp — click the page to place it (M)")
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-collection" Label="Stamps…" Title="Choose the stamp; create, edit or delete your own" OnClick="() => ShowDialog(DialogKind.Stamps)" />
                        <RibbonButton Icon="bi-plus-square" Label="New Stamp" Title="Create a custom stamp with your own text and colour" OnClick="NewCustomStamp" />
                        <RibbonButton Icon="bi-dash-square" Label="Remove Custom" Title="Remove the chosen custom stamp" Disabled="@(SelectedCustomStamp == null)" OnClick="RemoveSelectedCustomStampAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Marks">
                    <div class="pe-stack">
                        <div class="pe-row">
                            @ToolButton(Tool.Check, "bi-check-lg", "Check", "Checkmark ✓", compact: true)
                            @ToolButton(Tool.Cross, "bi-x-lg", "Cross", "Cross ✕", compact: true)
                        </div>
                        <div class="pe-row">
                            @ToolButton(Tool.Dot, "bi-circle-fill", "Dot", "Dot ●", compact: true)
                            @ToolButton(Tool.Circle, "bi-circle", "Circle", "Circle ○", compact: true)
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Highlight Color">
                    <div class="pe-stack">
                        @Swatches(HighlightColors, _highlightColor, c => _highlightColor = c)
                        <div class="pe-field-inline" title="Highlight opacity (10%–100%)">
                            <span>Opacity</span>
                            <input type="number" min="10" max="100" step="10" @bind="HighlightOpacityPercent" aria-label="Highlight opacity percent" style="width:52px" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Stroke Width">
                    <div class="pe-stack">
                        <div class="pe-field-inline" title="Stroke width for shapes, arrows and freehand drawing">
                            <select @bind="_inkWidth" aria-label="Stroke width">
                                @foreach (var pw in new[] { 0.5, 1.0, 2.0, 3.0, 5.0, 8.0, 12.0 })
                                {
                                    <option value="@pw">@pw pt</option>
                                }
                            </select>
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Drawing Color">
                    <div class="pe-stack">
                        @Swatches(InkColors, _strokeColor, c => _strokeColor = c)
                        <div class="pe-field-inline">
                            <span>Other</span>
                            <input type="color" @bind="_strokeColor" aria-label="Drawing colour" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Annotations">
                    <div class="pe-stack">
                        @ToolButton(Tool.Text, "bi-fonts", "Add Text", "Add Text — click anywhere to place horizontal text")
                        @ToolButton(Tool.VerticalText, "bi-type", "Vertical Text", "Vertical Text — click anywhere to place text running bottom to top")
                        <RibbonButton Icon="bi-trash" Label="Delete" Title="Delete the selected comment, drawing or text" Disabled="@(SelectedItem == null)" OnClick="DeleteSelectedItem" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Text Format">
                    @TextFormatControls(colours: false)
                </RibbonGroup>
                <RibbonGroup Title="Color">
                    <div class="pe-stack">
                        @Swatches(TextColours, _textColor, SetTextColour)
                        <div class="pe-field-inline">
                            <span>Other</span>
                            <input type="color" value="@_textColor" @onchange="e => SetTextColour(e.Value?.ToString() ?? _textColor)" aria-label="Text colour" />
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Recognise Text">
                    <RibbonButton Large Icon="bi-textarea-resize" Label="OCR" Title="Recognise Text: make scanned pages searchable and copyable" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Ocr)" />
                </RibbonGroup>
                break;

            case RibbonTab.Forms:
                <RibbonGroup Title="Fields">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-eraser" Label="Clear All" Title="Clear the values of all form fields" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ClearAllFields" />
                        <RibbonButton Icon="bi-x-square" Label="Delete Field" Title="Delete the selected form field" Disabled="@(SelectedFieldInfo == null)" OnClick="DeleteFieldAnyMode" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-box-arrow-in-down" Label="Import Data" Title="Fill the fields from an exported data or JSON file" Disabled="@(NoDoc || FieldCount == 0)" OnClick="() => ShowDialog(DialogKind.ImportData)" />
                        <RibbonButton Icon="bi-box-arrow-up" Label="Export Data" Title="Download the field values as a tab-separated file" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ExportDataAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Save Options">
                    <RibbonButton Large Icon="bi-download" Label="Save Filled PDF" Title="Download the PDF with its form fields still fillable" Disabled="NoDoc" OnClick="SaveAsync" />
                    <RibbonButton Large Icon="bi-layers" Label="Flatten &amp; Save" Title="Download with the fields baked in (no longer fillable)" Disabled="NoDoc" OnClick="SaveFlattenedAsync" />
                </RibbonGroup>
                break;

            case RibbonTab.AI:
                <RibbonGroup Title="Assist">
                    @ToolButton(Tool.SelectText, "bi-textarea-t", "Select Text", "Drag over text or an area, then Explain, Summarise, Rewrite, Translate or Ask (Shift+S)", large: true)
                    <RibbonButton Large Icon="bi-list-nested" Label="Outline" Title="A summary outline with key points and page links" Disabled="@(NoDoc || AiRunning)" OnClick="AiOutlineAsync" />
                    <RibbonMenu Large Icon="bi-pencil" Label="Write" Title="Write something from this document" Disabled="@(NoDoc || AiRunning)">
                        @foreach (var (key, label) in WritePresets)
                        {
                            var k = key;
                            <button role="menuitem" @onclick="() => AiWriteAsync(k)">@label</button>
                        }
                    </RibbonMenu>
                    <RibbonButton Large Icon="@(Listening ? "bi-mic-fill" : "bi-mic")" Label="Ask by Voice" Title="Click, then speak your question" Active="Listening" OnClick="AskByVoiceAsync" />
                </RibbonGroup>
                <RibbonGroup Title="Documents">
                    <RibbonButton Large Icon="bi-globe2" Label="Translate PDF" Title="A translated copy that keeps the layout" Disabled="@(NoDoc || AiRunning)" OnClick="ShowTranslate" />
                    <RibbonButton Large Icon="bi-files" Label="Ask Across PDFs" Title="Ask one question about several PDFs; answers cite file and page" Disabled="AiRunning" OnClick="() => ShowDialog(DialogKind.AskAcross)" />
                    <RibbonButton Large Icon="bi-magic" Label="Design Form with AI" Title="Describe the form you need and the AI lays it out on the design canvas" Disabled="AiRunning" OnClick="() => ShowDialog(DialogKind.DesignAi)" />
                    <RibbonButton Large Icon="bi-diagram-3" Label="Mind Map" Title="The document as a mind map; click a topic to go to its page" Disabled="@(NoDoc || AiRunning)" OnClick="MindMapAsync" />
                </RibbonGroup>
                <RibbonGroup Title="Chat">
                    <RibbonButton Large Icon="bi-chat-dots" Label="Open Chat" Title="Show the AI chat panel" OnClick="() => ShowRight(RightTab.AI)" />

@page "/"
@page "/fill"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@(Doc == null ? "PdfEdit" : $"{Doc.FileName} — PdfEdit")</PageTitle>

<div class="pe-app @ThemeClass @(Settings.ReduceMotion ? "pe-reduce-motion" : "")" data-bs-theme="@(ThemeIsLight ? "light" : "dark")" style="@(UiScale != 1 ? $"zoom:{Css(UiScale)}" : null)">

    @* ── Title bar ─────────────────────────────────────────────────────── *@
    <div class="pe-titlebar">
        <div class="pe-logo" aria-hidden="true">P</div>
        <span class="pe-app-name">PdfEdit</span>
        @if (Doc != null)
        {
            <span class="pe-doc-name">— @Doc.FileName@(Doc.IsModified || HasPending ? " •" : "")</span>
        }
        <span class="pe-spacer"></span>
        <button class="pe-icon-btn" title="Undo (Ctrl+Z)" aria-label="Undo" disabled="@(!CanUndo)" @onclick="UndoAsync"><i class="bi bi-arrow-counterclockwise"></i></button>
        <button class="pe-icon-btn" title="Redo (Ctrl+Y)" aria-label="Redo" disabled="@(!CanRedo)" @onclick="RedoAsync"><i class="bi bi-arrow-clockwise"></i></button>
        <button class="pe-icon-btn" title="@($"Theme: {ThemeName(_theme)} — click for the next one")" aria-label="Switch theme" @onclick="NextThemeAsync">
            <i class="bi @ThemeIcon(_theme)"></i>
        </button>
    </div>

    @* ── Ribbon tabs ───────────────────────────────────────────────────── *@
    <div class="pe-tabs" role="tablist">
        <button class="pe-tab file" role="tab" @onclick="() => OpenBackstage(Doc == null ? Backstage.Open : Backstage.Info)">File</button>
        @foreach (var t in Enum.GetValues<RibbonTab>())
        {
            var tab = t;
            <button class="pe-tab @(_tab == tab ? "active" : "")" role="tab" aria-selected="@(_tab == tab)" @onclick="() => _tab = tab">@TabName(tab)</button>
        }
    </div>

    @* ── Ribbon ────────────────────────────────────────────────────────── *@
    <div class="pe-ribbon" role="toolbar" aria-label="@TabName(_tab)">
        @* Keyed by tab, so each tab's groups are new elements (none keep another tab's collapsed state). *@
        <div class="pe-ribbon-row" @key="_tab">
        @switch (_tab)
        {
            case RibbonTab.Home:
                <RibbonGroup Title="File">
                    <RibbonButton Large Icon="bi-folder2-open" Label="Open" Title="Open a PDF (Ctrl+O)" OnClick="() => OpenBackstage(Backstage.Open)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-camera" Label="Scan" Title="Scan with your camera, or make a PDF from photos of pages (scanners can't be reached from a browser)" OnClick="() => ShowDialog(DialogKind.ScanCamera)" />
                        <RibbonButton Icon="bi-magic" Label="Clean Up Scans" Title="Remove blank pages, straighten crooked scans, split two-page spreads" Disabled="NoDoc" OnClick="ShowCleanupAsync" />
                        <RibbonButton Icon="bi-file-earmark-word" Label="From Office" Title="Make a PDF from Word, Excel, PowerPoint, text, Markdown or HTML files" OnClick="() => ShowDialog(DialogKind.Combine)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-link-45deg" Label="From Link" Title="Open a PDF from a web address, or import a Google Docs, Sheets or Slides link" OnClick="() => ShowDialog(DialogKind.GoogleLink)" />
                        <RibbonButton Icon="bi-cloud-arrow-down" Label="Import from Cloud" Title="Open a PDF, Word file or Google Doc from Google Drive or OneDrive" OnClick="() => ShowCloudAsync(save: false)" />
                        @if (Doc?.CloudFile != null)
                        {
                            <RibbonButton Icon="bi-cloud-check" Label="Save Back" Title="@($"Replace {CloudFileName}")" OnClick="SaveBackToCloudAsync" />
                        }
                        else
                        {
                            <RibbonButton Icon="bi-cloud-arrow-up" Label="Save to Cloud" Title="Save this PDF to Google Drive or OneDrive" Disabled="NoDoc" OnClick="() => ShowCloudAsync(save: true)" />
                        }
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-download" Label="Save" Title="Download the PDF (Ctrl+S)" Disabled="NoDoc" OnClick="SaveAsync" />
                        <RibbonButton Icon="bi-save2" Label="Save As" Title="Save a copy: flattened, PDF/A or password-protected" Disabled="NoDoc" OnClick="() => OpenBackstage(Backstage.SaveAs)" />
                        <RibbonButton Icon="bi-printer" Label="Print" Title="Print the document (Ctrl+P)" Disabled="NoDoc" OnClick="PrintAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-floppy" Label="Save Draft" Title="Keep your work in this browser now — it's also kept every few seconds — so reloading or closing the page doesn't lose it" Disabled="@(NoDoc && Design.Elements is not { Count: > 0 })" OnClick="SaveDraftNowAsync" />
                        <RibbonButton Icon="bi-share" Label="Share" Title="Send the PDF with your device's share sheet: mail, messages, AirDrop, Teams… (downloads it if the browser can't share)" Disabled="NoDoc" OnClick="ShareAsync" />
                        <RibbonButton Icon="bi-phone" Label="On Phone" Title="Continue on your phone or tablet: a QR code opens a copy of this PDF there, at the same page" Disabled="NoDoc" OnClick="ContinueOnPhoneAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-earmark-plus" Label="New" Title="A new blank document" OnClick="NewBlankAsync" />
                        <RibbonButton Icon="bi-x-square" Label="Close" Title="Close the current document (Ctrl+W)" Disabled="NoDoc" OnClick="CloseCurrentAsync" />
                        <RibbonButton Icon="bi-gear" Label="Settings" Title="Settings and preferences" OnClick="() => ShowDialog(DialogKind.Settings)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Clipboard">
                    <RibbonButton Large Icon="bi-clipboard" Label="Paste" Title="Paste (Ctrl+V) — what you copied, or a picture copied from another app" Disabled="NoDoc" OnClick="PasteAsync" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-scissors" Label="Cut" Title="Cut (Ctrl+X)" Disabled="!CanCopy" OnClick="CutAsync" />
                        <RibbonButton Icon="bi-copy" Label="Copy" Title="Copy (Ctrl+C)" Disabled="!CanCopy" OnClick="CopyAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Navigation">
                    <div class="pe-stack">
                        <div class="pe-row">
                            <RibbonButton Compact Icon="bi-chevron-bar-left" Label="First" Title="Go to the first page" Disabled="@(NoDoc || _page == 0)" OnClick="() => GoToPageAsync(0)" />
                            <RibbonButton Compact Icon="bi-chevron-left" Label="Previous" Title="Previous page (Ctrl+Left)" Disabled="@(NoDoc || _page == 0)" OnClick="() => GoToPageAsync(_page - 1)" />
                            <RibbonButton Compact Icon="bi-chevron-right" Label="Next" Title="Next page (Ctrl+Right)" Disabled="@(NoDoc || _page >= PageCount - 1)" OnClick="() => GoToPageAsync(_page + 1)" />
                            <RibbonButton Compact Icon="bi-chevron-bar-right" Label="Last" Title="Go to the last page" Disabled="@(NoDoc || _page >= PageCount - 1)" OnClick="() => GoToPageAsync(PageCount - 1)" />
                        </div>
                        <div class="pe-field-inline">
                            <span>Page</span>
                            <input type="number" min="1" max="@PageCount" value="@(_page + 1)" @onchange="PageBoxChangedAsync" disabled="@NoDoc" aria-label="Go to page" style="width:52px" />
                            <span>of @PageCount</span>
                        </div>
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Search">
                    <div class="pe-stack">
                        <div class="pe-field-inline">
                            <input type="search" placeholder="Find text" aria-label="Find text" @bind="_searchText" @bind:event="oninput"
                                   @onkeydown="SearchKeyAsync" disabled="@NoDoc" style="width:120px" />
                        </div>
                        <RibbonButton Icon="bi-search" Label="Search" Title="Search the text, fields and comments (Ctrl+F)" Disabled="NoDoc" OnClick="SearchAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Pages">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-trash" Label="Delete Page" Title="Delete the current page" Disabled="@(NoDoc || PageCount < 2)" OnClick="DeletePageAsync" />
                        <RibbonButton Icon="bi-file-earmark-arrow-up" Label="Insert Before" Title="Insert a blank page before the current page" Disabled="NoDoc" OnClick="() => InsertBlankAsync(before: true)" />
                        <RibbonButton Icon="bi-copy" Label="Duplicate Page" Title="Duplicate the current page and insert it right after" Disabled="NoDoc" OnClick="DuplicatePageAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-earmark-arrow-down" Label="Insert After" Title="Insert a blank page after the current page" Disabled="NoDoc" OnClick="() => InsertBlankAsync(before: false)" />
                        <RibbonButton Icon="bi-arrow-up" Label="Move Up" Title="Move this page one position earlier" Disabled="@(NoDoc || _page == 0)" OnClick="() => MovePageAsync(-1)" />
                        <RibbonButton Icon="bi-arrow-down" Label="Move Down" Title="Move this page one position later" Disabled="@(NoDoc || _page >= PageCount - 1)" OnClick="() => MovePageAsync(1)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-box-arrow-up-right" Label="Extract Page" Title="Save the current page as a separate PDF" Disabled="NoDoc" OnClick="ExtractThisPageAsync" />
                        <RibbonButton Icon="bi-image" Label="Export as Image" Title="Download the current page as a PNG" Disabled="NoDoc" OnClick="ExportPageImageAsync" />
                        <RibbonButton Icon="bi-layout-split" Label="Split PDF" Title="Every page as a separate PDF, in a ZIP" Disabled="NoDoc" OnClick="SplitAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-files" Label="Merge PDFs" Title="Combine this PDF with other PDFs, appending them at the end" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Merge)" />
                        <RibbonButton Icon="bi-file-earmark-plus" Label="Insert PDF" Title="Insert another PDF at the start or after the current page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.InsertPdf)" />
                        <RibbonButton Icon="bi-scissors" Label="Delete Range" Title="Delete a range of pages" Disabled="@(NoDoc || PageCount < 2)" OnClick="() => ShowDialog(DialogKind.DeleteRange)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-box-arrow-up" Label="Extract Range" Title="Save a range of pages as a new PDF" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.ExtractRange)" />
                        <RibbonButton Icon="bi-layout-split" Label="Compare PDFs" Title="Compare this PDF with another file page by page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.CompareUpload)" />
                        <RibbonButton Icon="bi-layout-sidebar" Label="Thumbnails" Title="Show or hide the page thumbnails" Active="_showLeft" OnClick="() => _showLeft = !_showLeft" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-droplet-half" Label="Watermark" Title="Watermark &amp; background — text or a picture, behind or over the page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Watermark)" />
                        <RibbonButton Icon="bi-droplet" Label="Remove Watermark" Title="Remove watermarks added by PdfEdit (Undo brings them back)" Disabled="NoDoc" OnClick="RemoveWatermarkAsync" />
                        <RibbonButton Icon="bi-123" Label="Page Numbers" Title="Add 'Page N of M' to every page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.PageNumbers)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-zip" Label="Compress" Title="Make the file smaller" Disabled="NoDoc" OnClick="CompressAsync" />
                        <RibbonButton Icon="bi-images" Label="Export as Images" Title="Every page as a PNG, in a ZIP" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.Images)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Document">
                    <RibbonButton Large Icon="bi-info-circle" Label="Properties" Title="Title, author, subject and keywords" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Properties)" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-copy" Label="Duplicate Page" Title="Duplicate the current page" Disabled="NoDoc" OnClick="DuplicatePageAsync" />
                        <RibbonButton Icon="bi-layout-text-window" Label="Header / Footer" Title="Add header and footer text to every page" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.HeaderFooter)" />
                        <RibbonButton Icon="bi-hash" Label="Bates Numbers" Title="Sequential Bates numbers with a prefix and suffix" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Bates)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-crop" Label="Crop Pages" Title="Trim the page margins" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Crop)" />
                        <RibbonButton Icon="bi-aspect-ratio" Label="Resize Pages" Title="Change the paper size (A4, Letter …); content is scaled to fit" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Resize)" />
                        <RibbonButton Icon="bi-grid" Label="Pages per Sheet" Title="2, 4, 6, 9 or 16 pages on each sheet, or a booklet to fold" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.NUp)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-circle-half" Label="Greyscale" Title="Convert text, drawings and pictures to shades of grey" Disabled="NoDoc" OnClick="GreyscaleAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Security">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-lock" Label="Password Protect" Title="Encrypt with an open password and set permissions" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Protect)" />
                        <RibbonButton Icon="bi-unlock" Label="Remove Password" Title="Remove the password and encryption (the PDF must be open)" Disabled="NoDoc" OnClick="RemovePasswordAsync" />
                        <RibbonButton Icon="bi-eraser" Label="Remove Hidden Info" Title="Remove metadata, scripts, attachments and other hidden data" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.Sanitize)" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Automate">
                    <RibbonButton Large Icon="bi-collection-play" Label="Batch Process" Title="Run steps (OCR, compress, watermark, numbering, password …) over many PDFs" OnClick="ShowBatch" />
                    <RibbonButton Large Icon="bi-table" Label="Bulk Fill" Title="One filled copy of this form for each row of a CSV or Excel file" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ShowBulkFillAsync" />
                </RibbonGroup>
                break;

            case RibbonTab.FillSign:
                <RibbonGroup Title="Select">
                    @ToolButton(Tool.Select, "bi-cursor", "Select", "Select — click fields to fill them, click placed text to edit (V)", large: true)
                    <div class="pe-stack">
                        @ToolButton(Tool.Hand, "bi-hand-index", "Hand", "Hand — drag to pan the page (H)")
                        @ToolButton(Tool.Zoom, "bi-zoom-in", "Zoom", "Marquee zoom — drag a rectangle to zoom in (Z)")
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Add Content">
                    @ToolButton(Tool.Text, "bi-fonts", "Add Text", "Add Text — click anywhere on the page to type (T)", large: true)
                    @ToolButton(Tool.Date, "bi-calendar-event", "Date", "Date — click the page to stamp today's date (D)", large: true)
                    <div class="pe-stack">
                        @ToolButton(Tool.VerticalText, "bi-type", "Vertical Text", "Vertical text — click the page to type text running bottom to top")
                        <RibbonButton Icon="bi-input-cursor-text" Label="Fill Field" Title="Fill text field — click a form field to type in it (F)" Disabled="NoDoc" OnClick="FillFieldTool" />
                        <RibbonButton Icon="bi-check2-square" Label="Checkbox" Title="Toggle check box / radio button — click one to tick it" Disabled="NoDoc" OnClick="FillFieldTool" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Marks">
                    @ToolButton(Tool.Check, "bi-check-lg", "Check", "Checkmark — click the page to place ✓ (K)", large: true)
                    @ToolButton(Tool.Cross, "bi-x-lg", "Cross", "Cross — click the page to place ✕", large: true)
                    <div class="pe-stack">
                        @ToolButton(Tool.Dot, "bi-circle-fill", "Dot", "Dot — click the page to place a filled dot ●")
                        @ToolButton(Tool.LineMark, "bi-dash-lg", "Line", "Line — click the page to place a short line —")
                        @ToolButton(Tool.Circle, "bi-circle", "Circle", "Circle — click the page to place a circle ○")
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Text">
                    @TextFormatControls(colours: true)
                </RibbonGroup>
                <RibbonGroup Title="Sign">
                    <RibbonButton Large Icon="bi-pen" Label="Sign" Title="Sign — click a signature field or the page to place your signature (S)" Disabled="NoDoc" Active="_tool == Tool.Signature" OnClick="SignatureToolAsync" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-pencil-square" Label="New Signature…" Title="Draw, type or import a new signature, then click the page to place it" Disabled="NoDoc" OnClick="() => NewSignature(initials: false)" />
                        <RibbonButton Icon="bi-type-italic" Label="New Initials…" Title="Create your initials, then click the page to place them" Disabled="NoDoc" OnClick="() => NewSignature(initials: true)" />
                        <RibbonButton Icon="bi-patch-check" Label="Certificate…" Title="Sign with a certificate (Digital ID) — proves who signed and that nothing changed afterwards" Disabled="NoDoc" OnClick="() => { PrepareCertSign(); ShowDialog(DialogKind.CertSign); }" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-shield-check" Label="Signatures" Title="Check the digital signatures in this PDF" Disabled="NoDoc" OnClick="CheckSignaturesAsync" />
                    </div>
                    @ToolButton(Tool.Stamp, "bi-postage", "Stamp", "Stamp — click the page to place the chosen stamp (M)", large: true)
                    <div class="pe-stack">
                        @StampPicker()
                        <RibbonButton Icon="bi-collection" Label="Stamps…" Title="Choose the stamp; create, edit or delete your own" OnClick="() => ShowDialog(DialogKind.Stamps)" />
                        <RibbonButton Icon="bi-plus-square" Label="New Stamp…" Title="Create a stamp with your own text and colour" OnClick="NewCustomStamp" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Fields">
                    <RibbonButton Large Icon="bi-ui-checks" Label="Highlight Fields" Title="Show a coloured highlight over all fillable form fields" Active="HighlightFields" OnClick="() => HighlightFields = !HighlightFields" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-eraser" Label="Clear All" Title="Clear the values of all form fields" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ClearAllFields" />
                        <RibbonButton Icon="bi-x-square" Label="Delete Field" Title="Delete the selected form field (select it with Edit Fields)" Disabled="@(SelectedFieldInfo == null)" OnClick="DeleteFieldAnyMode" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Comment">
                    @ToolButton(Tool.Note, "bi-sticky", "Sticky Note", "Sticky note — click the page to add a comment", large: true)
                    @ToolButton(Tool.Highlight, "bi-highlighter", "Highlight", "Highlight text — drag over text (I)", large: true)
                    @ToolButton(Tool.Ink, "bi-brush", "Draw", "Draw freehand — sign or annotate with the pen (W)", large: true)
                    <div class="pe-stack">
                        @ToolButton(Tool.Eraser, "bi-eraser", "Eraser", "Eraser — click a drawing or comment to remove it")
                        @ToolButton(Tool.Link, "bi-link-45deg", "Link", "Link — drag a rectangle to add a link to a web page, email or page")
                        <RibbonButton Icon="@(Dictating ? "bi-mic-fill" : "bi-mic")" Label="Dictate" Title="Type by speaking: click a field, note or text box, then talk. Click again to stop" Active="Dictating" OnClick="ToggleDictationAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Finish">
                    <RibbonButton Large Icon="bi-check2-circle" Label="Apply Changes" Title="Write everything you've added into the PDF" Disabled="@(NoDoc || !HasPending)" OnClick="CommitAsync" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-download" Label="Save" Title="Download the filled and signed PDF (Ctrl+S)" Disabled="NoDoc" OnClick="SaveAsync" />
                        <RibbonButton Icon="bi-layers" Label="Flatten &amp; Save" Title="Make fields and comments part of the page so they can't be changed, then download" Disabled="NoDoc" OnClick="SaveFlattenedAsync" />
                        <RibbonButton Icon="bi-printer" Label="Print" Title="Print the document (Ctrl+P)" Disabled="NoDoc" OnClick="PrintAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-share" Label="Share" Title="Send the PDF with your device's share sheet: mail, messages, AirDrop, Teams… (downloads it if the browser can't share)" Disabled="NoDoc" OnClick="ShareAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-arrow-counterclockwise" Label="Undo" Title="Undo (Ctrl+Z)" Disabled="!CanUndo" OnClick="UndoAsync" />
                        <RibbonButton Icon="bi-x-circle" Label="Discard Changes" Title="Remove what you've added since the last Apply" Disabled="@(NoDoc || !HasPending)" OnClick="DiscardPending" />
                        <RibbonButton Icon="bi-floppy" Label="Save Draft" Title="Keep your work in this browser now — it's also kept every few seconds — so reloading or closing the page doesn't lose it" Disabled="NoDoc" OnClick="SaveDraftNowAsync" />
                    </div>
                </RibbonGroup>
                break;

            case RibbonTab.Edit:
                <RibbonGroup Title="Clipboard">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-scissors" Label="Cut" Title="Cut (Ctrl+X)" Disabled="!CanCopy" OnClick="CutAsync" />
                        <RibbonButton Icon="bi-copy" Label="Copy" Title="Copy (Ctrl+C)" Disabled="!CanCopy" OnClick="CopyAsync" />
                        <RibbonButton Icon="bi-clipboard" Label="Paste" Title="Paste (Ctrl+V)" Disabled="NoDoc" OnClick="PasteAsync" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="History">
                    <RibbonButton Large Icon="bi-arrow-counterclockwise" Label="Undo" Title="Undo the last change (Ctrl+Z)" Disabled="!CanUndo" OnClick="UndoAsync" />
                    <RibbonButton Large Icon="bi-arrow-clockwise" Label="Redo" Title="Redo what was undone (Ctrl+Y)" Disabled="!CanRedo" OnClick="RedoAsync" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-arrow-counterclockwise" Label="Undo Ann." Title="Take back the last thing added on the page" Disabled="@(!_items.Any(i => i.Baseline == null))" OnClick="UndoAnnotation" />
                        <RibbonButton Icon="bi-arrow-clockwise" Label="Redo Ann." Title="Put back what Undo Ann. took off" Disabled="@(_itemRedo.Count == 0)" OnClick="RedoAnnotation" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Annotations">
                    <RibbonButton Large Icon="bi-trash" Label="Delete" Title="Delete the selected comment, drawing or text (Del)" Disabled="@(SelectedItem == null)" OnClick="DeleteSelectedItem" />
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-highlighter" Label="Find &amp; Highlight" Title="Search for text and highlight every match" Disabled="NoDoc" OnClick="() => ShowDialog(DialogKind.FindHighlight)" />
                        <RibbonButton Icon="bi-eraser" Label="Clear All Fields" Title="Clear every form field's value" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ClearAllFields" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Form Data">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-box-arrow-in-down" Label="Import Data" Title="Fill the fields from an exported data file" Disabled="@(NoDoc || FieldCount == 0)" OnClick="() => ShowDialog(DialogKind.ImportData)" />
                        <RibbonButton Icon="bi-filetype-json" Label="Import from JSON" Title="Fill the fields from a JSON file of {field name: value} pairs" Disabled="@(NoDoc || FieldCount == 0)" OnClick="() => ShowDialog(DialogKind.ImportData)" />
                        <RibbonButton Icon="bi-box-arrow-up" Label="Export Data" Title="Download the field values as a tab-separated file" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ExportDataAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-layers" Label="Flatten &amp; Save" Title="Download with the fields turned into plain page content" Disabled="NoDoc" OnClick="SaveFlattenedAsync" />
                        <RibbonButton Icon="bi-arrow-repeat" Label="Reset Form" Title="Put every field back as it was when last applied" Disabled="@(NoDoc || FieldCount == 0)" OnClick="ResetForm" />
                    </div>
                </RibbonGroup>
                <RibbonGroup Title="Tools">
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-search" Label="Find &amp; Replace" Title="Find and replace text in the form's field values" Disabled="@(NoDoc || FieldCount == 0)" OnClick="() => ShowDialog(DialogKind.FindReplace)" />
                        <RibbonButton Icon="bi-asterisk" Label="Validate Required" Title="Check that every required field is filled in" Disabled="@(NoDoc || FieldCount == 0)" OnClick="CheckRequired" />
                        <RibbonButton Icon="bi-archive" Label="Archive (PDF/A)" Title="Download an archive-friendly PDF/A copy" Disabled="NoDoc" OnClick="PdfAAsync" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-text" Label="Export Text" Title="All the text as a .txt file" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.Text)" />
                        <RibbonButton Icon="bi-file-earmark-word" Label="Export to Word" Title="The text of every page as a Word document" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.Word)" />
                        <RibbonButton Icon="bi-file-earmark-excel" Label="Export to Excel" Title="The tables and columns as an Excel workbook" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.Excel)" />
                    </div>
                    <div class="pe-stack">
                        <RibbonButton Icon="bi-file-earmark-slides" Label="Export to PowerPoint" Title="One slide per page" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.PowerPoint)" />

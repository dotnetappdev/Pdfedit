                            <button role="menuitem" @onclick="() => ExportAsync(ExportFormat.Markdown)"><i class="bi bi-markdown"></i> Markdown (.md)</button>
                            <button role="menuitem" @onclick="() => ExportAsync(ExportFormat.Epub)"><i class="bi bi-book"></i> E-book (.epub)</button>
                        </RibbonMenu>
                        <RibbonButton Icon="bi-file-image" Label="Extract Images" Title="Every picture in the PDF, in a ZIP" Disabled="NoDoc" OnClick="() => ExportAsync(ExportFormat.Pictures)" />

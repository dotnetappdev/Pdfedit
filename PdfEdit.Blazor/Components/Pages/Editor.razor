                <RibbonGroup Title="Add Form Field">
                    <RibbonButton Large Icon="bi-magic" Label="Detect Fields" Title="Find the boxes, squares and blank lines of a flat form and make them fillable fields" Disabled="NoDoc" OnClick="DetectFieldsAsync" />

@* Something added on the page that isn't written into the PDF yet. *@
@{
    var i = Item;
    var style = Editor.OverlayStyle(i.Left, PageH - i.Top - i.Height, i.Width, i.Height, PageW, PageH);
    var textStyle = $"font-weight:{(i.Bold ? 700 : 400)};font-style:{(i.Italic ? "italic" : "normal")};text-decoration:{(i.Underline ? "underline" : "none")};" +
                    $"text-transform:{(i.Upper ? "uppercase" : "none")};text-align:{i.Align.ToString().ToLowerInvariant()};" +
                    $"letter-spacing:{Editor.Css(i.CharSpacing / PageW * 100)}cqw;white-space:{(i.Fit == TextFit.Auto ? "pre" : "pre-wrap")}";
    var rot = i.Rotation != 0 ? $"rot{i.Rotation}" : "";
}
<div class="pe-item-wrap @(Ed.SelectedItemId == i.Id ? "sel" : "")" @onpointerdown="Select">
@switch (i.Kind)
{
    case ItemKind.Text:
        <div class="pe-item text @rot" style="@style;color:@i.Color;font-size:@Editor.Css(i.FontSize / PageW * 100)cqw" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <textarea id="item-@i.Id" aria-label="Text on page" placeholder="Type here" style="@textStyle" readonly="@i.Locked"
                      @bind="Item.Text" @bind:event="oninput" @bind:after="Grow" @onblur="() => Ed.Refresh()"></textarea>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Mark:
        <div class="pe-item mark" style="@style;color:@i.Color;font-size:@Editor.Css(i.FontSize / PageW * 100)cqw" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <span class="pe-mark-glyph" style="@(i.Rotation != 0 ? $"transform:rotate({i.Rotation}deg)" : null)">@i.Text</span>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Signature or ItemKind.Picture:
        <div class="pe-item signature" style="@style" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <img src="@i.ImageUrl" alt="@i.Describe()" draggable="false" />
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Note:
        <div class="pe-item note" style="left:@Editor.Css(i.Left / PageW * 100)%;top:@Editor.Css(i.Top / PageH * 100)%" title="@i.Text"
             @onclick="Edit" role="button" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)" aria-label="Sticky note: @i.Text">
            <i class="bi bi-sticky-fill"></i>
            <ItemChrome Ed="Ed" Item="Item" Resizable="false" />
        </div>
        break;
    case ItemKind.Stamp:
        <div class="pe-item stamp" style="@style;color:@i.Color;border-color:@i.Color" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <div class="pe-stamp-body @rot">
                <div class="pe-stamp-title" style="font-size:@Editor.Css(StampTitleSize() / PageW * 100)cqw">@i.Text</div>
                @if (!string.IsNullOrEmpty(i.Subtitle))
                {
                    <div class="pe-stamp-sub" style="font-size:@Editor.Css(StampSubSize() / PageW * 100)cqw">@i.Subtitle</div>
                }
            </div>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Callout:
        var tip = i.Points is { Count: > 0 } tp ? tp[0] : new PdfEdit.Models.PointD(i.Left - 30, i.Top + i.Height + 30);
        var (ax, ay) = CalloutAttach(tip);
        <div class="pe-item callout" style="@style;border-color:@i.Color;font-size:@Editor.Css(i.FontSize / PageW * 100)cqw" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <svg class="pe-callout-line" viewBox="0 0 @Editor.Css(i.Width) @Editor.Css(i.Height)" preserveAspectRatio="none" aria-hidden="true">
                <line x1="@Editor.Css(ax)" y1="@Editor.Css(ay)" x2="@Editor.Css(tip.X - i.Left)" y2="@Editor.Css(tip.Y - i.Top)" stroke="@i.Color" stroke-width="1" />
                <circle cx="@Editor.Css(tip.X - i.Left)" cy="@Editor.Css(tip.Y - i.Top)" r="1.6" fill="@i.Color" />
            </svg>
            <textarea id="item-@i.Id" aria-label="Callout text" placeholder="Type the callout" readonly="@i.Locked"
                      @bind="Item.Text" @bind:event="oninput" @onblur="() => Ed.Refresh()"></textarea>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.InsertText:
        <div class="pe-item caret" style="@style;color:@i.Color" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)" @ondblclick="Edit">
            <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0 10 L5 0 L10 10 Q5 7.5 0 10Z" fill="currentColor" /></svg>
            <ItemChrome Ed="Ed" Item="Item" Resizable="false" />
        </div>
        break;
    case ItemKind.ReplaceText:
        <div class="pe-item replace" style="@style;color:@i.Color" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)" @ondblclick="Edit">
            <span class="pe-strike" style="background:@i.Color"></span>
            <svg class="pe-replace-caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M0 10 L5 0 L10 10 Q5 7.5 0 10Z" fill="currentColor" /></svg>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Cloud:
        <div class="pe-item cloud" style="@style" title="Cloud" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <svg viewBox="0 0 @Editor.Css(i.Width) @Editor.Css(i.Height)" preserveAspectRatio="none" aria-hidden="true">
                <path d="@CloudPath()" fill="none" stroke="@i.Color" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                <rect class="hit" x="0" y="0" width="@Editor.Css(i.Width)" height="@Editor.Css(i.Height)" />
            </svg>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    case ItemKind.Ink or ItemKind.Line or ItemKind.Arrow or ItemKind.Distance or ItemKind.Perimeter or ItemKind.Area
        or ItemKind.Polygon or ItemKind.Polyline when i.Points != null:
        var vb = $"{Editor.Css(i.Left)} {Editor.Css(i.Top)} {Editor.Css(i.Width)} {Editor.Css(i.Height)}";
        var pts = string.Join(" ", i.Points.Select(p => Editor.Css(p.X) + "," + Editor.Css(p.Y)));
        <div class="pe-item sketch" style="@style" title="@i.Describe()" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <svg viewBox="@vb" preserveAspectRatio="none" aria-hidden="true">
                @if (i.Kind is ItemKind.Area or ItemKind.Polygon)
                {
                    <polygon class="hit" points="@pts" />
                    <polygon points="@pts" fill="@(i.Kind == ItemKind.Area ? i.Color + "22" : "none")" stroke="@i.Color" stroke-width="@Editor.Css(i.LineWidth)" stroke-linejoin="round" />
                }
                else
                {
                    <polyline class="hit" points="@pts" />
                    <polyline points="@pts" fill="none" stroke="@i.Color" stroke-width="@Editor.Css(i.LineWidth)" stroke-linecap="round" stroke-linejoin="round" />
                }
                @foreach (var extra in Decorations())
                {
                    <polyline points="@extra" fill="none" stroke="@i.Color" stroke-width="@Editor.Css(i.LineWidth)" stroke-linecap="round" stroke-linejoin="round" />
                }
                @if (i.Kind is ItemKind.Distance or ItemKind.Perimeter or ItemKind.Area)
                {
                    var (lx, ly) = LabelSpot();
                    @* Razor reserves <text>, so the SVG label is written as markup. *@
                    @((MarkupString)$"<text x=\"{Editor.Css(lx)}\" y=\"{Editor.Css(ly)}\" fill=\"{i.Color}\" font-size=\"9\" text-anchor=\"middle\" class=\"pe-measure\">{System.Net.WebUtility.HtmlEncode(i.MeasureLabel())}</text>")
                }
            </svg>
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
    default:
        var kind = i.Kind switch
        {
            ItemKind.Highlight => i.Markup switch
            {
                PdfEdit.Models.HighlightKind.Underline => "markup underline",
                PdfEdit.Models.HighlightKind.Squiggly => "markup squiggly",
                PdfEdit.Models.HighlightKind.Strikethrough => "markup strike",
                _ => "highlight",
            },
            ItemKind.Redact => "redact",
            _ => "rect",
        };
        <div class="pe-item box @kind" title="@i.Describe()" style="@BoxStyle(style)" data-drag="i:@i.Id" data-locked="@(i.Locked ? "1" : null)">
            <ItemChrome Ed="Ed" Item="Item" />
        </div>
        break;
}
</div>

@code {
    [Parameter, EditorRequired] public Editor Ed { get; set; } = default!;
    [Parameter, EditorRequired] public PageItem Item { get; set; } = default!;
    [Parameter] public double PageW { get; set; }
    [Parameter] public double PageH { get; set; }

    private string BoxStyle(string style) => Item.Kind switch
    {
        ItemKind.Rectangle => $"{style};border-color:{Item.Color};border-width:2px",
        ItemKind.Ellipse => $"{style};border-color:{Item.Color};border-width:2px;border-radius:50%",
        ItemKind.Highlight when Item.Markup == PdfEdit.Models.HighlightKind.Highlight => $"{style};background:{Item.Color}66",
        ItemKind.Highlight => $"{style};color:{Item.Color}",
        _ => style,
    };

    // Where the callout's line leaves the box (box-local points): the side facing the tip.
    private (double X, double Y) CalloutAttach(PdfEdit.Models.PointD tip)
    {
        double l = Item.Left, t = Item.Top, w = Item.Width, h = Item.Height;
        if (tip.X >= l && tip.X <= l + w) return (w / 2, tip.Y > t + h / 2 ? h : 0);
        if (tip.Y >= t && tip.Y <= t + h) return (tip.X < l ? 0 : w, h / 2);
        return (tip.X < l ? 0 : w, tip.Y > t + h / 2 ? h : 0);
    }

    // Scallops all round the box, like the PDF's cloud.
    private string CloudPath()
    {
        double w = Item.Width, h = Item.Height, r0 = Math.Clamp(Math.Min(w, h) / 6, 3, 9);
        var sb = new System.Text.StringBuilder();
        void Edge(double x1, double y1, double x2, double y2)
        {
            double len = Math.Sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
            int n = Math.Max(1, (int)Math.Round(len / (r0 * 2)));
            for (int k = 0; k < n; k++)
            {
                double ax = x1 + (x2 - x1) * k / n, ay = y1 + (y2 - y1) * k / n;
                double bx = x1 + (x2 - x1) * (k + 1) / n, by = y1 + (y2 - y1) * (k + 1) / n;
                double r = len / n / 2;
                sb.Append($"M{Editor.Css(ax)} {Editor.Css(ay)} A{Editor.Css(r)} {Editor.Css(r)} 0 0 1 {Editor.Css(bx)} {Editor.Css(by)} ");
            }
        }
        Edge(0, 0, w, 0); Edge(w, 0, w, h); Edge(w, h, 0, h); Edge(0, h, 0, 0);
        return sb.ToString();
    }

    // Title and subtitle text sizes, fitted to the stamp like the PDF appearance is.
    // A stamp turned a quarter lays its text along the box's height.
    private (double W, double H) StampBox() => Item.QuarterTurn ? (Item.Height, Item.Width) : (Item.Width, Item.Height);

    private double StampTitleSize()
    {
        var (w, h) = StampBox();
        bool sub = !string.IsNullOrEmpty(Item.Subtitle);
        double size = (sub ? h * 0.42 : h * 0.55) / 1.15;
        double inner = w * 0.82;
        double textW = Item.Text.Length * size * 0.68;
        return textW > inner ? size * inner / textW : size;
    }

    private double StampSubSize()
    {
        var (w, h) = StampBox();
        double size = h * 0.2 / 1.15;
        double inner = w * 0.82;
        double textW = (Item.Subtitle?.Length ?? 0) * size * 0.5;
        return textW > inner ? size * inner / textW : size;
    }

    // Arrow head (open, like the PDF's OpenArrow) and the end ticks of a distance.
    private IEnumerable<string> Decorations()
    {
        var p = Item.Points!;
        if (p.Count < 2 || Item.Kind is not (ItemKind.Arrow or ItemKind.Distance)) yield break;
        var (a, b) = (p[0], p[^1]);
        double ang = Math.Atan2(b.Y - a.Y, b.X - a.X);
        string P(double x, double y) => Editor.Css(x) + "," + Editor.Css(y);
        if (Item.Kind == ItemKind.Arrow)
        {
            double len = 9 + Item.LineWidth * 1.5, spread = 0.45;
            yield return $"{P(b.X - len * Math.Cos(ang - spread), b.Y - len * Math.Sin(ang - spread))} {P(b.X, b.Y)} " +
                         P(b.X - len * Math.Cos(ang + spread), b.Y - len * Math.Sin(ang + spread));
        }
        else
        {
            double t = 5, nx = -Math.Sin(ang) * t, ny = Math.Cos(ang) * t;
            yield return $"{P(a.X - nx, a.Y - ny)} {P(a.X + nx, a.Y + ny)}";
            yield return $"{P(b.X - nx, b.Y - ny)} {P(b.X + nx, b.Y + ny)}";
        }
    }

    private (double X, double Y) LabelSpot()
    {
        var p = Item.Points!;
        return Item.Kind switch
        {
            ItemKind.Distance => ((p[0].X + p[^1].X) / 2, (p[0].Y + p[^1].Y) / 2 - 4),
            ItemKind.Area => (p.Average(q => q.X), p.Average(q => q.Y) + 3),
            _ => (p[^1].X, p[^1].Y - 5),
        };
    }

    // Selecting redraws the page too, so the item selected before loses its outline and toolbar.
    private void Select()
    {
        if (Ed.SelectedItemId == Item.Id) return;
        Ed.SelectItem(Item);
        Ed.Refresh();
    }

    private void Remove()
    {
        Ed.RemoveItem(Item);
        Ed.Refresh();
    }

    private void Edit()
    {
        Ed.EditingNote = Item;
        Ed.ShowDialog(DialogKind.Note);
        Ed.Refresh();
    }

    // Size the box to the text as it's typed, as its Fit says (like the Windows app's auto-size text).
    private void Grow() => Ed.GrowText(Item);
}

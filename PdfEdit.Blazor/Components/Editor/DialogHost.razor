@* The editor's dialog boxes. Each keeps its own inputs and calls the editor to do the work. *@
@inject IJSRuntime JS

@switch (Ed.Dialog)
{
    case DialogKind.Password:
        <Modal Title="Password required" OnClose="Close">
            <ChildContent>
                <p><strong>@Ed.PendingPassword?.Name</strong> is protected. Enter its password to open it.</p>
                @if (Ed.PendingPassword?.Wrong == true) { <p style="color:#dc3545">That password isn't right. Try again.</p> }
                <input class="form-control" type="password" @bind="_password" @onkeydown="PasswordKey" aria-label="Password" autofocus />
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="OpenWithPassword">Open</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Properties:
        <Modal Title="Document Properties" OnClose="Close">
            <ChildContent>
                <div class="mb-2"><label>Title</label><input class="form-control" @bind="_meta.Title" /></div>
                <div class="mb-2"><label>Author</label><input class="form-control" @bind="_meta.Author" /></div>
                <div class="mb-2"><label>Subject</label><input class="form-control" @bind="_meta.Subject" /></div>
                <div class="mb-2"><label>Keywords</label><input class="form-control" @bind="_meta.Keywords" /></div>
                <p class="pe-hint mb-0">Creator: @_meta.Creator · Producer: @_meta.Producer</p>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(() => Ed.SetMetadataAsync(_meta))">Save</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Watermark:
        <Modal Title="Watermark" OnClose="Close" Wide>
            <ChildContent>
                <div class="row g-2">
                    <div class="col-8"><label>Text</label><input class="form-control" @bind="_wm.Text" /></div>
                    <div class="col-4"><label>Size</label><input class="form-control" type="number" min="8" max="300" @bind="_wm.FontSize" /></div>
                    <div class="col-4">
                        <label>Font</label>
                        <select class="form-select" @bind="_wmFamily">
                            <option>Helvetica</option><option>Times</option><option>Courier</option>
                        </select>
                    </div>
                    <div class="col-4 d-flex align-items-end gap-3">
                        <label class="d-flex gap-1 align-items-center"><input type="checkbox" @bind="_wmBold" /> Bold</label>
                        <label class="d-flex gap-1 align-items-center"><input type="checkbox" @bind="_wmItalic" /> Italic</label>
                    </div>
                    <div class="col-4"><label>Colour</label><input class="form-control form-control-color" type="color" @bind="_wmColor" /></div>
                    <div class="col-6">
                        <label>Layout</label>
                        <select class="form-select" @bind="_wm.Layout">
                            <option value="@WatermarkLayout.DiagonalUp">Diagonal up</option>
                            <option value="@WatermarkLayout.DiagonalDown">Diagonal down</option>
                            <option value="@WatermarkLayout.Horizontal">Horizontal</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label>Position</label>
                        <select class="form-select" @bind="_wm.Position">
                            <option value="@WatermarkPosition.Center">Centre</option>
                            <option value="@WatermarkPosition.Top">Top</option>
                            <option value="@WatermarkPosition.Bottom">Bottom</option>
                            <option value="@WatermarkPosition.Tiled">Tiled</option>
                        </select>
                    </div>
                    <div class="col-6"><label>Opacity: @((int)(_wm.Opacity * 100))%</label><input class="form-range" type="range" min="0.05" max="1" step="0.05" @bind="_wm.Opacity" @bind:event="oninput" /></div>
                    <div class="col-6 d-flex align-items-end"><label class="d-flex gap-1 align-items-center"><input type="checkbox" @bind="_wm.Behind" /> Behind the page content</label></div>
                    <div class="col-6">
                        <label>Pages</label>
                        <select class="form-select" @bind="_wm.Pages">
                            <option value="@WatermarkPages.All">All pages</option>
                            <option value="@WatermarkPages.Current">This page (@(Ed.CurrentPage + 1))</option>
                            <option value="@WatermarkPages.Range">Pages…</option>
                        </select>
                    </div>
                    @if (_wm.Pages == WatermarkPages.Range)
                    {
                        <div class="col-6"><label>Page range</label><input class="form-control" placeholder="1-3, 5" @bind="_wm.PageRange" /></div>
                    }
                </div>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="ApplyWatermark">Add watermark</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.PageNumbers:
        <Modal Title="Page Numbers" OnClose="Close">
            <ChildContent>
                <div class="mb-2">
                    <label>Format</label>
                    <select class="form-select" @bind="_numFormat">
                        <option value="Page {n} of {total}">Page 1 of 10</option>
                        <option value="{n}">1</option>
                        <option value="{n} / {total}">1 / 10</option>
                        <option value="- {n} -">- 1 -</option>
                        <option value="Page {n}">Page 1</option>
                    </select>
                </div>
                <div class="mb-2"><label>Position</label>@PositionSelect(_numPosition, v => _numPosition = v)</div>
                <div class="mb-2"><label>Size</label><input class="form-control" type="number" min="6" max="36" @bind="_numSize" /></div>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(() => Ed.PageNumbersAsync(_numFormat, _numPosition, _numSize))">Add numbers</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.HeaderFooter:
        <Modal Title="Header and Footer" OnClose="Close">
            <ChildContent>
                <div class="mb-2"><label>Header</label><input class="form-control" @bind="_header" placeholder="e.g. Confidential" /></div>
                <div class="mb-2"><label>Footer</label><input class="form-control" @bind="_footer" placeholder="e.g. Acme Ltd" /></div>
                <div class="row g-2">
                    <div class="col-6">
                        <label>Alignment</label>
                        <select class="form-select" @bind="_hfAlign"><option>Left</option><option>Center</option><option>Right</option></select>
                    </div>
                    <div class="col-6"><label>Size</label><input class="form-control" type="number" min="6" max="36" @bind="_hfSize" /></div>
                </div>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(string.IsNullOrWhiteSpace(_header) && string.IsNullOrWhiteSpace(_footer))"
                        @onclick="() => Do(() => Ed.HeaderFooterAsync(NullIfEmpty(_header), NullIfEmpty(_footer), _hfSize, _hfAlign))">Add</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Bates:
        <Modal Title="Bates Numbers" OnClose="Close">
            <ChildContent>
                <div class="row g-2">
                    <div class="col-4"><label>Prefix</label><input class="form-control" @bind="_batesPrefix" placeholder="ABC" /></div>
                    <div class="col-4"><label>Start at</label><input class="form-control" type="number" min="0" @bind="_batesStart" /></div>
                    <div class="col-4"><label>Digits</label><input class="form-control" type="number" min="1" max="12" @bind="_batesDigits" /></div>
                    <div class="col-4"><label>Suffix</label><input class="form-control" @bind="_batesSuffix" /></div>
                    <div class="col-8"><label>Position</label>@PositionSelect(_batesPosition, v => _batesPosition = v)</div>
                </div>
                <p class="pe-hint mt-2 mb-0">First number: @(_batesPrefix + _batesStart.ToString().PadLeft(_batesDigits, '0') + _batesSuffix)</p>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(() => Ed.BatesAsync(_batesPrefix, _batesStart, _batesDigits, _batesSuffix, _batesPosition))">Add numbers</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Protect:
        <Modal Title="Password Protect" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Downloads a protected copy. The copy you're editing here stays unlocked.</p>
                <div class="mb-2"><label>Password to open</label><input class="form-control" type="password" @bind="_userPw" @bind:event="oninput" /></div>
                <div class="mb-2"><label>Confirm password</label><input class="form-control" type="password" @bind="_userPw2" @bind:event="oninput" /></div>
                <div class="mb-2"><label>Permissions password (optional)</label><input class="form-control" type="password" @bind="_ownerPw" /></div>
                <label class="d-flex gap-2 align-items-center"><input type="checkbox" @bind="_allowPrint" /> Allow printing</label>
                <label class="d-flex gap-2 align-items-center"><input type="checkbox" @bind="_allowCopy" /> Allow copying text</label>
                @if (_userPw != _userPw2) { <p style="color:#dc3545" class="mb-0 mt-2">The passwords don't match.</p> }
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(string.IsNullOrEmpty(_userPw) || _userPw != _userPw2)"
                        @onclick="() => Do(() => Ed.ProtectAsync(_userPw, NullIfEmpty(_ownerPw) ?? _userPw, _allowPrint, _allowCopy))">Download protected PDF</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Sanitize:
        <Modal Title="Remove Hidden Information" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Removes things you can't see on the page. The visible content and form fields stay.</p>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_sanMeta" /> Document metadata (author, title, XMP)</label>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_sanScripts" /> JavaScript and automatic actions</label>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_sanFiles" /> Attached files</label>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_sanComments" /> Comments and marks</label>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_sanBookmarks" /> Bookmarks</label>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(() => Ed.SanitizeAsync(new SanitizeOptions(_sanMeta, _sanScripts, _sanFiles, _sanComments, _sanBookmarks)))">Remove</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Resize:
        <Modal Title="Resize Pages" OnClose="Close">
            <ChildContent>
                <div class="mb-2">
                    <label>Paper size</label>
                    <select class="form-select" @bind="_paper">
                        @foreach (var p in PageLayoutService.PaperSizes) { <option value="@p.Name">@p.Name (@Math.Round(p.Width / 72 * 25.4) × @Math.Round(p.Height / 72 * 25.4) mm)</option> }
                    </select>
                </div>
                <label class="d-flex gap-2"><input type="radio" name="fit" checked="@(_fit == ResizeFit.Fit)" @onchange="() => _fit = ResizeFit.Fit" /> Scale the content to fit</label>
                <label class="d-flex gap-2"><input type="radio" name="fit" checked="@(_fit == ResizeFit.Centre)" @onchange="() => _fit = ResizeFit.Centre" /> Keep its size, centred</label>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(() => Ed.ResizeAsync(_paper, _fit))">Resize</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.NUp:
        <Modal Title="Pages per Sheet" OnClose="Close">
            <ChildContent>
                <div class="mb-2">
                    <label>Pages on each A4 sheet</label>
                    <select class="form-select" @bind="_nup">
                        <option value="2">2 (side by side)</option><option value="4">4</option><option value="6">6</option><option value="9">9</option>
                    </select>
                </div>
                <label class="d-flex gap-2"><input type="checkbox" @bind="_nupBorders" /> Draw a border round each page</label>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="ApplyNUp">Arrange</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Signature:
        <Modal Title="Your Signature" OnClose="Close" Wide>
            <ChildContent>
                <div class="pe-panel-tabs mb-2" style="border:0">
                    <button class="pe-panel-tab @(_sigTyped ? "" : "active")" @onclick="() => SetSigMode(false)">Draw</button>
                    <button class="pe-panel-tab @(_sigTyped ? "active" : "")" @onclick="() => SetSigMode(true)">Type</button>
                </div>
                @if (_sigTyped)
                {
                    <div class="row g-2">
                        <div class="col-7"><label>Your name</label><input class="form-control" @bind="_sigName" @bind:event="oninput" /></div>
                        <div class="col-5">
                            <label>Style</label>
                            <select class="form-select" @bind="_sigFont">
                                <option value="'Segoe Script','Brush Script MT','Lucida Handwriting',cursive">Script</option>
                                <option value="'Georgia','Times New Roman',serif">Classic</option>
                                <option value="'Comic Sans MS','Chalkboard SE',cursive">Casual</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3 p-3" style="background:#fff;border:1px solid var(--pe-input-border);border-radius:4px;min-height:90px;color:@_sigColor;font:40px @_sigFont">@_sigName</div>
                }
                else
                {
                    <canvas class="pe-sigpad" @ref="_sigCanvas" data-color="@_sigColor" aria-label="Draw your signature"></canvas>
                    <p class="pe-hint mt-1 mb-0">Draw with the mouse, a pen or your finger.</p>
                }
                <div class="d-flex align-items-center gap-2 mt-2">
                    <label class="mb-0">Ink</label>
                    @foreach (var c in new[] { "#0b2a6f", "#000000", "#1565c0" })
                    {
                        var colour = c;
                        <button class="pe-btn" style="width:28px;height:28px;padding:0;background:@c;@(_sigColor == c ? "outline:2px solid var(--pe-accent)" : "")"
                                title="@c" aria-label="Ink colour @c" @onclick="() => SetSigColor(colour)"></button>
                    }
                </div>
            </ChildContent>
            <Footer>
                @if (!_sigTyped) { <button class="pe-btn me-auto" @onclick="ClearSig">Clear</button> }
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="UseSignature">Use signature</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Note when Ed.EditingNote is { } note:
        <Modal Title="Sticky Note" OnClose="CloseNote">
            <ChildContent>
                <textarea class="form-control" rows="5" @bind="note.Text" @bind:event="oninput" aria-label="Note" autofocus></textarea>
            </ChildContent>
            <Footer>
                <button class="pe-btn me-auto" @onclick="() => { Ed.RemoveItem(note); Close(); }">Delete</button>
                <button class="pe-btn primary" @onclick="CloseNote">Done</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Merge:
    case DialogKind.Combine:
        var merging = Ed.Dialog == DialogKind.Merge;
        <Modal Title="@(merging ? "Merge PDFs" : "Create a PDF from files")" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">@(merging ? "The files are added after the last page, in the order you pick them." : "PDFs and pictures (PNG, JPEG, GIF, BMP, TIFF) are combined in the order you pick them; each picture becomes an A4 page.")</p>
                <InputFile class="form-control" multiple accept=".pdf,.png,.jpg,.jpeg,.gif,.bmp,.tif,.tiff" OnChange="e => _files = e.GetMultipleFiles(50)" />
                @if (_files.Count > 0)
                {
                    <ol class="mt-2 mb-0">@foreach (var f in _files) { <li>@f.Name</li> }</ol>
                }
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)"
                        @onclick="() => Do(() => merging ? Ed.MergeAsync(_files) : Ed.CombineFilesAsync(_files))">@(merging ? "Merge" : "Create")</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.InsertPdf:
        <Modal Title="Insert PDF" OnClose="Close">
            <ChildContent>
                <InputFile class="form-control" accept=".pdf" OnChange="e => _files = [e.File]" />
                <label class="d-flex gap-2 mt-2"><input type="radio" name="where" checked="@(!_insertAtStart)" @onchange="() => _insertAtStart = false" /> After page @(Ed.CurrentPage + 1)</label>
                <label class="d-flex gap-2"><input type="radio" name="where" checked="@_insertAtStart" @onchange="() => _insertAtStart = true" /> Before the first page</label>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.InsertPdfAsync(_files[0], _insertAtStart))">Insert</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.ImportData:
        <Modal Title="Import Form Data" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Choose a data file made by Export Data (field name, a tab, then the value, one per line).</p>
                <InputFile class="form-control" accept=".txt,.tsv" OnChange="e => _files = [e.File]" />
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.ImportDataAsync(_files[0]))">Import</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.ExtractRange:
    case DialogKind.DeleteRange:
        var extracting = Ed.Dialog == DialogKind.ExtractRange;
        <Modal Title="@(extracting ? "Extract Pages" : "Delete Pages")" OnClose="Close">
            <ChildContent>
                <label>Pages (this document has @Ed.PageCount)</label>
                <input class="form-control" @bind="_range" @bind:event="oninput" placeholder="e.g. 1-3, 5, 8-" autofocus />
                <p class="pe-hint mt-1 mb-0">@(extracting ? "They're saved as a new PDF and downloaded." : "Undo brings them back.")</p>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn @(extracting ? "primary" : "danger")" disabled="@string.IsNullOrWhiteSpace(_range)"
                        @onclick="() => Do(() => extracting ? Ed.ExtractRangeAsync(_range) : Ed.DeleteRangeAsync(_range))">@(extracting ? "Extract" : "Delete")</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Statistics:
        <Modal Title="Document Statistics" OnClose="Close">
            <ChildContent>
                @if (_stats == null)
                {
                    <p class="pe-hint">Counting…</p>
                }
                else
                {
                    <table class="table table-sm" style="color:inherit">
                        <tbody>@foreach (var (k, v) in _stats) { <tr><th>@k</th><td>@v</td></tr> }</tbody>
                    </table>
                }
            </ChildContent>
            <Footer><button class="pe-btn primary" @onclick="Close">Close</button></Footer>
        </Modal>
        break;

    case DialogKind.Shortcuts:
        <Modal Title="Keyboard Shortcuts" OnClose="Close">
            <ChildContent>
                <table class="table table-sm" style="color:inherit">
                    <tbody>
                        @foreach (var (k, v) in Shortcuts) { <tr><td><kbd>@k</kbd></td><td>@v</td></tr> }
                    </tbody>
                </table>
            </ChildContent>
            <Footer><button class="pe-btn primary" @onclick="Close">Close</button></Footer>
        </Modal>
        break;

    case DialogKind.AiSettings:
        <Modal Title="AI Assistant Setup" OnClose="Close">
            <ChildContent>
                <div class="mb-2">
                    <label>Provider</label>
                    <select class="form-select" value="@_aiProvider" @onchange="e => { _aiProvider = e.Value?.ToString() ?? _aiProvider; _aiKey = Ed.SessionKey(_aiProvider); }">
                        @foreach (var p in AiProviderService.Providers.Keys) { <option value="@p">@(p == AiProviderService.LocalProvider ? "Local AI (Ollama, LM Studio…)" : p == AiProviderService.CopilotProvider ? "GitHub Copilot models" : p)</option> }
                    </select>
                </div>
                @if (_aiProvider == AiProviderService.LocalProvider)
                {
                    <p class="pe-hint mb-0">
                        @(Ed.HasServerKey(_aiProvider)
                            ? $"This server uses a local AI server at {AppSettings.Current.LocalAiEndpoint} (model {AppSettings.Current.LocalAiModel})."
                            : "No local AI server is set up for this site. The site's owner sets PdfEdit:Ai:LocalEndpoint in its configuration.")
                    </p>
                }
                else
                {
                    <div class="mb-2">
                        <label>@(_aiProvider == AiProviderService.CopilotProvider ? "GitHub token (with the models permission)" : $"{_aiProvider} API key")</label>
                        <input class="form-control" type="password" autocomplete="off" @bind="_aiKey" placeholder="@(Ed.HasServerKey(_aiProvider) ? "Using the site's key — type one to use your own" : "Paste your key")" />
                    </div>
                    <p class="pe-hint mb-0">Your key stays in this browser session's memory on the server and is forgotten when you close the page. It's sent only to @_aiProvider.</p>
                }
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="SaveAiSettings">Use @(_aiProvider == AiProviderService.LocalProvider ? "Local AI" : _aiProvider)</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.DetectFields when Ed.DetectedFields is { } found:
        <Modal Title="Detect Fields" OnClose="Close" Wide>
            <ChildContent>
                <p class="pe-hint">Found @found.Count possible field@(found.Count == 1 ? "" : "s"). Untick any you don't want, and change names if you like.</p>
                <div style="max-height:50vh;overflow:auto">
                    <table class="table table-sm" style="color:inherit;font-size:12px">
                        <thead><tr><th></th><th>Name</th><th>Kind</th><th>Page</th></tr></thead>
                        <tbody>
                            @foreach (var f in found)
                            {
                                var field = f;
                                <tr>
                                    <td><input type="checkbox" checked="@f.Include" @onchange="e => field.Include = e.Value is true" aria-label="Include @f.Name" /></td>
                                    <td><input class="form-control form-control-sm" value="@f.Name" @onchange="e => field.Name = e.Value?.ToString() ?? field.Name" /></td>
                                    <td>@f.Kind</td>
                                    <td>@f.Page</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" @onclick="() => Do(Ed.AddDetectedFieldsAsync)">Add @found.Count(f => f.Include) field@(found.Count(f => f.Include) == 1 ? "" : "s")</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.OpenDesign:
        <Modal Title="Open Design" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Choose a .pdfdesign file saved here or in the PdfEdit Windows app.</p>
                <InputFile class="form-control" accept=".pdfdesign,.json" OnChange="e => _files = [e.File]" />
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.OpenDesignAsync(_files[0]))">Open</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.DesignPicture:
        <Modal Title="Insert Picture" OnClose="Close">
            <ChildContent>
                <InputFile class="form-control" accept=".png,.jpg,.jpeg,.gif,.bmp,.tif,.tiff" OnChange="e => _files = [e.File]" />
                <p class="pe-hint mt-1 mb-0">The picture is kept inside the design.</p>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.AddDesignPictureAsync(_files[0]))">Insert</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Ocr:
        <Modal Title="Recognise Text (OCR)" OnClose="Close">
            <ChildContent>
                @if (_ocrLanguages == null)
                {
                    <p class="pe-hint">Checking the OCR engine…</p>
                }
                else if (_ocrLanguages.Count == 0)
                {
                    <p>@Editor.OcrMissing</p>
                }
                else
                {
                    <p class="pe-hint">Reads the text on scanned pages and adds it invisibly, so you can search, select and copy it. The pages look the same.</p>
                    <label>Language</label>
                    <select class="form-select" @bind="_ocrLang">
                        @foreach (var l in _ocrLanguages) { <option value="@l">@LanguageName(l)</option> }
                    </select>
                    <label class="d-flex gap-2 mt-2"><input type="checkbox" @bind="_ocrSkip" /> Skip pages that already have text</label>
                }
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_ocrLanguages is not { Count: > 0 })" @onclick="() => Do(() => Ed.RunOcrAsync(_ocrLang, _ocrSkip))">Recognise text</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.ScanCamera:
        <Modal Title="Scan with Camera" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">On a phone or tablet this opens the camera: take a photo of each page. On a computer, choose pictures of the pages. They become a PDF in the order you pick them.</p>
                <InputFile class="form-control" accept="image/*" capture="environment" multiple OnChange="e => _files = e.GetMultipleFiles(50)" />
                @if (_files.Count > 0) { <p class="mt-2 mb-1">@_files.Count page@(_files.Count == 1 ? "" : "s")</p> }
                @if (_ocrLanguages is { Count: > 0 })
                {
                    <label class="d-flex gap-2 mt-2"><input type="checkbox" @bind="_scanOcr" /> Make it searchable (OCR)</label>
                    @if (_scanOcr)
                    {
                        <select class="form-select mt-1" @bind="_ocrLang">
                            @foreach (var l in _ocrLanguages) { <option value="@l">@LanguageName(l)</option> }
                        </select>
                    }
                }
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.ScanImagesAsync(_files, _scanOcr && _ocrLanguages is { Count: > 0 }, _ocrLang))">Make PDF</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.CompareUpload:
        <Modal Title="Compare PDFs" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Choose the other version. The open PDF is treated as the older one: red is only in it, green only in the version you choose, orange changed in both.</p>
                <InputFile class="form-control" accept=".pdf" OnChange="e => _files = [e.File]" />
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(_files.Count == 0)" @onclick="() => Do(() => Ed.CompareWithAsync(_files[0]))">Compare</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Compare when Ed.Comparison is { } cmp:
        <Modal Title="@($"Compare: {Ed.Doc?.FileName} → {Ed.CompareName}")" OnClose="Close" Wide>
            <ChildContent>
                <div class="d-flex gap-2 align-items-center mb-2 flex-wrap">
                    <div class="pe-panel-tabs" style="border:0">
                        @foreach (var (mode, name) in new[] { ("diff", "Differences"), ("old", "Old"), ("new", "New"), ("text", "Text changes") })
                        {
                            var m = mode;
                            <button class="pe-panel-tab @(_cmpMode == m ? "active" : "")" @onclick="() => _cmpMode = m">@name</button>
                        }
                    </div>
                    <span class="pe-hint ms-auto">@cmp.Count(p => p.ChangedPercent > 0 || p.Text?.HasDifferences == true) of @cmp.Count page@(cmp.Count == 1 ? "" : "s") changed</span>
                </div>
                <div class="pe-compare">
                    @foreach (var p in cmp)
                    {
                        <div class="pe-compare-page">
                            <div class="pe-compare-head">
                                <strong>Page @p.Page</strong>
                                <span class="@(p.ChangedPercent > 0 ? "pe-changed" : "pe-same")">@(p.Text is { ExistsInA: false } ? "added" : p.Text is { ExistsInB: false } ? "removed" : p.ChangedPercent > 0 ? $"{p.ChangedPercent}% changed" : "no visible change")</span>
                            </div>
                            @if (_cmpMode == "text")
                            {
                                @if (p.Text is { HasDifferences: true } t)
                                {
                                    @foreach (var l in t.OnlyInA) { <div class="pe-diff-del">− @l</div> }
                                    @foreach (var l in t.OnlyInB) { <div class="pe-diff-add">+ @l</div> }
                                }
                                else { <div class="pe-hint">Same text.</div> }
                            }
                            else
                            {
                                var url = _cmpMode == "old" ? p.OldUrl : _cmpMode == "new" ? p.NewUrl : p.DiffUrl;
                                @if (url != null) { <img src="@url" alt="Page @p.Page (@_cmpMode)" loading="lazy" /> }
                                else { <div class="pe-hint">This page isn't in that version.</div> }
                            }
                        </div>
                    }
                </div>
            </ChildContent>
            <Footer><button class="pe-btn primary" @onclick="Close">Close</button></Footer>
        </Modal>
        break;

    case DialogKind.CertSign:
        <Modal Title="Sign with Certificate" OnClose="Close" Wide>
            <ChildContent>
                <h4 style="font-size:13px;font-weight:600">1. Your Digital ID</h4>
                @if (Ed.SigningCert != null)
                {
                    <p class="mb-1"><i class="bi bi-patch-check-fill" style="color:var(--pe-accent)"></i> @Ed.SigningCertDescription</p>
                    <button class="pe-btn mb-2" @onclick="() => _certChange = true">Use a different one</button>
                }
                @if (Ed.SigningCert == null || _certChange)
                {
                    <div class="pe-panel-tabs mb-2" style="border:0">
                        <button class="pe-panel-tab @(_certCreate ? "" : "active")" @onclick="() => _certCreate = false">Use my .pfx / .p12 file</button>
                        <button class="pe-panel-tab @(_certCreate ? "active" : "")" @onclick="() => _certCreate = true">Create a new Digital ID</button>
                    </div>
                    @if (!_certCreate)
                    {
                        <div class="row g-2 align-items-end">
                            <div class="col-6"><InputFile class="form-control" accept=".pfx,.p12" OnChange="e => _files = [e.File]" /></div>
                            <div class="col-4"><label>Password</label><input class="form-control" type="password" autocomplete="off" @bind="_certPw" /></div>
                            <div class="col-2"><button class="pe-btn primary w-100" disabled="@(_files.Count == 0)" @onclick="LoadCert">Use</button></div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            <div class="col-6"><label>Name</label><input class="form-control" @bind="_idName" /></div>
                            <div class="col-6"><label>Email</label><input class="form-control" @bind="_idEmail" /></div>
                            <div class="col-6"><label>Organisation (optional)</label><input class="form-control" @bind="_idOrg" /></div>
                            <div class="col-6"><label>Password for the ID</label><input class="form-control" type="password" autocomplete="new-password" @bind="_idPw" @bind:event="oninput" /></div>
                        </div>
                        <p class="pe-hint mt-1 mb-1">A self-signed ID: fine for your own records and people who know you; it isn't vouched for by a certificate authority. The .pfx file downloads so you can use it again.</p>
                        <button class="pe-btn primary" disabled="@(string.IsNullOrWhiteSpace(_idName) || _idPw.Length < 4)" @onclick="CreateId">Create and use</button>
                    }
                    @if (_certError != null) { <p style="color:#dc3545" class="mt-1 mb-0">@_certError</p> }
                    <p class="pe-hint mt-1 mb-0">The Digital ID is used only to sign this document and is kept in memory for this session — never saved on the server.</p>
                }

                <h4 class="mt-3" style="font-size:13px;font-weight:600">2. Where</h4>
                @foreach (var f in Ed.EmptySignatureFields)
                {
                    var name = f.Name;
                    <label class="d-flex gap-2"><input type="radio" name="where" checked="@(_signWhere == "field:" + name)" @onchange="() => SetWhere(name)" /> In the signature field “@f.Name” (page @f.Page)</label>
                }
                <label class="d-flex gap-2"><input type="radio" name="where" checked="@(_signWhere == "box")" @onchange="@(() => SetWhere(null, box: true))" /> A signature box at the bottom right of page @(Ed.CurrentPage + 1)</label>
                <label class="d-flex gap-2"><input type="radio" name="where" checked="@(_signWhere == "invisible")" @onchange="@(() => SetWhere(null, box: false))" /> Invisible (shown only in the signatures list)</label>
                @if (Ed.SignaturePng != null)
                {
                    <label class="d-flex gap-2 mt-1"><input type="checkbox" @bind="_signImage" /> Show my drawn signature in the box</label>
                }

                <h4 class="mt-3" style="font-size:13px;font-weight:600">3. Details</h4>
                <div class="row g-2">
                    <div class="col-6"><label>Reason</label><input class="form-control" @bind="_signReason" placeholder="I approve this document" /></div>
                    <div class="col-6"><label>Location</label><input class="form-control" @bind="_signLocation" /></div>
                    <div class="col-6"><label>Contact</label><input class="form-control" @bind="_signContact" /></div>
                    <div class="col-6"><label>Timestamp server (optional)</label><input class="form-control" @bind="_signTsa" placeholder="http://timestamp.digicert.com" /></div>
                </div>
                <label class="d-flex gap-2 mt-2"><input type="checkbox" @bind="_signCertify" /> Certify: lock the document so no further changes are allowed</label>
            </ChildContent>
            <Footer>
                <button class="pe-btn" @onclick="Close">Cancel</button>
                <button class="pe-btn primary" disabled="@(Ed.SigningCert == null)" @onclick="SignNow">Sign and download</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Cloud:
        <Modal Title="@(Ed.CloudSaving ? "Save to cloud storage" : "Open from cloud storage")" OnClose="Close" Wide>
            <ChildContent>
                @if (Ed.Cloud.Providers.Count == 0)
                {
                    <p>Cloud storage isn't set up on this server.</p>
                    <p class="pe-hint mb-0">
                        Whoever runs PdfEdit can add a Google Drive and/or OneDrive OAuth app in its settings
                        (PdfEdit:Cloud:Google:ClientId and ClientSecret, PdfEdit:Cloud:OneDrive:ClientId and ClientSecret),
                        with <code>@(Ed.CloudCallbackUrl)</code> as the redirect address. See the README.
                    </p>
                }
                else
                {
                    <div class="pe-panel-tabs mb-2" role="tablist">
                        @foreach (var p in Ed.Cloud.Providers)
                        {
                            var provider = p;
                            <button class="pe-panel-tab @(Ed.CloudService == provider ? "active" : "")" role="tab"
                                    @onclick="() => ActAsync(() => Ed.SelectCloudAsync(provider))">@provider.DisplayName</button>
                        }
                    </div>
                    @if (Ed.CloudService is { } svc)
                    {
                        @if (!svc.IsConnected)
                        {
                            <div class="pe-cloud-connect">
                                <i class="bi bi-cloud"></i>
                                <p>Connect your @svc.DisplayName to open PDFs from it and save them back.</p>
                                <button class="pe-btn primary" @onclick="() => ActAsync(Ed.ConnectCloudAsync)">Connect @svc.DisplayName</button>
                                @if (Ed.CloudSignInUrl != null)
                                {
                                    <p class="pe-hint mt-2 mb-0">Waiting for you to sign in… If no window opened, <a href="@Ed.CloudSignInUrl" target="_blank" rel="noopener">open the sign-in page</a>.</p>
                                }
                                <p class="pe-hint mt-2 mb-0">You stay signed in only while this page is open; PdfEdit keeps nothing afterwards.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="pe-hint"><i class="bi bi-person-circle"></i> @svc.AccountName</span>
                                <button class="pe-btn ms-auto" @onclick="Ed.DisconnectCloud">Disconnect</button>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <nav class="pe-crumbs" aria-label="Folder">
                                    @if (Ed.CloudSearching)
                                    {
                                        <button class="pe-linkbtn" @onclick="() => ActAsync(() => Ed.CloudLoadAsync(svc.RootId, Ed.CloudPath.FirstOrDefault().Name ?? My, reset: true))">@My</button>
                                        <span>› Search results</span>
                                    }
                                    else
                                    {
                                        @foreach (var (crumb, i) in Ed.CloudPath.Select((c, i) => (c, i)))
                                        {
                                            var c = crumb;
                                            @if (i > 0) { <span>›</span> }
                                            <button class="pe-linkbtn" @onclick="() => ActAsync(() => Ed.CloudLoadAsync(c.Id, c.Name))">@c.Name</button>
                                        }
                                    }
                                </nav>
                                <input type="search" class="form-control form-control-sm ms-auto" style="max-width:220px" placeholder="Search" aria-label="Search cloud files"
                                       @bind="Ed.CloudSearchText" @bind:event="oninput" @onkeydown="CloudSearchKey" />
                                <button class="pe-btn" @onclick="() => ActAsync(Ed.CloudSearchAsync)" aria-label="Search"><i class="bi bi-search"></i></button>
                            </div>
                            <div class="pe-cloud-list">
                                @if (Ed.CloudLoading)
                                {
                                    <p class="pe-hint p-3 mb-0">Loading…</p>
                                }
                                else if (Ed.CloudItems.Count == 0)
                                {
                                    <p class="pe-hint p-3 mb-0">@(Ed.CloudSearching ? "Nothing found." : "This folder has no PDFs or folders.")</p>
                                }
                                else
                                {
                                    <ul class="pe-list" role="listbox" aria-label="Files">
                                        @foreach (var it in Ed.CloudItems)
                                        {
                                            var item = it;
                                            bool usable = item.IsFolder || !Ed.CloudSaving;
                                            <li class="@(usable ? "" : "pe-disabled")" role="option" title="@item.Name"
                                                @onclick="() => CloudClick(item, usable)">
                                                <i class="bi @CloudIcon(item) pe-type"></i>
                                                <span>@item.Name</span>
                                                <span class="pe-meta">@item.Kind @item.SizeText @item.ModifiedText</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            @if (Ed.CloudSaving)
                            {
                                <div class="d-flex align-items-end gap-2 mt-2">
                                    <div class="flex-grow-1">
                                        <label class="mb-0">File name</label>
                                        <input class="form-control form-control-sm" @bind="Ed.CloudSaveName" @bind:event="oninput" aria-label="File name" />
                                    </div>
                                    <button class="pe-btn primary" disabled="@(Ed.Doc == null || Ed.CloudPath.Count == 0 || Ed.CloudSearching)"
                                            @onclick="() => ActAsync(Ed.CloudSaveHereAsync)">Save in @(Ed.CloudPath.Count > 0 ? Ed.CloudPath[^1].Name : "this folder")</button>
                                </div>
                            }
                        }
                        @if (Ed.CloudError != null)
                        {
                            <p class="mt-2 mb-0" style="color:#dc3545">@Ed.CloudError</p>
                        }
                    }
                }
            </ChildContent>
            <Footer><button class="pe-btn" @onclick="Close">Close</button></Footer>
        </Modal>
        break;

    case DialogKind.Batch:
        <Modal Title="Batch Process" OnClose="Close" Wide>
            <ChildContent>
                <div class="pe-batch">
                    <section>
                        <h4>1. Files</h4>
                        @if (Ed.Doc != null)
                        {
                            <label class="pe-check-label mb-1"><input type="checkbox" @bind="Ed.BatchIncludeOpen" /> The open document (@Ed.Doc.FileName)</label>
                        }
                        <div class="pe-drop small">
                            <i class="bi bi-files"></i> Add PDFs
                            <InputFile multiple accept=".pdf,application/pdf" OnChange="AddBatchFiles" aria-label="Add PDFs to process" />
                        </div>
                        <ul class="pe-list pe-batch-list">
                            @foreach (var (f, i) in Ed.BatchFiles.Select((f, i) => (f, i)))
                            {
                                var index = i;
                                <li><i class="bi bi-file-earmark-pdf pe-type"></i><span>@f.Name</span>
                                    <button class="pe-linkbtn ms-auto" title="Remove" aria-label="Remove @f.Name" @onclick="() => Ed.RemoveBatchFile(index)"><i class="bi bi-x-lg"></i></button></li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h4>2. Steps</h4>
                        <select @key="_stepPicks" class="form-select form-select-sm mb-1" aria-label="Add a step" @onchange="AddBatchStep">
                            <option value="">Add a step…</option>
                            @foreach (var k in Enum.GetValues<BatchStepKind>())
                            {
                                <option value="@k">@BatchStep.Title(k)</option>
                            }
                        </select>
                        <ul class="pe-list pe-batch-list">
                            @foreach (var st in Ed.BatchSteps)
                            {
                                var step = st;
                                <li class="@(Ed.SelectedBatchStep == step ? "selected" : "")" @onclick="() => Ed.SelectedBatchStep = step">
                                    <span>@step.Summary()</span>
                                    <span class="ms-auto d-flex gap-1">
                                        <button class="pe-linkbtn" title="Move up" aria-label="Move up" @onclick="() => Ed.MoveBatchStep(step, -1)" @onclick:stopPropagation="true"><i class="bi bi-arrow-up"></i></button>
                                        <button class="pe-linkbtn" title="Move down" aria-label="Move down" @onclick="() => Ed.MoveBatchStep(step, 1)" @onclick:stopPropagation="true"><i class="bi bi-arrow-down"></i></button>
                                        <button class="pe-linkbtn" title="Remove" aria-label="Remove step" @onclick="() => Ed.RemoveBatchStep(step)" @onclick:stopPropagation="true"><i class="bi bi-x-lg"></i></button>
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                    <section class="pe-props">
                        <h4>3. Settings</h4>
                        @if (Ed.SelectedBatchStep is not { } sel)
                        {
                            <p class="pe-hint">Add steps, then select one to change its settings.</p>
                        }
                        else
                        {
                            <strong style="font-size:12.5px">@BatchStep.Title(sel.Kind)</strong>
                            @foreach (var p in BatchStep.Schema(sel.Kind))
                            {
                                var param = p;
                                @if (param.IsBool)
                                {
                                    <label class="pe-check-label mt-1"><input type="checkbox" checked="@sel.GetBool(param.Key)" @onchange="e => SetBatchSetting(sel, param.Key, e)" /> @param.Label</label>
                                }
                                else if (param.Choices != null)
                                {
                                    <label>@param.Label</label>
                                    <select class="form-select form-select-sm" value="@sel.Get(param.Key)" @onchange="e => SetBatchSetting(sel, param.Key, e)">
                                        @foreach (var c in param.Choices) { <option value="@c">@c</option> }
                                    </select>
                                }
                                else
                                {
                                    <label>@param.Label</label>
                                    <input class="form-control form-control-sm" type="@(param.Secret ? "password" : "text")" value="@sel.Get(param.Key)" @onchange="e => SetBatchSetting(sel, param.Key, e)" />
                                }
                            }
                            @if (sel.Kind == BatchStepKind.Ocr)
                            {
                                <label>Languages</label>
                                <input class="form-control form-control-sm" @bind="Ed.BatchOcrLanguages" />
                                <p class="pe-hint mt-1">Tesseract language codes, e.g. eng or eng+deu. Pages that already have text are skipped.</p>
                            }
                            @if (sel.Kind == BatchStepKind.HeaderFooter) { <p class="pe-hint mt-1">{file} = file name, {date} = today.</p> }
                            @if (sel.Kind == BatchStepKind.Password) { <p class="pe-hint mt-1">Passwords are only used for this run.</p> }
                            @if (BatchStep.Schema(sel.Kind).Count == 0 && sel.Kind != BatchStepKind.Ocr) { <p class="pe-hint mt-1">No settings.</p> }
                        }
                    </section>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <label class="mb-0">Add to file names</label>
                    <input class="form-control form-control-sm" style="width:130px" @bind="Ed.BatchSuffix" aria-label="Add to file names" />
                    <span class="pe-hint ms-2">@Ed.BatchStatus</span>
                </div>
                @if (Ed.BatchLog.Count > 0)
                {
                    <ul class="pe-batch-log">
                        @foreach (var (err, text) in Ed.BatchLog)
                        {
                            <li class="@(err ? "err" : "")"><i class="bi @(err ? "bi-x-circle" : "bi-check-circle")"></i> @text</li>
                        }
                    </ul>
                }
            </ChildContent>
            <Footer>
                @if (Ed.BatchRunning)
                {
                    <button class="pe-btn" @onclick="Ed.StopBatch">Stop</button>
                }
                else
                {
                    <button class="pe-btn primary" disabled="@(Ed.BatchSteps.Count == 0)" @onclick="() => ActAsync(Ed.RunBatchAsync)">Run and download</button>
                }
                <button class="pe-btn" @onclick="Close">Close</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.BulkFill:
        <Modal Title="Bulk Fill" OnClose="Close" Wide>
            <ChildContent>
                <p class="pe-hint">One filled copy of this form for each row of a spreadsheet (CSV or Excel .xlsx) — like a mail merge.</p>
                <div class="pe-drop small">
                    <i class="bi bi-file-earmark-spreadsheet"></i> @(Ed.BulkData == null ? "Choose the spreadsheet" : $"{Ed.BulkDataName}: {Ed.BulkData.Rows.Count} row(s), {Ed.BulkData.Headers.Count} column(s) — choose another")
                    <InputFile accept=".csv,.xlsx,.tsv,.txt" OnChange="LoadBulkData" aria-label="Choose the spreadsheet" />
                </div>
                @if (Ed.BulkData is { } data)
                {
                    <div class="pe-bulk-map">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Field</th><th>Type</th><th>Column</th><th>First row</th></tr></thead>
                            <tbody>
                                @foreach (var f in Ed.BulkFields)
                                {
                                    var field = f;
                                    int col = Ed.BulkMapping.GetValueOrDefault(field.Name, -1);
                                    <tr>
                                        <td>@field.Name</td>
                                        <td class="pe-hint">@field.Kind</td>
                                        <td>
                                            <select class="form-select form-select-sm" value="@col" @onchange="e => SetBulkColumn(field.Name, e)" aria-label="Column for @field.Name">
                                                <option value="-1">— leave empty —</option>
                                                @for (int c = 0; c < data.Headers.Count; c++)
                                                {
                                                    <option value="@c">@data.Headers[c]</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="pe-hint">@(col >= 0 && data.Rows.Count > 0 ? data.Cell(0, col) : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-2 mt-1 align-items-end">
                        <div class="col-6">
                            <label class="mb-0">File names</label>
                            <input class="form-control form-control-sm" @bind="Ed.BulkPattern" @bind:event="oninput" aria-label="File names"
                                   title="Column names in braces, e.g. {Last name} {First name}; {row} is the row number" />
                            <span class="pe-hint">@(Ed.BulkExampleName.Length > 0 ? "e.g. " + Ed.BulkExampleName : "")</span>
                        </div>
                        <div class="col-6">
                            <label class="pe-check-label"><input type="checkbox" @bind="Ed.BulkFlatten" /> Flatten (values can't be changed afterwards)</label>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mt-2">
                        <label class="pe-check-label"><input type="radio" name="bulkout" checked="@(Ed.BulkOutput == "zip")" @onchange="() => Ed.BulkOutput = Zip" /> One PDF per row (ZIP)</label>
                        <label class="pe-check-label"><input type="radio" name="bulkout" checked="@(Ed.BulkOutput == "combined")" @onchange="() => Ed.BulkOutput = Combined" /> All in one PDF</label>
                        <label class="pe-check-label"><input type="radio" name="bulkout" checked="@(Ed.BulkOutput == "both")" @onchange="() => Ed.BulkOutput = Both" /> Both (ZIP)</label>
                    </div>
                    @if (Ed.BulkStatus != null) { <p class="pe-hint mt-2 mb-0">@Ed.BulkStatus</p> }
                }
            </ChildContent>
            <Footer>
                <button class="pe-btn primary" disabled="@(Ed.BulkData == null)" @onclick="() => ActAsync(Ed.RunBulkFillAsync)">Fill and download</button>
                <button class="pe-btn" @onclick="Close">Close</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Translate:
        <Modal Title="Translate PDF" OnClose="Close">
            <ChildContent>
                <p class="pe-hint">Each paragraph is translated by the AI Assistant (@Ed.AiProvider) and written back in its place, so the layout stays the same. Undo brings back the original.</p>
                <label>Into</label>
                <input class="form-control" list="pe-languages" @bind="Ed.TranslateLanguage" @bind:event="oninput" aria-label="Language" disabled="@Ed.Translating" />
                <datalist id="pe-languages">
                    @foreach (var l in Editor.TranslateLanguages) { <option value="@l"></option> }
                </datalist>
                <div class="d-flex gap-3 mt-2">
                    <label class="pe-check-label"><input type="radio" name="trscope" checked="@(!Ed.TranslateThisPage)" disabled="@Ed.Translating" @onchange="() => Ed.TranslateThisPage = false" /> The whole PDF</label>
                    <label class="pe-check-label"><input type="radio" name="trscope" checked="@Ed.TranslateThisPage" disabled="@Ed.Translating" @onchange="() => Ed.TranslateThisPage = true" /> This page (@(Ed.CurrentPage + 1))</label>
                </div>
                @if (Ed.TranslateStatus != null)
                {
                    <p class="mt-3 mb-0" style="font-size:12.5px">@if (Ed.Translating) { <span class="spinner-border spinner-border-sm me-2"></span> }@Ed.TranslateStatus</p>
                }
            </ChildContent>
            <Footer>
                @if (Ed.Translating)
                {
                    <button class="pe-btn" @onclick="Ed.StopTranslate">Stop</button>
                }
                else
                {
                    <button class="pe-btn primary" disabled="@(Ed.TranslateLanguage.Trim().Length == 0)" @onclick="() => ActAsync(Ed.TranslatePdfAsync)">Translate</button>
                }
                <button class="pe-btn" @onclick="Close">Close</button>
            </Footer>
        </Modal>
        break;

    case DialogKind.Signatures:
        <Modal Title="Signatures" OnClose="Close" Wide>
            <ChildContent>
                @if (Ed.SignatureChecks is not { Count: > 0 } checks)
                {
                    <p>This PDF has no digital signatures.</p>
                }
                else
                {
                    @foreach (var c in checks)
                    {
                        <div class="pe-action" style="align-items:flex-start">
                            <i class="bi @(c.IntegrityOk ? (c.Trusted ? "bi-patch-check-fill" : "bi-patch-exclamation-fill") : "bi-x-octagon-fill")"
                               style="font-size:22px;color:@(c.IntegrityOk ? (c.Trusted ? "#1E7B34" : "#E6A100") : "#C62828")"></i>
                            <div style="flex:1;font-size:12.5px">
                                <strong>@c.SignedBy</strong> — @c.SignedAt.ToLocalTime().ToString("g") (@c.FieldName)<br />
                                @(c.IntegrityOk ? "The document hasn't been changed since it was signed." : "The document has been changed since it was signed, or the signature is damaged.")
                                @(c.CoversWholeDocument ? "" : $" Signed revision {c.Revision} of {c.TotalRevisions}: later changes aren't covered.")<br />
                                <span class="pe-hint">@c.TrustNote@(c.Timestamped ? " Timestamped." : "")@(c.Reason.Length > 0 ? $" Reason: {c.Reason}." : "")@(c.Location.Length > 0 ? $" Location: {c.Location}." : "")</span>
                            </div>
                        </div>
                    }
                }
            </ChildContent>
            <Footer><button class="pe-btn primary" @onclick="Close">Close</button></Footer>
        </Modal>
        break;

    case DialogKind.About:
        <Modal Title="About PdfEdit" OnClose="Close">
            <ChildContent>
                <div class="text-center">
                    <div class="pe-logo mx-auto mb-2" style="width:56px;height:56px;font-size:30px;border-radius:12px">P</div>
                    <h4 style="font-weight:700">PdfEdit for the web</h4>
                    <p class="pe-hint">Version @Version · the PdfEdit Windows app in your browser, built on the same PdfEdit.Core and PdfEdit.Render libraries.</p>
                    <p class="mb-1"><a href="@Editor.GitHubUrl" target="_blank" rel="noopener">GitHub</a> · <a href="@(Editor.GitHubUrl + "/releases/latest")" target="_blank" rel="noopener">Windows app</a> · <a href="@(Editor.GitHubUrl + "/blob/main/LICENSE")" target="_blank" rel="noopener">MIT licence</a></p>
                    <p class="pe-hint mb-0">Built with .NET 10, Blazor, iText 8 and Pdfium.</p>
                </div>
            </ChildContent>
            <Footer><button class="pe-btn primary" @onclick="Close">Close</button></Footer>
        </Modal>
        break;
}

@code {
    [Parameter, EditorRequired] public Editor Ed { get; set; } = default!;

    private DialogKind _shown;

    // Inputs (reset each time a dialog opens)
    private string _password = "", _range = "";
    private PdfMetadataInfo _meta = new();
    private WatermarkOptions _wm = new();
    private string _wmFamily = "Helvetica", _wmColor = "#808080";
    private bool _wmBold = true, _wmItalic;
    private string _numFormat = "Page {n} of {total}", _numPosition = "BottomCenter";
    private float _numSize = 9;
    private string? _header, _footer;
    private string _hfAlign = "Center";
    private float _hfSize = 10;
    private string _batesPrefix = "", _batesSuffix = "", _batesPosition = "BottomRight";
    private int _batesStart = 1, _batesDigits = 6;
    private string _userPw = "", _userPw2 = "", _ownerPw = "";
    private bool _allowPrint = true, _allowCopy;
    private bool _sanMeta = true, _sanScripts = true, _sanFiles = true, _sanComments, _sanBookmarks;
    private string _paper = "A4";
    private ResizeFit _fit = ResizeFit.Fit;
    private int _nup = 2;
    private bool _nupBorders;
    private IReadOnlyList<IBrowserFile> _files = [];
    private bool _insertAtStart;
    private List<(string, string)>? _stats;
    private string _aiProvider = "", _aiKey = "";
    private IReadOnlyList<string>? _ocrLanguages;
    private string _ocrLang = "eng";
    private bool _ocrSkip = true, _scanOcr = true;
    private string _cmpMode = "diff";
    private bool _certChange, _certCreate, _signCertify, _signImage = true;
    private string _certPw = "", _idName = "", _idEmail = "", _idOrg = "", _idPw = "";
    private string? _certError;
    private string _signWhere = "box", _signReason = "", _signLocation = "", _signContact = "", _signTsa = "";

    private ElementReference _sigCanvas;
    private bool _sigTyped, _sigPadReady;
    private string _sigName = "", _sigColor = "#0b2a6f";
    private string _sigFont = "'Segoe Script','Brush Script MT','Lucida Handwriting',cursive";

    private static readonly (string, string)[] Shortcuts =
    [
        ("Ctrl+O", "Open"), ("Ctrl+S", "Save (download)"), ("Ctrl+P", "Print"), ("Ctrl+Z", "Undo"), ("Ctrl+Y", "Redo"),
        ("Ctrl+F", "Find"), ("Ctrl++ / Ctrl+-", "Zoom in / out"), ("Ctrl+0", "Actual size"), ("Esc", "Back to Select / close"),
    ];

    private static string Version =>
        typeof(PdfFormService).Assembly.GetName().Version is { } v ? $"{v.Major}.{v.Minor}.{v.Build}" : "";

    protected override async Task OnParametersSetAsync()
    {
        if (Ed.Dialog == _shown) return;
        _shown = Ed.Dialog;
        _files = [];
        _range = "";
        _sigPadReady = false;
        switch (_shown)
        {
            case DialogKind.Password:
                _password = "";
                break;
            case DialogKind.Ocr or DialogKind.ScanCamera:
                _ocrLanguages = await Ed.Ocr.LanguagesAsync();
                if (_ocrLanguages.Count > 0 && !_ocrLanguages.Contains(_ocrLang)) _ocrLang = _ocrLanguages.Contains("eng") ? "eng" : _ocrLanguages[0];
                break;
            case DialogKind.CertSign:
                _certChange = false; _certError = null; _certPw = "";
                _signWhere = Ed.EmptySignatureFields.Count > 0 ? "field:" + Ed.EmptySignatureFields[0].Name : "box";
                break;
            case DialogKind.AiSettings:
                _aiProvider = Ed.AiProvider;
                _aiKey = Ed.SessionKey(_aiProvider);
                break;
            case DialogKind.Properties when Ed.Doc != null:
                var m = Ed.Doc.Metadata;
                _meta = new PdfMetadataInfo { Title = m.Title, Author = m.Author, Subject = m.Subject, Keywords = m.Keywords, Creator = m.Creator, Producer = m.Producer };
                break;
            case DialogKind.Statistics when Ed.Doc != null:
                _stats = null;
                var doc = Ed.Doc;
                _stats = await Task.Run(() =>
                {
                    int words = 0, chars = 0;
                    for (int p = 1; p <= doc.Info.PageCount; p++)
                    {
                        var text = PdfTextExtractorService.GetPageText(doc.CurrentPath, p);
                        chars += text.Length;
                        words += text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
                    }
                    long size = new FileInfo(doc.CurrentPath).Length;
                    return new List<(string, string)>
                    {
                        ("Pages", doc.Info.PageCount.ToString()),
                        ("Words", words.ToString("N0")),
                        ("Characters", chars.ToString("N0")),
                        ("Form fields", doc.Info.FormFields.Select(f => f.Name).Distinct().Count().ToString()),
                        ("Comments and marks", doc.Annotations.Count.ToString()),
                        ("Bookmarks", doc.Bookmarks.Count.ToString()),
                        ("File size", size >= 1024 * 1024 ? $"{size / 1024d / 1024:0.0} MB" : $"{size / 1024d:0} KB"),
                    };
                });
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Ed.Dialog == DialogKind.Signature && !_sigTyped && !_sigPadReady)
        {
            _sigPadReady = true;
            await JS.InvokeVoidAsync("pdfedit.sigPad.init", _sigCanvas);
        }
    }

    private RenderFragment PositionSelect(string value, Action<string> set) => __builder =>
    {
        <select class="form-select" value="@value" @onchange="e => set(e.Value?.ToString() ?? value)">
            @foreach (var (v, name) in new[] { ("BottomCenter", "Bottom centre"), ("BottomRight", "Bottom right"), ("BottomLeft", "Bottom left"), ("TopCenter", "Top centre"), ("TopRight", "Top right"), ("TopLeft", "Top left") })
            {
                <option value="@v" selected="@(v == value)">@name</option>
            }
        </select>
    };

    private static string LanguageName(string code) => code switch
    {
        "eng" => "English", "deu" => "German", "fra" => "French", "spa" => "Spanish", "ita" => "Italian",
        "por" => "Portuguese", "nld" => "Dutch", "pol" => "Polish", "swe" => "Swedish", "dan" => "Danish",
        "nor" => "Norwegian", "fin" => "Finnish", "ces" => "Czech", "tur" => "Turkish", "rus" => "Russian",
        "ukr" => "Ukrainian", "ell" => "Greek", "ara" => "Arabic", "heb" => "Hebrew", "hin" => "Hindi",
        "jpn" => "Japanese", "kor" => "Korean", "chi_sim" => "Chinese (simplified)", "chi_tra" => "Chinese (traditional)",
        _ => code,
    };

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private void Close()
    {
        Ed.CloseDialog();
        _shown = DialogKind.None;
        Ed.Refresh();
    }

    /// <summary>Runs an editor command and keeps the dialog open (the cloud browser).</summary>
    private async Task ActAsync(Func<Task> action)
    {
        Ed.Refresh();
        await action();
        Ed.Refresh();
    }

    private const string My = "My files";
    private const string Zip = "zip", Combined = "combined", Both = "both";
    private int _stepPicks;

    private async Task AddBatchFiles(InputFileChangeEventArgs e) => await ActAsync(() => Ed.AddBatchFilesAsync(e.GetMultipleFiles(200)));

    private void AddBatchStep(ChangeEventArgs e)
    {
        if (Enum.TryParse<BatchStepKind>(e.Value?.ToString(), out var kind)) Ed.AddBatchStep(kind);
        _stepPicks++;   // a fresh picker, back on "Add a step…"
    }

    private static void SetBatchSetting(BatchStep step, string key, ChangeEventArgs e) =>
        step.Settings[key] = e.Value is bool b ? (b ? "true" : "false") : e.Value?.ToString() ?? "";

    private Task LoadBulkData(InputFileChangeEventArgs e) => ActAsync(() => Ed.LoadBulkDataAsync(e.File));

    private void SetBulkColumn(string field, ChangeEventArgs e) =>
        Ed.BulkMapping[field] = int.TryParse(e.Value?.ToString(), out var c) ? c : -1;

    private Task CloudClick(CloudItem item, bool usable) => usable ? ActAsync(() => Ed.CloudOpenAsync(item)) : Task.CompletedTask;

    private Task CloudSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? ActAsync(Ed.CloudSearchAsync) : Task.CompletedTask;

    private static string CloudIcon(CloudItem item) => item.IsFolder ? "bi-folder-fill" : item.Kind switch
    {
        "PDF" => "bi-file-earmark-pdf",
        "Google Doc" or "Word" => "bi-file-earmark-word",
        "Google Sheet" or "Excel" => "bi-file-earmark-excel",
        "Google Slides" or "PowerPoint" => "bi-file-earmark-slides",
        _ => "bi-file-earmark",
    };

    /// <summary>Closes the dialog and runs the editor command.</summary>
    private async Task Do(Func<Task> action)
    {
        Ed.CloseDialog();
        _shown = DialogKind.None;
        Ed.Refresh();
        await action();
        Ed.Refresh();
    }

    private async Task OpenWithPassword()
    {
        if (Ed.PendingPassword is not { } pending) return;
        var pw = _password;
        Ed.CloseDialog();
        _shown = DialogKind.None;
        await pending.Retry(pw);
        Ed.Refresh();
    }

    private async Task PasswordKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OpenWithPassword();
    }

    private async Task LoadCert()
    {
        _certError = await Ed.LoadCertificateAsync(_files[0], _certPw);
        if (_certError == null) { _certChange = false; _files = []; }
        _certPw = "";
    }

    private async Task CreateId()
    {
        _certError = null;
        try
        {
            await Ed.CreateDigitalIdAsync(_idName.Trim(), _idEmail.Trim(), _idOrg.Trim(), _idPw);
            _certChange = false;
            _idPw = "";
        }
        catch (Exception ex) { _certError = ex.Message; }
        Ed.Refresh();
    }

    private void SetWhere(string? field, bool box = false) =>
        _signWhere = field != null ? "field:" + field : box ? "box" : "invisible";

    private Task SignNow()
    {
        string? field = _signWhere.StartsWith("field:") ? _signWhere[6..] : null;
        bool visible = _signWhere == "box";
        return Do(() => Ed.SignWithCertificateAsync(field, visible, _signReason, _signLocation, _signContact, _signCertify, _signTsa, _signImage));
    }

    private void SaveAiSettings()
    {
        if (_aiProvider != AiProviderService.LocalProvider) Ed.SetSessionKey(_aiProvider, _aiKey);
        if (Ed.AiProvider != _aiProvider)
        {
            Ed.AiProvider = _aiProvider;
            Ed.AiModel = Editor.DefaultModel(_aiProvider);
        }
        Ed.ShowRight(RightTab.AI);
        Close();
    }

    private Task ApplyWatermark()
    {
        _wm.FontName = WatermarkOptions.FontNameFor(_wmFamily, _wmBold, _wmItalic);
        _wm.Color = _wmColor;
        var options = _wm;
        return Do(() => Ed.WatermarkAsync(options));
    }

    private Task ApplyNUp()
    {
        var (c, r) = _nup switch { 4 => (2, 2), 6 => (2, 3), 9 => (3, 3), _ => (2, 1) };
        return Do(() => Ed.NUpAsync(c, r, _nupBorders));
    }

    private void CloseNote()
    {
        Ed.EditingNote = null;
        Close();
    }

    // ── Signature ────────────────────────────────────────────────────────────

    private void SetSigMode(bool typed)
    {
        _sigTyped = typed;
        _sigPadReady = false;
    }

    private async Task SetSigColor(string colour)
    {
        _sigColor = colour;
        if (!_sigTyped && _sigPadReady) await JS.InvokeVoidAsync("pdfedit.sigPad.setColor", _sigCanvas, colour);
    }

    private async Task ClearSig() => await JS.InvokeVoidAsync("pdfedit.sigPad.clear", _sigCanvas);

    private async Task UseSignature()
    {
        string dataUrl = _sigTyped
            ? (string.IsNullOrWhiteSpace(_sigName) ? "" : await JS.InvokeAsync<string>("pdfedit.sigPad.typed", _sigName, _sigFont, _sigColor))
            : await JS.InvokeAsync<string>("pdfedit.sigPad.toPng", _sigCanvas);
        if (string.IsNullOrEmpty(dataUrl))
        {
            Ed.Toast(_sigTyped ? "Type your name first." : "Draw your signature first.", "error");
            Ed.Refresh();
            return;
        }
        Ed.SignaturePng = Convert.FromBase64String(dataUrl[(dataUrl.IndexOf(',') + 1)..]);
        Ed.SetTool(Tool.Signature);
        Close();
    }
}

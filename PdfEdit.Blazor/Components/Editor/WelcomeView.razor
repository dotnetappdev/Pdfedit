@* Shown when no document is open, like the Windows app's start page. *@
<div class="pe-welcome">
    <h1>Welcome to PdfEdit</h1>
    <p class="pe-hint">Fill in and sign forms, comment, redact, and organise and convert PDFs — in your browser.
        The work is done by the same code as the PdfEdit Windows app.</p>

    <div class="pe-drop">
        <i class="bi bi-cloud-arrow-up"></i>
        <strong>Drop a PDF here</strong> or click to choose one
        <div class="pe-hint">Up to @(PdfDocumentStore.MaxUploadBytes / 1024 / 1024) MB. It's kept on the server only while you work on it, and your work is kept in this browser as a draft so a reload doesn't lose it.</div>
        <InputFile accept=".pdf,application/pdf" OnChange="OnFile" aria-label="Open a PDF" />
    </div>

    @if (Ed.OtherDrafts.Count > 0)
    {
        @* Work kept as drafts in this browser by another window, or one that was closed. *@
        <div class="pe-recent">
            <div class="pe-recent-head"><h4 class="pe-hint">Unsaved drafts</h4></div>
            <ul class="pe-recent-list">
                @foreach (var d in Ed.OtherDrafts.ToList())
                {
                    var draft = d;
                    <li>
                        <button class="pe-recent-open" title="Carry on with @d.Name" @onclick="() => ActAsync(() => Ed.RestoreOtherDraftAsync(draft))">
                            <i class="bi @(d.Kind == "design" ? "bi-pencil-square" : "bi-file-earmark-pdf-fill")"></i>
                            <span class="pe-recent-name">@d.Name</span>
                            <span class="pe-recent-meta">@(d.Kind == "design" ? "Design" : "Draft") · @d.When</span>
                        </button>
                        <button class="pe-icon-btn" title="Discard this draft" aria-label="Discard the draft of @d.Name" @onclick="() => ActAsync(() => Ed.DiscardDraftAsync(draft))"><i class="bi bi-x"></i></button>
                    </li>
                }
            </ul>
            <p class="pe-hint pe-recent-note">Kept in this browser only, from a window that was closed or is open elsewhere.</p>
        </div>
    }

    <RecentFiles Open="file => ActAsync(() => Ed.OpenUploadAsync(file))" />

    <div class="d-flex gap-2 mb-3">
        <button class="pe-btn" @onclick="() => ActAsync(Ed.NewBlankAsync)"><i class="bi bi-file-earmark-plus"></i> New blank PDF</button>
        <button class="pe-btn" @onclick="() => { Ed.ShowDialog(DialogKind.Combine); Ed.Refresh(); }"><i class="bi bi-file-earmark-image"></i> Create from images or files</button>
        <button class="pe-btn" @onclick="() => { Ed.NewDesignPage(); Ed.Refresh(); }"><i class="bi bi-pencil-square"></i> Design a form</button>
        <button class="pe-btn" @onclick="() => { Ed.ShowDialog(DialogKind.ScanCamera); Ed.Refresh(); }"><i class="bi bi-camera"></i> Scan with camera</button>
    </div>

    <div class="pe-welcome-templates">
        <div class="pe-recent-head">
            <h4 class="pe-hint" style="font-weight:600">Start from a template</h4>
            <button class="pe-link" @onclick="() => { Ed.OpenBackstage(Backstage.New); Ed.Refresh(); }">More templates</button>
        </div>
        <TemplateGallery Ed="Ed" Compact="true" />
    </div>

    @if (Ed.Samples.Count > 0)
    {
        <h4 class="pe-hint" style="font-weight:600">Sample documents</h4>
        <div class="pe-cards">
            @foreach (var s in Ed.Samples)
            {
                var path = s;
                <button class="pe-card" @onclick="() => ActAsync(() => Ed.OpenSampleAsync(path))">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>@Path.GetFileNameWithoutExtension(path)</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Editor Ed { get; set; } = default!;

    private Task OnFile(InputFileChangeEventArgs e) => ActAsync(() => Ed.OpenUploadAsync(e.File));

    private async Task ActAsync(Func<Task> action)
    {
        await action();
        Ed.Refresh();
    }
}

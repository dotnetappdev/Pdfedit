@* A ribbon button like the Windows app's: Large = icon over a label, Compact = icon only, otherwise icon beside it. *@
<button type="button" class="pe-rbtn @(Large ? "large" : Compact ? "icon" : "small") @(Active ? "active" : "")"
        title="@(Title ?? Label)" aria-label="@(Title ?? Label)" aria-pressed="@(Active ? "true" : null)"
        disabled="@Disabled" @onclick="OnClick">
    @if (Glyph != null)
    {
        <b class="pe-glyph" aria-hidden="true" style="@GlyphStyle">@Glyph</b>
    }
    else
    {
        <i class="bi @Icon" aria-hidden="true"></i>
    }
    @if (!Compact)
    {
        <span>@Label</span>
    }
</button>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Large { get; set; }
    /// <summary>Just the icon (or <see cref="Glyph"/>), like the Windows app's small format buttons.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>Text shown instead of an icon (B, I, U, A-, A+ …).</summary>
    [Parameter] public string? Glyph { get; set; }
    [Parameter] public string? GlyphStyle { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}

@inject IJSRuntime JS
@* A ribbon drop-down button (the Windows app's DropDownButton): a menu of choices underneath. *@
<div class="pe-rmenu" @ref="_root">
    <button type="button" class="pe-rbtn @(Large ? "large" : "small") @(_open ? "active" : "")" title="@(Title ?? Label)" aria-label="@(Title ?? Label)"
            aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">
        <i class="bi @Icon" aria-hidden="true"></i>
        <span>@Label <i class="bi bi-chevron-down pe-rmenu-caret" aria-hidden="true"></i></span>
    </button>
    @if (_open)
    {
        <div class="pe-flyout-backdrop" @onclick="() => _open = false"></div>
        <div class="pe-rmenu-list" role="menu" @onclick="() => _open = false">@ChildContent</div>
    }
</div>

@code {
    private bool _open, _place;
    private ElementReference _root;
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Large { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Toggle()
    {
        _open = !_open;
        _place = _open;
    }

    // The ribbon scrolls sideways (and so clips), so the menu is placed on the page under the button.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_place) return;
        _place = false;
        await JS.InvokeVoidAsync("pdfedit.placeMenu", _root);
    }
}
